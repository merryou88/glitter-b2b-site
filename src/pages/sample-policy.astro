---
/**
 * Sample Policy Page — /sample-policy
 * Independent page explaining free swatch policy
 * CTA priority: Request Free Sample > Get Custom Quote
 */
import Layout from "@layouts/Layout.astro";
import CTAButton from "@components/CTAButton.astro";

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Sample Policy", item: "https://nixiafabric.com/sample-policy/" },
  ],
};

const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Are the swatch samples free?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, fabric swatches are free of charge. Customers bear the shipping cost only.",
      },
    },
    {
      "@type": "Question",
      name: "How long does it take to receive samples?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Sample turnaround is 3-7 business days depending on customization and shipping destination.",
      },
    },
    {
      "@type": "Question",
      name: "Can I request custom colors for swatches?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, we offer Custom Color Matching. Provide a Pantone reference or physical sample and we will match it.",
      },
    },
  ],
};

const sampleSteps = [
  {
    step: "01",
    title: "Submit Request",
    desc: "Fill out the contact form with your product requirements and end-use application.",
  },
  {
    step: "02",
    title: "Confirm Details",
    desc: "Our team confirms fabric type, backing, color, and shipping method within 24 hours.",
  },
  {
    step: "03",
    title: "Receive Swatches",
    desc: "Samples shipped in 3-7 business days. Evaluate color, texture, and quality firsthand.",
  },
  {
    step: "04",
    title: "Place Order",
    desc: "Confirm specifications and proceed with bulk production at factory-direct pricing.",
  },
];

const sampleIncludes = [
  "Chunky Glitter Synthetic Leather swatches (multiple colors)",
  "Foil-Printed Synthetic Leather swatches (multiple metallic tones)",
  "Backing material reference (Elastic Knitted / PU Coated)",
  "Thickness and GSM specification cards",
  "Testing and compliance document request guidance",
];
---

<Layout
  title="Fabric Sample Policy | Free Glitter & Foil Swatches"
  description="Request glitter, foil, iridescent or synthetic leather fabric swatches from Nixia Fabric. Samples are available for buyer evaluation before bulk orders; customer pays shipping."
  keywords="free fabric swatch, sample policy, glitter fabric sample, foil fabric sample, synthetic leather swatch, fabric sample request"
  canonical="https://nixiafabric.com/sample-policy/"
  structuredData={[breadcrumbData, faqData]}
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__current">Sample Policy</span>
      </nav>
      <span class="eyebrow">Sample Policy</span>
      <h1>Request Free Sample</h1>
      <p class="page-hero__desc">
        As a synthetic leather manufacturer since 2013, we provide free fabric samples
        for our global B2B buyers. Custom color and backing sample requests are acceptable.
      </p>
    </div>
  </section>

  <!-- Sample Process Steps -->
  <section class="section">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow">How It Works</span>
        <h2>Simple 4-Step Process</h2>
      </div>
      <div class="steps-grid">
        {sampleSteps.map((s) => (
          <div class="step-card">
            <span class="step-card__number">{s.step}</span>
            <h3 class="step-card__title">{s.title}</h3>
            <p class="step-card__desc">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="section section--alt">
    <div class="container">
      <div class="include-layout">
        <div class="include-layout__content">
          <span class="eyebrow">What You Receive</span>
          <h2>Sample Package Includes</h2>
          <p class="include-layout__intro">
            Each sample package is curated to help you evaluate fabric quality,
            color accuracy, and backing options for your specific application.
          </p>
          <ul class="include-list">
            {sampleIncludes.map((item) => (
              <li class="include-list__item">
                <span class="include-list__icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6L9 17l-5-5" />
                  </svg>
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="include-layout__card">
          <div class="include-card">
            <span class="include-card__label">Shipping</span>
            <span class="include-card__value">Customer bears cost</span>
            <p class="include-card__desc">
              Samples are free. You only pay for shipping.
              Express shipping available via DHL, FedEx, or UPS.
            </p>
            <div class="include-card__divider"></div>
            <span class="include-card__label">Turnaround</span>
            <span class="include-card__value">3-7 Business Days</span>
            <p class="include-card__desc">
              From request confirmation to shipment dispatch.
              Custom color matching may require additional time.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow">FAQ</span>
        <h2>Sample Policy Questions</h2>
      </div>
      <div class="faq-list">
        <div class="faq-item">
          <h3 class="faq-item__question">Are the swatch samples free?</h3>
          <p class="faq-item__answer">
            Yes, fabric swatches are free of charge. Customers bear the shipping cost only.
            We believe in letting you evaluate the material quality before committing to bulk orders.
          </p>
        </div>
        <div class="faq-item">
          <h3 class="faq-item__question">How long does it take to receive samples?</h3>
          <p class="faq-item__answer">
            Sample turnaround is 3-7 business days depending on customization requirements
            and shipping destination. Express shipping is available for urgent requests.
          </p>
        </div>
        <div class="faq-item">
          <h3 class="faq-item__question">Can I request custom colors for swatches?</h3>
          <p class="faq-item__answer">
            Yes, we offer Custom Color Matching. Provide a Pantone reference or physical sample
            and our team will match the color precisely. Custom color samples may require
            additional processing time.
          </p>
        </div>
        <div class="faq-item">
          <h3 class="faq-item__question">What backing options are available?</h3>
          <p class="faq-item__answer">
            We offer two backing types: Elastic Knitted (flexible, stretchable) and PU Coated
            (durable, water-resistant). Both options can be included in your sample package
            for comparison.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--dark">
    <div class="container text-center">
      <span class="eyebrow">Ready to Request?</span>
      <h2>Get Your Free Samples Today</h2>
      <p style="max-width: 600px; margin: var(--space-lg) auto var(--space-2xl);">
        Fill out the contact form with your product requirements and end-use application.
        Our team will respond within 24 hours.
      </p>
      <div class="btn-group" style="justify-content: center;">
        <CTAButton href="/contact/" variant="primary" size="lg" rfq>Request Free Sample</CTAButton>
        <CTAButton href="/products/" variant="secondary" size="lg">Discover Fabrics</CTAButton>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    padding-block: var(--space-3xl) var(--space-4xl);
    position: relative;
    overflow: hidden;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 20% 50%, rgba(196, 160, 53, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 30%, rgba(42, 65, 112, 0.4) 0%, transparent 50%);
    pointer-events: none;
  }

  .page-hero .container {
    position: relative;
    z-index: 1;
  }

  .page-hero .breadcrumb {
    margin-bottom: var(--space-lg);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
  }

  .page-hero .breadcrumb a:hover {
    color: var(--color-accent-light);
  }

  .breadcrumb__sep {
    margin-inline: var(--space-xs);
    opacity: 0.5;
  }

  .breadcrumb__current {
    color: var(--color-white);
  }

  .page-hero .eyebrow {
    color: var(--color-accent-light);
  }

  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .page-hero__desc {
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-lg);
    max-width: 640px;
  }

  /* Section Header Centered */
  .section-header--center {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  /* Steps Grid */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xl);
  }

  .step-card {
    text-align: center;
    padding: var(--space-xl);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
  }

  .step-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .step-card__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-white);
    background-color: var(--color-accent);
    border-radius: 50%;
    margin-bottom: var(--space-md);
  }

  .step-card__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-xs);
  }

  .step-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* Include Layout */
  .include-layout {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-3xl);
    align-items: center;
  }

  .include-layout__intro {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
  }

  .include-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .include-list__item {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .include-list__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--color-accent);
    background-color: rgba(196, 160, 53, 0.1);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .include-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
  }

  .include-card__label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .include-card__value {
    display: block;
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .include-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .include-card__divider {
    height: 1px;
    background-color: var(--color-border);
    margin: var(--space-lg) 0;
  }

  /* FAQ */
  .faq-list {
    max-width: 800px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .faq-item {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
  }

  .faq-item__question {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .faq-item__answer {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Responsive */
  @media (max-width: 968px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .include-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .steps-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
