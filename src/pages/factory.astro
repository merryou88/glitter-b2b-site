---
/**
 * Factory Page — /factory
 * Showcases real manufacturing capability without fabricated numbers.
 * Sections: Factory Introduction, Manufacturing Capability,
 *           Production Process, Quality Control, Packing Process
 */
import Layout from "@layouts/Layout.astro";
import CTAButton from "@components/CTAButton.astro";

// Breadcrumb structured data
const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://nixiafabric.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Factory",
      item: "https://nixiafabric.com/factory",
    },
  ],
};

const factoryPageData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Nixia Fabric Factory — Manufacturing Capability",
  description: "Explore Nixia Fabric's manufacturing facility — Chunky Glitter Synthetic Leather and Foil-Printed Synthetic Leather production, Custom Color Matching, Factory Direct Supply, quality control, and packing processes.",
  url: "https://nixiafabric.com/factory",
  about: {
    "@type": "Organization",
    name: "Nixia Fabric",
    additionalType: "Manufacturer",
  },
};

const productionSteps = [
  {
    num: "01",
    title: "Material Preparation",
    desc: "Raw fabric substrates are inspected and prepared — woven, knitted, or non-woven bases are selected based on product specifications.",
  },
  {
    num: "02",
    title: "Surface Treatment",
    desc: "Base fabric undergoes surface treatment to ensure optimal adhesion for glitter particles or metallic foil lamination.",
  },
  {
    num: "03",
    title: "Glitter Bonding / Foil Lamination",
    desc: "Glitter particles are bonded to the fabric surface using specialized adhesive techniques. For foil fabric, metallic foil is laminated under controlled heat and pressure.",
  },
  {
    num: "04",
    title: "Color Development & Matching",
    desc: "Custom colors are developed and matched against client samples. Our color lab ensures consistency across production batches.",
  },
  {
    num: "05",
    title: "Curing & Setting",
    desc: "Bonded fabric passes through curing and heat-setting processes to ensure durability, adhesion strength, and dimensional stability.",
  },
  {
    num: "06",
    title: "Finishing & Inspection",
    desc: "Fabric is finished with edge treatment, inspected for quality, and prepared for packing and shipment.",
  },
];

const qcItems = [
  {
    title: "Raw Material Inspection",
    desc: "All incoming base fabrics and materials are tested for composition, weight, width, and visual defects before entering production.",
    icon: "search",
  },
  {
    title: "In-Process Quality Control",
    desc: "During glitter bonding and foil lamination, our technicians monitor adhesion strength, glitter density, color consistency, and surface uniformity at each stage.",
    icon: "monitor",
  },
  {
    title: "Adhesion Testing",
    desc: "Finished fabric undergoes adhesion testing — including rub tests and peel strength tests — to ensure glitter and foil particles remain firmly bonded.",
    icon: "shield",
  },
  {
    title: "Color Consistency Check",
    desc: "Every production batch is checked against approved color standards using lightbox comparison and spectrophotometer measurement.",
    icon: "palette",
  },
  {
    title: "Final Inspection & Grading",
    desc: "Each roll is individually inspected, graded, and tagged with batch numbers for full traceability from production to delivery.",
    icon: "clipboard",
  },
  {
    title: "Sample Retention",
    desc: "Production samples are retained for each batch, allowing us to reference and match future reorders with consistent quality.",
    icon: "archive",
  },
];

const capabilities = [
  {
    title: "Chunky Glitter Synthetic Leather Production",
    desc: "Elastic, PU, non-woven, and Oxford glitter fabrics with various glitter particle sizes and densities.",
    items: ["Elastic Knitted Backing", "PU Coated Backing", "Non-woven Backing", "Oxford Woven Backing"],
  },
  {
    title: "Foil-Printed Synthetic Leather Production",
    desc: "Metallic foil lamination on fabric substrates — gold, silver, and custom metallic finishes.",
    items: ["Gold Foil Lamination", "Silver Foil Lamination", "Custom Metallic Colors", "Matte & Glossy Finishes"],
  },
  {
    title: "Custom Color Matching",
    desc: "In-house color lab for developing and matching custom colors based on client requirements and Pantone references.",
    items: ["Pantone Color Matching", "Custom Color Matching", "Metallic Tone Development", "Batch-to-Batch Consistency"],
  },
  {
    title: "Factory Direct & Custom Manufacturing",
    desc: "Full Factory Direct Supply capability — custom GSM, width, backing material, and special finishes tailored to client specifications.",
    items: ["Custom GSM & Width", "Custom Backing Options", "Custom Glitter Density", "Special Finishes"],
  },
];

const packingSteps = [
  {
    title: "Roll Packing",
    desc: "Fabric is rolled on sturdy cardboard tubes to prevent creasing, with plastic film wrapping for moisture protection.",
  },
  {
    title: "Inner Protection",
    desc: "Acid-free tissue paper or PE film is applied between layers for premium products to protect the glitter or foil surface.",
  },
  {
    title: "Outer Packaging",
    desc: "Woven bags or strong carton tubes are used for outer packaging, with edge protectors for international shipping.",
  },
  {
    title: "Labeling & Documentation",
    desc: "Each package is labeled with product name, batch number, specifications, and quantity. Packing lists and quality certificates are included.",
  },
];
---

<Layout
  title="Factory — Manufacturing Capability"
  description="Explore Nixia Fabric's manufacturing facility — Chunky Glitter Synthetic Leather and Foil-Printed Synthetic Leather production, Custom Color Matching, Factory Direct Supply, quality control, and packing processes."
  keywords="glitter fabric factory, foil fabric factory, fabric manufacturer china, Factory Direct Supply, Custom Color Matching, fabric quality control"
  structuredData={[breadcrumbData, factoryPageData]}
>
  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__current">Factory</span>
      </nav>
    </div>
  </div>

  <!-- Factory Hero -->
  <section class="factory-hero">
    <div class="container">
      <span class="eyebrow">Manufacturing Facility</span>
      <h1>Nixia Fabric Factory</h1>
      <p class="factory-hero__desc">
        We have specialized in glitter and foil-printed synthetic leather since 2013.
        With our own production facility and stable partnerships with qualified material
        manufacturers, we deliver reliable fabrics for footwear, handbag and accessory
        manufacturers worldwide.
      </p>
      <div class="factory-hero__badges">
        <span class="factory-hero__badge">Manufacturer</span>
        <span class="factory-hero__badge">Factory</span>
        <span class="factory-hero__badge">Factory Direct Supply</span>
        <span class="factory-hero__badge">Custom Color Matching</span>
      </div>
    </div>
  </section>

  <!-- Factory Introduction -->
  <section class="section">
    <div class="container">
      <div class="factory-intro">
        <div class="factory-intro__left">
          <span class="eyebrow">Factory Introduction</span>
          <h2>Specialized in Glitter & Foil-Printed Manufacturing</h2>
          <p>
            We are a synthetic leather manufacturer since 2013, with in-house production
            for glitter and foil-printed PU, together with partnerships with other
            qualified material factories. Our production focuses on fabrics for shoes,
            handbags and accessories.
          </p>
          <p>
            We own our in-house factory and control every step — from raw material
            selection to color development, from glitter bonding to final inspection.
            Our clients deal directly with the people who make their fabric.
          </p>
          <p>
            We do not publish factory area, machine counts, or employee numbers —
            because what matters to our clients is the quality of the fabric we deliver,
            the consistency of our colors, and the reliability of our production schedule.
          </p>
        </div>
        <div class="factory-intro__right">
          <div class="factory-intro__card">
            <div class="factory-intro__card-header">
              <span class="eyebrow">What We Produce</span>
            </div>
            <ul class="factory-intro__list">
              <li>Chunky Glitter Synthetic Leather — Elastic, PU, Non-woven, Oxford</li>
              <li>Foil-Printed Synthetic Leather — Metallic, Gold, Silver</li>
              <li>Custom Color Matching</li>
              <li>Factory Direct Supply</li>
              <li>Custom Backing & GSM</li>
              <li>Special Finishes</li>
            </ul>
          </div>
          <div class="factory-intro__card factory-intro__card--dark">
            <div class="factory-intro__card-header">
              <span class="eyebrow" style="color: var(--color-accent-light);">What We Don't Do</span>
            </div>
            <ul class="factory-intro__list">
              <li>We are not a trading company</li>
              <li>We are not a sourcing agent</li>
              <li>No middleman markup</li>
              <li>Direct factory communication</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Manufacturing Capability -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Manufacturing Capability</span>
        <h2>What We Can Produce</h2>
        <p>
          Our factory is equipped for the full range of Chunky Glitter Synthetic Leather
          and Foil-Printed Synthetic Leather production, from material preparation to Custom Color
          Matching and Factory Direct manufacturing.
        </p>
      </div>

      <div class="capabilities-grid">
        {capabilities.map((cap) => (
          <div class="cap-card">
            <h3 class="cap-card__title">{cap.title}</h3>
            <p class="cap-card__desc">{cap.desc}</p>
            <ul class="cap-card__list">
              {cap.items.map((item) => (
                <li class="cap-card__item">
                  <span class="cap-card__check">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  </span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Production Process -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Production Process</span>
        <h2>From Raw Material to Finished Fabric</h2>
        <p>
          Our production follows a systematic process to ensure consistent quality across
          every production batch.
        </p>
      </div>

      <div class="process-timeline">
        {productionSteps.map((step, i) => (
          <div class={`process-step ${i % 2 === 0 ? "process-step--left" : "process-step--right"}`}>
            <div class="process-step__marker">
              <span class="process-step__num">{step.num}</span>
            </div>
            <div class="process-step__content">
              <h3 class="process-step__title">{step.title}</h3>
              <p class="process-step__desc">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality Control -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Quality Control</span>
        <h2>Six-Stage Quality Management</h2>
        <p>
          Quality is not an afterthought — it is built into every stage of our production.
          From raw material inspection to final grading, we maintain strict standards.
        </p>
      </div>

      <div class="qc-grid">
        {qcItems.map((qc) => (
          <div class="qc-card">
            <div class="qc-card__icon">
              {qc.icon === "search" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
              )}
              {qc.icon === "monitor" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" />
                </svg>
              )}
              {qc.icon === "shield" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
              )}
              {qc.icon === "palette" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" /><circle cx="17.5" cy="10.5" r=".5" fill="currentColor" /><circle cx="8.5" cy="7.5" r=".5" fill="currentColor" /><circle cx="6.5" cy="12.5" r=".5" fill="currentColor" /><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z" />
                </svg>
              )}
              {qc.icon === "clipboard" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /><rect x="8" y="2" width="8" height="4" rx="1" ry="1" />
                </svg>
              )}
              {qc.icon === "archive" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="21 8 21 21 3 21 3 8" /><rect x="1" y="3" width="22" height="5" /><line x1="10" y1="12" x2="14" y2="12" />
                </svg>
              )}
            </div>
            <h3 class="qc-card__title">{qc.title}</h3>
            <p class="qc-card__desc">{qc.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Packing Process -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Packing Process</span>
        <h2>Careful Packing for International Shipping</h2>
        <p>
          Every roll is packed to withstand international shipping — protecting the glitter
          surface and ensuring the fabric arrives in perfect condition.
        </p>
      </div>

      <div class="packing-grid">
        {packingSteps.map((step, i) => (
          <div class="packing-card">
            <div class="packing-card__num">{String(i + 1).padStart(2, "0")}</div>
            <h3 class="packing-card__title">{step.title}</h3>
            <p class="packing-card__desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--dark">
    <div class="container text-center">
      <span class="eyebrow">Work With the Manufacturer</span>
      <h2>Ready to Start Your Fabric Project?</h2>
      <p style="max-width: 600px; margin: var(--space-lg) auto var(--space-2xl);">
        Deal directly with the factory. No middleman, no trading company markup.
        Request samples or get a custom quote for your specific requirements.
      </p>
      <div class="btn-group" style="justify-content: center;">
        <CTAButton href="/sample-policy" variant="primary" size="lg">Request Free Sample</CTAButton>
        <CTAButton href="/contact" variant="secondary" size="lg">Get Custom Quotation</CTAButton>
      </div>
    </div>
  </section>

  <!-- Visit Our Factory -->
  <section class="visit-factory">
    <div class="container">
      <div class="visit-factory__grid">
        <!-- Left: Contact Info -->
        <div class="visit-factory__info">
          <span class="visit-factory__eyebrow">GET IN TOUCH</span>
          <h2 class="visit-factory__title">Visit Our Factory</h2>

          <div class="visit-factory__items">
            <div class="visit-factory__item">
              <div class="visit-factory__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              </div>
              <div class="visit-factory__item-content">
                <h3 class="visit-factory__item-label">Address</h3>
                <p class="visit-factory__item-text">No.63 Chuangqi Road, Shilou Town, Panyu District, Guangzhou, China</p>
              </div>
            </div>

            <div class="visit-factory__item">
              <div class="visit-factory__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10" />
                  <polyline points="12 6 12 12 16 14" />
                </svg>
              </div>
              <div class="visit-factory__item-content">
                <h3 class="visit-factory__item-label">Business Hours</h3>
                <p class="visit-factory__item-text">Mon&#8209;Sat, 8:00 AM&#8209;18:00 PM (CST, UTC+8)</p>
              </div>
            </div>

            <div class="visit-factory__item">
              <div class="visit-factory__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
              </div>
              <div class="visit-factory__item-content">
                <h3 class="visit-factory__item-label">Phone</h3>
                <p class="visit-factory__item-text"><a href="tel:+8613800000000">+86 138 0000 0000</a></p>
              </div>
            </div>

            <div class="visit-factory__item">
              <div class="visit-factory__icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                  <polyline points="22,6 12,13 2,6" />
                </svg>
              </div>
              <div class="visit-factory__item-content">
                <h3 class="visit-factory__item-label">Email</h3>
                <p class="visit-factory__item-text"><a href="mailto:info@nixiafabric.com">info@nixiafabric.com</a></p>
              </div>
            </div>
          </div>

          <div class="visit-factory__cta">
            <CTAButton href="/contact" variant="primary" size="lg">Book a Factory Visit</CTAButton>
          </div>
        </div>

        <!-- Right: Google Maps (with fallback) -->
        <div class="visit-factory__map" id="factory-map-wrapper">
          <iframe
            src="https://maps.google.com/maps?q=No.63%20Chuangqi%20Road%2C%20Shilou%20Town%2C%20Panyu%20District%2C%20Guangzhou%2C%20China&t=&z=15&ie=UTF8&iwloc=&output=embed"
            width="100%"
            height="400"
            style="border:0; border-radius:12px;"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            id="factory-map-iframe"
          ></iframe>
        </div>
        <!-- Fallback card (shown when Google Maps is unreachable) -->
        <div class="visit-factory__fallback" id="factory-map-fallback">
          <div class="visit-factory__fallback-icon">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
          </div>
          <p class="visit-factory__fallback-text">No.63 Chuangqi Road, Shilou Town, Panyu District, Guangzhou, China</p>
          <a class="visit-factory__fallback-link" href="https://maps.google.com/maps?q=No.63%20Chuangqi%20Road%2C%20Shilou%20Town%2C%20Panyu%20District%2C%20Guangzhou%2C%20China" target="_blank" rel="noopener noreferrer">
            View on Google Maps
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7" /><polyline points="7 7 17 7 17 17" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .breadcrumb-bar {
    background-color: var(--color-bg-alt);
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb a:hover {
    color: var(--color-accent-dark);
  }

  .breadcrumb__sep {
    color: var(--color-text-light);
  }

  .breadcrumb__current {
    color: var(--color-primary);
    font-weight: 600;
  }

  /* Factory Hero */
  .factory-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    padding-block: var(--space-3xl) var(--space-4xl);
    position: relative;
    overflow: hidden;
  }

  .factory-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 50%, rgba(196, 160, 53, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 30%, rgba(42, 65, 112, 0.4) 0%, transparent 50%);
    pointer-events: none;
  }

  .factory-hero .container {
    position: relative;
    z-index: 1;
  }

  .factory-hero .eyebrow {
    color: var(--color-accent-light);
  }

  .factory-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .factory-hero__desc {
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-lg);
    max-width: 680px;
    margin-bottom: var(--space-2xl);
  }

  .factory-hero__badges {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .factory-hero__badge {
    padding: 0.5rem 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.05);
  }

  /* Factory Introduction */
  .factory-intro {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-4xl);
    align-items: start;
  }

  .factory-intro__left p {
    margin-bottom: var(--space-md);
    font-size: var(--text-base);
    line-height: 1.8;
  }

  .factory-intro__right {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .factory-intro__card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
  }

  .factory-intro__card--dark {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .factory-intro__card--dark .factory-intro__list li {
