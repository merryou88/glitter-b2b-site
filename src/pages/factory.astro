---
/**
 * Factory Page — /factory
 * Showcases real manufacturing capability without fabricated numbers.
 * Sections: Factory Introduction, Production Capability, Workshop,
 *           Production Process, Quality Control, Testing, Custom Orders,
 *           Packing, Commercial Conditions and Factory Audit
 */
import Layout from "@layouts/Layout.astro";
import CTAButton from "@components/CTAButton.astro";

// Breadcrumb structured data
const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://nixiafabric.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Factory",
      item: "https://nixiafabric.com/factory/",
    },
  ],
};

const factoryPageData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Foil Fabric Manufacturing & Quality Control | Nixia Fabric",
  description: "Explore Nixia Fabric's Guangzhou production facility, foil fabric processing, quality control, sample development and roll packing for performance apparel.",
  url: "https://nixiafabric.com/factory/",
  about: {
    "@type": "Organization",
    name: "Nixia Fabric",
    additionalType: "Manufacturer",
  },
};

const toWebp = (src: string) => src.replace(/\.(png|jpe?g)$/i, ".webp");

const productionSteps = [
  {
    num: "01",
    title: "Order Specification Review",
    desc: "The product, application, approved reference, color or foil effect, quantity, usable width and packing requirements are recorded before production.",
    checkpoint: "Order specification and approved reference confirmed",
  },
  {
    num: "02",
    title: "Incoming Material Check",
    desc: "Base fabric, foil and production materials are checked against the order requirements for identity, appearance, width and suitability for the requested finish.",
    checkpoint: "Materials released for production",
  },
  {
    num: "03",
    title: "Setup & First Production Check",
    desc: "Heat, pressure, speed and alignment are adjusted for the selected fabric. The first acceptable length is compared with the approved reference before bulk continuation.",
    checkpoint: "First production output approved",
  },
  {
    num: "04",
    title: "Hot-Stamping Foil Transfer",
    desc: "Foil is transferred onto the fabric surface under controlled production settings, with operators checking coverage, alignment and surface consistency during the run.",
    checkpoint: "Foil coverage and appearance remain consistent",
  },
  {
    num: "05",
    title: "In-Process Inspection",
    desc: "Production is compared with the approved reference for color direction, pattern, gloss, visible defects and foil transfer consistency.",
    checkpoint: "Non-conforming sections identified before finishing",
  },
  {
    num: "06",
    title: "Final Roll Inspection",
    desc: "Finished rolls are checked for appearance, usable width, roll quantity, labeling and the order-specific acceptance requirements.",
    checkpoint: "Roll approved or held for review",
  },
  {
    num: "07",
    title: "Packing & Shipment Release",
    desc: "Approved rolls are packed, labeled and matched with the packing list before shipment or customer collection.",
    checkpoint: "Packing and shipping information verified",
  },
];

const qcItems = [
  {
    title: "Controlled Order Specification",
    desc: "Every order starts from a confirmed product or approved reference, quantity, color or foil effect, usable width, packing method and buyer-specific requirements.",
    icon: "search",
  },
  {
    title: "Approved Reference",
    desc: "Stock orders are checked against the confirmed product reference. Custom orders proceed after the buyer approves the development sample or strike-off.",
    icon: "monitor",
  },
  {
    title: "First Production Approval",
    desc: "The first acceptable production output is reviewed before the remaining quantity continues, reducing the risk of repeating an incorrect effect.",
    icon: "shield",
  },
  {
    title: "In-Process Appearance Checks",
    desc: "Operators monitor foil coverage, alignment, gloss, color direction, surface marks and visible defects against the approved reference.",
    icon: "palette",
  },
  {
    title: "Final Roll Release",
    desc: "Rolls are checked against the order requirements for appearance, usable width, quantity, labels and packing before shipment release.",
    icon: "clipboard",
  },
  {
    title: "Buyer-Specific Test Plan",
    desc: "Required test methods, acceptance levels, reporting party and sample submission are agreed before production when third-party testing is needed.",
    icon: "archive",
  },
];

const capabilities = [
  {
    title: "Hot-Stamping Foil Fabric Production",
    desc: "Hot-stamping foil finishing on stretch fabric substrates — iridescent, gradient and custom metallic effects.",
    items: ["Metallic Foil Effects", "Iridescent & Gradient Effects", "Patterned Foil Transfer", "Matte & Glossy Finishes"],
  },
  {
    title: "Sample & Effect Matching",
    desc: "Development can start from a buyer sample, reference image, target color direction or required surface effect.",
    items: ["Buyer Sample Review", "Reference Color Direction", "Foil Effect Development", "Approval Sample Before Bulk"],
  },
  {
    title: "Custom Development Support",
    desc: "Base fabric, GSM, usable width and finish options are reviewed according to the application and order requirements.",
    items: ["Base Fabric Options", "GSM & Usable Width", "Special Finishes", "Buyer-Specific Requirements"],
  },
];

const packingSteps = [
  {
    title: "Roll Packing",
    desc: "Finished fabric is prepared in rolls using an inner tube and protective outer wrapping suitable for the confirmed shipping method.",
  },
  {
    title: "Surface Protection",
    desc: "Additional protective layers or special roll requirements can be discussed when the foil surface or buyer handling process requires them.",
  },
  {
    title: "Outer Packaging",
    desc: "Outer packing is selected according to roll size, shipment method and buyer requirements rather than using one format for every product.",
  },
  {
    title: "Labeling & Documentation",
    desc: "Roll labels, shipping marks, packing lists and buyer-requested documentation are confirmed as part of the order.",
  },
];

const workshopPhotos = [
  { src: "/images/process/raw_material_preparation.webp", alt: "Raw material preparation in the fabric workshop" },
  { src: "/images/process/hot_stamping_foil_transfer.webp", alt: "Hot-stamping foil transfer production line in operation" },
  { src: "/images/process/on_line_visual_inspection.webp", alt: "On-line visual inspection of foil fabric" },
  { src: "/images/process/sample_confirmation.webp", alt: "Sample confirmation of hot-pressed foil fabric detail" },
  { src: "/images/process/final_packing.webp", alt: "Final packing area for foil fabric rolls" },
];

const customOrderSteps = [
  {
    num: "01",
    title: "Requirement Review",
    desc: "Buyer provides the application, reference sample or image, target effect, expected quantity and required delivery market.",
  },
  {
    num: "02",
    title: "Feasibility & Quotation",
    desc: "We review the base fabric, foil effect, usable width, MOQ, sampling route, testing needs, packing and estimated timing.",
  },
  {
    num: "03",
    title: "Development Sample",
    desc: "A sample or strike-off is prepared when a stock reference cannot fully represent the requested result.",
  },
  {
    num: "04",
    title: "Buyer Approval",
    desc: "The buyer approves the physical appearance, base fabric, color direction and foil effect before bulk production.",
  },
  {
    num: "05",
    title: "Order Confirmation",
    desc: "Final quantity, unit, price, delivery term, production timing, test plan, labels and packing are confirmed in the order documents.",
  },
  {
    num: "06",
    title: "Bulk Production",
    desc: "Materials are checked, the first production output is approved and the remaining quantity proceeds with in-process inspection.",
  },
  {
    num: "07",
    title: "Final Release",
    desc: "Finished rolls are checked against the approved reference and order-specific requirements before packing.",
  },
  {
    num: "08",
    title: "Packing & Shipment",
    desc: "Rolls, labels, packing list and shipping details are verified before dispatch or customer collection.",
  },
];

const orderConditions = [
  {
    title: "Product Specifications",
    desc: "Composition, GSM, width, stretch, available colors and other product-specific data are maintained on each product detail page.",
    href: "/products/",
    linkLabel: "Compare product specifications",
  },
  {
    title: "MOQ",
    desc: "Standard-product MOQ follows the selected product page. Custom MOQ is confirmed after reviewing the base fabric, foil, color or pattern and development route.",
    href: "/products/",
    linkLabel: "View product MOQ",
  },
  {
    title: "Lead Time",
    desc: "Stock dispatch and production lead time are different. The applicable timing is shown on the product page when confirmed and finalized in the quotation.",
    href: "/contact/",
    linkLabel: "Confirm order timing",
  },
  {
    title: "Testing & Packing",
    desc: "Required test methods, reporting party, acceptance criteria, roll packing, labels and shipping marks are confirmed before order release.",
    href: "/certifications/",
    linkLabel: "Review testing support",
  },
];

const testOptions = [
  {
    title: "Production Appearance",
    desc: "Comparison with the approved reference for foil coverage, alignment, color direction, gloss and visible surface defects.",
  },
  {
    title: "Order Measurements",
    desc: "Usable width, roll quantity and other agreed product measurements are checked against the confirmed order specification.",
  },
  {
    title: "Rubbing Performance",
    desc: "Dry and wet rubbing tests can be arranged to an agreed method such as ISO 105-X12 when required by the buyer.",
  },
  {
    title: "Washing & Dimensional Change",
    desc: "Buyer-specific washing procedures and dimensional-change testing can be arranged using agreed methods such as ISO 6330 and ISO 5077.",
  },
  {
    title: "Chemical Compliance",
    desc: "SGS, REACH or market-specific restricted-substance testing can be arranged according to the product, destination and buyer protocol.",
  },
  {
    title: "Pre-Production Agreement",
    desc: "Test method, sample quantity, acceptance level, cost and reporting party should be confirmed before bulk production.",
  },
];

const auditSupport = [
  "Factory visit arrangement for buyers and agents",
  "Business license and entity documents",
  "SGS / REACH testing arranged according to buyer requirements",
  "Production & packing documentation support",
  "Embedded factory video and live video review support",
];

const factorySnapshot = [
  { label: "Production model", value: "Own production facility" },
  { label: "Core capability", value: "Foil fabric processing and finishing" },
  { label: "Quality control", value: "Incoming, in-process and final inspection" },
  { label: "Development", value: "Sample, base fabric and foil effect review" },
  { label: "Packing", value: "Roll packing and batch labeling" },
  { label: "Factory review", value: "Visit or video review available" },
];
---

<Layout
  title="Foil Fabric Manufacturing & Quality Control | Nixia Fabric"
  description="See Nixia Fabric's Guangzhou production facility for foil fabric processing, sample and foil-effect matching, quality inspection, roll packing and custom development."
  keywords="foil fabric manufacturer, foil fabric factory, hot-stamping foil fabric factory, custom foil fabric development, foil fabric quality control, performance apparel fabric supplier"
  structuredData={[breadcrumbData, factoryPageData]}
  footerFocus="foil"
>
  <!-- Factory Hero -->
  <section class="factory-hero">
    <div class="container">
      <span class="eyebrow">Foil Fabric Manufacturing</span>
      <h1>Foil Fabric Manufacturing in Guangzhou</h1>
      <p class="factory-hero__desc">
        We operate our own production facility for foil fabric processing, sample and
        effect matching, quality inspection and roll packing. Since 2013, we have
        supported stage costume, performance wear, dancewear and party apparel manufacturers.
      </p>
      <div class="factory-hero__badges">
        <span class="factory-hero__badge">Own Production Facility</span>
        <span class="factory-hero__badge">Foil Application</span>
        <span class="factory-hero__badge">Sample Matching</span>
        <span class="factory-hero__badge">Quality Inspection</span>
        <span class="factory-hero__badge">Custom Development</span>
      </div>
    </div>
  </section>

  <!-- Factory Introduction -->
  <section class="section">
    <div class="container">
      <div class="factory-intro">
        <div class="factory-intro__left">
          <span class="eyebrow">Production Introduction</span>
          <h2>Production Controlled from Foil Application to Shipment</h2>
          <p>
            We have focused on hot-stamping foil finishes since 2013. Our own production
            facility supports foil application, sample and effect matching, inspection
            and finished roll packing for performance apparel customers.
          </p>
          <p>
            The buying process starts with the application, fabric reference and target
            surface effect. We then review the base fabric, color direction, sample
            approval, production specification and order requirements before bulk work.
          </p>
        </div>
        <div class="factory-intro__right">
          <div class="factory-intro__card">
            <div class="factory-intro__card-header">
              <span class="eyebrow">What We Support</span>
            </div>
            <ul class="factory-intro__list">
              <li>Hot-Stamping Foil Fabric — Iridescent, Gradient, Metallic</li>
              <li>Color Direction &amp; Foil Effect Matching</li>
              <li>Base Fabric Review</li>
              <li>Custom Pattern &amp; Foil Effect</li>
              <li>Roll Packing Requirements</li>
            </ul>
          </div>
          <div class="factory-intro__card factory-intro__card--dark">
            <div class="factory-intro__card-header">
              <span class="eyebrow" style="color: var(--color-accent-light);">How We Work</span>
            </div>
            <ul class="factory-intro__list">
              <li>Start from buyer application and reference sample</li>
              <li>Confirm fabric and foil effect before bulk order</li>
              <li>Keep specifications, quantity and packing clear</li>
              <li>Manage practical B2B production requirements</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Factory Snapshot -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header section-header--left">
        <span class="eyebrow">Factory at a Glance</span>
        <h2>Manufacturing Capability Buyers Can Review</h2>
        <p>
          Our production setup is organized around consistent foil effects, clear
          specifications, inspection records and export-ready packing.
        </p>
      </div>
      <div class="factory-snapshot">
        {factorySnapshot.map((item) => (
          <div class="factory-snapshot__item">
            <span class="factory-snapshot__label">{item.label}</span>
            <strong class="factory-snapshot__value">{item.value}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Workshop Photos -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Production Scenes</span>
        <h2>Foil Application, Inspection and Packing</h2>
        <p>
          Production scenes covering material preparation, foil transfer, inspection,
          sample confirmation and roll packing.
        </p>
      </div>
      <div class="workshop-grid">
        {workshopPhotos.map((photo) => (
          <figure class="workshop-photo">
            <picture>
              <source srcset={toWebp(photo.src)} type="image/webp" />
              <img src={photo.src} alt={photo.alt} width="1200" height="675" loading="lazy" decoding="async" />
            </picture>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Factory Video -->
  <section class="section section--dark factory-video">
    <div class="container">
      <div class="factory-video__content">
        <div class="factory-video__copy">
          <span class="eyebrow">Remote Factory Review</span>
          <h2>See Our Production Facility in Operation</h2>
          <p>
            Watch a short overview of our material displays, production equipment and
            workshop team. For project-specific review, buyers can also arrange a live
            video factory tour.
          </p>
          <CTAButton href="/contact/" variant="primary" size="lg">Arrange a Video Factory Tour</CTAButton>
        </div>
        <div class="factory-video__media">
          <video
            controls
            playsinline
            preload="metadata"
            poster="/images/factory/nixia-factory-poster.jpg"
            aria-label="Nixia Fabric Guangzhou production facility video"
          >
            <source src="/images/factory/nixia-factory-branded.mp4" type="video/mp4" />
            <p>
              Your browser cannot play this video.
              <a href="/images/factory/nixia-factory-branded.mp4">Open the factory video</a>.
            </p>
          </video>
          <div class="factory-video__meta" aria-hidden="true">
            <span>Guangzhou production facility</span>
            <span>00:59</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Manufacturing Capability -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Production Capability</span>
        <h2>What We Can Produce</h2>
        <p>
          We support hot-stamping foil fabric production, sample and effect matching,
          buyer-specific development and finished roll packing.
        </p>
      </div>

      <div class="capabilities-grid">
        {capabilities.map((cap) => (
          <div class="cap-card">
            <h3 class="cap-card__title">{cap.title}</h3>
            <p class="cap-card__desc">{cap.desc}</p>
            <ul class="cap-card__list">
              {cap.items.map((item) => (
                <li class="cap-card__item">
                  <span class="cap-card__check">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  </span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Production Process -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Production Workflow</span>
        <h2>From Order Specification to Shipment Release</h2>
        <p>
          The same control method applies across products, while composition, GSM,
          width, MOQ and lead time remain specific to the selected product and order.
        </p>
      </div>

      <div class="process-timeline">
        {productionSteps.map((step, i) => (
          <div class={`process-step ${i % 2 === 0 ? "process-step--left" : "process-step--right"}`}>
            <div class="process-step__marker">
              <span class="process-step__num">{step.num}</span>
            </div>
            <div class="process-step__content">
              <h3 class="process-step__title">{step.title}</h3>
              <p class="process-step__desc">{step.desc}</p>
              <p class="process-step__checkpoint"><strong>QC checkpoint:</strong> {step.checkpoint}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality Control Detail -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Standardized Quality Control</span>
        <h2>One Control Method, Product-Specific Acceptance Criteria</h2>
        <p>
          Quality is standardized through a confirmed order specification, approved
          reference, first production check, in-process comparison and final roll release.
          Product tolerances and test requirements are agreed for the selected item.
        </p>
      </div>

      <div class="qc-grid">
        {qcItems.map((qc) => (
          <div class="qc-card">
            <div class="qc-card__icon">
              {qc.icon === "search" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
              )}
              {qc.icon === "monitor" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" />
                </svg>
              )}
              {qc.icon === "shield" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
              )}
              {qc.icon === "palette" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" /><circle cx="17.5" cy="10.5" r=".5" fill="currentColor" /><circle cx="8.5" cy="7.5" r=".5" fill="currentColor" /><circle cx="6.5" cy="12.5" r=".5" fill="currentColor" /><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z" />
                </svg>
              )}
              {qc.icon === "clipboard" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /><rect x="8" y="2" width="8" height="4" rx="1" ry="1" />
                </svg>
              )}
              {qc.icon === "archive" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="21 8 21 21 3 21 3 8" /><rect x="1" y="3" width="22" height="5" /><line x1="10" y1="12" x2="14" y2="12" />
                </svg>
              )}
            </div>
            <h3 class="qc-card__title">{qc.title}</h3>
            <p class="qc-card__desc">{qc.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testing Options -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Inspection &amp; Testing</span>
        <h2>Testing Is Defined by the Product and Buyer Requirement</h2>
        <p>
          Routine production checks and third-party laboratory tests are different.
          Required methods, acceptance criteria, reporting party and cost should be
          agreed before production.
        </p>
      </div>
      <div class="testing-grid">
        {testOptions.map((item) => (
          <article class="testing-item">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Packing Process -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Packing Process</span>
        <h2>Order-Specific Roll Packing and Documentation</h2>
        <p>
          Packing is confirmed according to the product, roll size, transport method,
          labels and buyer requirements instead of applying one format to every order.
        </p>
      </div>

      <div class="packing-grid">
        {packingSteps.map((step, i) => (
          <div class="packing-card">
            <div class="packing-card__num">{String(i + 1).padStart(2, "0")}</div>
            <h3 class="packing-card__title">{step.title}</h3>
            <p class="packing-card__desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Custom Order Process -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Custom Order Execution</span>
        <h2>How a Custom Foil Fabric Order Moves to Bulk Production</h2>
        <p>
          Custom work is controlled through feasibility review, physical sample approval,
          written order confirmation and first production approval before full bulk output.
        </p>
      </div>
      <div class="custom-order-grid">
        {customOrderSteps.map((item) => (
          <article class="custom-order-card">
            <span class="custom-order-card__num">{item.num}</span>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Order Conditions -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Commercial Conditions</span>
        <h2>Specifications, MOQ and Lead Time Follow the Selected Product</h2>
        <p>
          Factory controls are consistent, but product specifications and commercial
          conditions vary by fabric, stock status and customization level.
        </p>
      </div>
      <div class="order-conditions-grid">
        {orderConditions.map((item) => (
          <article class="order-condition">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
            <a href={item.href}>{item.linkLabel}<span aria-hidden="true"> →</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Factory Audit Support -->
  <section class="section section--alt">
    <div class="container">
      <div class="audit-wrap">
        <div class="audit-copy">
          <span class="eyebrow">Factory Audit</span>
          <h2>Buyers Are Welcome to Visit</h2>
          <p>
            We support buyer and agent factory visits, remote video review and the
            documents needed for audit and compliance review.
          </p>
          <ul class="audit-list">
            {auditSupport.map((item) => (
