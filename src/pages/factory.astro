<script>
  // Map fallback: probe Google Maps servers with a lightweight image.
  // If the image fails (e.g. Google blocked in China), hide the iframe
  // and show the fallback card so no blank frame appears.
  (function () {
    var iframe = document.getElementById('factory-map-iframe');
    var wrapper = document.getElementById('factory-map-wrapper');
    var fallback = document.getElementById('factory-map-fallback');
    var grid = document.querySelector('.visit-factory__grid');
    if (!iframe || !wrapper || !fallback || !grid) return;

    function showFallback() {
      wrapper.classList.add('visit-factory__map--hidden');
      fallback.classList.add('visit-factory__fallback--visible');
      grid.classList.add('visit-factory__grid--map-failed');
    }

    // Method 1: probe a Google Maps static asset
    var probe = new Image();
    probe.onload = function () {
      // Google reachable — iframe should load, keep it
    };
    probe.onerror = function () {
      // Google blocked — show fallback immediately
      showFallback();
    };
    probe.src = 'https://maps.gstatic.com/mapfiles/api-3/images/powered-by-google-on-non-white3_hdpi.png?_=' + Date.now();

    // Method 2: secondary timeout — if the iframe hasn't fired load
    // within 6 seconds, show fallback as a safety net
    var iframeLoaded = false;
    iframe.addEventListener('load', function () {
      iframeLoaded = true;
    });
    setTimeout(function () {
      if (!iframeLoaded) {
        showFallback();
      }
    }, 6000);
  })();
</script>
