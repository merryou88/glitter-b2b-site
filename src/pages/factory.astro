<style>
  .breadcrumb-bar {
    background-color: var(--color-bg-alt);
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb a:hover {
    color: var(--color-accent-dark);
  }

  .breadcrumb__sep {
    color: var(--color-text-light);
  }

  .breadcrumb__current {
    color: var(--color-primary);
    font-weight: 600;
  }

  /* Factory Hero */
  .factory-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    padding-block: var(--space-3xl) var(--space-4xl);
    position: relative;
    overflow: hidden;
  }

  .factory-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 50%, rgba(196, 160, 53, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 30%, rgba(42, 65, 112, 0.4) 0%, transparent 50%);
    pointer-events: none;
  }

  .factory-hero .container {
    position: relative;
    z-index: 1;
  }

  .factory-hero .eyebrow {
    color: var(--color-accent-light);
  }

  .factory-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .factory-hero__desc {
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-lg);
    max-width: 680px;
    margin-bottom: var(--space-2xl);
  }

  .factory-hero__badges {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .factory-hero__badge {
    padding: 0.5rem 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.05);
  }

  /* Factory Introduction */
  .factory-intro {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-4xl);
    align-items: start;
  }

  .factory-intro__left p {
    margin-bottom: var(--space-md);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .factory-intro__right {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .factory-intro__card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
  }

  .factory-intro__card--dark {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .factory-intro__card--dark .factory-intro__list li {
    color: rgba(255, 255, 255, 0.85);
  }

  .factory-intro__card--dark .factory-intro__list li::before {
    color: var(--color-accent);
  }

  .factory-intro__card-header {
    margin-bottom: var(--space-md);
  }

  .factory-intro__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .factory-intro__list li {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    padding-left: var(--space-lg);
    position: relative;
    line-height: 1.6;
  }

  .factory-intro__list li::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 700;
  }

  /* Capabilities Grid */
  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }

  .cap-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    transition: all var(--transition-base);
  }

  .cap-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent-light);
  }

  .cap-card__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-sm);
  }

  .cap-card__desc {
    font-size: var(--text-sm);
    margin-bottom: var(--space-lg);
  }

  .cap-card__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .cap-card__item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .cap-card__check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: rgba(196, 160, 53, 0.12);
    color: var(--color-accent-dark);
    flex-shrink: 0;
  }

  /* Process Timeline */
  .process-timeline {
    position: relative;
    max-width: 900px;
    margin-inline: auto;
  }

  .process-timeline::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--color-accent), var(--color-border));
    transform: translateX(-50%);
  }

  .process-step {
    display: flex;
    align-items: flex-start;
    margin-bottom: var(--space-2xl);
    position: relative;
  }

  .process-step--left {
    flex-direction: row;
    padding-right: 50%;
  }

  .process-step--right {
    flex-direction: row-reverse;
    padding-left: 50%;
  }

  .process-step__marker {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .process-step__num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-primary);
    color: var(--color-white);
    font-weight: 800;
    font-size: var(--text-sm);
    border: 4px solid var(--color-bg);
    box-shadow: var(--shadow-md);
  }

  .process-step__content {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    margin: 0 var(--space-xl);
    transition: all var(--transition-base);
  }

  .process-step__content:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent-light);
  }

  .process-step__title {
    font-size: var(--text-base);
    margin-bottom: var(--space-sm);
  }

  .process-step__desc {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  /* QC Grid */
  .qc-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .qc-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    transition: all var(--transition-base);
  }

  .qc-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
  }

  .qc-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background-color: var(--color-primary);
    color: var(--color-white);
    margin-bottom: var(--space-lg);
  }

  .qc-card__title {
    font-size: var(--text-base);
    margin-bottom: var(--space-sm);
  }

  .qc-card__desc {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  /* Packing Grid */
  .packing-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .packing-card {
    background-color: var(--color-bg-alt);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    border-top: 3px solid var(--color-accent);
    transition: all var(--transition-base);
  }

  .packing-card:hover {
    background-color: var(--color-white);
    box-shadow: var(--shadow-md);
  }

  .packing-card__num {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
    line-height: 1;
  }

  .packing-card__title {
    font-size: var(--text-base);
    margin-bottom: var(--space-sm);
  }

  .packing-card__desc {
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  /* Production Process Steps with Images */
  .process-steps-with-images {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
    max-width: 900px;
    margin-inline: auto;
  }

  .process-step-img {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .process-step-img:nth-child(even) {
    direction: rtl;
  }

  .process-step-img:nth-child(even) > * {
    direction: ltr;
  }

  .process-step-img__media {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    aspect-ratio: 16 / 9;
    background: var(--color-bg);
  }

  .process-step-img__media picture,
  .process-step-img__media img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .process-step-img__media img {
    object-fit: cover;
    filter: sepia(0.08) saturate(0.95) brightness(1.02) hue-rotate(5deg);
  }

  .process-step-img__info {
    padding: var(--space-md);
  }

  .process-step-img__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-accent);
    color: var(--color-white);
    font-weight: 800;
    font-size: var(--text-base);
    margin-bottom: var(--space-md);
  }

  .process-step-img__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-sm);
  }

  .process-step-img__desc {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  /* Production Lines */
  .lines-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }

  .line-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    border-top: 3px solid var(--color-accent);
    transition: all var(--transition-base);
  }

  .line-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
  }

  .line-card h3 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-sm);
  }

  .line-card p {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  /* Workshop Photos */
  .workshop-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .workshop-photo {
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    aspect-ratio: 16 / 10;
    background: var(--color-bg);
  }

  .workshop-photo picture,
  .workshop-photo img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .workshop-photo img {
    object-fit: cover;
    filter: sepia(0.08) saturate(0.95) brightness(1.02) hue-rotate(5deg);
  }

  /* Equipment */
  .equipment-grid {
    max-width: 720px;
  }

  .equipment-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .equipment-item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md);
    background-color: var(--color-bg-alt);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .equipment-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: rgba(196, 160, 53, 0.12);
    color: var(--color-accent-dark);
    flex-shrink: 0;
  }

  /* OEM & ODM */
  .oem-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .oem-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    text-align: center;
    transition: all var(--transition-base);
  }

  .oem-card:hover {
    background-color: var(--color-bg-alt);
    transform: translateY(-4px);
  }

  .oem-card h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-sm);
    color: var(--color-primary);
  }

  .oem-card p {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
  }

  /* Factory Audit */
  .audit-wrap {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-4xl);
    align-items: center;
  }

  .audit-copy p {
    margin-bottom: var(--space-lg);
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .audit-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .audit-list li {
    padding: var(--space-sm) var(--space-md);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .audit-cta {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  /* Responsive */
  @media (max-width: 968px) {
    .factory-intro {
      grid-template-columns: 1fr;
    }

    .qc-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .packing-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .oem-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .workshop-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .audit-wrap {
      grid-template-columns: 1fr;
    }

    .process-step-img {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .process-step-img:nth-child(even) {
      direction: ltr;
    }
  }

  @media (max-width: 768px) {
    .factory-intro,
    .qc-grid,
    .packing-grid,
    .capabilities-grid,
    .visit-factory__grid {
      grid-template-columns: 1fr;
    }

    .process-step-img {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .process-step-img:nth-child(even) {
      direction: ltr;
