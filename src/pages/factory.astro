---
/**
 * Factory Page — /factory
 * Showcases real manufacturing capability without fabricated numbers.
 * Sections: Factory Introduction, Production Lines, Workshop,
 *           Manufacturing Capability, Equipment, Production Process,
 *           Quality Control, OEM & ODM, Packing Process, Factory Audit
 */
import Layout from "@layouts/Layout.astro";
import CTAButton from "@components/CTAButton.astro";

// Breadcrumb structured data
const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://nixiafabric.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Factory",
      item: "https://nixiafabric.com/factory/",
    },
  ],
};

const factoryPageData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Glitter & Foil Fabric Factory in Guangzhou | Nixia Fabric",
  description: "Explore Nixia Fabric's Guangzhou production facility for glitter, foil, iridescent and stretch fabrics, with in-house finishing, batch QC, OEM/ODM and custom sample support.",
  url: "https://nixiafabric.com/factory/",
  about: {
    "@type": "Organization",
    name: "Nixia Fabric",
    additionalType: "Manufacturer",
  },
};

const toWebp = (src: string) => src.replace(/\.(png|jpe?g)$/i, ".webp");

const productionSteps = [
  {
    num: "01",
    title: "Material Preparation",
    desc: "Raw fabric substrates are inspected and prepared — woven, knitted, or non-woven bases are selected based on product specifications.",
  },
  {
    num: "02",
    title: "Surface Treatment",
    desc: "Base fabric undergoes surface treatment to ensure optimal adhesion for glitter particles or metallic foil lamination.",
  },
  {
    num: "03",
    title: "Glitter Bonding / Foil Lamination",
    desc: "Glitter particles are bonded to the fabric surface using specialized adhesive techniques. For foil fabric, metallic foil is laminated under controlled heat and pressure.",
  },
  {
    num: "04",
    title: "Color Development & Matching",
    desc: "Custom colors are developed and matched against client samples. Our color lab ensures consistency across production batches.",
  },
  {
    num: "05",
    title: "Curing & Setting",
    desc: "Bonded fabric passes through curing and heat-setting processes to ensure durability, adhesion strength, and dimensional stability.",
  },
  {
    num: "06",
    title: "Finishing & Inspection",
    desc: "Fabric is finished with edge treatment, inspected for quality, and prepared for packing and shipment.",
  },
];

const qcItems = [
  {
    title: "Raw Material Inspection",
    desc: "All incoming base fabrics and materials are tested for composition, weight, width, and visual defects before entering production.",
    icon: "search",
  },
  {
    title: "In-Process Quality Control",
    desc: "During glitter bonding and foil lamination, our technicians monitor adhesion strength, glitter density, color consistency, and surface uniformity at each stage.",
    icon: "monitor",
  },
  {
    title: "Adhesion Testing",
    desc: "Finished fabric undergoes adhesion testing — including rub tests and peel strength tests — to ensure glitter and foil particles remain firmly bonded.",
    icon: "shield",
  },
  {
    title: "Color Consistency Check",
    desc: "Every production batch is checked against approved color standards using lightbox comparison and spectrophotometer measurement.",
    icon: "palette",
  },
  {
    title: "Final Inspection & Grading",
    desc: "Each roll is individually inspected, graded, and tagged with batch numbers for full traceability from production to delivery.",
    icon: "clipboard",
  },
  {
    title: "Sample Retention",
    desc: "Production samples are retained for each batch, allowing us to reference and match future reorders with consistent quality.",
    icon: "archive",
  },
];

const capabilities = [
  {
    title: "Chunky Glitter Synthetic Leather Production",
    desc: "Elastic, PU, non-woven, and Oxford glitter fabrics with various glitter particle sizes and densities.",
    items: ["Elastic Knitted Backing", "PU Coated Backing", "Non-woven Backing", "Oxford Woven Backing"],
  },
  {
    title: "Foil-Printed Synthetic Leather Production",
    desc: "Metallic foil lamination on fabric substrates — gold, silver, and custom metallic finishes.",
    items: ["Gold Foil Lamination", "Silver Foil Lamination", "Custom Metallic Colors", "Matte & Glossy Finishes"],
  },
  {
    title: "Custom Color Matching",
    desc: "In-house color lab for developing and matching custom colors based on client requirements and Pantone references.",
    items: ["Pantone Color Matching", "Custom Color Matching", "Metallic Tone Development", "Batch-to-Batch Consistency"],
  },
  {
    title: "Factory Direct & Custom Manufacturing",
    desc: "Full Factory Direct Supply capability — custom GSM, width, backing material, and special finishes tailored to client specifications.",
    items: ["Custom GSM & Width", "Custom Backing Options", "Custom Glitter Density", "Special Finishes"],
  },
];

const packingSteps = [
  {
    title: "Roll Packing",
    desc: "Fabric is rolled on sturdy cardboard tubes to prevent creasing, with plastic film wrapping for moisture protection.",
  },
  {
    title: "Inner Protection",
    desc: "Acid-free tissue paper or PE film is applied between layers for premium products to protect the glitter or foil surface.",
  },
  {
    title: "Outer Packaging",
    desc: "Woven bags or strong carton tubes are used for outer packaging, with edge protectors for international shipping.",
  },
  {
    title: "Labeling & Documentation",
    desc: "Each package is labeled with product name, batch number, specifications, and quantity. Packing lists and quality certificates are included.",
  },
];

const productionLines = [
  {
    title: "Glitter Coating Line",
    desc: "Glitter particle bonding on woven, knitted and non-woven substrates with adjustable particle density.",
  },
  {
    title: "Hot-Stamping Foil Transfer Line",
    desc: "Metallic foil lamination under controlled heat and pressure for gold, silver and custom metallic finishes.",
  },
  {
    title: "Color Development & Matching Lab",
    desc: "In-house lab for Pantone-based color development and batch-to-batch consistency checks.",
  },
  {
    title: "Finishing & Inspection Station",
    desc: "Surface finish, edge treatment, on-line inspection and roll grading before packing.",
  },
];

const workshopPhotos = [
  { src: "/images/process/raw_material_preparation.jpg", alt: "Raw material preparation in the glitter fabric workshop" },
  { src: "/images/process/hot_stamping_foil_transfer.jpg", alt: "Hot-stamping foil transfer production line in operation" },
  { src: "/images/process/on_line_visual_inspection.jpg", alt: "On-line visual inspection of glitter and foil fabric" },
  { src: "/images/process/sample_confirmation.jpg", alt: "Sample confirmation of hot-pressed glitter fabric detail" },
  { src: "/images/process/final_packing.jpg", alt: "Final packing area for glitter and foil fabric rolls" },
];

const equipment = [
  "Glitter coating / bonding machines",
  "Hot-stamping foil transfer presses",
  "Color matching & development stations",
  "Curing & heat-setting equipment",
  "Inspection & grading tables",
];

const oemOdm = [
  {
    title: "Custom Colors",
    desc: "Pantone reference or client swatch matched to production color standards.",
  },
  {
    title: "Custom Backing & GSM",
    desc: "Elastic, PU, non-woven and Oxford backing with adjustable GSM and width.",
  },
  {
    title: "Custom Finishes",
    desc: "Matte, glossy, embossed and special surface treatments per product requirement.",
  },
  {
    title: "Sample-to-Bulk Process",
    desc: "Prototype samples, buyer confirmation and pre-production samples before bulk production.",
  },
];

const auditSupport = [
  "Factory visit arrangement for buyers and agents",
  "Business license and entity documents",
  "SGS / REACH testing arranged according to buyer requirements",
  "Production & packing documentation support",
];
---

<Layout
  title="Glitter & Foil Fabric Factory in Guangzhou | Nixia Fabric"
  description="Explore Nixia Fabric's Guangzhou production facility for glitter, foil, iridescent and stretch fabrics, with in-house finishing, batch QC, OEM/ODM and custom sample support."
  keywords="glitter fabric factory, foil fabric factory, fabric manufacturer china, Factory Direct Supply, Custom Color Matching, fabric quality control, OEM, ODM"
  structuredData={[breadcrumbData, factoryPageData]}
>
  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__current">Factory</span>
      </nav>
    </div>
  </div>

  <!-- Factory Hero -->
  <section class="factory-hero">
    <div class="container">
      <span class="eyebrow">Manufacturing Facility</span>
      <h1>Our Factory</h1>
      <p class="factory-hero__desc">
        We have specialized in glitter and foil-printed synthetic leather since 2013.
        With our own production facility and stable partnerships with qualified material
        manufacturers, we deliver reliable fabrics for footwear, handbag and accessory
        manufacturers worldwide.
      </p>
      <div class="factory-hero__badges">
        <span class="factory-hero__badge">Manufacturer</span>
        <span class="factory-hero__badge">Factory</span>
        <span class="factory-hero__badge">Factory Direct Supply</span>
        <span class="factory-hero__badge">Custom Color Matching</span>
      </div>
    </div>
  </section>

  <!-- Factory Introduction -->
  <section class="section">
    <div class="container">
      <div class="factory-intro">
        <div class="factory-intro__left">
          <span class="eyebrow">Factory Introduction</span>
          <h2>Specialized in Glitter & Foil-Printed Manufacturing</h2>
          <p>
            We are a synthetic leather manufacturer since 2013, with in-house production
            for glitter and foil-printed PU, plus qualified upstream material support
            when a project needs it. Our production focuses on fabrics for shoes,
            handbags and accessories.
          </p>
          <p>
            We control every step we run in-house — from raw material selection to color
            development, from glitter bonding to final inspection. Our clients deal
            directly with the people who make their fabric.
          </p>
        </div>
        <div class="factory-intro__right">
          <div class="factory-intro__card">
            <div class="factory-intro__card-header">
              <span class="eyebrow">What We Produce</span>
            </div>
            <ul class="factory-intro__list">
              <li>Chunky Glitter Synthetic Leather — Elastic, PU, Non-woven, Oxford</li>
              <li>Foil-Printed Synthetic Leather — Metallic, Gold, Silver</li>
              <li>Custom Color Matching</li>
              <li>Factory Direct Supply</li>
              <li>Custom Backing & GSM</li>
              <li>Special Finishes</li>
            </ul>
          </div>
          <div class="factory-intro__card factory-intro__card--dark">
            <div class="factory-intro__card-header">
              <span class="eyebrow" style="color: var(--color-accent-light);">What We Don't Do</span>
            </div>
            <ul class="factory-intro__list">
              <li>We are not a trading company</li>
              <li>We are not a sourcing agent</li>
              <li>No middleman markup</li>
              <li>Direct factory communication</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Production Lines -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Production Lines</span>
        <h2>Dedicated Lines for Glitter &amp; Foil Fabric</h2>
        <p>
          Our factory is equipped with professional glitter coating and hot-stamping
          foil-transfer production lines. We provide OEM &amp; ODM solutions, support
          custom color matching and multiple base-fabric options for glitter &amp;
          foil-printed fabrics.
        </p>
      </div>
      <div class="lines-grid">
        {productionLines.map((line) => (
          <article class="line-card">
            <h3>{line.title}</h3>
            <p>{line.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Workshop Photos -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Workshop</span>
        <h2>Real Workshop Scenes</h2>
        <p>
          Photos of our production floor — coating, foil transfer, inspection and packing.
        </p>
      </div>
      <div class="workshop-grid">
        {workshopPhotos.map((photo) => (
          <figure class="workshop-photo">
            <picture>
              <source srcset={toWebp(photo.src)} type="image/webp" />
              <img src={photo.src} alt={photo.alt} width="1200" height="675" loading="lazy" decoding="async" />
            </picture>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Manufacturing Capability -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Manufacturing Capability</span>
        <h2>What We Can Produce</h2>
        <p>
          Our factory is equipped for the full range of Chunky Glitter Synthetic Leather
          and Foil-Printed Synthetic Leather production, from material preparation to Custom Color
          Matching and Factory Direct manufacturing.
        </p>
      </div>

      <div class="capabilities-grid">
        {capabilities.map((cap) => (
          <div class="cap-card">
            <h3 class="cap-card__title">{cap.title}</h3>
            <p class="cap-card__desc">{cap.desc}</p>
            <ul class="cap-card__list">
              {cap.items.map((item) => (
                <li class="cap-card__item">
                  <span class="cap-card__check">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                  </span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Equipment -->
  <section class="section">
    <div class="container">
      <div class="section-header section-header--left">
        <span class="eyebrow">Equipment</span>
        <h2>Equipment We Run In-House</h2>
        <p>
          Capability is driven by the equipment on our production floor — from coating to
          final inspection.
        </p>
      </div>
      <div class="equipment-grid">
        <ul class="equipment-list">
          {equipment.map((item) => (
            <li class="equipment-item">
              <span class="equipment-check" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Production Process: 5-Step Workflow with Images -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Production Process</span>
        <h2>Production Process</h2>
        <p>
          Our production follows a streamlined five-step process — from raw material
          preparation to final packing — ensuring consistent quality at every stage.
        </p>
      </div>

      <div class="process-steps-with-images">
        <div class="process-step-img">
          <div class="process-step-img__media">
            <picture>
              <source srcset={toWebp('/images/process/raw_material_preparation.jpg')} type="image/webp" />
              <img src="/images/process/raw_material_preparation.jpg" alt="Raw material preparation in glitter fabric production warehouse" width="1200" height="675" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="process-step-img__info">
            <span class="process-step-img__num">01</span>
            <h3 class="process-step-img__title">Raw Material Preparation</h3>
            <p class="process-step-img__desc">
              Base fabrics and raw materials are inspected, sorted and prepared
              according to production specifications.
            </p>
          </div>
        </div>

        <div class="process-step-img">
          <div class="process-step-img__media">
            <picture>
              <source srcset={toWebp('/images/process/hot_stamping_foil_transfer.jpg')} type="image/webp" />
              <img src="/images/process/hot_stamping_foil_transfer.jpg" alt="Hot-stamping foil transfer production line for metallic foil fabrics" width="1200" height="675" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="process-step-img__info">
            <span class="process-step-img__num">02</span>
            <h3 class="process-step-img__title">Hot-Stamping Foil Transfer</h3>
            <p class="process-step-img__desc">
              Metallic foil is transferred onto the fabric surface under controlled
              heat and pressure for consistent adhesion and finish.
            </p>
          </div>
        </div>

        <div class="process-step-img">
          <div class="process-step-img__media">
            <picture>
              <source srcset={toWebp('/images/process/on_line_visual_inspection.jpg')} type="image/webp" />
              <img src="/images/process/on_line_visual_inspection.jpg" alt="On-line visual inspection of glitter and foil-printed fabric quality" width="1200" height="675" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="process-step-img__info">
            <span class="process-step-img__num">03</span>
            <h3 class="process-step-img__title">On-Line Visual Inspection</h3>
            <p class="process-step-img__desc">
              Technicians monitor the production line in real time, checking surface
              texture, gloss performance and printing details.
            </p>
          </div>
        </div>

        <div class="process-step-img">
          <div class="process-step-img__media">
            <picture>
              <source srcset={toWebp('/images/process/sample_confirmation.jpg')} type="image/webp" />
              <img src="/images/process/sample_confirmation.jpg" alt="Sample confirmation close-up of hot-pressed glitter fabric detail" width="1200" height="675" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="process-step-img__info">
            <span class="process-step-img__num">04</span>
            <h3 class="process-step-img__title">Sample Confirmation</h3>
            <p class="process-step-img__desc">
              Production samples are compared against approved standards to verify
              color, texture and overall quality before bulk continuation.
            </p>
          </div>
        </div>

        <div class="process-step-img">
          <div class="process-step-img__media">
            <picture>
              <source srcset={toWebp('/images/process/final_packing.jpg')} type="image/webp" />
              <img src="/images/process/final_packing.jpg" alt="Factory exterior and final packing area for glitter and foil fabrics" width="1200" height="675" loading="lazy" decoding="async" />
            </picture>
          </div>
          <div class="process-step-img__info">
            <span class="process-step-img__num">05</span>
            <h3 class="process-step-img__title">Final Packing</h3>
            <p class="process-step-img__desc">
              Inspected fabric rolls are carefully packed with protective wrapping
              for domestic and international shipping.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Production Process: Detailed Timeline -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Production Workflow</span>
        <h2>From Raw Material to Finished Fabric</h2>
        <p>
          Our production follows a systematic process to ensure consistent quality across
          every production batch.
        </p>
      </div>

      <div class="process-timeline">
        {productionSteps.map((step, i) => (
          <div class={`process-step ${i % 2 === 0 ? "process-step--left" : "process-step--right"}`}>
            <div class="process-step__marker">
              <span class="process-step__num">{step.num}</span>
            </div>
            <div class="process-step__content">
              <h3 class="process-step__title">{step.title}</h3>
              <p class="process-step__desc">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality Control Overview -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Quality Control</span>
        <h2>Quality Control</h2>
        <p>
          Every production batch will go through strict manual inspection. We check
          surface texture, gloss performance and printing details to guarantee
          consistent fabric quality.
        </p>
      </div>
    </div>
  </section>

  <!-- Quality Control Detail -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Quality Management System</span>
        <h2>Six-Stage Quality Management</h2>
        <p>
          Quality is not an afterthought — it is built into every stage of our production.
          From raw material inspection to final grading, we maintain strict standards.
        </p>
      </div>

      <div class="qc-grid">
        {qcItems.map((qc) => (
          <div class="qc-card">
            <div class="qc-card__icon">
              {qc.icon === "search" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
              )}
              {qc.icon === "monitor" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="3" width="20" height="14" rx="2" ry="2" /><line x1="8" y1="21" x2="16" y2="21" /><line x1="12" y1="17" x2="12" y2="21" />
                </svg>
              )}
              {qc.icon === "shield" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
              )}
              {qc.icon === "palette" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" /><circle cx="17.5" cy="10.5" r=".5" fill="currentColor" /><circle cx="8.5" cy="7.5" r=".5" fill="currentColor" /><circle cx="6.5" cy="12.5" r=".5" fill="currentColor" /><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z" />
                </svg>
              )}
              {qc.icon === "clipboard" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /><rect x="8" y="2" width="8" height="4" rx="1" ry="1" />
                </svg>
              )}
              {qc.icon === "archive" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="21 8 21 21 3 21 3 8" /><rect x="1" y="3" width="22" height="5" /><line x1="10" y1="12" x2="14" y2="12" />
                </svg>
              )}
            </div>
            <h3 class="qc-card__title">{qc.title}</h3>
            <p class="qc-card__desc">{qc.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Packing Process -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Packing Process</span>
        <h2>Careful Packing for International Shipping</h2>
        <p>
          Every roll is packed to withstand international shipping — protecting the glitter
          surface and ensuring the fabric arrives in perfect condition.
        </p>
      </div>

      <div class="packing-grid">
        {packingSteps.map((step, i) => (
          <div class="packing-card">
            <div class="packing-card__num">{String(i + 1).padStart(2, "0")}</div>
            <h3 class="packing-card__title">{step.title}</h3>
            <p class="packing-card__desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OEM & ODM -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">OEM &amp; ODM</span>
        <h2>Custom Fabric Development</h2>
        <p>
          We develop fabric to your specification — from color and backing to finish and
          packing.
        </p>
      </div>
      <div class="oem-grid">
        {oemOdm.map((item) => (
          <article class="oem-card">
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))}
