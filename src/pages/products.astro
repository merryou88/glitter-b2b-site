---
/**
 * Products Listing Page — /products
 * Product-led catalog with responsive purchasing controls and finish shortcuts.
 * Filtering and sorting are implemented client-side on the static-rendered grid.
 */
import Layout from "@layouts/Layout.astro";
import { performanceProducts } from "@data/allProducts";
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

// Import catalog sources at build time so Astro can emit responsive, cached
// thumbnails without changing the original images used by product details.
// Match the catalog's first main-image convention, not every gallery asset.
const catalogImages = import.meta.glob<{ default: ImageMetadata }>(
  "/public/images/products/**/main/*-main-1.webp",
  { eager: true },
);
const catalogImageSizes = "(max-width: 640px) calc(100vw - 34px), (max-width: 768px) calc(100vw - 50px), (max-width: 968px) calc((100vw - 74px) / 2), (max-width: 1279px) calc((100vw - 100px) / 3), 232px";

const catalogProducts = performanceProducts;

const recommendedProductOrder = [
  "iridescent-gradient-laser-ice-silk",
  "iridescent-laser-hot-stamping-stretch-ice-silk",
  "rainbow-iridescent-laser-foil-nylon-spandex-fabric",
  "gradient-rainbow-dot-foil-knit-fabric",
  "rainbow-fingerprint-dot-foil-ice-silk-fabric",
  "holographic-mermaid-scale-milk-silk-stretch-fabric",
  "shiny-foil-4-way-stretch-knit-fabric",
  "blue-purple-gradient-laser-foil-spandex-fabric",
  "rainbow-dot-laser-foil-knit-fabric",
  "full-print-hot-stamping-spandex-milk-silk",
  "plain-iridescent-laser-spandex-4-way-stretch",
  "dense-dot-foil-suede-look-fabric",
];

const productOrderMap = new Map(recommendedProductOrder.map((slug, index) => [slug, index]));
const sortedProducts = [...catalogProducts].sort((a, b) => {
  const aOrder = productOrderMap.get(a.slug) ?? Number.MAX_SAFE_INTEGER;
  const bOrder = productOrderMap.get(b.slug) ?? Number.MAX_SAFE_INTEGER;

  if (aOrder !== bOrder) return aOrder - bOrder;
  return catalogProducts.indexOf(a) - catalogProducts.indexOf(b);
});

const catalogImageOptions = (source: ImageMetadata) => ({
  // Keep descriptors honest for the one source smaller than 720px.
  widths: [...new Set([360, 540, 720].map((width) => Math.min(width, source.width)))],
  sizes: catalogImageSizes,
  width: Math.min(720, source.width),
  format: "webp" as const,
  quality: 72,
});
const firstImageSource = catalogImages[`/public${sortedProducts[0]?.mainImageWebp || sortedProducts[0]?.mainImageUrl}`]?.default;
const firstImage = firstImageSource
  ? await getImage({ src: firstImageSource, ...catalogImageOptions(firstImageSource) })
  : null;

const findRowValue = (rows, labels) =>
  rows?.find((row) => labels.includes(row.label))?.value;

const productMoqDisplay = (product) => product.inStock ? "50m" : "200m";

const effectOptions = [
  { value: "all", label: "All Fabrics" },
  { value: "foil", label: "Foil" },
  { value: "metallic", label: "Metallic" },
  { value: "holographic", label: "Holographic" },
  { value: "iridescent", label: "Iridescent" },
];

const catalogTitle = (product) => product.title.split(/ for /i)[0];
const catalogStretch = (product) =>
  findRowValue(product.specTable, ["Stretch", "Elasticity"]) || "Check sample";

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Products", item: "https://nixiafabric.com/products/" },
  ],
};

const collectionPageData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Foil Fabric Supplier for Dancewear & Performance Costumes",
  description: "Source wholesale foil fabrics, holographic fabrics and iridescent spandex fabrics for dancewear, stage costumes and performance apparel.",
  url: "https://nixiafabric.com/products/",
};

const sourcingLinks = [
  {
    href: "/applications/holographic-fabric-wholesale/",
    title: "Holographic Fabric Wholesale",
    desc: "Compare color-shifting stretch fabrics for dancewear, stage costumes and performance apparel.",
  },
  {
    href: "/applications/dancewear-fabric-supplier/",
    title: "Dancewear Fabric Supplier",
    desc: "Review 4-way stretch foil, iridescent and holographic options for bodysuits and competition costumes.",
  },
  {
    href: "/sample-policy/",
    title: "Samples, MOQ & Custom Development",
    desc: "Check sample policy, MOQ notes and RFQ details before confirming a bulk fabric order.",
  },
];

---

<Layout
  title="Foil Fabric Supplier | Nixia Fabric"
  description="Source wholesale foil, holographic and iridescent stretch fabrics for dancewear, stage costumes and performance apparel. Samples, MOQ and custom support."
  keywords="foil fabric supplier, wholesale foil fabric, holographic fabric wholesale, iridescent spandex fabric, dancewear fabric supplier, performance costume fabric, custom foil fabric sample, foil fabric MOQ"
  canonical="https://nixiafabric.com/products/"
  structuredData={[breadcrumbData, collectionPageData]}
  footerFocus="foil"
>
  {firstImage && (
    <link slot="head" rel="preload" as="image" href={firstImage.src}
      imagesrcset={firstImage.srcSet.attribute} imagesizes={catalogImageSizes}
      type="image/webp" fetchpriority="high" />
  )}
  <!-- Page Hero (compact catalog header) -->
  <section class="page-hero">
    <div class="container">
      <h1>Wholesale Foil &amp; Metallic Fabrics</h1>
      <p class="page-hero__desc">
        Explore holographic, iridescent and foil stretch fabrics for costume and apparel production. Custom colors available for bulk orders.
      </p>
      <div class="catalog-quick-facts" aria-label="Catalog purchasing facts">
        <span>Stock MOQ from 50m</span>
        <span>Custom MOQ from 200m</span>
        <span>Fabric Swatches Available</span>
        <span>Custom Colors Available</span>
      </div>
      <div class="page-hero__actions btn-group">
        <a href="/sample-policy/" data-rfq-open data-rfq-intent="sample" class="btn btn--primary" aria-haspopup="dialog" aria-controls="rfq-quote-modal">Request Samples</a>
        <a href="/contact/" data-rfq-open data-rfq-intent="quote" class="btn btn--outline" aria-haspopup="dialog" aria-controls="rfq-quote-modal">Request Bulk Quote</a>
      </div>
    </div>
  </section>

  <!-- Catalog: search, effect shortcuts and product grid -->
  <section class="section" id="catalog">
    <div class="container">
      <div class="catalog-toolbar">
        <label class="catalog-search">
          <span class="sr-only">Search fabrics</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
          <input id="catalog-search" type="search" placeholder="Search fabrics" autocomplete="off" />
        </label>
      <div class="catalog-effect-filters" aria-label="Filter fabrics by effect">
        {effectOptions.map((option) => (
          <button type="button" class="catalog-effect-filter" data-effect={option.value} aria-pressed={option.value === "all" ? "true" : "false"}>
            {option.label}
          </button>
        ))}
      </div>
        <button type="button" id="catalog-reset" class="catalog-reset" hidden>Clear filters</button>
      </div>



      <p id="catalog-result-status" class="sr-only" role="status" aria-live="polite">{sortedProducts.length} fabrics found</p>
      <div class="product-grid" id="product-grid">
        {
          sortedProducts.map((item, index) => (
            <div
              class="product-card"
              data-id={item.slug}
              data-search={[item.title, item.shortIntro, item.specs.baseMaterial, ...(item.tags || []), ...(item.applications || [])].join(" ").toLowerCase()}
            >
              <a href={`/products/${item.slug}/`} class="product-card__link" aria-label={`View ${item.title}`}>
                <div class="product-card__image-wrap">
                  {catalogImages[`/public${item.mainImageWebp || item.mainImageUrl}`] ? (
                    <Image
                      src={catalogImages[`/public${item.mainImageWebp || item.mainImageUrl}`].default}
                      alt={item.title}
                      class="product-card__image"
                      {...catalogImageOptions(catalogImages[`/public${item.mainImageWebp || item.mainImageUrl}`].default)}
                      loading={index === 0 ? "eager" : "lazy"}
                      fetchpriority={index === 0 ? "high" : "auto"}
                      decoding="async"
                      onerror="this.style.display='none';this.closest('.product-card__image-wrap').querySelector('.product-card__placeholder').style.display='flex'"
                    />
                  ) : item.mainImageUrl ? (
                    <picture>
                      {item.mainImageWebp && <source srcset={item.mainImageWebp} type="image/webp" />}
                      <img src={item.mainImageUrl} alt={item.title} class="product-card__image" loading="lazy" width="1200" height="1200" decoding="async" onerror="this.style.display='none';this.closest('.product-card__image-wrap').querySelector('.product-card__placeholder').style.display='flex'" />
                    </picture>
                  ) : null}
                  <div class="product-card__placeholder" style={item.mainImageUrl ? "display:none" : "display:flex"}>
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21 15 16 10 5 21"/>
                    </svg>
                    <span>Image coming soon</span>
                  </div>
                  {item.badge && <span class="product-card__badge">{item.badge}</span>}
                </div>
              </a>

              <div class="product-card__body">
                <a href={`/products/${item.slug}/`} class="product-card__title-link">
                  <h2 class="product-card__title" title={catalogTitle(item)}>{catalogTitle(item)}</h2>
                </a>

                <div class="product-card__spec-grid" aria-label="Key product specifications">
                  <div><span>Width</span><strong>{item.specs.width || "To be confirmed"}</strong></div>
                  <div><span>Weight</span><strong>{item.specs.weight || "To be confirmed"}</strong></div>
                  <div>
                    <span>Composition / Base</span>
                    <strong>{item.specs.baseMaterial || "To be confirmed"}</strong>
                  </div>
                  <div><span>Stretch</span><strong>{catalogStretch(item)}</strong></div>
                  <div><span>MOQ</span><strong>{productMoqDisplay(item)}</strong></div>
                </div>

                <div class="product-card__meta">
                  <span class:list={{ "product-card__stock": item.stockStatus?.toLowerCase().includes("in-stock") }}>
                    {item.stockStatus}
                  </span>
                  {item.stockStatus?.toLowerCase().includes("in-stock") && (
                    <span class="product-card__swatch-note">✅ Free swatch card available</span>
                  )}
                  <span>{item.badge}</span>
                </div>
                <p class="product-card__applications"><strong>Applications:</strong> {(item.applications || []).slice(0, 4).join(" · ")}</p>

                <div class="product-card__actions">
                  <a href={`/contact/?sku=${encodeURIComponent(item.title)}`} data-rfq-open data-rfq-sku={item.title} class="product-card__btn product-card__btn--primary">Request Sample / Quote</a>
                  <a href={`/products/${item.slug}/`} class="product-card__details-link">View Details</a>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <p class="catalog-empty" id="catalog-empty" hidden>No products match this filter.</p>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container">
      <div class="sourcing-paths" aria-label="Fabric sourcing paths">
        {sourcingLinks.map((link) => (
          <a href={link.href} class="sourcing-path">
            <span class="sourcing-path__eyebrow">Buyer guide</span>
            <strong>{link.title}</strong>
            <span>{link.desc}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="section section--alt">
    <div class="container" style="text-align:center">
      <h2 class="section-header__title">Need a Custom Quote?</h2>
      <p class="section-header__desc" style="max-width:560px;margin:0 auto var(--space-lg)">
        Send your fabric sample, photo or design reference. We can help match the foil effect
        and recommend a suitable fabric for your production.
      </p>
      <p class="catalog-sample-note">Free stock swatches available; buyer pays shipping. Custom samples may incur a fee.</p>
      <div class="btn-group" style="justify-content:center">
        <a href="/sample-policy/" data-rfq-open class="btn btn--primary">Request Sample</a>
        <a href="/contact/" data-rfq-open class="btn btn--outline">Request a Quote</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    padding-block: var(--space-md) var(--space-lg);
    position: relative;
    overflow: hidden;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 50%, rgba(196, 160, 53, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 30%, rgba(42, 65, 112, 0.4) 0%, transparent 50%);
    pointer-events: none;
  }

  .page-hero .container { position: relative; z-index: 1; }

  .page-hero .eyebrow { color: var(--color-accent-light); }
  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-sm);
    font-size: 32px;
    line-height: 1.2;
  }
  .page-hero h1 span { display: inline; }

  .page-hero__desc {
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-lg);
    width: 100%;
  }

  .page-hero__actions {
    margin-top: var(--space-sm);
  }

  .page-hero__actions .btn--outline {
    color: var(--color-white);
    border-color: rgba(255, 255, 255, 0.65);
  }

  .page-hero__actions .btn--outline:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--color-white);
  }

  .catalog-sample-note {
    margin: 0 0 var(--space-md);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .catalog-quick-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: var(--space-sm);
    color: rgba(255, 255, 255, 0.82);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .catalog-quick-facts span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .catalog-quick-facts span::before {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-accent-light);
  }

  .section--compact {
    padding-block: var(--space-xl) 0;
  }

  .sourcing-paths {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .sourcing-path {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-height: 100%;
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(22, 41, 77, 0.05);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .sourcing-path:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .sourcing-path__eyebrow {
    color: var(--color-accent-dark);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sourcing-path strong {
    color: var(--color-primary);
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  .sourcing-path span:last-child {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  /* ==================== Catalog Toolbar ==================== */
  #catalog {
    padding-top: 0;
  }

  .catalog-toolbar {
    display: flex;
    gap: var(--space-md);
    align-items: center;
    padding: var(--space-md);
    margin-bottom: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-white);
    box-shadow: 0 4px 16px rgba(22, 41, 77, 0.05);
  }

  .catalog-search {
    position: relative;
    display: block;
    flex: 0 0 240px;
    min-width: 0;
  }

  .catalog-search svg {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    width: 1.05rem;
    height: 1.05rem;
    color: var(--color-text-muted);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .catalog-search input {
    width: 100%;
    min-height: 42px;
    padding: 0.6rem 0.8rem 0.6rem 2.45rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text);
    background: var(--color-bg);
    font: inherit;
    font-size: var(--text-sm);
  }

  .catalog-search input:focus {
    outline: 2px solid rgba(196, 160, 53, 0.3);
    outline-offset: 1px;
    border-color: var(--color-accent);
  }

  .catalog-reset {
    min-height: 38px;
    justify-self: start;
    border: 0;
    background: transparent;
    color: var(--color-accent-dark);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }

  .catalog-reset:hover { text-decoration: underline; }

  .catalog-reset[hidden] { display: none; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .catalog-empty {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-3xl) 0;
  }

  /* ==================== Product Grid ==================== */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .product-grid.is-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  /* ==================== Product Card ==================== */
  .product-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
  }

  .product-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(22, 41, 77, 0.1);
    border-color: rgba(196, 160, 53, 0.4);
  }

  .product-card.is-hidden { display: none; }

  .product-card__link { display: block; }

  .product-card__body,
  .product-card__link {
    min-width: 0;
  }

  .product-card__image-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--color-bg);
    overflow: hidden;
  }

  .product-card__image-wrap picture,
  .product-card__image-wrap img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-card__image {
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .product-card:hover .product-card__image {
    transform: scale(1.05);
  }

  .product-card__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    width: 100%;
    height: 100%;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    background: var(--color-bg);
  }

  .product-card__badge {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    display: inline-block;
    padding: 0.25rem 0.625rem;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-white);
    background: var(--color-accent);
    border-radius: var(--radius-sm);
    z-index: 1;
  }

  .product-card__body {
    padding: var(--space-md) var(--space-md) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .product-card__title-link { text-decoration: none; }

  .product-card__title {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__spec-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 0.2rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--color-border);
  }

  .product-card__spec-grid div {
    min-width: 0;
  }

  .product-card__spec-grid span {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--color-text-muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .product-card__spec-grid strong {
    display: block;
    color: var(--color-primary);
    font-size: var(--text-xs);
    line-height: 1.35;
    overflow-wrap: anywhere;
    white-space: normal;
  }

  .product-card__swatch-note {
    display: none;
  }

  .product-card__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .product-card__meta span {
    min-width: 0;
  }

  .product-card__meta span:nth-child(2) {
    grid-column: 2;
    text-align: left;
  }

  .product-card__stock {
    color: var(--color-accent-dark);
  }

  .product-card__applications {
    min-height: 2.8em;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: 1.45;
  }

  .product-card__applications strong {
    color: var(--color-primary);
  }

  .product-card__specs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .product-card__spec {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 600;
  }

  .product-card__spec svg { color: var(--color-accent-dark); }

  .product-card__spec--stock {
    color: var(--color-accent-dark);
    font-weight: 700;
  }

  .product-card__spec--stock svg {
    color: var(--color-accent);
  }

