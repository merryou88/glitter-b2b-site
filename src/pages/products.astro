</style>

<script>
  (function () {
    const grid = document.getElementById("product-grid");
    const searchInput = document.getElementById("catalog-search") as HTMLInputElement;
    const resetButton = document.getElementById("catalog-reset");
    const emptyEl = document.getElementById("catalog-empty");
    const resultStatus = document.getElementById("catalog-result-status");
    const effectButtons = Array.from(document.querySelectorAll(".catalog-effect-filter"));
    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll(".product-card"));
    let effectValue = "all";

    function applyFilters() {
      const search = (searchInput?.value || "").trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const text = card.getAttribute("data-search") || "";
        const show = (!search || text.includes(search)) && (effectValue === "all" || text.includes(effectValue));
        card.classList.toggle("is-hidden", !show);
        if (show) visible++;
      });
      if (emptyEl) emptyEl.hidden = visible !== 0;
      if (resultStatus) resultStatus.textContent = visible + " fabrics found";
      if (resetButton) resetButton.hidden = !search && effectValue === "all";
      effectButtons.forEach((button) => {
        button.setAttribute("aria-pressed", button.getAttribute("data-effect") === effectValue ? "true" : "false");
      });
    }

    effectButtons.forEach((button) => {
      button.addEventListener("click", () => {
        effectValue = button.getAttribute("data-effect") || "all";
        applyFilters();
      });
    });
    searchInput?.addEventListener("input", applyFilters);
    resetButton?.addEventListener("click", () => {
      if (searchInput) searchInput.value = "";
      effectValue = "all";
      applyFilters();
    });
    applyFilters();
  })();
</script>
