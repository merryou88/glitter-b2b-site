---
/**
 * Products Listing Page — /products
 * Catalog-style layout: filter chips + sort → product grid
 * Filter/sort implemented client-side on the static-rendered grid.
 */
import Layout from "@layouts/Layout.astro";
import { performanceProducts } from "@data/allProducts";

const catalogProducts = performanceProducts;

const recommendedProductOrder = [
  "iridescent-laser-hot-stamping-stretch-ice-silk",
  "iridescent-gradient-laser-ice-silk",
  "shiny-foil-4-way-stretch-knit-fabric",
  "blue-purple-gradient-laser-foil-spandex-fabric",
  "rainbow-dot-laser-foil-knit-fabric",
  "full-print-hot-stamping-spandex-milk-silk",
  "plain-iridescent-laser-spandex-4-way-stretch",
  "non-shedding-glitter-suede-look-laser-foil-fabric",
];

const productOrderMap = new Map(recommendedProductOrder.map((slug, index) => [slug, index]));
const sortedProducts = [...catalogProducts].sort((a, b) => {
  const aOrder = productOrderMap.get(a.slug) ?? Number.MAX_SAFE_INTEGER;
  const bOrder = productOrderMap.get(b.slug) ?? Number.MAX_SAFE_INTEGER;

  if (aOrder !== bOrder) return aOrder - bOrder;
  return catalogProducts.indexOf(a) - catalogProducts.indexOf(b);
});

const findRowValue = (rows, labels) =>
  rows?.find((row) => labels.includes(row.label))?.value;

const productMoq = (product) =>
  findRowValue(product.specTable, ["MOQ"]) ||
  findRowValue(product.b2bTable, ["MOQ"]) ||
  product.specs.moq;

const productMoqDisplay = (product) => {
  const moq = String(productMoq(product) || "").trim();
  if (!moq) return "To be confirmed";
  if (/[a-z]/i.test(moq)) return moq;
  const yards = Math.round(Number(moq) * 1.09361);
  return `${moq} m / ${yards || "—"} yd`;
};

const productFilterTags = (product) => {
  const searchable = [
    product.title,
    product.shortIntro,
    product.specs.baseMaterial,
    ...(product.tags || []),
  ]
    .join(" ")
    .toLowerCase();
  const stretch =
    searchable.includes("4-way") || searchable.includes("four-way")
      ? "4-way stretch"
      : searchable.includes("high stretch") || searchable.includes("highly elastic")
        ? "high stretch"
        : searchable.includes("stretch") || searchable.includes("elastic")
          ? "stretch / knit"
          : "structured";
  const finish =
    searchable.includes("laser") || searchable.includes("iridescent") || searchable.includes("holographic")
      ? "laser / iridescent"
      : searchable.includes("printed") || searchable.includes("print")
        ? "printed foil"
        : searchable.includes("suede") || searchable.includes("texture") || searchable.includes("emboss")
          ? "textured foil"
          : "foil";

  return { stretch, finish };
};

const finishOptions = ["laser / iridescent", "printed foil", "textured foil", "foil"];
const stretchOptions = ["4-way stretch", "high stretch", "stretch / knit", "structured"];
const applicationOptions = [
  "stage costumes",
  "dancewear",
  "performance wear",
  "party wear",
  "performance props",
  "backdrops",
];

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Products", item: "https://nixiafabric.com/products/" },
  ],
};

const collectionPageData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Foil Fabric Supplier for Dancewear & Performance Costumes",
  description: "Source wholesale foil fabrics, holographic fabrics and iridescent spandex fabrics for dancewear, stage costumes and performance apparel.",
  url: "https://nixiafabric.com/products/",
};

const sourcingLinks = [
  {
    href: "/applications/holographic-fabric-wholesale/",
    title: "Holographic Fabric Wholesale",
    desc: "Compare color-shifting stretch fabrics for dancewear, stage costumes and performance apparel.",
  },
  {
    href: "/applications/dancewear-fabric-supplier/",
    title: "Dancewear Fabric Supplier",
    desc: "Review 4-way stretch foil, iridescent and holographic options for bodysuits and competition costumes.",
  },
  {
    href: "/sample-policy/",
    title: "Samples, MOQ & Custom Development",
    desc: "Check sample policy, MOQ notes and RFQ details before confirming a bulk fabric order.",
  },
];

---

<Layout
  title="Foil Fabric Supplier for Dancewear & Performance Costumes | Nixia Fabric"
  description="Source wholesale foil fabric, holographic fabric and iridescent spandex fabric for dancewear, stage costumes and performance apparel. Samples, MOQ and custom support."
  keywords="foil fabric supplier, wholesale foil fabric, holographic fabric wholesale, iridescent spandex fabric, dancewear fabric supplier, performance costume fabric, custom foil fabric sample, foil fabric MOQ"
  canonical="https://nixiafabric.com/products/"
  structuredData={[breadcrumbData, collectionPageData]}
  footerFocus="foil"
>
  <!-- Page Hero (compact catalog header) -->
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Performance Fabric Catalog</span>
      <h1>Foil Fabric Supplier for Dancewear & Performance Costumes</h1>
      <p class="page-hero__desc">
        Source wholesale foil fabric, holographic stretch fabric and iridescent spandex fabric
        for dancewear, stage costumes and performance apparel. Compare samples, MOQ and custom options.
      </p>
      <div class="catalog-quick-facts" aria-label="Catalog purchasing facts">
        <span>{catalogProducts.length} products</span>
        <span>MOQ from 100 m / 109 yd</span>
        <span>Samples available</span>
        <span>OEM / ODM support</span>
      </div>
    </div>
  </section>

  <section class="section section--compact">
    <div class="container">
      <div class="sourcing-paths" aria-label="Fabric sourcing paths">
        {sourcingLinks.map((link) => (
          <a href={link.href} class="sourcing-path">
            <span class="sourcing-path__eyebrow">Buyer guide</span>
            <strong>{link.title}</strong>
            <span>{link.desc}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Catalog: filter + sort + grid -->
  <section class="section" id="catalog">
    <div class="container">
      <div class="catalog-toolbar">
        <label class="catalog-search">
          <span class="sr-only">Search fabrics</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
          <input id="catalog-search" type="search" placeholder="Search fabric name, finish or application" autocomplete="off" />
        </label>
        <div class="catalog-controls">
          <label class="catalog-filter">
            <span>Finish</span>
            <select id="finish-filter">
              <option value="all">All finishes</option>
              {finishOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </label>
          <label class="catalog-filter">
            <span>Stretch</span>
            <select id="stretch-filter">
              <option value="all">All stretch types</option>
              {stretchOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </label>
          <label class="catalog-filter">
            <span>Application</span>
            <select id="application-filter">
              <option value="all">All applications</option>
              {applicationOptions.map((option) => <option value={option}>{option}</option>)}
            </select>
          </label>
          <label class="catalog-filter">
            <span>Stock</span>
            <select id="stock-filter">
              <option value="all">All stock status</option>
              <option value="in-stock">In stock</option>
              <option value="in-stock-color-options">In stock color options</option>
              <option value="availability-to-be-confirmed">Availability to be confirmed</option>
            </select>
          </label>
          <label class="catalog-sort">
            <span>Sort</span>
            <select id="catalog-sort" class="catalog-sort__select">
              <option value="default">Recommended</option>
              <option value="az">Name A–Z</option>
              <option value="colors">Most Colors</option>
            </select>
          </label>
        </div>
      </div>

      <div class="catalog-summary">
        <p class="catalog-count" id="catalog-count" aria-live="polite">Showing {catalogProducts.length} products</p>
        <div class="catalog-summary__actions">
          <div class="catalog-view-toggle" aria-label="Catalog view">
            <button type="button" class="catalog-view-toggle__btn is-active" data-view="grid" aria-pressed="true">Grid</button>
            <button type="button" class="catalog-view-toggle__btn" data-view="list" aria-pressed="false">List</button>
          </div>
          <button type="button" id="catalog-reset" class="catalog-reset" hidden>Clear filters</button>
        </div>
      </div>

      <div class="product-grid" id="product-grid">
        {
          sortedProducts.map((item) => (
            <div
              class="product-card"
              data-id={item.slug}
              data-search={[item.title, item.shortIntro, item.specs.baseMaterial, ...(item.tags || []), ...(item.applications || [])].join(" ").toLowerCase()}
              data-filter-tags={JSON.stringify(productFilterTags(item))}
              data-applications={(item.applications || []).join("|").toLowerCase()}
              data-stock={(item.stockStatus || "").toLowerCase().replace(/\s+/g, "-")}
              data-colors={item.colorCount ?? item.imageList.length}
              data-title={item.title}
            >
              <a href={`/products/${item.slug}/`} class="product-card__link" aria-label={`View ${item.title}`}>
                <div class="product-card__image-wrap">
                  {item.mainImageUrl ? (
                    <picture>
                      {item.mainImageWebp && <source srcset={item.mainImageWebp} type="image/webp" />}
                      <img src={item.mainImageUrl} alt={item.title} class="product-card__image" loading="lazy" width="1200" height="1200" decoding="async" onerror="this.style.display='none';this.closest('.product-card__image-wrap').querySelector('.product-card__placeholder').style.display='flex'" />
                    </picture>
                  ) : null}
                  <div class="product-card__placeholder" style={item.mainImageUrl ? "display:none" : "display:flex"}>
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21 15 16 10 5 21"/>
                    </svg>
                    <span>Image coming soon</span>
                  </div>
                  {item.badge && <span class="product-card__badge">{item.badge}</span>}
                </div>
              </a>

              <div class="product-card__body">
                <a href={`/products/${item.slug}/`} class="product-card__title-link">
                  <h2 class="product-card__title">{item.title}</h2>
                </a>
                <p class="product-card__desc">{item.shortIntro}</p>

                <div class="product-card__spec-grid" aria-label="Key product specifications">
                  <div><span>Width</span><strong>{item.specs.width || "To be confirmed"}</strong></div>
                  <div><span>Weight</span><strong>{item.specs.weight || "To be confirmed"}</strong></div>
                  <div><span>Material</span><strong>{item.specs.baseMaterial || "To be confirmed"}</strong></div>
                  <div><span>MOQ</span><strong>{productMoqDisplay(item)}</strong></div>
                </div>

                <div class="product-card__meta">
                  <span class:list={{ "product-card__stock": item.stockStatus?.toLowerCase().includes("in-stock") }}>
                    {item.stockStatus}
                  </span>
                  <span>{item.badge}</span>
                </div>
                <p class="product-card__applications"><strong>Applications:</strong> {(item.applications || []).slice(0, 4).join(" · ")}</p>

                <div class="product-card__actions">
                  <a href={`/products/${item.slug}/`} class="product-card__btn product-card__btn--outline">View Details</a>
                  <a href={`/contact/?sku=${encodeURIComponent(item.title)}`} data-rfq-open data-rfq-sku={item.title} class="product-card__btn product-card__btn--primary">Request Sample / Quote</a>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <p class="catalog-empty" id="catalog-empty" hidden>No products match this filter.</p>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="section section--alt">
    <div class="container" style="text-align:center">
      <h2 class="section-header__title">Need a Custom Quote?</h2>
      <p class="section-header__desc" style="max-width:560px;margin:0 auto var(--space-lg)">
        Send your fabric sample, photo or design reference. We can help match the foil effect
        and recommend a suitable fabric for your production.
      </p>
      <div class="btn-group" style="justify-content:center">
        <a href="/sample-policy/" data-rfq-open class="btn btn--primary">Request Sample</a>
        <a href="/contact/" data-rfq-open class="btn btn--outline">Request a Quote</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    padding-block: var(--space-3xl) var(--space-2xl);
    position: relative;
    overflow: hidden;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 50%, rgba(196, 160, 53, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 30%, rgba(42, 65, 112, 0.4) 0%, transparent 50%);
    pointer-events: none;
  }

  .page-hero .container { position: relative; z-index: 1; }

  .page-hero .eyebrow { color: var(--color-accent-light); }
  .page-hero h1 { color: var(--color-white); margin-bottom: var(--space-md); }

  .page-hero__desc {
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-lg);
    max-width: 640px;
  }

  .catalog-quick-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: var(--space-lg);
    color: rgba(255, 255, 255, 0.82);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .catalog-quick-facts span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .catalog-quick-facts span::before {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-accent-light);
  }

  .section--compact {
    padding-block: var(--space-xl) 0;
  }

  .sourcing-paths {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .sourcing-path {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-height: 100%;
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(22, 41, 77, 0.05);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .sourcing-path:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .sourcing-path__eyebrow {
    color: var(--color-accent-dark);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sourcing-path strong {
    color: var(--color-primary);
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  .sourcing-path span:last-child {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  /* ==================== Catalog Toolbar ==================== */
  #catalog {
    padding-top: var(--space-2xl);
  }

  .catalog-toolbar {
    display: grid;
    grid-template-columns: minmax(280px, 1fr) auto;
    gap: var(--space-md);
    align-items: center;
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-white);
    box-shadow: 0 4px 16px rgba(22, 41, 77, 0.05);
  }

  .catalog-search {
    position: relative;
    display: block;
  }

  .catalog-search svg {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    width: 1.05rem;
    height: 1.05rem;
    color: var(--color-text-muted);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .catalog-search input {
    width: 100%;
    min-height: 42px;
    padding: 0.6rem 0.8rem 0.6rem 2.45rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text);
    background: var(--color-bg);
    font: inherit;
    font-size: var(--text-sm);
  }

  .catalog-search input:focus,
  .catalog-filter select:focus,
  .catalog-sort__select:focus {
    outline: 2px solid rgba(196, 160, 53, 0.3);
    outline-offset: 1px;
    border-color: var(--color-accent);
  }

  .catalog-controls {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.65rem;
    justify-content: flex-end;
  }

  .catalog-filter,
  .catalog-sort {
    display: grid;
    gap: 0.25rem;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .catalog-filter select,
  .catalog-sort__select {
    min-height: 38px;
    width: 136px;
    min-width: 0;
    padding: 0.45rem 1.9rem 0.45rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-white);
    color: var(--color-primary);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .catalog-sort__select {
    width: 128px;
  }

  .catalog-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 48px;
  }

  .catalog-summary__actions {
    display: inline-flex;
    align-items: center;
    gap: var(--space-md);
  }

  .catalog-view-toggle {
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    padding: 0.2rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
  }

  .catalog-view-toggle__btn {
    min-height: 30px;
    padding: 0.25rem 0.7rem;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    font-size: var(--text-xs);
    font-weight: 800;
    cursor: pointer;
  }

  .catalog-view-toggle__btn.is-active {
    background: var(--color-white);
    color: var(--color-primary);
    box-shadow: 0 1px 3px rgba(22, 41, 77, 0.12);
  }

  .catalog-reset {
    border: 0;
    background: transparent;
    color: var(--color-accent-dark);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
  }

  .catalog-reset:hover { text-decoration: underline; }

  .catalog-reset[hidden] { display: none; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .catalog-count {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-lg);
  }

  .catalog-empty {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-3xl) 0;
  }

  /* ==================== Product Grid ==================== */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .product-grid.is-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  /* ==================== Product Card ==================== */
  .product-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
  }

  .product-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(22, 41, 77, 0.1);
    border-color: rgba(196, 160, 53, 0.4);
  }

  .product-card.is-hidden { display: none; }

  .product-card__link { display: block; }

  .product-card__body,
  .product-card__link {
    min-width: 0;
  }

  .product-card__image-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--color-bg);
    overflow: hidden;
  }

  .product-card__image-wrap picture,
  .product-card__image-wrap img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-card__image {
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .product-card:hover .product-card__image {
    transform: scale(1.05);
  }

  .product-card__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    width: 100%;
    height: 100%;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    background: var(--color-bg);
  }

  .product-card__badge {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    display: inline-block;
    padding: 0.25rem 0.625rem;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-white);
    background: var(--color-accent);
    border-radius: var(--radius-sm);
    z-index: 1;
  }

  .product-card__body {
    padding: var(--space-md) var(--space-md) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .product-card__title-link { text-decoration: none; }

  .product-card__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-primary);
    margin: 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__spec-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 0.2rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--color-border);
  }

  .product-card__spec-grid div {
    min-width: 0;
  }

  .product-card__spec-grid span {
    display: block;
    margin-bottom: 0.15rem;
    color: var(--color-text-muted);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .product-card__spec-grid strong {
    display: block;
    overflow: hidden;
    color: var(--color-primary);
    font-size: var(--text-xs);
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .product-card__meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .product-card__meta span {
    min-width: 0;
  }

  .product-card__meta span:nth-child(2) {
    grid-column: 2;
    text-align: left;
  }

  .product-card__stock {
    color: var(--color-accent-dark);
  }

  .product-card__applications {
    min-height: 2.8em;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: 1.45;
  }

  .product-card__applications strong {
    color: var(--color-primary);
  }

  .product-card__specs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .product-card__spec {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 600;
  }

  .product-card__spec svg { color: var(--color-accent-dark); }

  .product-card__spec--stock {
    color: var(--color-accent-dark);
    font-weight: 700;
  }

  .product-card__spec--stock svg {
    color: var(--color-accent);
  }

  .product-card__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .product-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.75rem;
    border-radius: 10px;
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    min-height: 40px;
  }

  .product-card__btn--outline {
    border: 1.5px solid var(--color-border);
    color: var(--color-primary);
    background: var(--color-white);
  }

  .product-card__btn--outline:hover {
    border-color: var(--color-primary);
    background: rgba(22, 41, 77, 0.03);
  }

  .product-card__btn--primary {
    background: var(--color-accent);
    color: #fff;
    border: 1.5px solid var(--color-accent);
  }

  .product-card__btn--primary:hover {
    background: var(--color-accent-dark);
    border-color: var(--color-accent-dark);
  }

  .product-grid.is-list .product-card {
    display: grid;
    grid-template-columns: minmax(180px, 220px) minmax(0, 1fr);
    align-items: stretch;
  }

  .product-grid.is-list .product-card:hover {
    transform: translateY(-1px);
  }

  .product-grid.is-list .product-card__image-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    height: 100%;
    min-height: 180px;
  }

  .product-grid.is-list .product-card__body {
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(180px, 1.2fr) minmax(260px, 1.4fr) minmax(180px, 0.8fr);
    gap: var(--space-md);
    align-items: center;
  }

  .product-grid.is-list .product-card__title-link,
  .product-grid.is-list .product-card__desc {
    grid-column: 1;
  }

  .product-grid.is-list .product-card__desc {
    -webkit-line-clamp: 3;
  }

  .product-grid.is-list .product-card__spec-grid {
    grid-column: 2;
    grid-row: 1 / span 3;
    margin-top: 0;
    padding: 0;
    border-top: 0;
  }

  .product-grid.is-list .product-card__meta,
  .product-grid.is-list .product-card__applications,
  .product-grid.is-list .product-card__actions {
    grid-column: 3;
  }

  .product-grid.is-list .product-card__applications {
    min-height: 0;
  }

  .product-grid.is-list .product-card__actions {
    grid-template-columns: 1fr;
  }

  /* ==================== Responsive ==================== */
  @media (max-width: 968px) {
    .product-grid { grid-template-columns: repeat(2, 1fr); }
    .sourcing-paths { grid-template-columns: 1fr; }
    .catalog-toolbar {
      grid-template-columns: 1fr;
      align-items: stretch;
    }
    .catalog-controls {
      justify-content: flex-start;
      flex-wrap: wrap;
    }
    .product-grid.is-list .product-card {
      grid-template-columns: 150px minmax(0, 1fr);
    }
    .product-grid.is-list .product-card__body {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .product-grid.is-list .product-card__title-link,
    .product-grid.is-list .product-card__desc,
    .product-grid.is-list .product-card__spec-grid,
    .product-grid.is-list .product-card__meta,
    .product-grid.is-list .product-card__applications,
    .product-grid.is-list .product-card__actions {
      grid-column: auto;
      grid-row: auto;
    }
    .product-grid.is-list .product-card__spec-grid {
      padding-top: 0.7rem;
      border-top: 1px solid var(--color-border);
    }
  }

  @media (max-width: 768px) {
    .product-grid { grid-template-columns: 1fr; }

    .product-card__body { padding: var(--space-md); }

    .page-hero { padding-block: var(--space-2xl) var(--space-3xl); }
    .page-hero__desc { font-size: var(--text-base); }
    .catalog-controls { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .catalog-filter select,
    .catalog-sort__select { width: 100%; min-width: 0; }
    .catalog-summary {
      align-items: flex-start;
      flex-direction: column;
      padding-block: var(--space-sm);
    }
    .catalog-summary__actions {
      justify-content: space-between;
      width: 100%;
    }
    .catalog-quick-facts { display: grid; gap: 0.55rem; }
    .product-grid.is-list .product-card { grid-template-columns: 1fr; }
    .product-grid.is-list .product-card__image-wrap { min-height: auto; }
    .product-card__actions { grid-template-columns: 1fr; }
  }
</style>

<script>
  (function () {
    var grid = document.getElementById("product-grid");
    var searchInput = document.getElementById("catalog-search");
    var finishFilter = document.getElementById("finish-filter");
    var stretchFilter = document.getElementById("stretch-filter");
    var applicationFilter = document.getElementById("application-filter");
    var stockFilter = document.getElementById("stock-filter");
    var sortSelect = document.getElementById("catalog-sort");
    var countEl = document.getElementById("catalog-count");
    var emptyEl = document.getElementById("catalog-empty");
    var resetButton = document.getElementById("catalog-reset");
    var viewButtons = Array.prototype.slice.call(document.querySelectorAll(".catalog-view-toggle__btn"));
    if (!grid) return;

    var cards = Array.prototype.slice.call(grid.querySelectorAll(".product-card"));
    var filterControls = [searchInput, finishFilter, stretchFilter, applicationFilter, stockFilter];

    function hasApplication(card, value) {
      if (value === "all") return true;
      return (card.getAttribute("data-applications") || "").split("|").some(function (application) {
        return application === value;
      });
    }

    function applyFilters() {
      var search = (searchInput && searchInput.value || "").trim().toLowerCase();
      var finish = finishFilter ? finishFilter.value : "all";
      var stretch = stretchFilter ? stretchFilter.value : "all";
      var application = applicationFilter ? applicationFilter.value : "all";
      var stock = stockFilter ? stockFilter.value : "all";
      var visible = 0;

      cards.forEach(function (card) {
        var tags = {};
        try { tags = JSON.parse(card.getAttribute("data-filter-tags") || "{}"); } catch (error) {}
        var cardStock = card.getAttribute("data-stock") || "";
        var show =
          (!search || (card.getAttribute("data-search") || "").indexOf(search) !== -1) &&
          (finish === "all" || tags.finish === finish) &&
          (stretch === "all" || tags.stretch === stretch) &&
          hasApplication(card, application) &&
          (stock === "all" || cardStock === stock);
        card.classList.toggle("is-hidden", !show);
        if (show) visible++;
      });
      if (countEl) countEl.textContent = "Showing " + visible + " products";
      if (emptyEl) emptyEl.hidden = visible !== 0;
      if (resetButton) {
        resetButton.hidden = !search && finish === "all" && stretch === "all" && application === "all" && stock === "all";
      }
    }

    function applySort(mode) {
      var sorted = cards.slice().sort(function (a, b) {
        if (mode === "az") {
          return (a.getAttribute("data-title") || "").localeCompare(b.getAttribute("data-title") || "");
        }
        if (mode === "colors") {
          return parseInt(b.getAttribute("data-colors") || "0", 10) - parseInt(a.getAttribute("data-colors") || "0", 10);
        }
        return parseInt(a.getAttribute("data-order") || "0", 10) - parseInt(b.getAttribute("data-order") || "0", 10);
      });
      sorted.forEach(function (card) { grid.appendChild(card); });
    }

    // Preserve original order for "Recommended"
    cards.forEach(function (card, i) { card.setAttribute("data-order", String(i)); });

    function setView(mode) {
      var nextMode = mode === "list" ? "list" : "grid";
      grid.classList.toggle("is-list", nextMode === "list");
      viewButtons.forEach(function (button) {
        var active = button.getAttribute("data-view") === nextMode;
        button.classList.toggle("is-active", active);
        button.setAttribute("aria-pressed", active ? "true" : "false");
      });
      try { window.localStorage.setItem("catalogView", nextMode); } catch (error) {}
    }

    viewButtons.forEach(function (button) {
      button.addEventListener("click", function () {
        setView(button.getAttribute("data-view") || "grid");
      });
    });

    filterControls.forEach(function (control) {
      if (control) control.addEventListener("input", applyFilters);
      if (control && control.tagName === "SELECT") control.addEventListener("change", applyFilters);
    });

    if (sortSelect) {
      sortSelect.addEventListener("change", function () {
        applySort(sortSelect.value);
      });
    }

    if (resetButton) {
      resetButton.addEventListener("click", function () {
        if (searchInput) searchInput.value = "";
        [finishFilter, stretchFilter, applicationFilter, stockFilter].forEach(function (control) {
          if (control) control.value = "all";
        });
        if (sortSelect) sortSelect.value = "default";
        applySort("default");
        applyFilters();
      });
    }

    var savedView = "grid";
    try { savedView = window.localStorage.getItem("catalogView") || "grid"; } catch (error) {}
    setView(savedView);
    applyFilters();
  })();
</script>
