---
/**
 * Products Listing Page — /products
 * Catalog-style layout: category tiles → filter chips + sort → product grid
 * Filter/sort implemented client-side on the static-rendered grid.
 */
import Layout from "@layouts/Layout.astro";
import { allProducts } from "@data/allProducts";

/* ---- Application collections (aligned with home Applications section) ---- */
const collections = [
  {
    key: "swimwear",
    label: "Fashion & Swimwear",
    desc: "4-way stretch spandex and milk-silk bases with foil and laser finishes.",
    image: "/shots/application- fashion-swimwear.jpg",
    href: "/applications/foil-fabric-for-swimwear/",
  },
  {
    key: "footwear,handbag",
    label: "Shoes & Bags",
    desc: "Structured glitter and synthetic-leather bases for uppers, handbags and trims.",
    image: "/shots/application-shoes-glitter-fabric.png",
    href: "/applications/glitter-fabric-for-shoes/",
  },
  {
    key: "stage-costume",
    label: "Party & Stage Costumes",
    desc: "Holographic and iridescent fabrics for dance, cosplay and performance outfits.",
    image: "/shots/application-costume-glitter.jpg",
    href: "/applications/holographic-fabric-for-stage-costumes/",
  },
  {
    key: "decoration",
    label: "Toys, Crafts & Decor",
    desc: "Cut-clean glitter fabrics for toys, DIY crafts, backdrops and festive projects.",
    image: "/shots/application-toys-crafts-decor.webp",
    href: "/applications/glitter-fabric-for-decoration/",
  },
];

const collectionCount = (key: string) =>
  allProducts.filter((p) => key.split(",").some((t) => p.tags.includes(t))).length;

/* ---- Filter chips (application-based, with counts) ---- */
const filters = [
  { key: "all", label: "All Products" },
  { key: "swimwear", label: "Fashion & Swimwear" },
  { key: "footwear,handbag", label: "Shoes & Bags" },
  { key: "stage-costume", label: "Party & Stage" },
  { key: "decoration", label: "Decor & Crafts" },
  { key: "metallic", label: "Metallic" },
  { key: "gradient", label: "Gradient" },
  { key: "printed", label: "Printed" },
].map((f) => ({
  ...f,
  count: f.key === "all" ? allProducts.length : collectionCount(f.key),
}));

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Products", item: "https://nixiafabric.com/products/" },
  ],
};

const collectionPageData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Wholesale Glitter, Foil & Iridescent Fabric Collection",
  description: "Browse glitter, foil, iridescent and stretch fabrics for footwear, handbags, fashion, swimwear, stage costumes and decoration. Factory-direct supply with custom color matching and OEM/ODM support.",
  url: "https://nixiafabric.com/products/",
};

const toWebp = (src: string) => src.replace(/\.(png|jpe?g)$/i, ".webp");
---

<Layout
  title="Wholesale Glitter, Foil & Iridescent Fabrics | Nixia Fabric"
  description="Browse wholesale glitter, foil, iridescent and stretch fabrics for shoes, handbags, fashion, swimwear, stage costumes and decoration. Factory-direct supply, custom options and sample support."
  keywords="wholesale glitter fabric, foil fabric supplier, iridescent fabric manufacturer, stretch fabric wholesale, glitter synthetic leather"
  canonical="https://nixiafabric.com/products/"
  structuredData={[breadcrumbData, collectionPageData]}
>
  <!-- Page Hero (compact catalog header) -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__current">Products</span>
      </nav>
      <span class="eyebrow">Wholesale Catalog</span>
      <h1>Wholesale Glitter, Foil &amp; Iridescent Fabrics</h1>
      <p class="page-hero__desc">
        Browse {allProducts.length} fabric options for shoes, handbags, fashion, swimwear,
        stage costumes and decoration. Stock materials, OEM/ODM customization and buyer-specific
        testing support are available through our factory team.
      </p>
    </div>
  </section>

  <!-- Application Collections -->
  <section class="section section--flush">
    <div class="container">
      <div class="collections-grid">
        {collections.map((c) => (
          <a href={c.href} class="collection-card" data-filter={c.key}>
            <picture class="collection-card__media">
              <source srcset={toWebp(c.image)} type="image/webp" />
              <img src={c.image} alt={`${c.label} fabric applications`} loading="lazy" width="1672" height="941" />
            </picture>
            <span class="collection-card__overlay" aria-hidden="true"></span>
            <div class="collection-card__body">
              <span class="collection-card__count">{collectionCount(c.key)} ITEMS</span>
              <h2 class="collection-card__title">{c.label}</h2>
              <p class="collection-card__desc">{c.desc}</p>
              <span class="collection-card__cta">Browse Collection &gt;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Catalog: filter + sort + grid -->
  <section class="section" id="catalog">
    <div class="container">
      <div class="catalog-toolbar">
        <div class="catalog-chips" role="tablist" aria-label="Filter products">
          {filters.map((f, i) => (
            <button
              type="button"
              class:list={["catalog-chip", { "is-active": i === 0 }]}
              data-filter={f.key}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
            >
              {f.label} <span class="catalog-chip__count">{f.count}</span>
            </button>
          ))}
        </div>
        <label class="catalog-sort">
          <span class="catalog-sort__label">Sort by</span>
          <select id="catalog-sort" class="catalog-sort__select">
            <option value="default">Recommended</option>
            <option value="az">Name A–Z</option>
            <option value="colors">Most Colors</option>
          </select>
        </label>
      </div>

      <p class="catalog-count" id="catalog-count" aria-live="polite">
        Showing {allProducts.length} products
      </p>

      <div class="product-grid" id="product-grid">
        {
          allProducts.map((item) => (
            <div class="product-card" data-id={item.slug} data-tags={item.tags.join(",")} data-colors={item.colorCount ?? item.imageList.length} data-title={item.title}>
              <a href={`/products/${item.slug}/`} class="product-card__link" aria-label={`View ${item.title}`}>
                <div class="product-card__image-wrap">
                  {item.mainImageUrl ? (
                    <picture>
                      {item.mainImageWebp && <source srcset={item.mainImageWebp} type="image/webp" />}
                      <img src={item.mainImageUrl} alt={item.title} class="product-card__image" loading="lazy" width="1200" height="1200" decoding="async" onerror="this.style.display='none';this.closest('.product-card__image-wrap').querySelector('.product-card__placeholder').style.display='flex'" />
                    </picture>
                  ) : null}
                  <div class="product-card__placeholder" style={item.mainImageUrl ? "display:none" : "display:flex"}>
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21 15 16 10 5 21"/>
                    </svg>
                    <span>Image coming soon</span>
                  </div>
                  {item.badge && <span class="product-card__badge">{item.badge}</span>}
                </div>
              </a>

              <div class="product-card__body">
                <a href={`/products/${item.slug}/`} class="product-card__title-link">
                  <h2 class="product-card__title">{item.title}</h2>
                </a>
                <p class="product-card__desc">{item.shortIntro}</p>

                <div class="product-card__specs">
                  {item.stockStatus ? (
                    <span class="product-card__spec product-card__spec--stock" title="In stock">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                      {item.stockStatus}
                    </span>
                  ) : null}
                  <span class="product-card__spec">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7h-9l-2 2H4a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1z"/></svg>
                    MOQ {item.specs.moq}m
                  </span>
                  <span class="product-card__spec">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    {item.specs.leadTime} days
                  </span>
                </div>

                <div class="product-card__actions">
                  <a href={`/products/${item.slug}/`} class="product-card__btn product-card__btn--outline">Details</a>
                  <a href={`/contact/?sku=${encodeURIComponent(item.title)}`} data-rfq-open data-rfq-sku={item.title} class="product-card__btn product-card__btn--primary">Add Quote</a>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <p class="catalog-empty" id="catalog-empty" hidden>No products match this filter.</p>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="section section--alt">
    <div class="container" style="text-align:center">
      <h2 class="section-header__title">Need a Custom Quote?</h2>
      <p class="section-header__desc" style="max-width:560px;margin:0 auto var(--space-lg)">
        Contact us for custom color matching, backing options, and bulk pricing.
        Free samples available — we ship worldwide.
      </p>
      <div class="btn-group" style="justify-content:center">
        <a href="/sample-policy/" data-rfq-open class="btn btn--primary">Request Free Sample</a>
        <a href="/contact/" data-rfq-open class="btn btn--outline">Get Custom Quotation</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    padding-block: var(--space-3xl) var(--space-4xl);
    position: relative;
    overflow: hidden;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 50%, rgba(196, 160, 53, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 30%, rgba(42, 65, 112, 0.4) 0%, transparent 50%);
    pointer-events: none;
  }

  .page-hero .container { position: relative; z-index: 1; }

  .page-hero .breadcrumb {
    margin-bottom: var(--space-lg);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
  }

  .page-hero .breadcrumb a { color: rgba(255, 255, 255, 0.6); text-decoration: none; }
  .page-hero .breadcrumb a:hover { color: var(--color-accent-light); }

  .breadcrumb__sep { margin-inline: var(--space-xs); opacity: 0.5; }
  .breadcrumb__current { color: var(--color-white); }

  .page-hero .eyebrow { color: var(--color-accent-light); }
  .page-hero h1 { color: var(--color-white); margin-bottom: var(--space-md); }

  .page-hero__desc {
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-lg);
    max-width: 640px;
  }

  /* ==================== Collection Tiles ==================== */
  .section--flush {
    padding-top: var(--space-3xl);
    background: #f7f5ef;
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
  }

  .collection-card {
    position: relative;
    display: block;
    height: 280px;
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    border: 1px solid rgba(22, 41, 77, 0.06);
    box-shadow: 0 6px 20px rgba(22, 41, 77, 0.12);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .collection-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 34px rgba(22, 41, 77, 0.18);
  }

  .collection-card__media {
    position: absolute;
    inset: 0;
  }

  .collection-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .collection-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.78) 0%,
      rgba(0, 0, 0, 0.38) 45%,
      rgba(0, 0, 0, 0.32) 100%
    );
  }

  .collection-card__body {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.25rem;
  }

  .collection-card__count {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--color-accent-light);
    border: 1px solid rgba(196, 160, 53, 0.45);
    background: rgba(0, 0, 0, 0.35);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
  }

  .collection-card__title {
    color: #fff;
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0.7rem 0 0;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
  }

  .collection-card__desc {
    color: rgba(255, 255, 255, 0.92);
    font-size: var(--text-sm);
    line-height: 1.5;
    margin: 0.35rem 0 0;
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.3);
  }

  .collection-card__cta {
    margin-top: auto;
    color: var(--color-accent-light);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  /* ==================== Catalog Toolbar ==================== */
  .catalog-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    flex-wrap: wrap;
    margin-bottom: var(--space-md);
  }

  .catalog-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .catalog-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-white);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    min-height: 38px;
  }

  .catalog-chip:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-dark);
  }

  .catalog-chip.is-active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  .catalog-chip__count {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.05rem 0.45rem;
    border-radius: 999px;
    background: rgba(22, 41, 77, 0.07);
  }

  .catalog-chip.is-active .catalog-chip__count {
    background: rgba(255, 255, 255, 0.18);
  }

  .catalog-sort {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .catalog-sort__select {
    padding: 0.45rem 0.75rem;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background: var(--color-white);
    color: var(--color-primary);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    min-height: 38px;
  }

  .catalog-sort__select:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .catalog-count {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-lg);
  }

  .catalog-empty {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-3xl) 0;
  }

  /* ==================== Product Grid ==================== */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  /* ==================== Product Card ==================== */
  .product-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.25s ease, transform 0.25s ease, border-color 0.25s ease;
  }

  .product-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(22, 41, 77, 0.1);
    border-color: rgba(196, 160, 53, 0.4);
  }

  .product-card.is-hidden { display: none; }

  .product-card__link { display: block; }

  .product-card__image-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--color-bg);
    overflow: hidden;
  }

  .product-card__image-wrap picture,
  .product-card__image-wrap img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .product-card__image {
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .product-card:hover .product-card__image {
    transform: scale(1.05);
  }

  .product-card__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    width: 100%;
    height: 100%;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    background: var(--color-bg);
  }

  .product-card__badge {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    display: inline-block;
    padding: 0.25rem 0.625rem;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-white);
    background: var(--color-accent);
    border-radius: var(--radius-sm);
    z-index: 1;
  }

  .product-card__body {
    padding: var(--space-md) var(--space-md) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .product-card__title-link { text-decoration: none; }

  .product-card__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-primary);
    margin: 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__specs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .product-card__spec {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-weight: 600;
  }

  .product-card__spec svg { color: var(--color-accent-dark); }

  .product-card__spec--stock {
    color: var(--color-accent-dark);
    font-weight: 700;
  }

  .product-card__spec--stock svg {
    color: var(--color-accent);
  }

  .product-card__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .product-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.75rem;
    border-radius: 10px;
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    min-height: 40px;
  }

  .product-card__btn--outline {
    border: 1.5px solid var(--color-border);
    color: var(--color-primary);
    background: var(--color-white);
  }

  .product-card__btn--outline:hover {
    border-color: var(--color-primary);
    background: rgba(22, 41, 77, 0.03);
  }

  .product-card__btn--primary {
    background: var(--color-accent);
    color: #fff;
    border: 1.5px solid var(--color-accent);
  }

  .product-card__btn--primary:hover {
    background: var(--color-accent-dark);
    border-color: var(--color-accent-dark);
  }

  /* ==================== Responsive ==================== */
  @media (max-width: 1199px) {
    .collections-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 968px) {
    .product-grid { grid-template-columns: repeat(2, 1fr); }
    .catalog-toolbar { align-items: flex-start; flex-direction: column; }
  }

  @media (max-width: 768px) {
    .product-grid { grid-template-columns: 1fr; }
    .collections-grid { grid-template-columns: 1fr; }

    .product-card__body { padding: var(--space-md); }

    .page-hero { padding-block: var(--space-2xl) var(--space-3xl); }
    .page-hero__desc { font-size: var(--text-base); }
  }
</style>

<script>
  (function () {
    var grid = document.getElementById("product-grid");
    var chips = document.querySelectorAll(".catalog-chip");
    var sortSelect = document.getElementById("catalog-sort");
    var countEl = document.getElementById("catalog-count");
    var emptyEl = document.getElementById("catalog-empty");
    if (!grid || !chips.length) return;

    var cards = Array.prototype.slice.call(grid.querySelectorAll(".product-card"));
    var currentFilter = "all";

    function applyFilter() {
      var visible = 0;
      var activeTags = currentFilter === "all" ? [] : currentFilter.split(",");
      cards.forEach(function (card) {
        var tags = (card.getAttribute("data-tags") || "").split(",");
        var show = currentFilter === "all" || activeTags.some(function (t) { return tags.indexOf(t) !== -1; });
        card.classList.toggle("is-hidden", !show);
        if (show) visible++;
      });
      if (countEl) countEl.textContent = "Showing " + visible + " products";
      if (emptyEl) emptyEl.hidden = visible !== 0;
    }

    function applySort(mode) {
      var sorted = cards.slice().sort(function (a, b) {
        if (mode === "az") {
          return (a.getAttribute("data-title") || "").localeCompare(b.getAttribute("data-title") || "");
        }
        if (mode === "colors") {
          return parseInt(b.getAttribute("data-colors") || "0", 10) - parseInt(a.getAttribute("data-colors") || "0", 10);
        }
        return parseInt(a.getAttribute("data-order") || "0", 10) - parseInt(b.getAttribute("data-order") || "0", 10);
      });
      sorted.forEach(function (card) { grid.appendChild(card); });
    }

    // Preserve original order for "Recommended"
    cards.forEach(function (card, i) { card.setAttribute("data-order", String(i)); });

    chips.forEach(function (chip) {
      chip.addEventListener("click", function () {
        chips.forEach(function (c) {
          c.classList.remove("is-active");
          c.setAttribute("aria-selected", "false");
        });
        chip.classList.add("is-active");
        chip.setAttribute("aria-selected", "true");
        currentFilter = chip.getAttribute("data-filter") || "all";
        applyFilter();
      });
    });

    // Collection tiles scroll to catalog and activate the matching filter
    document.querySelectorAll(".collection-card").forEach(function (tile) {
      tile.addEventListener("click", function (e) {
        var key = tile.getAttribute("data-filter");
        var chip = document.querySelector('.catalog-chip[data-filter="' + key + '"]');
        if (chip) {
          e.preventDefault();
          chip.click();
        }
        // default: anchor scroll to #catalog happens naturally
      });
    });

    if (sortSelect) {
      sortSelect.addEventListener("change", function () {
        applySort(sortSelect.value);
      });
    }

    applyFilter();
  })();
</script>
