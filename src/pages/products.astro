---
/**
 * Products Listing Page — /products
 * Displays all 40 glitter synthetic leather products in a responsive grid
 */
import Layout from "@layouts/Layout.astro";
import products from "@data/products.json";

interface Product {
  id: string;
  title: string;
  category: string;
  shortDesc: string;
  fullDescription: string;
  mainImage: string;
  skuImages: string[];
  detailImages: string[];
  videoLocal: string;
  videoYoutubeUrl: string;
  tags: string[];
}

const allProducts: Product[] = products;

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Products", item: "https://nixiafabric.com/products" },
  ],
};

const collectionPageData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Glitter Synthetic Leather Collection",
  description: "Browse our complete range of glitter synthetic leather for footwear, handbag and accessory manufacturing. Factory direct supply with custom color matching.",
  url: "https://nixiafabric.com/products",
  hasPart: allProducts.map((p) => ({
    "@type": "Product",
    name: p.title,
    url: `https://nixiafabric.com/products/${p.id}`,
    image: `https://nixiafabric.com${p.mainImage}`,
  })),
};
---

<Layout
  title="Glitter Synthetic Leather Products | Nixia Fabric"
  description="Browse our complete range of glitter synthetic leather for footwear, handbag and accessory manufacturing. All products SGS certified, REACH compliant, with free samples available."
  keywords="glitter synthetic leather, glitter fabric, synthetic leather manufacturer, PU glitter leather, B2B fabric supplier"
  canonical="https://nixiafabric.com/products"
  structuredData={[breadcrumbData, collectionPageData]}
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__current">Products</span>
      </nav>
      <span class="eyebrow">Our Collection</span>
      <h1>Glitter Synthetic Leather</h1>
      <p class="page-hero__desc">
        Explore our complete range of glitter synthetic leather.
        All products are SGS certified and REACH compliant, with free samples and custom color matching available.
      </p>
    </div>
  </section>

  <!-- Product Grid -->
  <section class="section">
    <div class="container">
      <div class="product-grid" id="product-grid">
        {
          allProducts.map((product) => (
            <a
              href={`/products/${product.id}/`}
              class="product-card"
              data-id={product.id}
            >
              <!-- Image -->
              <div class="product-card__image-wrap">
                {
                  product.mainImage ? (
                    <img
                      src={product.mainImage}
                      alt={product.title}
                      class="product-card__image"
                      loading="lazy"
                      width="400"
                      height="400"
                      onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                    />
                  ) : null
                }
                <div
                  class="product-card__placeholder"
                  style={product.mainImage ? "display:none" : "display:flex"}
                >
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                  </svg>
                  <span>Image coming soon</span>
                </div>
                <span class="product-card__badge">{product.category}</span>
              </div>

              <!-- Info -->
              <div class="product-card__body">
                <h2 class="product-card__title">{product.title}</h2>
                <p class="product-card__desc">{product.shortDesc}</p>

                <!-- Tags -->
                <div class="product-card__tags">
                  {product.tags.slice(0, 4).map((tag: string) => (
                    <span class="product-card__tag">{tag.replace(/-/g, " ")}</span>
                  ))}
                </div>

                <!-- Meta -->
                <div class="product-card__meta">
                  {product.skuImages.length > 0 && (
                    <span class="product-card__meta-item">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                        <circle cx="8.5" cy="8.5" r="1.5"/>
                        <polyline points="21 15 16 10 5 21"/>
                      </svg>
                      {product.skuImages.length} colors
                    </span>
                  )}
                  {product.videoLocal && (
                    <span class="product-card__meta-item">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="23 7 16 12 23 17 23 7"/>
                        <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                      </svg>
                      Video
                    </span>
                  )}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="section section--alt">
    <div class="container" style="text-align:center">
      <h2 class="section-header__title">Need a Custom Quote?</h2>
      <p class="section-header__desc" style="max-width:560px;margin:0 auto var(--space-lg)">
        Contact us for custom color matching, backing options, and bulk pricing.
        Free samples available — we ship worldwide.
      </p>
      <div class="btn-group" style="justify-content:center">
        <a href="/sample-policy/" class="btn btn--primary">Request Free Sample</a>
        <a href="/contact/" class="btn btn--outline">Get Custom Quotation</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    padding-block: var(--space-3xl) var(--space-4xl);
    position: relative;
    overflow: hidden;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 50%, rgba(196, 160, 53, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 30%, rgba(42, 65, 112, 0.4) 0%, transparent 50%);
    pointer-events: none;
  }

  .page-hero .container { position: relative; z-index: 1; }

  .page-hero .breadcrumb {
    margin-bottom: var(--space-lg);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
  }

  .page-hero .breadcrumb a { color: rgba(255, 255, 255, 0.6); text-decoration: none; }
  .page-hero .breadcrumb a:hover { color: var(--color-accent-light); }

  .breadcrumb__sep { margin-inline: var(--space-xs); opacity: 0.5; }
  .breadcrumb__current { color: var(--color-white); }

  .page-hero .eyebrow { color: var(--color-accent-light); }
  .page-hero h1 { color: var(--color-white); margin-bottom: var(--space-md); }

  .page-hero__desc {
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-lg);
    max-width: 640px;
  }

  /* Product Grid */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  /* Product Card */
  .product-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-base);
    display: flex;
    flex-direction: column;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-accent);
  }

  .product-card__image-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--color-bg);
    overflow: hidden;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .product-card:hover .product-card__image {
    transform: scale(1.05);
  }

  .product-card__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    width: 100%;
    height: 100%;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    background: var(--color-bg);
  }

  .product-card__badge {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    display: inline-block;
    padding: 0.25rem 0.625rem;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-white);
    background: var(--color-accent);
    border-radius: var(--radius-sm);
    z-index: 1;
  }

  .product-card__body {
    padding: var(--space-md) var(--space-lg) var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    flex: 1;
  }

  .product-card__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-primary);
    margin: 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
  }

  .product-card__tag {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-accent-dark);
    background: rgba(196, 160, 53, 0.08);
    border-radius: var(--radius-sm);
    text-transform: capitalize;
  }

  .product-card__meta {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-sm);
    font-size: var(--text-xs);
    color: var(--color-text-light);
  }

  .product-card__meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  /* Responsive */
  @media (max-width: 968px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .product-grid {
      grid-template-columns: 1fr;
    }

    .page-hero {
      padding-block: var(--space-2xl) var(--space-3xl);
    }

    .page-hero__desc {
      font-size: var(--text-base);
    }
  }
</style>
