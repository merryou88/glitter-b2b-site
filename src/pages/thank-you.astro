---
/**
 * Thank You Page — /thank-you
 * Landing page after successful contact form submission
 */
import Layout from "@layouts/Layout.astro";
import CTAButton from "@components/CTAButton.astro";

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Contact", item: "https://nixiafabric.com/contact" },
    { "@type": "ListItem", position: 3, name: "Thank You", item: "https://nixiafabric.com/thank-you" },
  ],
};
---

<Layout
  title="Thank You — Inquiry Received | Nixia Fabric"
  description="Thank you for contacting Nixia Fabric. We have received your inquiry and will get back to you within 24 hours."
  canonical="https://nixiafabric.com/thank-you"
  robots="noindex, follow"
  structuredData={[breadcrumbData]}
>
  <section class="thank-you-page">
    <div class="container">
      <div class="thank-you-card">
        <div class="thank-you-card__icon">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
            <polyline points="22 4 12 14.01 9 11.01" />
          </svg>
        </div>

        <span class="eyebrow thank-you-card__eyebrow">Inquiry Received</span>
        <h1>Thank You for Reaching Out!</h1>

        <p class="thank-you-card__desc">
          We have received your inquiry and our team will get back to you
          within <strong>24 hours</strong>. If your request is urgent,
          feel free to contact us directly via WhatsApp.
        </p>

        <div class="thank-you-card__actions">
          <a
            href="https://wa.me/8613800000000"
            class="thank-you-card__btn thank-you-card__btn--whatsapp"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
            </svg>
            Open WhatsApp Chat
          </a>

          <a href="/products/" class="thank-you-card__btn thank-you-card__btn--secondary">
            Browse Our Fabrics
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        </div>

        <div class="thank-you-card__divider"></div>

        <div class="thank-you-card__info">
          <div class="thank-you-card__info-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <span>Response within 24 hours</span>
          </div>
          <div class="thank-you-card__info-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
            <a href="mailto:info@nixiafabric.com">info@nixiafabric.com</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .thank-you-page {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    min-height: 70vh;
    display: flex;
    align-items: center;
    padding-block: var(--space-4xl);
    position: relative;
    overflow: hidden;
  }

  .thank-you-page::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 20% 50%, rgba(196, 160, 53, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 30%, rgba(42, 65, 112, 0.4) 0%, transparent 50%);
    pointer-events: none;
  }

  .thank-you-page .container {
    position: relative;
    z-index: 1;
    max-width: 640px;
  }

  .thank-you-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--space-3xl);
    text-align: center;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
  }

  .thank-you-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: rgba(37, 211, 102, 0.1);
    color: #25D366;
    margin-bottom: var(--space-lg);
  }

  .thank-you-card__eyebrow {
    color: #20bd5a;
    display: block;
    margin-bottom: var(--space-xs);
  }

  .thank-you-card h1 {
    font-size: var(--text-3xl);
    color: var(--color-primary);
    margin-bottom: var(--space-md);
  }

  .thank-you-card__desc {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    max-width: 440px;
    margin: 0 auto var(--space-xl);
  }

  .thank-you-card__actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .thank-you-card__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0.875rem var(--space-xl);
    font-size: var(--text-base);
    font-weight: 700;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .thank-you-card__btn--whatsapp {
    background: #25D366;
    color: var(--color-white);
  }

  .thank-you-card__btn--whatsapp:hover {
    background: #20bd5a;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(37, 211, 102, 0.35);
  }

  .thank-you-card__btn--secondary {
    background: transparent;
    color: var(--color-primary);
    border: 2px solid var(--color-primary);
  }

  .thank-you-card__btn--secondary:hover {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .thank-you-card__divider {
    height: 1px;
    background: var(--color-border);
    margin: var(--space-xl) 0;
  }

  .thank-you-card__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    align-items: center;
  }

  .thank-you-card__info-item {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .thank-you-card__info-item svg {
    color: var(--color-accent);
  }

  .thank-you-card__info-item a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .thank-you-card__info-item a:hover {
    color: var(--color-accent-dark);
  }

  @media (max-width: 640px) {
    .thank-you-card {
      padding: var(--space-xl);
    }

    .thank-you-card h1 {
      font-size: var(--text-2xl);
    }

    .thank-you-card__actions {
      flex-direction: column;
    }

    .thank-you-card__btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
