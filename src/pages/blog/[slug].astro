---
/**
 * Blog Article Page — /blog/[slug]
 * Static buyer guides with product recommendations and RFQ CTAs.
 */
import Layout from "@layouts/Layout.astro";
import CTAButton from "@components/CTAButton.astro";
import { blogArticles } from "@data/blogArticles";
import { allProducts } from "@data/allProducts";

const formatDate = (value: string) =>
  new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }).format(
    new Date(`${value}T00:00:00`),
  );

export function getStaticPaths() {
  return blogArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const relatedProducts = article.focusProducts
  .map((slug) => allProducts.find((product) => product.slug === slug))
  .filter(Boolean);
const articleUrl = `https://nixiafabric.com/blog/${article.slug}/`;
const contactHref = `/contact/?subject=${encodeURIComponent(`Question about ${article.title}`)}`;
const toParagraphs = (body: string | string[]) =>
  Array.isArray(body) ? body : String(body).split("\n\n").filter(Boolean);
const stripSectionNumber = (heading: string) => heading.replace(/^\d+\.\s*/, "");
const slugifyHeading = (heading: string) =>
  stripSectionNumber(heading)
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
const sectionNav = article.sections.map((section, index) => ({
  id: slugifyHeading(section.heading),
  label: stripSectionNumber(section.heading),
  number: String(index + 1).padStart(2, "0"),
}));

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: article.title,
  description: article.metaDesc,
  image: `https://nixiafabric.com${article.image}`,
  datePublished: article.date,
  dateModified: article.date,
  mainEntityOfPage: articleUrl,
  author: { "@type": "Organization", name: "Nixia Fabric" },
  publisher: {
    "@type": "Organization",
    name: "Nixia Fabric",
    logo: { "@type": "ImageObject", url: "https://nixiafabric.com/logo.png" },
  },
};

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://nixiafabric.com/blog/" },
    { "@type": "ListItem", position: 3, name: article.title, item: articleUrl },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: article.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<Layout
  title={article.metaTitle}
  description={article.metaDesc}
  keywords={`${article.title}, ${article.tags.join(", ")}, glitter fabric manufacturer, foil fabric supplier`}
  image={article.image}
  canonical={articleUrl}
  ogType="article"
  structuredData={[articleSchema, breadcrumbData, faqSchema]}
>
  <div class="article-breadcrumb">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/blog/">Blog</a>
        <span>/</span>
        <span aria-current="page">{article.category}</span>
      </nav>
    </div>
  </div>

  <article class="article-page">
    <header class="article-hero">
      <div class="container article-hero__grid">
        <div class="article-hero__copy">
          <div class="article-tags">
            {article.tags.map((tag) => <span class="badge badge--accent">{tag}</span>)}
          </div>
          <span class="eyebrow">{article.category}</span>
          <h1>{article.title}</h1>
          <p class="article-hero__intro">{article.intro}</p>
          <div class="article-meta">
            <span>Published {formatDate(article.date)}</span>
            <span aria-hidden="true">·</span>
            <span>{article.readTime}</span>
          </div>
        </div>
        <picture class="article-hero__image">
          <source srcset={article.imageWebp} type="image/webp" />
          <img src={article.image} alt={article.imageAlt} width="1600" height="900" />
        </picture>
      </div>
    </header>

    <div class="container article-layout">
      <aside class="article-aside">
        <div class="article-aside__block article-aside__block--toc">
          <span class="eyebrow">In This Guide</span>
          <nav class="article-toc" aria-label="Article sections">
            {sectionNav.map((item) => (
              <a href={`#${item.id}`}>
                <span>{item.number}</span>
                <strong>{item.label}</strong>
              </a>
            ))}
          </nav>
        </div>
        <div class="article-aside__block">
          <span class="eyebrow">Key Takeaways</span>
          <ul>
            {article.takeaways.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="article-aside__block article-aside__block--cta">
          <span class="eyebrow">Next Step</span>
          <h2>Ready to compare materials?</h2>
          <p>{article.quoteAngle}</p>
          <CTAButton href={contactHref} variant="primary" block rfq>Send an RFQ</CTAButton>
        </div>
      </aside>

      <div class="article-content">
        {article.buyerSummary && (
          <section class="article-summary">
            <span class="eyebrow">Buyer Summary</span>
            <h2>{article.buyerSummary.heading}</h2>
            <div class="article-summary__grid">
              {article.buyerSummary.items.map((item) => (
                <div class="article-summary__item">
                  <span>{item.label}</span>
                  <strong>{item.value}</strong>
                </div>
              ))}
            </div>
          </section>
        )}

        {article.sections.map((section, index) => (
          <section class="article-section" id={sectionNav[index].id}>
            <div class="article-section__heading">
              <span>{sectionNav[index].number}</span>
              <h2>{sectionNav[index].label}</h2>
            </div>
            {section.image && (
              <figure class="article-section__figure">
                <picture>
                  {section.imageWebp && <source srcset={section.imageWebp} type="image/webp" />}
                  <img src={section.image} alt={section.imageAlt ?? section.heading} loading="lazy" width="1200" height="900" />
                </picture>
                {section.caption && <figcaption>{section.caption}</figcaption>}
              </figure>
            )}
            {toParagraphs(section.body).map((paragraph) => <p>{paragraph}</p>)}
            {section.bullets && (
              <ul class="article-section__bullets">
                {section.bullets.map((item) => <li>{item}</li>)}
              </ul>
            )}
            {section.table && (
              <div class="article-table-wrap">
                <table class="article-table">
                  <thead>
                    <tr>{section.table.headers.map((header) => <th>{header}</th>)}</tr>
                  </thead>
                  <tbody>
                    {section.table.rows.map((row) => (
                      <tr>{row.map((cell) => <td>{cell}</td>)}</tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {section.callout && <div class="article-callout">{section.callout}</div>}
          </section>
        ))}

        <section class="decision-section">
          <span class="eyebrow">Buyer Decision Checklist</span>
          <h2>Confirm these points before you order</h2>
          <ul class="decision-list">
            {article.decisionChecklist.map((item) => (
              <li>
                <span class="decision-list__mark" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>

        <section class="related-section">
          <div class="related-section__heading">
            <div>
              <span class="eyebrow">Recommended Products</span>
              <h2>Shortlist for your next sample request</h2>
            </div>
            <a href="/products/" class="text-link">View all products →</a>
          </div>
          <div class="related-products">
            {relatedProducts.map((product) => (
              <a href={`/products/${product.slug}/`} class="related-product">
                <picture>
                  {product.mainImageWebp && <source srcset={product.mainImageWebp} type="image/webp" />}
                  <img src={product.mainImageUrl} alt={product.mainImageAlt} loading="lazy" width="720" height="405" />
                </picture>
                <span class="related-product__body">
                  <strong>{product.title}</strong>
                  <small>{product.specs.width} · MOQ {product.specs.moq}m · {product.stockStatus}</small>
                </span>
              </a>
            ))}
          </div>
        </section>

        <section class="article-faq">
          <span class="eyebrow">Common Questions</span>
          <h2>Before you request a quotation</h2>
          <div class="faq-list">
            {article.faqs.map((faq) => (
              <details>
                <summary>{faq.question}</summary>
                <p>{faq.answer}</p>
              </details>
            ))}
          </div>
        </section>
      </div>
    </div>
  </article>

  <section class="section section--dark article-final-cta">
    <div class="container">
      <div>
        <span class="eyebrow">Talk to Nixia Fabric</span>
        <h2>{article.ctaHeading}</h2>
        <p>{article.ctaText}</p>
      </div>
      <div class="btn-group">
        <CTAButton href={contactHref} variant="primary" size="lg" rfq>Request a Quotation</CTAButton>
        <CTAButton href="/sample-policy/" variant="secondary" size="lg">Review Sample Policy</CTAButton>
      </div>
    </div>
  </section>
</Layout>

<style>
  .article-breadcrumb {
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-alt);
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .breadcrumb a:hover,
  .text-link:hover {
    color: var(--color-accent-dark);
  }

  .article-hero {
    padding-block: var(--space-4xl);
    background: var(--color-primary);
  }

  .article-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    align-items: center;
    gap: var(--space-3xl);
  }

  .article-hero__copy h1 {
    margin: var(--space-sm) 0 var(--space-lg);
    color: var(--color-white);
    font-size: var(--text-5xl);
  }

  .article-hero .eyebrow {
    color: var(--color-accent-light);
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-xl);
  }

  .article-hero__intro {
    max-width: 650px;
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--text-lg);
  }

  .article-meta {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
    color: rgba(255, 255, 255, 0.58);
    font-size: var(--text-sm);
  }

  .article-hero__image {
    display: block;
    overflow: hidden;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-xl);
  }

  .article-hero__image img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .article-layout {
    display: grid;
    grid-template-columns: 300px minmax(0, 790px);
    justify-content: center;
    gap: var(--space-3xl);
    padding-block: var(--space-4xl);
  }

  .article-aside {
    display: grid;
    align-content: start;
    gap: var(--space-xl);
  }

  .article-aside__block {
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .article-aside__block h2 {
    margin: var(--space-sm) 0;
    font-size: var(--text-xl);
  }

  .article-aside__block p,
  .article-aside li {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .article-aside ul {
    display: grid;
    gap: var(--space-md);
  }

  .article-aside li {
    padding-left: 1rem;
    border-left: 2px solid var(--color-accent);
  }

  .article-aside__block--cta {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent);
    background: var(--color-bg-alt);
  }

  .article-toc {
    display: grid;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .article-toc a {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    align-items: start;
    gap: var(--space-sm);
    padding: var(--space-sm);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.35;
    transition: background var(--transition-base), color var(--transition-base);
  }

  .article-toc a:hover {
    background: var(--color-bg-alt);
    color: var(--color-primary);
  }

  .article-toc span {
    color: var(--color-accent-dark);
    font-weight: 800;
  }

  .article-content {
    min-width: 0;
  }

  .article-summary {
    margin-bottom: var(--space-3xl);
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
  }

  .article-summary h2 {
    margin: var(--space-xs) 0 var(--space-lg);
    color: var(--color-primary);
    font-size: var(--text-2xl);
  }

  .article-summary__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .article-summary__item {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-alt);
  }

  .article-summary__item span {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .article-summary__item strong {
    color: var(--color-primary);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .article-section {
    scroll-margin-top: 110px;
    margin-bottom: var(--space-3xl);
  }

  .article-section__heading,
  .decision-section h2,
  .related-section h2,
  .article-faq h2 {
    margin-bottom: var(--space-lg);
  }

  .article-section__heading {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-items: start;
    gap: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .article-section__heading span {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 800;
  }

  .article-section__heading h2,
  .decision-section h2,
  .related-section h2,
  .article-faq h2 {
    font-size: var(--text-2xl);
  }

  .article-section__heading h2 {
    margin: 0;
    color: var(--color-primary);
  }

  .article-section p {
    margin-bottom: var(--space-md);
    font-size: var(--text-lg);
    line-height: 1.75;
  }

  .article-section__figure {
    overflow: hidden;
    margin: 0 0 var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
    box-shadow: var(--shadow-sm);
  }

  .article-section__figure picture,
  .article-section__figure img {
    display: block;
    width: 100%;
  }

  .article-section__figure img {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .article-section__figure figcaption {
    padding: var(--space-sm) var(--space-md);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .article-section__bullets {
    display: grid;
    gap: var(--space-sm);
    margin: var(--space-lg) 0;
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-alt);
  }

  .article-section__bullets li {
    padding-left: var(--space-md);
    border-left: 3px solid var(--color-accent);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .article-table-wrap {
    overflow-x: auto;
    margin: var(--space-lg) 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
  }

  .article-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .article-table th,
  .article-table td {
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .article-table th {
    background: var(--color-bg-alt);
    color: var(--color-primary);
    font-weight: 800;
  }

  .article-table tr:last-child td {
    border-bottom: 0;
  }

  .article-callout {
    margin-top: var(--space-lg);
    padding: var(--space-lg);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-accent) 10%, white);
    color: var(--color-primary);
    font-weight: 700;
    line-height: var(--leading-relaxed);
  }

  .decision-section {
    margin-block: var(--space-3xl);
    padding: var(--space-xl);
    border-left: 4px solid var(--color-accent);
    background: var(--color-bg-alt);
  }

  .decision-list {
    display: grid;
    gap: var(--space-md);
  }

  .decision-list li {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    color: var(--color-text-secondary);
  }

  .decision-list__mark {
    display: grid;
    width: 24px;
    height: 24px;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .related-section {
    margin-bottom: var(--space-3xl);
  }

  .related-section__heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .text-link {
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 700;
    white-space: nowrap;
  }

  .related-products {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .related-product {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }

  .related-product:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }

  .related-product picture,
  .related-product img {
    display: block;
    width: 100%;
  }

  .related-product img {
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .related-product__body {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-md);
  }

  .related-product strong {
    color: var(--color-primary);
    font-size: var(--text-sm);
    line-height: 1.35;
  }

  .related-product small {
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .faq-list {
    display: grid;
    gap: var(--space-sm);
  }

  .faq-list details {
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .faq-list summary {
    color: var(--color-primary);
    cursor: pointer;
    font-weight: 700;
  }

  .faq-list p {
    margin-top: var(--space-sm);
  }

  .article-final-cta .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xl);
  }

  .article-final-cta h2 {
    margin: var(--space-sm) 0;
  }

  .article-final-cta p {
    max-width: 700px;
  }

  @media (max-width: 900px) {
    .article-hero__grid,
    .article-layout {
      grid-template-columns: 1fr;
    }

    .article-aside {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .article-aside__block--toc {
      grid-column: 1 / -1;
    }

    .article-final-cta .container {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 640px) {
    .article-hero {
      padding-block: var(--space-3xl);
    }

    .article-hero__copy h1 {
      font-size: var(--text-4xl);
    }

    .article-meta {
      flex-wrap: wrap;
    }

    .article-aside,
    .related-products,
    .article-summary__grid {
      grid-template-columns: 1fr;
    }

    .related-section__heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
