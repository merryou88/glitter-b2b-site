---
/**
 * Blog Page — /blog
 * Structure for future SEO content. Four sample article titles.
 * Articles not yet written — this page establishes the blog structure.
 */
import Layout from "@layouts/Layout.astro";
import CTAButton from "@components/CTAButton.astro";

// Sample article data (for future SEO content)
const articles = [
  {
    title: "What is Glitter Fabric?",
    slug: "what-is-glitter-fabric",
    category: "Basics",
    excerpt:
      "A comprehensive introduction to glitter fabric — what it is, how it's made, what types are available, and where it's used in shoes, handbags, and fashion accessories.",
    date: "Coming Soon",
    readTime: "— min read",
    status: "upcoming",
  },
  {
    title: "How to Choose Glitter Fabric for Shoes?",
    slug: "how-to-choose-glitter-fabric-for-shoes",
    category: "Guide",
    excerpt:
      "Selecting the right glitter fabric for shoe applications — understanding backing types, GSM, stretchability, and adhesion requirements for different shoe styles.",
    date: "Coming Soon",
    readTime: "— min read",
    status: "upcoming",
  },
  {
    title: "Glitter Fabric Manufacturing Process",
    slug: "glitter-fabric-manufacturing-process",
    category: "Manufacturing",
    excerpt:
      "A behind-the-scenes look at how glitter fabric is manufactured — from raw material preparation to glitter bonding, color development, and final inspection.",
    date: "Coming Soon",
    readTime: "— min read",
    status: "upcoming",
  },
  {
    title: "Custom Fabric Development Guide",
    slug: "custom-fabric-development-guide",
    category: "Guide",
    excerpt:
      "A guide to custom fabric development — how to specify colors, GSM, width, and backing materials when working with a fabric manufacturer for OEM production.",
    date: "Coming Soon",
    readTime: "— min read",
    status: "upcoming",
  },
];

const categories = ["All", "Basics", "Guide", "Manufacturing"];

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://nixiafabric.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Blog",
      item: "https://nixiafabric.com/blog",
    },
  ],
};

const blogData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Nixia Fabric Blog",
  description: "Articles and guides about glitter fabric, foil fabric, and custom fabric development.",
  url: "https://nixiafabric.com/blog",
};
---

<Layout
  title="Blog — Fabric Knowledge & Manufacturing Guides"
  description="Articles and guides about glitter fabric, foil fabric, manufacturing processes, and custom fabric development. Learn about decorative fabrics from Nixia Fabric."
  keywords="glitter fabric guide, foil fabric guide, fabric manufacturing process, custom fabric development, fabric knowledge"
  structuredData={[breadcrumbData, blogData]}
>
  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__current">Blog</span>
      </nav>
    </div>
  </div>

  <!-- Blog Hero -->
  <section class="blog-hero">
    <div class="container">
      <span class="eyebrow">Knowledge Center</span>
      <h1>Fabric Knowledge & Guides</h1>
      <p class="blog-hero__desc">
        Learn about glitter fabric, foil fabric, manufacturing processes, and custom
        development. Practical guides for designers, sourcing managers, and fabric buyers.
      </p>
    </div>
  </section>

  <!-- Category Filter (visual only, non-functional in static) -->
  <section class="blog-categories">
    <div class="container">
      <div class="blog-categories__list">
        {categories.map((cat, i) => (
          <button
            class={`blog-category ${i === 0 ? "blog-category--active" : ""}`}
            type="button"
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Articles Grid -->
  <section class="section">
    <div class="container">
      <div class="articles-grid">
        {articles.map((article) => (
          <article class="article-card">
            <div class="article-card__image">
              <div class="article-card__pattern">
                {article.category === "Basics" && (
                  <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" /><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12.01" y2="17" />
                  </svg>
                )}
                {article.category === "Guide" && (
                  <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" /><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                  </svg>
                )}
                {article.category === "Manufacturing" && (
                  <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 20h20V8l-6 4V8l-6 4V4H2v16z" /><path d="M6 16h2M10 16h2M14 16h2" />
                  </svg>
                )}
              </div>
              <span class="badge badge--accent article-card__badge">{article.category}</span>
              <span class="article-card__status">Coming Soon</span>
            </div>
            <div class="article-card__body">
              <h2 class="article-card__title">{article.title}</h2>
              <p class="article-card__excerpt">{article.excerpt}</p>
              <div class="article-card__meta">
                <span class="article-card__date">{article.date}</span>
                <span class="article-card__dot">·</span>
                <span class="article-card__read">{article.readTime}</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Blog Notice -->
      <div class="blog-notice">
        <div class="blog-notice__icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10" /><line x1="12" y1="16" x2="12" y2="12" /><line x1="12" y1="8" x2="12.01" y2="8" />
          </svg>
        </div>
        <div class="blog-notice__content">
          <h3>Articles Coming Soon</h3>
          <p>
            We're preparing in-depth articles about glitter fabric, foil fabric, and custom
            development. These guides will help you make informed decisions about fabric
            selection and manufacturing. Subscribe or check back soon.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--dark">
    <div class="container text-center">
      <span class="eyebrow">Have Questions?</span>
      <h2>Talk to the Manufacturer</h2>
      <p style="max-width: 600px; margin: var(--space-lg) auto var(--space-2xl);">
        While our articles are being prepared, you can get answers directly from our
        production team. Contact us with your fabric questions or project requirements.
      </p>
      <div class="btn-group" style="justify-content: center;">
        <CTAButton href="/#contact" variant="primary" size="lg">Request Swatch</CTAButton>
        <CTAButton href="/#contact" variant="secondary" size="lg">Get Custom Quote</CTAButton>
      </div>
    </div>
  </section>
</Layout>

<style>
  .breadcrumb-bar {
    background-color: var(--color-bg-alt);
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb a:hover {
    color: var(--color-accent-dark);
  }

  .breadcrumb__sep {
    color: var(--color-text-light);
  }

  .breadcrumb__current {
    color: var(--color-primary);
    font-weight: 600;
  }

  /* Blog Hero */
  .blog-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    padding-block: var(--space-3xl) var(--space-4xl);
    position: relative;
    overflow: hidden;
  }

  .blog-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 50%, rgba(196, 160, 53, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 30%, rgba(42, 65, 112, 0.4) 0%, transparent 50%);
    pointer-events: none;
  }

  .blog-hero .container {
    position: relative;
    z-index: 1;
  }

  .blog-hero .eyebrow {
    color: var(--color-accent-light);
  }

  .blog-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .blog-hero__desc {
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-lg);
    max-width: 680px;
  }

  /* Categories */
  .blog-categories {
    padding-block: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
  }

  .blog-categories__list {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .blog-category {
    padding: 0.5rem 1.25rem;
    font-size: var(--text-sm);
    font-weight: 600;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background-color: var(--color-white);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .blog-category:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-dark);
  }

  .blog-category--active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-white);
  }

  /* Articles Grid */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }

  .article-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all var(--transition-base);
    position: relative;
  }

  .article-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
    border-color: var(--color-accent-light);
  }

  .article-card__image {
    aspect-ratio: 16 / 9;
    background: linear-gradient(135deg, var(--color-bg-alt) 0%, #e8eaf0 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .article-card__pattern {
    color: var(--color-border-dark);
    opacity: 0.6;
    transition: all var(--transition-base);
  }

  .article-card:hover .article-card__pattern {
    opacity: 1;
    transform: scale(1.1);
    color: var(--color-accent);
  }

  .article-card__badge {
    position: absolute;
    top: var(--space-md);
    left: var(--space-md);
  }

  .article-card__status {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    padding: 0.25rem 0.75rem;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: var(--radius-full);
    background-color: rgba(22, 41, 77, 0.8);
    color: var(--color-white);
  }

  .article-card__body {
    padding: var(--space-xl);
  }

  .article-card__title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-sm);
    line-height: 1.3;
  }

  .article-card__excerpt {
    font-size: var(--text-sm);
    line-height: 1.7;
    margin-bottom: var(--space-lg);
  }

  .article-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .article-card__dot {
    color: var(--color-text-light);
  }

  /* Blog Notice */
  .blog-notice {
    display: flex;
    align-items: flex-start;
    gap: var(--space-lg);
    margin-top: var(--space-3xl);
    padding: var(--space-xl) var(--space-2xl);
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    border-left: 4px solid var(--color-accent);
  }

  .blog-notice__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    background-color: var(--color-accent);
    color: var(--color-white);
    flex-shrink: 0;
  }

  .blog-notice__content h3 {
    font-size: var(--text-base);
    margin-bottom: var(--space-sm);
  }

  .blog-notice__content p {
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .blog-notice {
      flex-direction: column;
      padding: var(--space-lg);
    }
  }
</style>
