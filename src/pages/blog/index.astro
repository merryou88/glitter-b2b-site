---
/**
 * Blog Page — /blog
 * Buyer-focused knowledge center with static article detail pages.
 */
import Layout from "@layouts/Layout.astro";
import CTAButton from "@components/CTAButton.astro";
import { blogArticles } from "@data/blogArticles";

const formatDate = (value: string) =>
  new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }).format(
    new Date(`${value}T00:00:00`),
  );

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://nixiafabric.com/blog/" },
  ],
};

const blogData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Nixia Fabric Blog",
  description: "Practical guides for buyers sourcing foil, iridescent and stretch fabrics.",
  url: "https://nixiafabric.com/blog/",
};

const featuredArticle =
  blogArticles.find(
    (article) => article.slug === "how-to-choose-hot-stamping-spandex-fabric-for-dancewear-stage-costumes",
  ) ?? blogArticles[0];
const latestArticles = blogArticles.filter((article) => article.slug !== featuredArticle.slug);
const getArticlesBySlug = (slugs: string[]) =>
  slugs
    .map((slug) => blogArticles.find((article) => article.slug === slug))
    .filter(Boolean);

const guideGroups = [
  {
    label: "Fabric Selection",
    title: "Choose the right fabric route",
    copy: "Compare foil, holographic, iridescent and 4-way stretch options before sampling.",
    articles: getArticlesBySlug([
      "what-is-foil-fabric-wholesale-buyer-guide",
      "hot-stamping-foil-finish-guide",
      "holographic-fabric-for-dancewear-what-buyers-should-check",
      "iridescent-vs-metallic-fabric-for-stage-costumes",
      "how-to-choose-4-way-stretch-fabric-for-bodysuits",
    ]),
  },
  {
    label: "Applications",
    title: "Match fabric to performance garments",
    copy: "Use application guides for dancewear, cheerleading, bodysuits and stage costumes.",
    articles: getArticlesBySlug([
      "how-to-choose-hot-stamping-spandex-fabric-for-dancewear-stage-costumes",
      "best-fabric-for-cheerleading-and-performance-costumes",
      "holographic-fabric-for-dancewear-what-buyers-should-check",
    ]),
  },
  {
    label: "Sample & RFQ",
    title: "Prepare a clearer sample request or quote",
    copy: "Reduce back-and-forth with sample, MOQ, unit conversion and RFQ templates.",
    articles: getArticlesBySlug([
      "how-to-request-fabric-sample-from-china-supplier",
      "foil-fabric-rfq-template-us-buyers",
      "how-to-calculate-fabric-moq-yards-meters",
      "fabric-gsm-vs-ounces-buyer-conversion-guide",
    ]),
  },
  {
    label: "Testing & Compliance",
    title: "Control risk before bulk production",
    copy: "Confirm testing support, approved samples, inspection points and shipment readiness.",
    articles: getArticlesBySlug([
      "sgs-reach-compliance-guide",
      "what-to-include-in-a-custom-fabric-rfq",
    ]),
  },
];

const buyerQuestions = [
  {
    label: "Choose Fabric",
    title: "Which foil or stretch fabric fits my costume project?",
    copy: "Compare base fabric, surface effect, stretch and application before requesting samples.",
  },
  {
    label: "Test Before Bulk",
    title: "What should I check before production?",
    copy: "Review stretch recovery, sewing behavior, color approval and surface appearance under real lighting.",
  },
  {
    label: "Compliance",
    title: "What documents should I discuss with the factory?",
    copy: "Use compliance guides to prepare SGS, REACH or buyer-specific testing questions early.",
  },
  {
    label: "RFQ Prep",
    title: "What details make a fabric quote faster?",
    copy: "Send application, target color, quantity, sample needs, destination and timeline.",
  },
];
---

<Layout
  title="Fabric Buyer Guides | Nixia Fabric"
  description="Practical buyer guides about hot-stamping foil, iridescent stretch fabrics, compliance testing and material selection from Nixia Fabric."
  keywords="foil fabric guide, iridescent stretch fabric guide, SGS REACH fabric testing, fabric buyer guide, fabric manufacturer"
  structuredData={[breadcrumbData, blogData]}
>
  <section class="resource-hero">
    <div class="container resource-hero__inner">
      <div class="resource-hero__copy">
        <span class="eyebrow">Knowledge Center</span>
        <h1>Fabric Buyer Guides</h1>
        <p>
          Practical sourcing guidance for stage costume, dancewear and performance outfit buyers.
          Use each guide to narrow your material choice before requesting samples.
        </p>
      </div>
      <div class="resource-hero__actions">
        <span>{blogArticles.length} buyer guides</span>
        <CTAButton href="/sample-policy/" variant="primary" rfq>Get Sample</CTAButton>
      </div>
    </div>
  </section>

  <section class="section resource-main">
    <div class="container">
      <div class="resource-layout">
        <article class="featured-guide">
          <a href={`/blog/${featuredArticle.slug}/`} class="featured-guide__image" aria-label={`Read ${featuredArticle.title}`}>
            <picture>
              <source srcset={featuredArticle.imageWebp} type="image/webp" />
              <img src={featuredArticle.image} alt={featuredArticle.imageAlt} width="1600" height="900" />
            </picture>
          </a>
          <div class="featured-guide__body">
            <span class="eyebrow">Featured Buying Guide</span>
            <h2><a href={`/blog/${featuredArticle.slug}/`}>{featuredArticle.title}</a></h2>
            <p>{featuredArticle.excerpt}</p>
            <div class="guide-meta">
              <span>{featuredArticle.category}</span>
              <span aria-hidden="true">·</span>
              <span>{featuredArticle.readTime}</span>
              <span aria-hidden="true">·</span>
              <span>{featuredArticle.focusProducts.length} related products</span>
            </div>
            <CTAButton href={`/blog/${featuredArticle.slug}/`} variant="primary">Read Guide</CTAButton>
          </div>
        </article>

        <aside class="resource-panel">
          <span class="eyebrow">Need a Fast Recommendation?</span>
          <h2>Send your project details to the factory</h2>
          <p>
            Share your end product, target look, quantity and delivery date. We can recommend a
            practical material route before you commit to a bulk order.
          </p>
          <div class="resource-panel__actions">
            <CTAButton href="/contact/" variant="primary" rfq>Get a Quote</CTAButton>
            <CTAButton href="/products/" variant="outline">Compare Products</CTAButton>
          </div>
        </aside>
      </div>

      <section class="guide-groups" aria-labelledby="guide-groups-heading">
        <div class="section-heading">
          <span class="eyebrow">Resource Topics</span>
          <h2 id="guide-groups-heading">Browse guides by sourcing task</h2>
        </div>
        <div class="guide-group-grid">
          {guideGroups.map((group) => (
            <section class="guide-group">
              <span>{group.label}</span>
              <h3>{group.title}</h3>
              <p>{group.copy}</p>
              <ul>
                {group.articles.map((article) => (
                  <li>
                    <a href={`/blog/${article.slug}/`}>{article.title}</a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </section>

      {latestArticles.length > 0 && (
        <section class="latest-guides">
          <div class="section-heading">
            <span class="eyebrow">Latest Buyer Guides</span>
            <h2>Find the answer closest to your sourcing question</h2>
          </div>

          <div class="guide-list">
            {latestArticles.map((article) => (
              <article class="guide-row">
                <a href={`/blog/${article.slug}/`} class="guide-row__image" aria-label={`Read ${article.title}`}>
                  <picture>
                    <source srcset={article.imageWebp} type="image/webp" />
                    <img src={article.image} alt={article.imageAlt} loading="lazy" width="520" height="360" />
                  </picture>
                </a>
                <div class="guide-row__body">
                  <div class="guide-row__tags">
                    <span>{article.category}</span>
                    <span>{formatDate(article.date)}</span>
                    <span>{article.readTime}</span>
                  </div>
                  <h3><a href={`/blog/${article.slug}/`}>{article.title}</a></h3>
                  <p>{article.excerpt}</p>
                  <a href={`/blog/${article.slug}/`} class="text-link">Read buyer guide →</a>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      <section class="buyer-questions" aria-labelledby="buyer-questions-heading">
        <div class="section-heading">
          <span class="eyebrow">Browse by Buyer Question</span>
          <h2 id="buyer-questions-heading">Use the guides like a sourcing checklist</h2>
        </div>
        <div class="question-grid">
          {buyerQuestions.map((item) => (
            <div class="question-item">
              <span>{item.label}</span>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="resource-cta">
        <div>
          <span class="eyebrow">Factory Support</span>
          <h2>Need help choosing the right fabric?</h2>
          <p>
            Send your application, target color and estimated quantity. We will help you compare
            stock options, samples and custom development routes.
          </p>
        </div>
        <div class="resource-cta__actions">
          <CTAButton href="/sample-policy/" variant="primary" size="lg" rfq>Get Sample</CTAButton>
          <CTAButton href="/contact/" variant="secondary" size="lg" rfq>Get a Quote</CTAButton>
        </div>
      </section>
      </div>
  </section>
</Layout>

<style>
  .resource-hero {
    padding-block: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-alt);
  }

  .resource-hero__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xl);
  }

  .resource-hero__copy {
    max-width: 760px;
  }

  .resource-hero h1 {
    margin: var(--space-xs) 0 var(--space-sm);
  }

  .resource-hero p {
    max-width: 680px;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
  }

  .resource-hero__actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--space-md);
  }

  .resource-hero__actions span {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 700;
    white-space: nowrap;
  }

  .resource-main {
    background: var(--color-white);
  }

  .resource-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: var(--space-xl);
    align-items: stretch;
  }

  .featured-guide {
    display: grid;
    grid-template-columns: minmax(280px, 42%) minmax(0, 1fr);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
  }

  .featured-guide__image,
  .featured-guide__image picture {
    display: block;
    min-height: 100%;
  }

  .featured-guide__image img {
    width: 100%;
    height: 100%;
    min-height: 360px;
    object-fit: cover;
  }

  .featured-guide__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: var(--space-2xl);
  }

  .featured-guide__body h2 {
    margin: var(--space-sm) 0;
    font-size: var(--text-3xl);
    line-height: 1.18;
  }

  .featured-guide__body p {
    margin-bottom: var(--space-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .guide-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-lg);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .resource-panel {
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-white);
  }

  .resource-panel .eyebrow {
    color: var(--color-accent-light);
  }

  .resource-panel h2 {
    margin: var(--space-sm) 0;
    color: var(--color-white);
    font-size: var(--text-2xl);
  }

  .resource-panel p {
    margin-bottom: var(--space-xl);
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .resource-panel__actions,
  .resource-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .latest-guides,
  .guide-groups,
  .buyer-questions,
  .resource-cta {
    margin-top: var(--space-3xl);
  }

  .section-heading {
    max-width: 720px;
    margin-bottom: var(--space-xl);
  }

  .section-heading h2 {
    margin-top: var(--space-xs);
  }

  .guide-list {
    display: grid;
    gap: var(--space-md);
  }

  .guide-group-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .guide-group {
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-alt);
  }

  .guide-group > span {
    color: var(--color-accent-dark);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .guide-group h3 {
    margin: var(--space-sm) 0;
    font-size: var(--text-xl);
  }

  .guide-group p {
    margin-bottom: var(--space-lg);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .guide-group ul {
    display: grid;
    gap: var(--space-sm);
  }

  .guide-group li {
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .guide-group a {
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.35;
  }

  .guide-row {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: var(--space-lg);
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
  }

  .guide-row__image,
  .guide-row__image picture {
    display: block;
  }

  .guide-row__image img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: calc(var(--radius-md) - 2px);
    background: var(--color-bg-alt);
  }

  .guide-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .guide-row__body h3 {
    margin: var(--space-xs) 0;
    font-size: var(--text-xl);
  }

  .guide-row__body p {
    margin-bottom: var(--space-sm);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .question-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .question-item {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-alt);
  }

  .question-item span {
    color: var(--color-accent-dark);
    font-size: var(--text-xs);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .question-item h3 {
    margin: var(--space-sm) 0;
    font-size: var(--text-lg);
    line-height: 1.25;
  }

  .question-item p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .resource-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    padding: var(--space-2xl);
    border-radius: var(--radius-md);
    background: var(--color-primary);
    color: var(--color-white);
  }

  .resource-cta .eyebrow {
    color: var(--color-accent-light);
  }

  .resource-cta h2 {
    margin: var(--space-xs) 0;
    color: var(--color-white);
  }

  .resource-cta p {
    max-width: 680px;
    color: rgba(255, 255, 255, 0.78);
  }

  @media (max-width: 980px) {
    .resource-hero__inner,
    .resource-layout,
    .featured-guide,
    .resource-cta {
      grid-template-columns: 1fr;
      align-items: flex-start;
    }

    .resource-hero__inner,
    .resource-cta {
      flex-direction: column;
    }

    .question-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .guide-group-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .resource-hero__actions,
    .resource-panel__actions,
    .resource-cta__actions {
      align-items: stretch;
      width: 100%;
      flex-direction: column;
    }

    .featured-guide__body,
    .resource-panel,
    .resource-cta,
    .guide-row,
    .question-item {
      padding: var(--space-lg);
    }

    .featured-guide__image img {
      min-height: 240px;
    }

    .guide-row {
      grid-template-columns: 1fr;
    }

    .question-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
