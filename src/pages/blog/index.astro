---
/**
 * Blog Page — /blog
 * Buyer-focused knowledge center with static article detail pages.
 */
import Layout from "@layouts/Layout.astro";
import CTAButton from "@components/CTAButton.astro";
import { blogArticles, blogCategories } from "@data/blogArticles";

const formatDate = (value: string) =>
  new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric" }).format(
    new Date(`${value}T00:00:00`),
  );

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Blog", item: "https://nixiafabric.com/blog/" },
  ],
};

const blogData = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Nixia Fabric Blog",
  description: "Practical guides for buyers sourcing glitter, foil, iridescent and synthetic leather fabrics.",
  url: "https://nixiafabric.com/blog/",
};
---

<Layout
  title="Blog — Fabric Knowledge & Manufacturing Guides"
  description="Practical buyer guides about glitter fabric, hot-stamping foil, compliance testing and material selection from Nixia Fabric."
  keywords="glitter fabric guide, foil fabric guide, SGS REACH fabric testing, synthetic leather buyer guide, fabric manufacturer"
  structuredData={[breadcrumbData, blogData]}
>
  <div class="breadcrumb-bar">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__current">Blog</span>
      </nav>
    </div>
  </div>

  <section class="blog-hero">
    <div class="container blog-hero__inner">
      <div>
        <span class="eyebrow">Knowledge Center</span>
        <h1>Fabric Knowledge &amp; Guides</h1>
        <p class="blog-hero__desc">
          Practical sourcing guidance for footwear, handbag, fashion, swimwear, stage costume and
          decoration buyers. Use each guide to narrow your material choice before requesting samples.
        </p>
      </div>
      <div class="blog-hero__signal">
        <strong>{blogArticles.length}</strong>
        <span>buyer guides</span>
        <small>with product recommendations</small>
      </div>
    </div>
  </section>

  <section class="blog-categories" aria-label="Filter articles">
    <div class="container">
      <div class="blog-categories__list">
        {blogCategories.map((category, index) => (
          <button
            class:list={["blog-category", { "blog-category--active": index === 0 }]}
            type="button"
            data-blog-filter={category}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            {category}
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="articles-heading">
        <div>
          <span class="eyebrow">For Better Buying Decisions</span>
          <h2>Start with the question behind your order</h2>
        </div>
        <p id="article-count" aria-live="polite">Showing {blogArticles.length} guides</p>
      </div>

      <div class="articles-grid" id="articles-grid">
        {blogArticles.map((article) => (
          <article class="article-card" data-blog-category={article.category}>
            <a href={`/blog/${article.slug}/`} class="article-card__image-link" aria-label={`Read ${article.title}`}>
              <picture class="article-card__image">
                <source srcset={article.imageWebp} type="image/webp" />
                <img src={article.image} alt={article.imageAlt} loading="lazy" width="1600" height="900" />
              </picture>
            </a>
            <div class="article-card__body">
              <div class="article-card__tags">
                {article.tags.map((tag) => <span class="badge badge--accent">{tag}</span>)}
              </div>
              <span class="article-card__category">{article.category}</span>
              <h2 class="article-card__title">
                <a href={`/blog/${article.slug}/`}>{article.title}</a>
              </h2>
              <p class="article-card__excerpt">{article.excerpt}</p>
              <div class="article-card__meta">
                <span>{formatDate(article.date)}</span>
                <span aria-hidden="true">·</span>
                <span>{article.readTime}</span>
              </div>
              <div class="article-card__footer">
                <a href={`/blog/${article.slug}/`} class="article-card__read-link">
                  Read buyer guide <span aria-hidden="true">→</span>
                </a>
                <span>{article.focusProducts.length} product matches</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="blog-notice">
        <div class="blog-notice__icon" aria-hidden="true">NF</div>
        <div class="blog-notice__content">
          <span class="eyebrow">Need a faster answer?</span>
          <h3>Send your project details to the manufacturer</h3>
          <p>
            Share your end product, target look, quantity and delivery date. We can compare stock
            materials, sample routes and custom options before you commit to a bulk order.
          </p>
          <div class="blog-notice__actions">
            <CTAButton href="/products/" variant="outline">Compare Products</CTAButton>
            <CTAButton href="/contact/" variant="primary" rfq>Send Your Requirement</CTAButton>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container text-center">
      <span class="eyebrow">Factory Support</span>
      <h2>Turn a material question into a clear quotation</h2>
      <p class="blog-cta-copy">
        Tell us what you are making, how much you need and when you need it. We will help you
        choose a practical material route and arrange the next sample step.
      </p>
      <div class="btn-group" style="justify-content: center;">
        <CTAButton href="/sample-policy/" variant="primary" size="lg" rfq>Request Free Sample</CTAButton>
        <CTAButton href="/contact/" variant="secondary" size="lg" rfq>Get Custom Quotation</CTAButton>
      </div>
    </div>
  </section>
</Layout>

<script>
  const filterButtons = Array.from(document.querySelectorAll("[data-blog-filter]"));
  const cards = Array.from(document.querySelectorAll("[data-blog-category]"));
  const count = document.getElementById("article-count");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.getAttribute("data-blog-filter");
      let visible = 0;

      filterButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle("blog-category--active", active);
        item.setAttribute("aria-pressed", String(active));
      });

      cards.forEach((card) => {
        const matches = filter === "All" || card.getAttribute("data-blog-category") === filter;
        card.hidden = !matches;
        if (matches) visible += 1;
      });

      if (count) count.textContent = `Showing ${visible} ${visible === 1 ? "guide" : "guides"}`;
    });
  });
</script>

<style>
  .breadcrumb-bar {
    background: var(--color-bg-alt);
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb a:hover {
    color: var(--color-accent-dark);
  }

  .breadcrumb__sep {
    color: var(--color-text-light);
  }

  .breadcrumb__current {
    color: var(--color-primary);
    font-weight: 600;
  }

  .blog-hero {
    background: var(--color-primary);
    color: var(--color-white);
    padding-block: var(--space-3xl);
  }

  .blog-hero__inner {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-3xl);
  }

  .blog-hero .eyebrow {
    color: var(--color-accent-light);
  }

  .blog-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .blog-hero__desc {
    max-width: 700px;
    color: rgba(255, 255, 255, 0.78);
    font-size: var(--text-lg);
  }

  .blog-hero__signal {
    min-width: 190px;
    padding: var(--space-lg);
    border-left: 1px solid rgba(255, 255, 255, 0.25);
    display: grid;
    gap: 0.15rem;
  }

  .blog-hero__signal strong {
    color: var(--color-accent-light);
    font-size: var(--text-5xl);
    line-height: 1;
  }

  .blog-hero__signal span {
    font-weight: 700;
  }

  .blog-hero__signal small {
    color: rgba(255, 255, 255, 0.65);
  }

  .blog-categories {
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .blog-categories__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .blog-category {
    padding: 0.55rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    background: var(--color-white);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .blog-category:hover,
  .blog-category--active {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-white);
  }

  .articles-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }

  .articles-heading h2 {
    max-width: 620px;
    margin-top: var(--space-xs);
  }

  .articles-heading p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .article-card {
    overflow: hidden;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .article-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .article-card[hidden] {
    display: none;
  }

  .article-card__image-link,
  .article-card__image {
    display: block;
  }

  .article-card__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-bg-alt);
  }

  .article-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-card__body {
    padding: var(--space-xl);
  }

  .article-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-bottom: var(--space-md);
  }

  .article-card__category {
    display: block;
    margin-bottom: var(--space-sm);
    color: var(--color-accent-dark);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-card__title {
    margin-bottom: var(--space-sm);
    font-size: var(--text-2xl);
    line-height: 1.3;
  }

  .article-card__title a:hover,
  .article-card__read-link:hover {
    color: var(--color-accent-dark);
  }

  .article-card__excerpt {
    min-height: 5.2rem;
    margin-bottom: var(--space-lg);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  .article-card__meta,
  .article-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    font-size: var(--text-xs);
  }

  .article-card__meta {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .article-card__footer {
    margin-top: var(--space-lg);
    color: var(--color-text-light);
  }

  .article-card__read-link {
    color: var(--color-primary);
    font-weight: 700;
  }

  .blog-notice {
    display: flex;
    align-items: flex-start;
    gap: var(--space-lg);
    margin-top: var(--space-3xl);
    padding: var(--space-xl) var(--space-2xl);
    border-left: 4px solid var(--color-accent);
    background: var(--color-bg-alt);
  }

  .blog-notice__icon {
    display: grid;
    width: 48px;
    height: 48px;
    flex: 0 0 auto;
    place-items: center;
    background: var(--color-primary);
    color: var(--color-accent-light);
    font-weight: 800;
  }

  .blog-notice__content h3 {
    margin-bottom: var(--space-sm);
    font-size: var(--text-xl);
  }

  .blog-notice__content p {
    max-width: 780px;
    margin-bottom: var(--space-lg);
    font-size: var(--text-sm);
  }

  .blog-notice__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .blog-cta-copy {
    max-width: 650px;
    margin: var(--space-lg) auto var(--space-2xl);
  }

  @media (max-width: 768px) {
    .blog-hero__inner,
    .articles-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .blog-hero__signal {
      min-width: 0;
      padding: var(--space-md) 0 0;
      border-top: 1px solid rgba(255, 255, 255, 0.25);
      border-left: 0;
    }

    .articles-heading p {
      white-space: normal;
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .blog-notice {
      flex-direction: column;
      padding: var(--space-lg);
    }

    .article-card__body {
      padding: var(--space-lg);
    }
  }
</style>
