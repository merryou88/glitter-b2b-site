---
/**
 * Certifications Page — /certifications
 * SGS Certified, REACH Compliant — test reports available upon request
 * Supports PDF certificate preview/download
 */
import Layout from "@layouts/Layout.astro";
import CTAButton from "@components/CTAButton.astro";

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Certifications", item: "https://nixiafabric.com/certifications" },
  ],
};

const certifications = [
  {
    name: "SGS Test Report",
    standard: "SGS Certified",
    desc: "Independent third-party testing by SGS verifies that our Chunky Glitter Synthetic Leather and Foil-Printed Synthetic Leather meet international safety and quality standards for textile materials.",
    file: "/docs/sgs_test_report.pdf",
    icon: "shield",
  },
  {
    name: "REACH Compliance Report",
    standard: "REACH Compliant",
    desc: "EU REACH regulation compliance confirms that our synthetic leather products do not contain substances of very high concern (SVHC) above regulatory thresholds, safe for European market import.",
    file: "/docs/reach_compliance_report.pdf",
    icon: "document",
  },
];

const qualitySteps = [
  {
    title: "Raw Material Testing",
    desc: "Incoming raw materials tested for composition, purity, and consistency before production begins.",
  },
  {
    title: "In-Process Quality Control",
    desc: "Each production batch monitored for thickness, adhesion strength, color accuracy, and surface finish.",
  },
  {
    title: "Finished Product Testing",
    desc: "Final products undergo SGS and REACH compliance testing before shipment approval.",
  },
  {
    title: "Batch Traceability",
    desc: "Every shipment includes batch numbers for full traceability from raw material to delivery.",
  },
];
---

<Layout
  title="Certifications — SGS Certified, REACH Compliant | Nixia Fabric"
  description="Nixia Fabric synthetic leather products are SGS Certified and REACH Compliant. Test reports available upon request. Quality-controlled manufacturing from raw material to finished fabric."
  keywords="SGS Certified, REACH Compliant, fabric certification, synthetic leather test report, quality control, textile compliance"
  canonical="https://nixiafabric.com/certifications"
  structuredData={[breadcrumbData]}
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__current">Certifications</span>
      </nav>
      <span class="eyebrow">Quality Assurance</span>
      <h1>SGS Certified, REACH Compliant</h1>
      <p class="page-hero__desc">
        Every batch of Chunky Glitter Synthetic Leather and Foil-Printed Synthetic Leather
        is tested and certified to meet international textile safety standards.
        Test reports available upon request.
      </p>
    </div>
  </section>

  <!-- Certification Cards -->
  <section class="section">
    <div class="container">
      <div class="cert-grid">
        {certifications.map((cert) => (
          <div class="cert-card">
            <div class="cert-card__header">
              <div class="cert-card__icon">
                {cert.icon === "shield" && (
                  <svg width="32" height="32" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round">
                    <path d="M24 6L38 12V22C38 31 32 38 24 42C16 38 10 31 10 22V12L24 6Z" />
                    <path d="M18 24L22 28L30 20" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {cert.icon === "document" && (
                  <svg width="32" height="32" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round">
                    <path d="M12 6H28L38 16V42H12V6Z" />
                    <path d="M28 6V16H38" />
                    <path d="M18 26H30M18 32H30" stroke-linecap="round" />
                  </svg>
                )}
              </div>
              <span class="cert-card__badge">{cert.standard}</span>
            </div>
            <h2 class="cert-card__title">{cert.name}</h2>
            <p class="cert-card__desc">{cert.desc}</p>
            <div class="cert-card__actions">
              <a href={cert.file} download class="cert-card__download">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                  <polyline points="7 10 12 15 17 10" />
                  <line x1="12" y1="15" x2="12" y2="3" />
                </svg>
                Download Report
              </a>
              <a href={cert.file} target="_blank" rel="noopener" class="cert-card__preview">
                Preview
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Quality Control Process -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow">Quality Control</span>
        <h2>Documented Quality Control Process</h2>
        <p>From raw material to finished synthetic leather — every step is monitored and documented.</p>
      </div>
      <div class="qc-grid">
        {qualitySteps.map((step, i) => (
          <div class="qc-card">
            <span class="qc-card__number">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="qc-card__title">{step.title}</h3>
            <p class="qc-card__desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust Badges -->
  <section class="section">
    <div class="container">
      <div class="trust-badges-row">
        <div class="trust-badge">
          <span class="trust-badge__icon">SGS</span>
          <span class="trust-badge__label">SGS Certified</span>
        </div>
        <div class="trust-badge">
          <span class="trust-badge__icon">REACH</span>
          <span class="trust-badge__label">REACH Compliant</span>
        </div>
        <div class="trust-badge">
          <span class="trust-badge__icon">ISO</span>
          <span class="trust-badge__label">Quality Management</span>
        </div>
        <div class="trust-badge">
          <span class="trust-badge__icon">Factory</span>
          <span class="trust-badge__label">Factory Direct Supply</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--dark">
    <div class="container text-center">
      <span class="eyebrow">Need Test Reports?</span>
      <h2>Request Certification Documents</h2>
      <p style="max-width: 600px; margin: var(--space-lg) auto var(--space-2xl);">
        Full test reports and certification documents are available upon request.
        Contact us with your specific requirements.
      </p>
      <div class="btn-group" style="justify-content: center;">
        <CTAButton href="/contact" variant="primary" size="lg">Request Documents</CTAButton>
        <CTAButton href="/sample-policy" variant="secondary" size="lg">Request Free Sample</CTAButton>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    padding-block: var(--space-3xl) var(--space-4xl);
    position: relative;
    overflow: hidden;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 20% 50%, rgba(196, 160, 53, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 30%, rgba(42, 65, 112, 0.4) 0%, transparent 50%);
    pointer-events: none;
  }

  .page-hero .container {
    position: relative;
    z-index: 1;
  }

  .page-hero .breadcrumb {
    margin-bottom: var(--space-lg);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
  }

  .page-hero .breadcrumb a:hover {
    color: var(--color-accent-light);
  }

  .breadcrumb__sep {
    margin-inline: var(--space-xs);
    opacity: 0.5;
  }

  .breadcrumb__current {
    color: var(--color-white);
  }

  .page-hero .eyebrow {
    color: var(--color-accent-light);
  }

  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .page-hero__desc {
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-lg);
    max-width: 640px;
  }

  /* Section Header Centered */
  .section-header--center {
    text-align: center;
    margin-bottom: var(--space-3xl);
  }

  .section-header--center p {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    max-width: 640px;
    margin: var(--space-sm) auto 0;
  }

  /* Certification Cards */
  .cert-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
  }

  .cert-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    transition: all var(--transition-base);
  }

  .cert-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .cert-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-lg);
  }

  .cert-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background-color: rgba(196, 160, 53, 0.1);
    color: var(--color-accent-dark);
  }

  .cert-card__badge {
    padding: 0.375rem 0.875rem;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent-dark);
    background-color: rgba(196, 160, 53, 0.12);
    border: 1px solid rgba(196, 160, 53, 0.3);
    border-radius: var(--radius-full);
  }

  .cert-card__title {
    font-size: var(--text-xl);
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .cert-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
  }

  .cert-card__actions {
    display: flex;
    gap: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .cert-card__download {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent-dark);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .cert-card__download:hover {
    color: var(--color-accent);
  }

  .cert-card__preview {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .cert-card__preview:hover {
    color: var(--color-primary);
  }

  /* Quality Control Grid */
  .qc-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-xl);
  }

  .qc-card {
    padding: var(--space-xl);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .qc-card__number {
    display: inline-block;
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-accent);
    opacity: 0.4;
    margin-bottom: var(--space-sm);
  }

  .qc-card__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-xs);
  }

  .qc-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* Trust Badges */
  .trust-badges-row {
    display: flex;
    justify-content: center;
    gap: var(--space-2xl);
    flex-wrap: wrap;
  }

  .trust-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
  }

  .trust-badge__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    font-size: var(--text-sm);
    font-weight: 800;
    color: var(--color-accent-dark);
    background-color: rgba(196, 160, 53, 0.1);
    border: 2px solid rgba(196, 160, 53, 0.3);
    border-radius: 50%;
  }

  .trust-badge__label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  /* Responsive */
  @media (max-width: 968px) {
    .qc-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .cert-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .qc-grid {
      grid-template-columns: 1fr;
    }

    .trust-badges-row {
      gap: var(--space-lg);
    }
  }
</style>
