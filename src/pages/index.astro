---
/**
 * index.astro — Nixia Fabric Home Page
 * Solution-oriented narrative (inspired by ecowoodplate.com)
 *
 * Module order: Hero → Our Main Fabric Series → Applications →
 *               Why Choose Nixia Fabric → Our Factory → Factory Trust →
 *               FAQ → Final CTA
 */
import Layout from "@layouts/Layout.astro";
import HeroCarousel from "@components/HeroCarousel.astro";
import CTAButton from "@components/CTAButton.astro";

// WebPage structured data for SEO
const webPageData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Nixia Fabric - Glitter & Thermal Foil Gulelite Fabric | OEM ODM Manufacturer & Wholesale Supplier",
  description:
    "Custom low MOQ glitter and thermal foil gulelite fabric supplier for Southeast Asia and Middle East buyers. Free sample available, OEM ODM support, and fast quote response.",
  url: "https://nixiafabric.com",
};

// FAQPage structured data for rich snippets
const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Do you offer free samples?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, we provide free fabric samples. The buyer only covers international shipping cost. Contact us to request samples for your project.",
      },
    },
    {
      "@type": "Question",
      name: "Can I get custom colors and custom backing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. We offer Custom Color Matching including Pantone matching, and Custom Backing Options including elastic, PU, non-woven, and Oxford.",
      },
    },
    {
      "@type": "Question",
      name: "Are your fabrics SGS Certified and REACH Compliant?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Our fabrics are SGS Certified and REACH Compliant. Test reports are available upon request.",
      },
    },
    {
      "@type": "Question",
      name: "Is Nixia Fabric a manufacturer or a trading company?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Nixia Fabric is a manufacturer — not a trading company. We own our in-house factory for glitter and foil-printed PU materials, with stable partnerships with other qualified material manufacturers.",
      },
    },
    {
      "@type": "Question",
      name: "What products do you manufacture?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "We manufacture glitter synthetic leather and foil-printed PU materials for shoes, handbags, and accessories. Multiple backing options and custom colors available.",
      },
    },
    {
      "@type": "Question",
      name: "What is your minimum order quantity?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Our standard MOQ varies by product type and customization level. We also support sampling and trial orders for new projects — contact us with your requirements for detailed MOQ information.",
      },
    },
    {
      "@type": "Question",
      name: "Can you provide samples before bulk order?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, we provide free fabric samples so you can evaluate material quality, color and texture before placing a bulk order. The buyer only covers international shipping cost.",
      },
    },
    {
      "@type": "Question",
      name: "Can you customize colors and backing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. We offer full custom color matching including Pantone references, and multiple backing options including elastic, PU, non-woven, and Oxford cloth to meet your specific application needs.",
      },
    },
    {
      "@type": "Question",
      name: "Do you support international shipping?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, we support international shipping with FOB and CIF trade terms. We have experience exporting to global footwear, handbag and accessory manufacturers.",
      },
    },
    {
      "@type": "Question",
      name: "Are your materials SGS certified and REACH compliant?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. All our glitter and foil-printed synthetic leather materials are SGS Certified and REACH Compliant. Test reports are available upon request to support your quality assurance requirements.",
      },
    },
  ],
};

// Featured SKUs — 4 product cards
const featuredProducts = [
  {
    title: "Thermal Foil Bronzing Fabric",
    description:
      "High-shine bronzing surface, custom color matching, low MOQ.",
    image: "/images/products/metallic-foil-fabric/01.jpg",
    alt: "Thermal foil bronzing fabric with metallic finish",
    href: "/products",
    cta: "View Details",
  },
  {
    title: "Gulelite / Glitter Fabric",
    description:
      "Dense sparkle surface for shoes and bags, stable quality.",
    image: "/images/products/elastic-glitter-fabric/01.jpg",
    alt: "Glitter fabric sample with sparkling texture",
    href: "/products",
    cta: "View Details",
  },
  {
    title: "Gold Bronzing Fabric",
    description: "Premium gold finish for luxury trims and panels.",
    image: "/images/products/gold-foil-fabric/01.jpg",
    alt: "Gold thermal foil fabric sample",
    href: "/products",
    cta: "View Details",
  },
  {
    title: "Non-woven Glitter Fabric",
    description: "Lightweight option for decoration and packaging.",
    image: "/images/products/non-woven-glitter-fabric/01.jpg",
    alt: "Non-woven glitter fabric sample",
    href: "/products",
    cta: "View Details",
  },
];

// Applications — 4 end-use scenario cards
const applications = [
  {
    title: "Bags & Shoes",
    description: "Uppers, panels, and decorative trims",
    image: "/image/home/Shoes.png",
    alt: "Glitter fabric used for bags and shoes",
    href: "/products",
  },
  {
    title: "Garment & Costume",
    description: "Stagewear, trims, and costume accents",
    image: "/image/home/Handbags.png",
    alt: "Foil fabric used for garment and costume trims",
    href: "/products",
  },
  {
    title: "Decoration & Gift Packaging",
    description: "Boxes, gift wrap, and display pieces",
    image: "/image/home/Accessories.png",
    alt: "Glitter fabric used for decoration and packaging",
    href: "/products",
  },
  {
    title: "Bags & Shoes",
    description: "Panels, labels, and sample matching",
    image: "/image/home/Fashion.png",
    alt: "Foil fabric used for bags and shoes",
    href: "/products",
  },
];

// Value advantages — 5 short buyer-focused points
const whyChooseUs = [
  {
    title: "OEM & ODM",
    desc: "Custom pattern and color.",
    icon: "factory",
  },
  {
    title: "Low MOQ Support",
    desc: "Trial orders available.",
    icon: "palette",
  },
  {
    title: "Fast Sample Turnaround",
    desc: "Quick development and shipment.",
    icon: "shield",
  },
  {
    title: "Strict Inspection",
    desc: "Checked before shipment.",
    icon: "certificate",
  },
  {
    title: "Export Markets",
    desc: "Southeast Asia and Middle East.",
    icon: "box",
  },
];

// Our Factory entry — 3 trust entry cards
const factoryEntries = [
  {
    title: "Production Line",
    image: "/image/process/hot_stamping_foil_transfer.jpg",
    alt: "Foil-printed synthetic leather production line in factory",
    href: "/factory",
  },
  {
    title: "Quality Control",
    image: "/image/process/on_line_visual_inspection.jpg",
    alt: "QC inspection station for fabric quality control",
    href: "/factory",
  },
  {
    title: "Warehouse",
    image: "/image/process/final_packing.jpg",
    alt: "Finished goods warehouse with packed fabric rolls",
    href: "/factory",
  },
];

// Factory trust badges
const trustBadges = [
  { label: "Guangzhou Base" },
  { label: "Southeast Asia" },
  { label: "Middle East" },
  { label: "Factory Backed" },
];
---

<Layout
  title="Nixia Fabric - Glitter & Thermal Foil Gulelite Fabric | OEM ODM Manufacturer & Wholesale Supplier"
  description="Custom low MOQ glitter and thermal foil gulelite fabric supplier for Southeast Asia and Middle East buyers. Free sample available, custom colors, and OEM ODM support."
  keywords="glitter synthetic leather, foil-printed synthetic leather, synthetic leather manufacturer, China fabric factory, custom synthetic leather, OEM ODM fabric, SGS REACH compliant"
  structuredData={[webPageData, faqData]}
>
  <!-- ==================== HERO CAROUSEL ==================== -->
  <HeroCarousel />

  <!-- ==================== HERO TRUST BAR ==================== -->
  <section class="hero-trust" aria-label="Business advantages">
    <div class="container">
      <div class="hero-trust__grid">
        <div class="hero-trust__item">
          <span class="hero-trust__value">24h</span>
          <span class="hero-trust__label">RFQ Response</span>
        </div>
        <div class="hero-trust__item">
          <span class="hero-trust__value">Factory Direct</span>
          <span class="hero-trust__label">Own Production Capability</span>
        </div>
        <div class="hero-trust__item">
          <span class="hero-trust__value">SGS</span>
          <span class="hero-trust__label">Certified Materials</span>
        </div>
        <div class="hero-trust__item">
          <span class="hero-trust__value">OEM & ODM</span>
          <span class="hero-trust__label">Custom Solutions</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== OUR MAIN FABRIC SERIES ==================== -->
  <section class="section" id="main-fabric-series">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Featured SKUs</span>
        <h2>Core Materials for Fast Scanning</h2>
        <p>Four main SKUs, each with a clear use case and a direct path to the product list.</p>
      </div>

      <div class="grid grid--4 fabric-series-grid">
        {featuredProducts.map((item) => (
          <a href={item.href} class="fabric-card">
            <div class="fabric-card__visual">
              <img
                src={item.image}
                alt={item.alt}
                width="600"
                height="600"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="fabric-card__body">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <span class="fabric-card__cta">{item.cta}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== APPLICATIONS (4 scenario cards) ==================== -->
  <section class="section section--alt" id="applications">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Applications</span>
        <h2>Applications</h2>
        <p>Short labels for quick buyer scanning.</p>
      </div>

      <div class="grid grid--4 applications-grid">
        {applications.map((app) => (
          <a href={app.href} class="app-card">
            <div class="app-card__visual">
              <img
                src={app.image}
                alt={app.alt}
                width="1200"
                height="675"
                loading="lazy"
                decoding="async"
              />
              <div class="app-card__overlay">
                <span class="app-card__cta">View Fabrics →</span>
              </div>
            </div>
            <div class="app-card__body">
              <h3>{app.title}</h3>
              <p>{app.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== WHY CHOOSE NIXIA FABRIC ==================== -->
  <section class="section" id="why-choose-us">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Why Us</span>
        <h2>Buyer Advantages</h2>
        <p>Short, practical points for sourcing teams.</p>
      </div>

      <div class="grid advantage-grid">
        {whyChooseUs.map((item) => (
          <div class="advantage-card">
            <div class="advantage-card__icon">
              {item.icon === "factory" && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6 42V20L18 26V20L30 26V20L42 26V42H6Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <rect x="12" y="32" width="4" height="6" fill="currentColor"/>
                  <rect x="22" y="32" width="4" height="6" fill="currentColor"/>
                  <rect x="32" y="32" width="4" height="6" fill="currentColor"/>
                </svg>
              )}
              {item.icon === "palette" && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M24 6C13 6 6 13 6 22C6 31 13 38 22 38C24 38 26 36 26 34C26 33 25 32 25 31C25 29 26 28 28 28H32C37 28 42 25 42 20C42 12 34 6 24 6Z" stroke="currentColor" stroke-width="2.5"/>
                  <circle cx="15" cy="22" r="3" fill="currentColor"/>
                  <circle cx="22" cy="15" r="3" fill="currentColor"/>
                  <circle cx="31" cy="17" r="3" fill="currentColor"/>
                </svg>
              )}
              {item.icon === "shield" && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M24 6L38 12V22C38 31 32 38 24 42C16 38 10 31 10 22V12L24 6Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <path d="M18 24L22 28L30 20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
              {item.icon === "certificate" && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="24" cy="20" r="12" stroke="currentColor" stroke-width="2.5"/>
                  <path d="M18 30L16 42L24 38L32 42L30 30" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <path d="M20 20L23 23L28 17" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
              {item.icon === "box" && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M24 6L6 15V33L24 42L42 33V15L24 6Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <path d="M6 15L24 24L42 15" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <path d="M24 24V42" stroke="currentColor" stroke-width="2.5"/>
                </svg>
              )}
            </div>
            <h3 class="advantage-card__title">{item.title}</h3>
            <p class="advantage-card__desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== OUR FACTORY ENTRY ==================== -->
  <section class="section section--alt" id="factory-entry">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Our Factory</span>
        <h2>Our Factory</h2>
        <p>Factory-backed fabric supplier based in Guangzhou, serving Southeast Asia and the Middle East.</p>
      </div>

      <div class="grid grid--3 factory-entry-grid">
        {factoryEntries.map((entry) => (
          <a href={entry.href} class="factory-entry-card">
            <div class="factory-entry-card__visual">
              <img
                src={entry.image}
                alt={entry.alt}
                width="600"
                height="400"
                loading="lazy"
                decoding="async"
              />
              <div class="factory-entry-card__overlay">
                <span class="factory-entry-card__cta">Explore →</span>
              </div>
            </div>
            <div class="factory-entry-card__body">
              <h3>{entry.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== FACTORY TRUST ==================== -->
  <section class="section section--dark" id="factory-trust">
    <div class="container">
      <div class="trust-layout">
        <!-- Left: content -->
        <div class="trust-layout__left">
          <span class="eyebrow">Factory & Certification</span>
          <h2>Factory-backed fabric supplier based in Guangzhou</h2>
          <p>
            Built for Southeast Asia and Middle East sourcing teams. Stable supply, clear QC,
            and direct factory support for custom projects.
          </p>

          <div class="trust-badges">
            {trustBadges.map((badge) => (
              <div class="trust-badge">
                <svg class="trust-badge__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span class="trust-badge__label">{badge.label}</span>
              </div>
            ))}
          </div>

          <div class="trust-actions">
            <CTAButton href="/factory" variant="primary" size="lg">
              Explore Our Factory
            </CTAButton>
            <CTAButton href="/sample-policy" variant="secondary" size="lg">
              Request Samples
            </CTAButton>
          </div>
        </div>

        <!-- Right: factory image -->
        <div class="trust-layout__right">
          <div class="trust-image-grid">
            <img
              src="/image/process/hot_stamping_foil_transfer.jpg"
              alt="Factory workshop for thermal foil fabric production"
              loading="lazy"
            />
            <img
              src="/image/process/on_line_visual_inspection.jpg"
              alt="Quality inspection station for fabric production"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== INQUIRY ==================== -->
  <section class="section section--alt inquiry-section" id="inquiry">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="eyebrow">Inquiry</span>
        <h2>Need Custom Fabric or Free Sample? Get Your Quote Within 24h</h2>
      </div>

      <form class="inquiry-form" id="inquiry-form" novalidate>
        <div class="inquiry-grid">
          <input class="inquiry-input" name="name" type="text" placeholder="Name *" autocomplete="name" required />
          <input class="inquiry-input" name="company" type="text" placeholder="Company *" autocomplete="organization" required />
          <input class="inquiry-input" name="email" type="email" placeholder="Email *" autocomplete="email" required />
          <input class="inquiry-input" name="subject" type="text" value="Homepage inquiry" hidden />
        </div>
        <textarea class="inquiry-textarea" name="message" rows="4" placeholder="Your Requirement *" required></textarea>
        <div class="inquiry-actions">
          <button type="submit" class="btn btn--primary btn--lg inquiry-submit">Get Custom Quote</button>
          <a href="/sample-policy" class="btn btn--outline btn--lg inquiry-link">Free Sample</a>
        </div>
        <p class="inquiry-note">Low MOQ, custom color, and fast sample support.</p>
        <p class="inquiry-error" id="inquiry-error" hidden></p>
      </form>
    </div>
  </section>

  <!-- ==================== FAQ ==================== -->
  <section class="section" id="faq">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="eyebrow">FAQ</span>
        <h2>Frequently Asked Questions</h2>
      </div>

      <div class="faq-list">
        {faqData.mainEntity.map((item, idx) => (
          <details class="faq-item" open={idx === 0}>
            <summary class="faq-item__question">
              <span>{item.name}</span>
              <svg class="faq-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <div class="faq-item__answer">
              <p>{item.acceptedAnswer.text}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== FINAL CTA ==================== -->
  <section class="final-cta" id="final-cta">
    <div class="container">
      <div class="final-cta__inner">
        <span class="eyebrow final-cta__eyebrow">WORK WITH OUR FACTORY</span>
        <h2 class="final-cta__title">Need Custom Fabric or Free Sample? Get Your Quote Within 24h</h2>
        <p class="final-cta__text">Fast reply. Low MOQ. Custom color and pattern support.</p>
        <div class="final-cta__actions">
          <CTAButton href="/contact" variant="primary" size="lg">
            Get Custom Quote
          </CTAButton>
          <CTAButton href="/sample-policy" variant="secondary" size="lg">
            Free Sample
          </CTAButton>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ==================== Fabric Series ==================== */
  .fabric-series-grid {
    gap: var(--space-2xl);
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .fabric-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all var(--transition-base);
  }

  .fabric-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .fabric-card__visual {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .fabric-card__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .fabric-card:hover .fabric-card__visual img {
    transform: scale(1.04);
  }

  .fabric-card__body {
    padding: var(--space-xl);
  }

  .fabric-card__body h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-sm);
    color: var(--color-primary);
  }

  .fabric-card__body p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-md);
  }

  .fabric-card__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    padding: 0.6rem 1rem;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-white);
    background: var(--color-accent);
    border-radius: var(--radius-sm);
  }

  .fabric-card:hover .fabric-card__cta {
    background: var(--color-accent-dark);
  }

  /* ==================== Applications ==================== */
  .applications-grid {
    gap: var(--space-lg);
  }

  .app-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    transition: all var(--transition-base);
  }

  .app-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .app-card__visual {
    aspect-ratio: 16 / 9;
    position: relative;
    overflow: hidden;
  }

  .app-card__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .app-card:hover .app-card__visual img {
    transform: scale(1.05);
  }

  .app-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: var(--space-md);
    background: linear-gradient(to top, rgba(22, 41, 77, 0.7) 0%, transparent 50%);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .app-card:hover .app-card__overlay {
    opacity: 1;
  }

  .app-card__cta {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-white);
    background-color: var(--color-accent);
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-full);
  }

  .app-card__body {
    padding: var(--space-md) var(--space-lg);
    text-align: center;
  }

  .app-card__body h3 {
    font-size: var(--text-lg);
    margin-bottom: 0.25rem;
  }

  .app-card__body p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* ==================== Why Choose Us ==================== */
  .advantage-grid {
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-xl);
  }

  .advantage-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    text-align: center;
    transition: all var(--transition-base);
  }

  .advantage-card:hover {
    box-shadow: var(--shadow-lg);
    border-color: var(--color-accent-light);
    transform: translateY(-4px);
  }

  .advantage-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
