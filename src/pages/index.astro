---
/**
 * index.astro — Nixia Fabric Home Page
 * Solution-oriented narrative (inspired by ecowoodplate.com)
 *
 * Module order: Hero → Applications → Advantages → Featured Products →
 *               Factory Trust → FAQ → Final CTA
 */
import Layout from "@layouts/Layout.astro";
import HeroCarousel from "@components/HeroCarousel.astro";
import CTAButton from "@components/CTAButton.astro";

// WebPage structured data for SEO
const webPageData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Nixia Fabric — Glitter & Foil-Printed Synthetic Leather Manufacturer",
  description:
    "China manufacturer specializing in Chunky Glitter Synthetic Leather and Foil-Printed Synthetic Leather for shoes, handbags, and fashion accessories. Factory Direct Supply and Custom Color Matching.",
  url: "https://nixiafabric.com",
};

// FAQPage structured data for rich snippets
const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Do you offer free samples?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, we provide free fabric samples. The buyer only covers international shipping cost. Contact us to request samples for your project.",
      },
    },
    {
      "@type": "Question",
      name: "Can I get custom colors and custom backing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. We offer Custom Color Matching including Pantone matching, and Custom Backing Options including elastic, PU, non-woven, and Oxford.",
      },
    },
    {
      "@type": "Question",
      name: "Are your fabrics SGS Certified and REACH Compliant?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Our fabrics are SGS Certified and REACH Compliant. Test reports are available upon request.",
      },
    },
    {
      "@type": "Question",
      name: "Is Nixia Fabric a manufacturer or a trading company?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Nixia Fabric is a manufacturer — not a trading company. We own our in-house factory for glitter and foil-printed PU materials, with stable partnerships with other qualified material manufacturers.",
      },
    },
    {
      "@type": "Question",
      name: "What products do you manufacture?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "We manufacture glitter synthetic leather and foil-printed PU materials for shoes, handbags, and accessories. Multiple backing options and custom colors available.",
      },
    },
  ],
};

// ③ Applications — 4 scenario cards (clickable, link to end-use pages)
const applications = [
  {
    title: "Shoes",
    description: "Shoe uppers, trims, and decorative panels",
    image: "/image/home/Shoes.png",
    alt: "Chunky Glitter Synthetic Leather shoe upper with metallic foil accent",
    href: "/products/fabric-for-shoes",
  },
  {
    title: "Handbags",
    description: "Bag bodies, flaps, and accent panels",
    image: "/image/home/Handbags.png",
    alt: "Chunky Glitter Synthetic Leather handbag",
    href: "/products/fabric-for-handbags",
  },
  {
    title: "Accessories",
    description: "Belts, wallets, and small leather goods",
    image: "/image/home/Accessories.png",
    alt: "Chunky Glitter Synthetic Leather belt and wallet accessories",
    href: "/products/fabric-for-accessories",
  },
  {
    title: "Fashion",
    description: "Fashion trims and decorative accents",
    image: "/image/home/Fashion.png",
    alt: "Chunky Glitter Synthetic Leather fashion trims",
    href: "/products/fabric-for-fashion-trims",
  },
];

// ④ Advantages — 4 B2B benefit icons
const advantages = [
  {
    title: "Request Free Sample",
    desc: "Customer bears shipping cost",
    icon: "sample",
  },
  {
    title: "Custom Color & Backing",
    desc: "Pantone color-matching & multiple backing options",
    icon: "palette",
  },
  {
    title: "SGS Certified, REACH Compliant",
    desc: "Test reports available upon request",
    icon: "shield",
  },
  {
    title: "Factory Direct Supply",
    desc: "Original manufacturer, not a trading company",
    icon: "factory",
  },
];

// ⑤ Core collections preview — 2 cards only
const coreCollections = [
  {
    label: "Foil-Printed Synthetic Leather",
    title: "Foil-Printed Synthetic Leather",
    description:
      "Foil-printed synthetic leather delivers smooth metallic luster via thermal transfer. Multiple metallic tones available. Backing material can be customized per project requirements.",
    image: "/images/preview_hotstamping_foil.jpg",
    alt: "Foil-printed synthetic leather for footwear and bags",
    href: "/products/metallic-foil-fabric",
  },
  {
    label: "Chunky Glitter Synthetic Leather",
    title: "Chunky Glitter Synthetic Leather",
    description:
      "Sparkling glitter synthetic leather for shoes, bags and accessories. Customizable colors and backing options to match your end-product needs.",
    image: "/images/preview_chunky_glitter.jpg",
    alt: "Chunky glitter synthetic leather for shoes and handbags",
    href: "/products/elastic-glitter-fabric",
  },
];

// ⑥ Factory trust badges
const trustBadges = [
  { label: "SGS Certified" },
  { label: "REACH Compliant" },
  { label: "Factory Direct Supply" },
  { label: "Custom Color Matching" },
];
---

<Layout
  title=""
  description="Nixia Fabric is a China manufacturer specializing in Chunky Glitter Synthetic Leather and Foil-Printed Synthetic Leather for shoes, handbags, and fashion accessories. Factory Direct Supply and Custom Color Matching."
  keywords="chunky glitter synthetic leather, foil-printed synthetic leather, glitter fabric manufacturer, foil fabric manufacturer, fabric factory china, metallic fabric factory, Custom Color Matching, glitter fabric for shoes, foil fabric for handbags"
  structuredData={[webPageData, faqData]}
>
  <!-- ==================== ② HERO CAROUSEL ==================== -->
  <HeroCarousel />

  <!-- ==================== ②b HERO TRUST BAR ==================== -->
  <section class="hero-trust" aria-label="Business advantages">
    <div class="container">
      <div class="hero-trust__grid">
        <div class="hero-trust__item">
          <span class="hero-trust__value">24h</span>
          <span class="hero-trust__label">RFQ Response</span>
        </div>
        <div class="hero-trust__item">
          <span class="hero-trust__value">3-7d</span>
          <span class="hero-trust__label">Sample Plan</span>
        </div>
        <div class="hero-trust__item">
          <span class="hero-trust__value">Factory Direct</span>
          <span class="hero-trust__label">Custom Projects</span>
        </div>
        <div class="hero-trust__item">
          <span class="hero-trust__value">FOB/CIF</span>
          <span class="hero-trust__label">Export Support</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== ③ APPLICATIONS (4 scenario cards) ==================== -->
  <section class="section" id="applications">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Applications</span>
        <h2>Where Our Fabrics Are Used</h2>
        <p>From shoe uppers to handbag panels — see how our glitter and foil fabrics bring products to life.</p>
      </div>

      <div class="grid grid--4 applications-grid">
        {applications.map((app) => (
          <a href={app.href} class="app-card">
            <div class="app-card__visual">
              <img
                src={app.image}
                alt={app.alt}
                width="1200"
                height="675"
                loading="lazy"
                decoding="async"
              />
              <div class="app-card__overlay">
                <span class="app-card__cta">View Fabrics →</span>
              </div>
            </div>
            <div class="app-card__body">
              <h3>{app.title}</h3>
              <p>{app.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== ④ ADVANTAGES (4 B2B icons) ==================== -->
  <section class="section section--alt" id="advantages">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">WHY US</span>
        <h2>Your Reliable Manufacturing Partner</h2>
        <p>From raw material to finished synthetic leather — full-service textile manufacturing with documented quality control.</p>
      </div>

      <div class="grid grid--4 advantage-grid">
        {advantages.map((item) => (
          <div class="advantage-card">
            <div class="advantage-card__icon">
              {item.icon === "sample" && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M8 20L24 10L40 20V38C40 39.1 39.1 40 38 40H10C8.9 40 8 39.1 8 38V20Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <path d="M8 20H40" stroke="currentColor" stroke-width="2.5"/>
                  <path d="M18 40V28H30V40" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <path d="M24 10V6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                  <path d="M20 8C20 6.9 21.8 6 24 6C26.2 6 28 6.9 28 8" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                </svg>
              )}
              {item.icon === "palette" && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M24 6C13 6 6 13 6 22C6 31 13 38 22 38C24 38 26 36 26 34C26 33 25 32 25 31C25 29 26 28 28 28H32C37 28 42 25 42 20C42 12 34 6 24 6Z" stroke="currentColor" stroke-width="2.5"/>
                  <circle cx="15" cy="22" r="3" fill="currentColor"/>
                  <circle cx="22" cy="15" r="3" fill="currentColor"/>
                  <circle cx="31" cy="17" r="3" fill="currentColor"/>
                </svg>
              )}
              {item.icon === "shield" && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M24 6L38 12V22C38 31 32 38 24 42C16 38 10 31 10 22V12L24 6Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <path d="M18 24L22 28L30 20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
              {item.icon === "factory" && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6 42V20L18 26V20L30 26V20L42 26V42H6Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <rect x="12" y="32" width="4" height="6" fill="currentColor"/>
                  <rect x="22" y="32" width="4" height="6" fill="currentColor"/>
                  <rect x="32" y="32" width="4" height="6" fill="currentColor"/>
                </svg>
              )}
            </div>
            <h3 class="advantage-card__title">{item.title}</h3>
            <p class="advantage-card__desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== ⑤ CORE COLLECTIONS PREVIEW ==================== -->
  <section class="section" id="core-collections">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Product Preview</span>
        <h2>Core Collections</h2>
        <p>Explore our core synthetic-leather collections for footwear &amp; accessories.</p>
      </div>

      <div class="grid grid--2 collections-grid">
        {coreCollections.map((item) => (
          <a href={item.href} class="collection-card">
            <div class="collection-card__visual">
              <img
                src={item.image}
                alt={item.alt}
                width="800"
                height="800"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="collection-card__body">
              <span class="collection-card__badge">{item.label}</span>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <span class="collection-card__cta">Learn More →</span>
            </div>
          </a>
        ))}
      </div>

      <div class="featured-cta">
        <CTAButton href="/products" variant="dark" size="lg">
          Discover Fabrics
        </CTAButton>
      </div>
    </div>
  </section>

  <!-- ==================== ⑥ FACTORY TRUST ==================== -->
  <section class="section section--dark" id="factory-trust">
    <div class="container">
      <div class="trust-layout">
        <!-- Left: content -->
        <div class="trust-layout__left">
          <span class="eyebrow">Factory & Certification</span>
          <h2>Factory Direct, Quality Assured</h2>
          <p>
            Specialized in synthetic leather since 2013. With our own production facility
            and solid partnerships with qualified material factories, we deliver reliable
            glitter & foil-printed fabrics for global footwear and bag manufacturers.
          </p>

          <div class="trust-badges">
            {trustBadges.map((badge) => (
              <div class="trust-badge">
                <svg class="trust-badge__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span class="trust-badge__label">{badge.label}</span>
              </div>
            ))}
          </div>

          <div class="trust-actions">
            <CTAButton href="/factory" variant="primary" size="lg">
              Explore Our Factory
            </CTAButton>
            <CTAButton href="/sample-policy" variant="secondary" size="lg">
              Request Free Sample
            </CTAButton>
          </div>
        </div>

        <!-- Right: factory image -->
        <div class="trust-layout__right">
          <div class="trust-image">
            <img
              src="/image/home/slide3.png"
              alt="In-house quality control inspection at Nixia Fabric factory"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== ⑦ FAQ ==================== -->
  <section class="section" id="faq">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="eyebrow">FAQ</span>
        <h2>Frequently Asked Questions</h2>
      </div>

      <div class="faq-list">
        {faqData.mainEntity.map((item, idx) => (
          <details class="faq-item" open={idx === 0}>
            <summary class="faq-item__question">
              <span>{item.name}</span>
              <svg class="faq-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <div class="faq-item__answer">
              <p>{item.acceptedAnswer.text}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== ⑧ FINAL CTA ==================== -->
  <section class="final-cta" id="final-cta">
    <div class="container">
      <div class="final-cta__inner">
        <span class="eyebrow final-cta__eyebrow">Get Started</span>
        <h2 class="final-cta__title">
          Request Free Samples for Your Project
        </h2>
        <p class="final-cta__text">
          See and feel the quality before you commit. Free samples — you only
          cover shipping.
        </p>
        <div class="final-cta__actions">
          <CTAButton href="/sample-policy" variant="primary" size="lg">
            Request Free Sample
          </CTAButton>
          <CTAButton href="/contact" variant="secondary" size="lg">
            Get Custom Quotation
          </CTAButton>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ==================== Applications ==================== */
  .applications-grid {
    gap: var(--space-lg);
  }

  .app-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    transition: all var(--transition-base);
  }

  .app-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .app-card__visual {
    aspect-ratio: 16 / 9;
    position: relative;
    overflow: hidden;
  }

  .app-card__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .app-card:hover .app-card__visual img {
    transform: scale(1.05);
  }

  .app-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: var(--space-md);
    background: linear-gradient(to top, rgba(22, 41, 77, 0.7) 0%, transparent 50%);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .app-card:hover .app-card__overlay {
    opacity: 1;
  }

  .app-card__cta {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-white);
    background-color: var(--color-accent);
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-full);
  }

  .app-card__body {
    padding: var(--space-md) var(--space-lg);
    text-align: center;
  }

  .app-card__body h3 {
    font-size: var(--text-lg);
    margin-bottom: 0.25rem;
  }

  .app-card__body p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* ==================== Advantages ==================== */
  .advantage-grid {
    gap: var(--space-xl);
  }

  .advantage-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    text-align: center;
    transition: all var(--transition-base);
  }

  .advantage-card:hover {
    box-shadow: var(--shadow-lg);
    border-color: var(--color-accent-light);
    transform: translateY(-4px);
  }

  .advantage-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background-color: rgba(196, 160, 53, 0.1);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-md);
    color: var(--color-accent);
  }

  .advantage-card__icon svg {
    width: 32px;
    height: 32px;
  }

  .advantage-card__title {
    font-size: var(--text-base);
    font-weight: 700;
    margin-bottom: var(--space-xs);
    color: var(--color-primary);
  }

  .advantage-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* ==================== Core Collections ==================== */
  .collections-grid {
    gap: var(--space-2xl);
  }

  .collection-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all var(--transition-base);
  }

  .collection-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .collection-card__visual {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .collection-card__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .collection-card:hover .collection-card__visual img {
    transform: scale(1.04);
  }

  .collection-card__body {
    padding: var(--space-xl);
  }

  .collection-card__badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent);
    background-color: rgba(196, 160, 53, 0.08);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-sm);
  }

  .collection-card__body h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-sm);
    color: var(--color-primary);
  }

  .collection-card__body p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-md);
  }

  .collection-card__cta {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .collection-card:hover .collection-card__cta {
    text-decoration: underline;
  }

  .featured-cta {
    text-align: center;
    margin-top: var(--space-3xl);
  }

  /* ==================== Factory Trust ==================== */
  .trust-layout {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: var(--space-4xl);
    align-items: center;
  }

  .trust-layout__left h2 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .trust-layout__left > p {
    color: rgba(255, 255, 255, 0.7);
    font-size: var(--text-lg);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .trust-badge {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0.5rem 1rem;
    border: 1px solid rgba(196, 160, 53, 0.3);
    border-radius: var(--radius-full);
    background: rgba(196, 160, 53, 0.05);
  }

  .trust-badge__check {
    width: 16px;
    height: 16px;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .trust-badge__label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
  }

  .trust-actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .trust-layout__right {
    position: relative;
  }

  .trust-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    box-shadow: var(--shadow-xl);
  }

  .trust-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ==================== FAQ ==================== */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .faq-item {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--transition-base);
  }

  .faq-item[open] {
    border-color: var(--color-accent-light);
  }

  .faq-item__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding: var(--space-lg) var(--space-xl);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-primary);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-item__question::-webkit-details-marker {
    display: none;
  }

  .faq-item__icon {
    width: 20px;
    height: 20px;
    color: var(--color-accent);
    flex-shrink: 0;
    transition: transform var(--transition-base);
  }

  .faq-item[open] .faq-item__icon {
    transform: rotate(180deg);
  }

  .faq-item__answer {
    padding: 0 var(--space-xl) var(--space-lg);
  }

  .faq-item__answer p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  /* ==================== Final CTA ==================== */
  .final-cta {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    padding-block: var(--space-5xl);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .final-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 50%, rgba(196, 160, 53, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 50%, rgba(196, 160, 53, 0.06) 0%, transparent 50%);
