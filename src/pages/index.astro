---
/**
 * index.astro — Nixia Fabric Home Page
 * Solution-oriented narrative (inspired by ecowoodplate.com)
 *
 * Module order: Hero → Our Main Fabric Series → Applications →
 *               Why Choose Nixia Fabric → Our Factory → Factory Trust →
 *               FAQ → Final CTA
 */
import Layout from "@layouts/Layout.astro";
import HeroCarousel from "@components/HeroCarousel.astro";
import CTAButton from "@components/CTAButton.astro";

// WebPage structured data for SEO
const webPageData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Nixia Fabric — Glitter & Foil-Printed Synthetic Leather Manufacturer",
  description:
    "China factory direct supplier of glitter and foil-printed synthetic leather for footwear, handbags and fashion accessories. OEM, custom colors and quality certification supported.",
  url: "https://nixiafabric.com",
};

// FAQPage structured data for rich snippets
const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Do you offer free samples?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, we provide free fabric samples. The buyer only covers international shipping cost. Contact us to request samples for your project.",
      },
    },
    {
      "@type": "Question",
      name: "Can I get custom colors and custom backing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. We offer Custom Color Matching including Pantone matching, and Custom Backing Options including elastic, PU, non-woven, and Oxford.",
      },
    },
    {
      "@type": "Question",
      name: "Are your fabrics SGS Certified and REACH Compliant?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Our fabrics are SGS Certified and REACH Compliant. Test reports are available upon request.",
      },
    },
    {
      "@type": "Question",
      name: "Is Nixia Fabric a manufacturer or a trading company?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Nixia Fabric is a manufacturer — not a trading company. We own our in-house factory for glitter and foil-printed PU materials, with stable partnerships with other qualified material manufacturers.",
      },
    },
    {
      "@type": "Question",
      name: "What products do you manufacture?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "We manufacture glitter synthetic leather and foil-printed PU materials for shoes, handbags, and accessories. Multiple backing options and custom colors available.",
      },
    },
    {
      "@type": "Question",
      name: "What is your minimum order quantity?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Our standard MOQ varies by product type and customization level. We also support sampling and trial orders for new projects — contact us with your requirements for detailed MOQ information.",
      },
    },
    {
      "@type": "Question",
      name: "Can you provide samples before bulk order?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, we provide free fabric samples so you can evaluate material quality, color and texture before placing a bulk order. The buyer only covers international shipping cost.",
      },
    },
    {
      "@type": "Question",
      name: "Can you customize colors and backing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. We offer full custom color matching including Pantone references, and multiple backing options including elastic, PU, non-woven, and Oxford cloth to meet your specific application needs.",
      },
    },
    {
      "@type": "Question",
      name: "Do you support international shipping?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, we support international shipping with FOB and CIF trade terms. We have experience exporting to global footwear, handbag and accessory manufacturers.",
      },
    },
    {
      "@type": "Question",
      name: "Are your materials SGS certified and REACH compliant?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. All our glitter and foil-printed synthetic leather materials are SGS Certified and REACH Compliant. Test reports are available upon request to support your quality assurance requirements.",
      },
    },
  ],
};

// Our Core Product Collections — 2 product cards
const fabricSeries = [
  {
    title: "Foil-Printed Synthetic Leather",
    description:
      "Custom foil-printed synthetic leather with various metallic finishes and multiple backing options.",
    image: "/images/preview_hotstamping_foil.jpg",
    alt: "Foil printed synthetic leather sample with metallic finish",
    href: "/products",
    cta: "Explore Foil-Printed Synthetic Leather",
  },
  {
    title: "Glitter Synthetic Leather",
    description:
      "Sparkle glitter coated synthetic leather for footwear, handbags and fashion accessories.",
    image: "/images/preview_chunky_glitter.jpg",
    alt: "Glitter synthetic leather material with sparkling texture",
    href: "/products",
    cta: "Explore Glitter Synthetic Leather",
  },
];

// Applications — 4 end-use scenario cards
const applications = [
  {
    title: "Footwear",
    description: "Shoe uppers, trims, and decorative panels",
    image: "/image/home/Shoes.png",
    alt: "Glitter synthetic leather used in footwear uppers",
    href: "/products",
  },
  {
    title: "Handbags & Purses",
    description: "Bag bodies, flaps, and accent panels",
    image: "/image/home/Handbags.png",
    alt: "Foil printed leather for handbags and purse panels",
    href: "/products",
  },
  {
    title: "Fashion Accessories",
    description: "Wallets, card holders, and belts",
    image: "/image/home/Accessories.png",
    alt: "Glitter synthetic leather used for wallets and belts",
    href: "/products",
  },
  {
    title: "Garment Trimming",
    description: "Fashion trims and decorative accents",
    image: "/image/home/Fashion.png",
    alt: "Foil printed synthetic leather for garment trimming and accents",
    href: "/products",
  },
];

// Why Global Buyers Choose Us — 5 B2B advantage items
const whyChooseUs = [
  {
    title: "Factory Direct Supply",
    desc: "Own production workshop with stable manufacturing capability.",
    icon: "factory",
  },
  {
    title: "Custom Fabric Solutions",
    desc: "Custom colors, patterns and backing options available.",
    icon: "palette",
  },
  {
    title: "Quality Inspection",
    desc: "Strict quality checking before shipment.",
    icon: "shield",
  },
  {
    title: "SGS & REACH Compliance",
    desc: "Materials meet international requirements.",
    icon: "certificate",
  },
  {
    title: "Flexible MOQ",
    desc: "Support sampling and trial orders for new projects.",
    icon: "box",
  },
];

// Our Factory entry — 3 trust entry cards
const factoryEntries = [
  {
    title: "Production Line",
    image: "/image/process/hot_stamping_foil_transfer.jpg",
    alt: "Foil-printed synthetic leather production line in factory",
    href: "/factory",
  },
  {
    title: "Quality Control",
    image: "/image/process/on_line_visual_inspection.jpg",
    alt: "QC inspection station for fabric quality control",
    href: "/factory",
  },
  {
    title: "Warehouse",
    image: "/image/process/final_packing.jpg",
    alt: "Finished goods warehouse with packed fabric rolls",
    href: "/factory",
  },
];

// Factory trust badges
const trustBadges = [
  { label: "SGS Certified" },
  { label: "REACH Compliant" },
  { label: "Factory Direct Supply" },
  { label: "Custom Color Matching" },
];
---

<Layout
  title="Glitter & Foil-Printed Synthetic Leather Manufacturer"
  description="China factory direct supplier of glitter and foil-printed synthetic leather for footwear, handbags and fashion accessories. OEM, custom colors and quality certification supported."
  keywords="glitter synthetic leather, foil-printed synthetic leather, synthetic leather manufacturer, China fabric factory, custom synthetic leather, OEM ODM fabric, SGS REACH compliant"
  structuredData={[webPageData, faqData]}
>
  <!-- ==================== HERO CAROUSEL ==================== -->
  <HeroCarousel />

  <!-- ==================== HERO TRUST BAR ==================== -->
  <section class="hero-trust" aria-label="Business advantages">
    <div class="container">
      <div class="hero-trust__grid">
        <div class="hero-trust__item">
          <span class="hero-trust__value">24h</span>
          <span class="hero-trust__label">RFQ Response</span>
        </div>
        <div class="hero-trust__item">
          <span class="hero-trust__value">Factory Direct</span>
          <span class="hero-trust__label">Own Production Capability</span>
        </div>
        <div class="hero-trust__item">
          <span class="hero-trust__value">SGS</span>
          <span class="hero-trust__label">Certified Materials</span>
        </div>
        <div class="hero-trust__item">
          <span class="hero-trust__value">OEM & ODM</span>
          <span class="hero-trust__label">Custom Solutions</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== OUR MAIN FABRIC SERIES ==================== -->
  <section class="section" id="main-fabric-series">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Our Products</span>
        <h2>Our Core Product Collections</h2>
        <p>Two core synthetic leather series for footwear, handbags and fashion accessories manufacturing.</p>
      </div>

      <div class="grid grid--2 fabric-series-grid">
        {fabricSeries.map((item) => (
          <a href={item.href} class="fabric-card">
            <div class="fabric-card__visual">
              <img
                src={item.image}
                alt={item.alt}
                width="800"
                height="800"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="fabric-card__body">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
              <span class="fabric-card__cta">{item.cta} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== APPLICATIONS (4 scenario cards) ==================== -->
  <section class="section section--alt" id="applications">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Applications</span>
        <h2>Applications</h2>
        <p>Materials designed for footwear, handbag and fashion accessory manufacturers.</p>
      </div>

      <div class="grid grid--4 applications-grid">
        {applications.map((app) => (
          <a href={app.href} class="app-card">
            <div class="app-card__visual">
              <img
                src={app.image}
                alt={app.alt}
                width="1200"
                height="675"
                loading="lazy"
                decoding="async"
              />
              <div class="app-card__overlay">
                <span class="app-card__cta">View Fabrics →</span>
              </div>
            </div>
            <div class="app-card__body">
              <h3>{app.title}</h3>
              <p>{app.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== WHY CHOOSE NIXIA FABRIC ==================== -->
  <section class="section" id="why-choose-us">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Why Us</span>
        <h2>Why Global Buyers Choose Us</h2>
        <p>Factory direct synthetic leather manufacturer with in-house production and quality assurance.</p>
      </div>

      <div class="grid advantage-grid">
        {whyChooseUs.map((item) => (
          <div class="advantage-card">
            <div class="advantage-card__icon">
              {item.icon === "factory" && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6 42V20L18 26V20L30 26V20L42 26V42H6Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <rect x="12" y="32" width="4" height="6" fill="currentColor"/>
                  <rect x="22" y="32" width="4" height="6" fill="currentColor"/>
                  <rect x="32" y="32" width="4" height="6" fill="currentColor"/>
                </svg>
              )}
              {item.icon === "palette" && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M24 6C13 6 6 13 6 22C6 31 13 38 22 38C24 38 26 36 26 34C26 33 25 32 25 31C25 29 26 28 28 28H32C37 28 42 25 42 20C42 12 34 6 24 6Z" stroke="currentColor" stroke-width="2.5"/>
                  <circle cx="15" cy="22" r="3" fill="currentColor"/>
                  <circle cx="22" cy="15" r="3" fill="currentColor"/>
                  <circle cx="31" cy="17" r="3" fill="currentColor"/>
                </svg>
              )}
              {item.icon === "shield" && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M24 6L38 12V22C38 31 32 38 24 42C16 38 10 31 10 22V12L24 6Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <path d="M18 24L22 28L30 20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
              {item.icon === "certificate" && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="24" cy="20" r="12" stroke="currentColor" stroke-width="2.5"/>
                  <path d="M18 30L16 42L24 38L32 42L30 30" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <path d="M20 20L23 23L28 17" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
              {item.icon === "box" && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M24 6L6 15V33L24 42L42 33V15L24 6Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <path d="M6 15L24 24L42 15" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <path d="M24 24V42" stroke="currentColor" stroke-width="2.5"/>
                </svg>
              )}
            </div>
            <h3 class="advantage-card__title">{item.title}</h3>
            <p class="advantage-card__desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== OUR FACTORY ENTRY ==================== -->
  <section class="section section--alt" id="factory-entry">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Our Factory</span>
        <h2>Our Factory</h2>
        <p>Own production capability, strict quality control and stable supply — see how we manufacture your synthetic leather.</p>
      </div>

      <div class="grid grid--3 factory-entry-grid">
        {factoryEntries.map((entry) => (
          <a href={entry.href} class="factory-entry-card">
            <div class="factory-entry-card__visual">
              <img
                src={entry.image}
                alt={entry.alt}
                width="600"
                height="400"
                loading="lazy"
                decoding="async"
              />
              <div class="factory-entry-card__overlay">
                <span class="factory-entry-card__cta">Explore →</span>
              </div>
            </div>
            <div class="factory-entry-card__body">
              <h3>{entry.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== FACTORY TRUST ==================== -->
  <section class="section section--dark" id="factory-trust">
    <div class="container">
      <div class="trust-layout">
        <!-- Left: content -->
        <div class="trust-layout__left">
          <span class="eyebrow">Factory & Certification</span>
          <h2>Factory Direct, Quality Assured</h2>
          <p>
            With our own production facility and experienced manufacturing partners, we provide
            reliable glitter and foil-printed synthetic leather solutions for global footwear
            and bag manufacturers.
          </p>

          <div class="trust-badges">
            {trustBadges.map((badge) => (
              <div class="trust-badge">
                <svg class="trust-badge__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12" />
                </svg>
                <span class="trust-badge__label">{badge.label}</span>
              </div>
            ))}
          </div>

          <div class="trust-actions">
            <CTAButton href="/factory" variant="primary" size="lg">
              Explore Our Factory
            </CTAButton>
            <CTAButton href="/sample-policy" variant="secondary" size="lg">
              Request Samples
            </CTAButton>
          </div>
        </div>

        <!-- Right: factory image -->
        <div class="trust-layout__right">
          <div class="trust-image">
            <img
              src="/image/home/slide3.png"
              alt="In-house quality control inspection at Nixia Fabric factory"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FAQ ==================== -->
  <section class="section" id="faq">
    <div class="container container--narrow">
      <div class="section-header">
        <span class="eyebrow">FAQ</span>
        <h2>Frequently Asked Questions</h2>
      </div>

      <div class="faq-list">
        {faqData.mainEntity.map((item, idx) => (
          <details class="faq-item" open={idx === 0}>
            <summary class="faq-item__question">
              <span>{item.name}</span>
              <svg class="faq-item__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <div class="faq-item__answer">
              <p>{item.acceptedAnswer.text}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== FINAL CTA ==================== -->
  <section class="final-cta" id="final-cta">
    <div class="container">
      <div class="final-cta__inner">
        <span class="eyebrow final-cta__eyebrow">WORK WITH OUR FACTORY</span>
        <h2 class="final-cta__title">
          Ready to Start Your Fabric Project?
        </h2>
        <p class="final-cta__text">
          Request samples or get a custom quotation for your fabric project.
        </p>
        <div class="final-cta__actions">
          <CTAButton href="/sample-policy" variant="primary" size="lg">
            Request Samples
          </CTAButton>
          <CTAButton href="/contact" variant="secondary" size="lg">
            Get Custom Quotation
          </CTAButton>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ==================== Fabric Series ==================== */
  .fabric-series-grid {
    gap: var(--space-2xl);
  }

  .fabric-card {
    display: block;
    text-decoration: none;
    color: inherit;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all var(--transition-base);
  }

  .fabric-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .fabric-card__visual {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .fabric-card__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .fabric-card:hover .fabric-card__visual img {
    transform: scale(1.04);
  }

  .fabric-card__body {
    padding: var(--space-xl);
  }

  .fabric-card__body h3 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-sm);
    color: var(--color-primary);
  }

  .fabric-card__body p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: var(--space-md);
  }

  .fabric-card__cta {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  .fabric-card:hover .fabric-card__cta {
    text-decoration: underline;
  }

  /* ==================== Applications ==================== */
  .applications-grid {
    gap: var(--space-lg);
  }

  .app-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    transition: all var(--transition-base);
  }

  .app-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .app-card__visual {
    aspect-ratio: 16 / 9;
    position: relative;
    overflow: hidden;
  }

  .app-card__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .app-card:hover .app-card__visual img {
    transform: scale(1.05);
  }

  .app-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: var(--space-md);
    background: linear-gradient(to top, rgba(22, 41, 77, 0.7) 0%, transparent 50%);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .app-card:hover .app-card__overlay {
    opacity: 1;
  }

  .app-card__cta {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-white);
    background-color: var(--color-accent);
    padding: 0.5rem 1.25rem;
    border-radius: var(--radius-full);
  }

  .app-card__body {
    padding: var(--space-md) var(--space-lg);
    text-align: center;
  }

  .app-card__body h3 {
    font-size: var(--text-lg);
    margin-bottom: 0.25rem;
  }

  .app-card__body p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* ==================== Why Choose Us ==================== */
  .advantage-grid {
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-xl);
  }

  .advantage-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    text-align: center;
    transition: all var(--transition-base);
  }

  .advantage-card:hover {
    box-shadow: var(--shadow-lg);
    border-color: var(--color-accent-light);
    transform: translateY(-4px);
  }

  .advantage-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background-color: rgba(196, 160, 53, 0.1);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-md);
    color: var(--color-accent);
  }

  .advantage-card__icon svg {
    width: 32px;
    height: 32px;
  }

  .advantage-card__title {
    font-size: var(--text-base);
    font-weight: 700;
    margin-bottom: var(--space-xs);
    color: var(--color-primary);
  }

  .advantage-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* ==================== Factory Entry ==================== */
  .factory-entry-grid {
    gap: var(--space-lg);
  }

  .factory-entry-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    transition: all var(--transition-base);
  }

  .factory-entry-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .factory-entry-card__visual {
    aspect-ratio: 3 / 2;
    position: relative;
    overflow: hidden;
  }

  .factory-entry-card__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .factory-entry-card:hover .factory-entry-card__visual img {
    transform: scale(1.05);
  }

  .factory-entry-card__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: var(--space-md);
    background: linear-gradient(to top, rgba(22, 41, 77, 0.7) 0%, transparent 50%);
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .factory-entry-card:hover .factory-entry-card__overlay {
    opacity: 1;
  }

  .factory-entry-card__cta {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-white);
    background-color: var(--color-accent);
    padding: 0.5rem 1.25rem;
