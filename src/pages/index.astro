---
/**
 * index.astro — Nixia Fabric Home Page
 * Solution-oriented narrative (inspired by ecowoodplate.com)
 *
 * Module order: Hero → Our Main Fabric Series → Applications →
 *               Why Choose Nixia Fabric → Our Factory → Factory Trust →
 *               Final CTA
 */
import Layout from "@layouts/Layout.astro";
import HeroCarousel from "@components/HeroCarousel.astro";
import CTAButton from "@components/CTAButton.astro";

// WebPage structured data for SEO
const webPageData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Nixia Fabric - Glitter & Thermal Foil Gulelite Fabric | OEM ODM Manufacturer & Wholesale Supplier",
  description:
    "Custom low MOQ glitter and thermal foil gulelite fabric supplier for Southeast Asia and Middle East buyers. Free sample available, OEM ODM support, and fast quote response.",
  url: "https://nixiafabric.com",
};

const toWebp = (src: string) => src.replace(/\.(png|jpe?g)$/i, ".webp");

const popularProducts = [
  {
    title: "Full‑Print Hot‑Stamping Spandex Milk‑Silk Fabric",
    description: "Stretchy 4‑way stretch, soft hand‑feel. Ideal for fashion garments, swimwear & stage performance costumes.",
    image: "/images/hot01.jpg",
    webp: "",
    alt: "Full‑Print Hot‑Stamping Spandex Milk‑Silk Fabric",
    href: "/products",
    moq: "MOQ 100m",
    badge: "In‑Stock Available",
  },
  {
    title: "Iridescent Laser Hot‑Stamping Stretch Ice‑Silk Fabric",
    description: "Elastic, gradient multi‑color finish. Great for stage costumes and backdrop decoration.",
    image: "/images/hot02.jpg",
    webp: "/images/hot02.webp",
    alt: "Iridescent Laser Hot‑Stamping Stretch Ice‑Silk Fabric",
    href: "/products",
    moq: "MOQ 100m",
    badge: "In‑Stock Available",
  },
  {
    title: "Non‑Woven Glitter Fabric",
    description: "Sparkling glitter surface, widely used for holiday decoration, stage props & performance costumes.",
    image: "/images/hot03.jpg",
    webp: "/images/hot03.webp",
    alt: "Non‑Woven Glitter Fabric",
    href: "/products",
    moq: "MOQ 200m",
    badge: "In‑Stock Available",
  },
  {
    title: "Iridescent Gradient Laser Hot‑Stamping Ice‑Silk Fabric",
    description: "Stretchy fabric with multi‑color iridescent finish, suitable for fashion apparel, stage costumes and backdrop decoration.",
    image: "/images/hot04.jpg",
    webp: "/images/hot04.webp",
    alt: "Iridescent Gradient Laser Hot‑Stamping Ice‑Silk Fabric",
    href: "/products",
    moq: "MOQ 100m",
    badge: "In‑Stock Available",
  },
  {
    title: "Plain Iridescent Laser Hot‑Stamping Spandex 4‑Way Stretch Fabric",
    description: "High 4‑way stretch performance, ideal for western‑style bodysuits, swimwear and fashionable stage garments.",
    image: "/images/hot05.jpg",
    webp: "",
    alt: "Plain Iridescent Laser Hot‑Stamping Spandex 4‑Way Stretch Fabric",
    href: "/products",
    moq: "MOQ 100m",
    badge: "In‑Stock Available",
  },
  {
    title: "Rainbow Gradient Glitter Synthetic Leather Fabric",
    description: "Reflective glitter finish, widely applied for bags, footwear and book‑covering materials.",
    image: "/images/hot06.jpg",
    webp: "/images/hot06.webp",
    alt: "Rainbow Gradient Glitter Synthetic Leather Fabric",
    href: "/products",
    moq: "MOQ 200m",
    badge: "3‑7 Days Lead Time",
  },
];

// Applications — 4 end-use scenario cards
const applications = [
  {
    title: "Fabrics for Bags & Shoes",
    description: "Uppers, clutches, hair-accessories & fashion trims.",
    image: "/shots/application-shoes-glitter-fabric.jpg",
    alt: "Foil fabric used in footwear",
    href: "/products",
  },
  {
    title: "Fabrics for Stage & Costume",
    description: "Stagewear, dance costumes, cosplay and carnival performance outfits.",
    image: "/shots/application-handbags-glitter-fabric.jpg",
    alt: "Foil fabric used in handbags and purses",
    href: "/products",
  },
  {
    title: "Fabrics for Night-Club & KTV Upholstery",
    description: "KTV booth & nightclub wall soft-pack interior decoration. Fire-retardant optional.",
    image: "/shots/application-accessories-glitter-fabric.jpg",
    alt: "Foil fabric used in fashion accessories",
    href: "/products",
  },
  {
    title: "Fabrics for Toys, Crafts & Festive Decor",
    description: "Toy covers, DIY craft materials, party backdrop & Christmas decorative projects.",
    image: "/shots/application-fashion-trim-glitter-fabric.jpg",
    alt: "Foil fabric used in garment trimming",
    href: "/products",
  },
];

const whyNixiaBenefits = [
  {
    title: "Flexible MOQ",
    desc: "Start small. Flexible MOQ for fabric trial orders and mass-production runs.",
    icon: "boxes",
  },
  {
    title: "Fast Sampling",
    desc: "Fabric samples ready within 3-7 working days.",
    icon: "swatch",
  },
  {
    title: "Compliance Support",
    desc: "SGS, fire-retardant reports or buyer-specific test documents can be arranged by project.",
    icon: "certificate",
  },
  {
    title: "Global Shipping",
    desc: "FOB, CIF or buyer-forwarder handover can be arranged per order.",
    icon: "shipping",
  },
];

const workflowA = [
  { title: "Inquiry &amp; Check Stock", icon: "message", tone: "slate" },
  { title: "Confirm Unit Price", icon: "warehouse", tone: "slate" },
  { title: "Request Stock Sample", icon: "swatch", tone: "gold" },
  { title: "Approve Fabric", icon: "invoice", tone: "olive" },
  { title: "Place Bulk Order", icon: "package", tone: "gold" },
  { title: "Production &amp; Delivery", icon: "truck", tone: "slate" },
];

const workflowB = [
  { title: "Inquiry &amp; Requirement", icon: "message", tone: "slate" },
  { title: "Formal Quotation", icon: "invoice", tone: "slate" },
  { title: "Prototype Sampling", icon: "sample", tone: "gold" },
  { title: "Buyer Sample Confirmation", icon: "sample", tone: "warm" },
  { title: "Pre-Production Sample", icon: "package", tone: "mist" },
  { title: "Mass Production", icon: "machine", tone: "gold" },
  { title: "Final Inspection &amp; Shipment", icon: "truck", tone: "slate" },
];

const workflowStepLabel = (index: number) => `STEP ${String(index + 1).padStart(2, "0")}`;

const renderWorkflowIcon = (type: string) => {
  switch (type) {
    case "warehouse":
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16" /><path d="M5 20V9l7-4 7 4v11" /><path d="M9 20v-7h6v7" /><path d="M8 12h8" /></svg>`;
    case "swatch":
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 5h8l4 4-7 10H6L4 9z" /><path d="M8 9h5" /><path d="M9 12h3" /></svg>`;
    case "invoice":
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4h10v16l-2-1.5-2 1.5-2-1.5-2 1.5-2-1.5-2 1.5z" /><path d="M9 8h6" /><path d="M9 12h6" /></svg>`;
    case "sample":
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7h14v10H5z" /><path d="M9 7v10" /><path d="M5 11h14" /><path d="M9 11c1.2-1 2.8-1 4 0" /></svg>`;
    case "package":
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7l8-4 8 4-8 4-8-4z" /><path d="M4 7v10l8 4 8-4V7" /><path d="M12 11v10" /></svg>`;
    case "machine":
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14v8H5z" /><path d="M9 8V5h6v3" /><path d="M8 16v3" /><path d="M16 16v3" /><path d="M9 12h6" /></svg>`;
    case "truck":
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h12v9H3z" /><path d="M15 10h4l2 3v3h-6z" /><circle cx="8" cy="18" r="1.5" /><circle cx="18" cy="18" r="1.5" /></svg>`;
    case "message":
    default:
      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v10H8l-4 4z" /><path d="M7 9h10" /><path d="M7 12h6" /></svg>`;
  }
};

const workflowToneClass = (tone: string) => `workflow-step__icon--${tone}`;

const WORKER_URL = (import.meta.env.WORKER_URL ?? "").replace(/\/$/, "");
const RFQ_ENDPOINT = WORKER_URL ? `${WORKER_URL}/api/rfq` : "https://nixia-fabric-inquiry.sales-8db.workers.dev/api/rfq";
const TURNSTILE_SITE_KEY = import.meta.env.TURNSTILE_SITE_KEY ?? "";

// homepage section data continues below
---

<Layout
  title="Nixia Fabric - Glitter & Thermal Foil Gulelite Fabric | OEM ODM Manufacturer & Wholesale Supplier"
  description="Custom low MOQ glitter and thermal foil gulelite fabric supplier for Southeast Asia and Middle East buyers. Free sample available, custom colors, and OEM ODM support."
  keywords="glitter synthetic leather, foil-printed synthetic leather, synthetic leather manufacturer, China fabric factory, custom synthetic leather, OEM ODM fabric, SGS REACH compliant"
  structuredData={[webPageData]}
>
  <!-- ==================== HERO CAROUSEL ==================== -->
  <HeroCarousel />

  <!-- ==================== HERO TRUST BAR ==================== -->
  <section class="hero-trust" aria-label="Business advantages">
    <div class="container">
      <div class="hero-trust__grid">
        <div class="hero-trust__item">
          <span class="hero-trust__value">24h</span>
          <span class="hero-trust__label">RFQ Response</span>
        </div>
        <div class="hero-trust__item">
          <span class="hero-trust__value">Factory Direct</span>
          <span class="hero-trust__label">Own Production Capability</span>
        </div>
        <div class="hero-trust__item">
          <span class="hero-trust__value">SGS</span>
          <span class="hero-trust__label">Certified Materials</span>
        </div>
        <div class="hero-trust__item">
          <span class="hero-trust__value">OEM & ODM</span>
          <span class="hero-trust__label">Custom Solutions</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== OUR MAIN FABRIC SERIES ==================== -->
  <section class="section" id="main-fabric-series">
    <div class="container">
      <div class="section-header section-header--row">
        <div>
          <span class="eyebrow">HOT SELLING</span>
          <h2>Popular Products</h2>
          <p>Premium fabrics for fashion, swimwear, stage costumes, footwear &amp; bags. OEM &amp; ODM available, sample service offered.</p>
        </div>
        <a href="/products" class="view-all-link">View All →</a>
      </div>

      <div class="grid fabric-series-grid">
          {popularProducts.map((item) => (
            <a href={item.href} class="fabric-card fabric-card--split">
              <div class="fabric-card__visual">
                <picture>
                  {item.webp && <source srcset={item.webp} type="image/webp" />}
                  <img src={item.image} alt={item.alt} width="1200" height="675" loading="lazy" decoding="async" />
                </picture>
              </div>
              <div class="fabric-card__body">
                <span class="fabric-card__tag fabric-card__tag--inline">BUYER PICK</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <div class="fabric-card__meta">
                  <span>{item.moq}</span>
                  <span>{item.badge}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
    </div>
  </section>

  <!-- ==================== APPLICATIONS (4 scenario cards) ==================== -->
  <section class="section section--alt" id="applications">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">WHAT WE MAKE</span>
        <h2>Product Series</h2>
        <p>Factory-direct wholesale glitter &amp; hot-stamping foil fabrics for importers, distributors and bulk-order buyers.</p>
      </div>

        <div class="grid grid--4 applications-grid applications-grid--stacked">
          {applications.map((app) => (
            <a href={app.href} class="app-card app-card--split">
              <div class="app-card__visual">
                <picture>
                  <source srcset={toWebp(app.image)} type="image/webp" />
                  <img src={app.image} alt={app.alt} width="1200" height="675" loading="lazy" decoding="async" />
                </picture>
                <div class="app-card__overlay">
                  <span class="app-card__cta">View Fabrics →</span>
                </div>
              </div>
            <div class="app-card__body">
              <h3>{app.title}</h3>
              <p>{app.description}</p>
              <span class="app-card__link">View Products ›</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== WHY NIXIA ==================== -->
  <section class="section" id="why-nixia">
    <div class="container">
      <div class="why-nixia-split">
        <div class="why-nixia-copy">
          <span class="eyebrow">WHY NIXIA</span>
          <h2>Your Reliable Fabric Manufacturing Partner</h2>
          <p>From raw base fabric to finished glitter &amp; hot-stamping material — full-service manufacturing with documented quality control.</p>

          <div class="why-nixia-trust" aria-label="Company trust data">
            <span><strong>Est. 2013</strong></span>
            <span aria-hidden="true">|</span>
            <span><strong>Exporting to 10+ Countries</strong></span>
            <span aria-hidden="true">|</span>
            <span><strong>500+ Rolls</strong> Monthly Capacity</span>
          </div>

          <div class="why-nixia-advantages" aria-label="Core advantages">
            {whyNixiaBenefits.map((item) => (
              <div class="why-nixia-advantage">
                <div class="why-nixia-advantage__icon" aria-hidden="true">
                  {item.icon === "boxes" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 8l8-4 8 4-8 4-8-4z" />
                      <path d="M4 8v8l8 4 8-4V8" />
                      <path d="M12 12v8" />
                    </svg>
                  )}
                  {item.icon === "swatch" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6 5h10l2 5-6 9H8L6 5z" />
                      <path d="M8 9h6" />
                      <path d="M9 12h4" />
                    </svg>
                  )}
                  {item.icon === "certificate" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 4h10v14H7z" />
                      <path d="M9 8h6" />
                      <path d="M9 12h4" />
                      <path d="M14 15l2 4-2-1-2 1 2-4z" />
                    </svg>
                  )}
                  {item.icon === "shipping" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 15h11l2-5H7L5 7H3z" />
                      <path d="M14 15h5l-1-4h-4z" />
                      <circle cx="8" cy="18" r="1.2" />
                      <circle cx="17" cy="18" r="1.2" />
                    </svg>
                  )}
                </div>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="why-nixia-media">
          <picture>
            <source srcset={toWebp('/image/process/hot_stamping_foil_transfer.jpg')} type="image/webp" />
            <img src="/image/process/hot_stamping_foil_transfer.jpg" alt="Factory workshop for fabric manufacturing" width="1200" height="675" loading="lazy" decoding="async" />
          </picture>
          <div class="why-nixia-badges" aria-label="Factory badges">
            <span class="why-nixia-badge-chip">SGS Test Available</span>
            <span class="why-nixia-badge-chip">Verified Factory</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== MANUFACTURING CAPABILITIES ==================== -->
  <section class="section section--alt" id="manufacturing-capabilities">
    <div class="container">
      <div class="capabilities-shell">
        <div class="capabilities-shell__title">MANUFACTURING CAPABILITIES</div>

        <div class="capability-bar" aria-label="Manufacturing capabilities">
          <div class="capability-item">
            <span class="capability-item__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 8h7l1 3H5z" />
                <path d="M12 7h6l1 4h-6z" />
                <path d="M5 11v6h14v-6" />
                <path d="M9 15h6" />
                <path d="M9 18h4" />
              </svg>
            </span>
            <div>
              <h3>Custom Foil Stamping</h3>
              <p>Custom metallic foil patterns &amp; colors</p>
            </div>
          </div>

          <div class="capability-item">
            <span class="capability-item__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 16c1.5-5 3.5-8 6-8s4 3 8 8" />
                <path d="M7 13l2-3 2 4 2-5 2 6" />
                <path d="M4 19h16" />
              </svg>
            </span>
            <div>
              <h3>Glitter Coating</h3>
              <p>Fine-particle glitter surface treatment</p>
            </div>
          </div>

          <div class="capability-item">
            <span class="capability-item__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 7h7l4 4v6H4z" />
                <path d="M11 7v4h4" />
                <path d="M7 14c2-2 5-3 8-4" />
                <path d="M15 10l2 1.5" />
              </svg>
            </span>
            <div>
              <h3>Custom Design</h3>
              <p>Custom pattern, color and base fabric selection</p>
            </div>
          </div>

          <div class="capability-item">
            <span class="capability-item__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 7h12" />
                <path d="M7 7l2 10h6l2-10" />
                <path d="M9 11h6" />
                <path d="M10 15h4" />
              </svg>
            </span>
            <div>
              <h3>Surface Finishing</h3>
              <p>Anti-drop-powder &amp; wear-resistant treatment</p>
            </div>
          </div>

          <div class="capability-item">
            <span class="capability-item__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 9h8l2 3h6v4H4z" />
                <path d="M7 16h2" />
                <path d="M14 16h2" />
                <path d="M15 12h3" />
              </svg>
            </span>
            <div>
              <h3>Export-ready Packaging</h3>
              <p>Roll packing for sea-shipping</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== RFQ & BUYER RESOURCE ==================== -->
  <section class="section section--alt" id="rfq-buyer-resource">
    <div class="container">
      <div class="rfq-grid">
        <div class="rfq-card rfq-card--dark">
          <span class="rfq-card__eyebrow">FACTORY DIRECT WHOLESALE</span>
          <h2>Send RFQ for Custom Fabric Solutions</h2>
          <p class="rfq-card__desc">Tell us your fabric type, end-use, quantity, color & backing requirements. Our factory team will reply with sample info, MOQ and quotation within 24 hours.</p>

          <form class="rfq-inline-form" id="rfq-inline-form" novalidate>
            <div class="rfq-inline-form__row">
              <div class="rfq-inline-form__field">
                <label for="rfq-inline-name">Name *</label>
                <input type="text" id="rfq-inline-name" name="name" placeholder="Your name" autocomplete="name" required />
              </div>
              <div class="rfq-inline-form__field">
                <label for="rfq-inline-email">E-mail *</label>
                <input type="email" id="rfq-inline-email" name="email" placeholder="you@company.com" autocomplete="email" required />
              </div>
            </div>
            <div class="rfq-inline-form__field">
              <label for="rfq-inline-message">Message *</label>
              <textarea id="rfq-inline-message" name="message" rows="3" placeholder="Fabric type, end-use, quantity, color & backing requirements..." required></textarea>
            </div>
            <div class="rfq-inline-form__field rfq-inline-form__field--turnstile">
              <div class="rfq-inline-form__turnstile" id="rfq-inline-turnstile"></div>
            </div>
            <div class="rfq-inline-form__error" id="rfq-inline-error" role="alert" hidden></div>
            <button type="submit" class="btn btn--primary btn--lg rfq-inline-form__submit">
              <span class="rfq-inline-form__submit-text">Send</span>
              <span class="rfq-inline-form__spinner" hidden>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/></svg>
              </span>
            </button>
          </form>
        </div>

        <div class="rfq-card rfq-card--light">
          <span class="rfq-card__eyebrow rfq-card__eyebrow--warm">BUYER RESOURCE</span>
          <h2>Request Wholesale Fabric Catalog</h2>
          <p>Use the catalog request to receive product range suggestions, OEM/ODM options, MOQ guidance and recommended SKUs for your market.</p>

          <ul class="buyer-resource-list" aria-label="Buyer resources">
            <li>Full fabric product range</li>
            <li>Custom surface finish options</li>
            <li>MOQ and sample guidance</li>
            <li>Recommended SKUs by market</li>
          </ul>

          <a class="buyer-resource-button" href="/catalog.pdf" download>Download Catalog</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SOURCING WORKFLOW ==================== -->
  <section class="section" id="sourcing-workflow">
    <div class="container">
      <div class="section-header section-header--left section-header--compact">
        <span class="eyebrow">SAMPLE TO SHIPMENT</span>
        <h2>Two Sourcing Paths for Fabric Buyers</h2>
        <p>We support both ready-stock fabric and custom finished orders, with clear workflows for each.</p>
      </div>

      <div class="workflow-timelines">
        <article class="workflow-timeline">
          <div class="workflow-timeline__head">
