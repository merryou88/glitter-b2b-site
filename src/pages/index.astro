---
/**
 * index.astro — Nixia Fabric Home Page
 * Solution-oriented narrative (inspired by ecowoodplate.com)
 *
 * Module order: Hero → Our Main Fabric Series → Applications →
 *               Why Choose Nixia Fabric → Our Factory → Factory Trust →
 *               FAQ → Final CTA
 */
import Layout from "@layouts/Layout.astro";
import HeroCarousel from "@components/HeroCarousel.astro";
import CTAButton from "@components/CTAButton.astro";
import RFQQuoteModal from "@components/RFQQuoteModal.astro";

// WebPage structured data for SEO
const webPageData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Nixia Fabric - Glitter & Thermal Foil Gulelite Fabric | OEM ODM Manufacturer & Wholesale Supplier",
  description:
    "Custom low MOQ glitter and thermal foil gulelite fabric supplier for Southeast Asia and Middle East buyers. Free sample available, OEM ODM support, and fast quote response.",
  url: "https://nixiafabric.com",
};

// FAQPage structured data for rich snippets
const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Do you offer free samples?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, we provide free fabric samples. The buyer only covers international shipping cost. Contact us to request samples for your project.",
      },
    },
    {
      "@type": "Question",
      name: "Can I get custom colors and custom backing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. We offer Custom Color Matching including Pantone matching, and Custom Backing Options including elastic, PU, non-woven, and Oxford.",
      },
    },
    {
      "@type": "Question",
      name: "Are your fabrics SGS Certified and REACH Compliant?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. Our fabrics are SGS Certified and REACH Compliant. Test reports are available upon request.",
      },
    },
    {
      "@type": "Question",
      name: "Is Nixia Fabric a manufacturer or a trading company?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Nixia Fabric is a manufacturer — not a trading company. We own our in-house factory for glitter and foil-printed PU materials, with stable partnerships with other qualified material manufacturers.",
      },
    },
    {
      "@type": "Question",
      name: "What products do you manufacture?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "We specialize in two core series: **Chunky Glitter Synthetic Leather** and **Foil-Printed Synthetic Leather**.\nOur fabrics are widely used for shoes, handbags, hair accessories, toys, stage decoration and wedding-event decor.\nWe support custom colors, patterns and multiple backing material options for bulk orders.",
      },
    },
    {
      "@type": "Question",
      name: "What is your minimum order quantity?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Our standard MOQ varies by product type and customization level. We also support sampling and trial orders for new projects — contact us with your requirements for detailed MOQ information.",
      },
    },
    {
      "@type": "Question",
      name: "Can you provide samples before bulk order?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, we provide free fabric samples so you can evaluate material quality, color and texture before placing a bulk order. The buyer only covers international shipping cost.",
      },
    },
    {
      "@type": "Question",
      name: "Can you customize colors and backing?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. We offer full custom color matching including Pantone references, and multiple backing options including elastic, PU, non-woven, and Oxford cloth to meet your specific application needs.",
      },
    },
    {
      "@type": "Question",
      name: "Do you support international shipping?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, we support international shipping with FOB and CIF trade terms. We have experience exporting to global footwear, handbag and accessory manufacturers.",
      },
    },
    {
      "@type": "Question",
      name: "Are your materials SGS certified and REACH compliant?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. All our glitter and foil-printed synthetic leather materials are SGS Certified and REACH Compliant. Test reports are available upon request to support your quality assurance requirements.",
      },
    },
  ],
};

const hotStampingFoilProducts = [
  {
    title: "Metallic Foil-Printed Synthetic Leather",
    description: "Reflective surface for stage and party projects.",
    image: "/images/products/metallic-foil-fabric/01.jpg",
    alt: "Metallic Foil-Printed Synthetic Leather",
    href: "/products",
  },
  {
    title: "Gold Foil-Printed Synthetic Leather",
    description: "Premium gold finish with strong visual impact.",
    image: "/images/products/gold-foil-fabric/01.jpg",
    alt: "Gold Foil-Printed Synthetic Leather",
    href: "/products",
  },
  {
    title: "Silver Foil-Printed Synthetic Leather",
    description: "Bright silver surface for trims and decor.",
    image: "/images/products/silver-foil-fabric/01.jpg",
    alt: "Silver Foil-Printed Synthetic Leather",
    href: "/products",
  },
  {
    title: "Chunky Glitter + Foil-Printed Composite Fabric",
    description: "Composite surface for heavier decorative use.",
    image: "/images/products/oxford-glitter-fabric/01.jpg",
    alt: "Chunky Glitter + Foil-Printed Composite Fabric",
    href: "/products",
  },
];

const glitterProducts = [
  {
    title: "Elastic Chunky Glitter Synthetic Leather",
    description: "Stretchable glitter fabric for footwear and bags.",
    image: "/images/products/elastic-glitter-fabric/01.jpg",
    alt: "Elastic Chunky Glitter Synthetic Leather",
    href: "/products",
  },
  {
    title: "Elastic PU Chunky Glitter Synthetic Leather",
    description: "Durable PU base with bonded glitter finish.",
    image: "/images/products/pu-glitter-fabric/01.jpg",
    alt: "Elastic PU Chunky Glitter Synthetic Leather",
    href: "/products",
  },
  {
    title: "Non-woven Chunky Glitter Synthetic Leather",
    description: "Lightweight option for accessories and decor.",
    image: "/images/products/non-woven-glitter-fabric/01.jpg",
    alt: "Non-woven Chunky Glitter Synthetic Leather",
    href: "/products",
  },
  {
    title: "Chunky Glitter + Foil-Printed Composite Fabric",
    description: "Composite fabric with glitter and foil finish.",
    image: "/images/products/oxford-glitter-fabric/01.jpg",
    alt: "Chunky Glitter + Foil-Printed Composite Fabric",
    href: "/products",
  },
];

// Applications — 4 end-use scenario cards
const applications = [
  {
    title: "Fabrics for Bags & Shoes",
    description: "Uppers, clutches, hair-accessories & fashion trims.",
    image: "/image/home/Shoes.png",
    alt: "Foil fabric used in footwear",
    href: "/products",
  },
  {
    title: "Fabrics for Stage & Costume",
    description: "Stagewear, dance costumes, cosplay and carnival performance outfits.",
    image: "/image/home/Handbags.png",
    alt: "Foil fabric used in handbags and purses",
    href: "/products",
  },
  {
    title: "Fabrics for Night-Club & KTV Upholstery",
    description: "KTV booth & nightclub wall soft-pack interior decoration. Fire-retardant optional.",
    image: "/image/home/Accessories.png",
    alt: "Foil fabric used in fashion accessories",
    href: "/products",
  },
  {
    title: "Fabrics for Toys, Crafts & Festive Decor",
    description: "Toy covers, DIY craft materials, party backdrop & Christmas decorative projects.",
    image: "/image/home/Fashion.png",
    alt: "Foil fabric used in garment trimming",
    href: "/products",
  },
];

const whyNixiaBenefits = [
  {
    title: "Flexible MOQ",
    desc: "Start small. Flexible MOQ for fabric trial orders and mass-production runs.",
    icon: "boxes",
  },
  {
    title: "Fast Sampling",
    desc: "Fabric samples ready within 3-7 working days.",
    icon: "swatch",
  },
  {
    title: "Compliance Support",
    desc: "SGS, fire-retardant reports or buyer-specific test documents can be arranged by project.",
    icon: "certificate",
  },
  {
    title: "Global Shipping",
    desc: "FOB, CIF or buyer-forwarder handover can be arranged per order.",
    icon: "shipping",
  },
];

// homepage section data continues below
---

<Layout
  title="Nixia Fabric - Glitter & Thermal Foil Gulelite Fabric | OEM ODM Manufacturer & Wholesale Supplier"
  description="Custom low MOQ glitter and thermal foil gulelite fabric supplier for Southeast Asia and Middle East buyers. Free sample available, custom colors, and OEM ODM support."
  keywords="glitter synthetic leather, foil-printed synthetic leather, synthetic leather manufacturer, China fabric factory, custom synthetic leather, OEM ODM fabric, SGS REACH compliant"
  structuredData={[webPageData, faqData]}
>
  <!-- ==================== HERO CAROUSEL ==================== -->
  <HeroCarousel />

  <!-- ==================== HERO TRUST BAR ==================== -->
  <section class="hero-trust" aria-label="Business advantages">
    <div class="container">
      <div class="hero-trust__grid">
        <div class="hero-trust__item">
          <span class="hero-trust__value">24h</span>
          <span class="hero-trust__label">RFQ Response</span>
        </div>
        <div class="hero-trust__item">
          <span class="hero-trust__value">Factory Direct</span>
          <span class="hero-trust__label">Own Production Capability</span>
        </div>
        <div class="hero-trust__item">
          <span class="hero-trust__value">SGS</span>
          <span class="hero-trust__label">Certified Materials</span>
        </div>
        <div class="hero-trust__item">
          <span class="hero-trust__value">OEM & ODM</span>
          <span class="hero-trust__label">Custom Solutions</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== OUR MAIN FABRIC SERIES ==================== -->
  <section class="section" id="main-fabric-series">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">HOT SELLING</span>
        <h2>Popular Products</h2>
        <p>Bulk OEM &amp; ODM glitter and hot-stamping foil fabrics. Clear MOQ, sample support and export-ready packing.</p>
      </div>

      <div class="hot-products-group">
        <div class="hot-products-group__head">
          <h3>Hot-Stamping Foil Fabrics</h3>
          <a href="/products" class="hot-products-group__all">View All →</a>
        </div>
        <div class="grid grid--4 fabric-series-grid fabric-series-grid--hot">
          {hotStampingFoilProducts.map((item) => (
            <a href={item.href} class="fabric-card fabric-card--split">
              <div class="fabric-card__visual">
                <img src={item.image} alt={item.alt} width="600" height="600" loading="lazy" decoding="async" />
              </div>
              <div class="fabric-card__body">
                <span class="fabric-card__tag fabric-card__tag--inline">BUYER PICK</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <div class="fabric-card__meta">
                  <span>MOQ 200m</span>
                  <span>Lead time 15-20 days</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <div class="hot-products-group">
        <div class="hot-products-group__head">
          <h3>Glitter Fabrics</h3>
          <a href="/products" class="hot-products-group__all">View All →</a>
        </div>
        <div class="grid grid--4 fabric-series-grid fabric-series-grid--glitter">
          {glitterProducts.map((item) => (
            <a href={item.href} class="fabric-card fabric-card--split">
              <div class="fabric-card__visual">
                <img src={item.image} alt={item.alt} width="600" height="600" loading="lazy" decoding="async" />
              </div>
              <div class="fabric-card__body">
                <span class="fabric-card__tag fabric-card__tag--inline">BUYER PICK</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <div class="fabric-card__meta">
                  <span>MOQ 200m</span>
                  <span>Lead time 15-20 days</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== APPLICATIONS (4 scenario cards) ==================== -->
  <section class="section section--alt" id="applications">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">WHAT WE MAKE</span>
        <h2>Product Series</h2>
        <p>Factory-direct wholesale glitter &amp; hot-stamping foil fabrics for importers, distributors and bulk-order buyers.</p>
      </div>

      <div class="grid grid--4 applications-grid applications-grid--stacked">
        {applications.map((app) => (
          <a href={app.href} class="app-card app-card--split">
            <div class="app-card__visual">
              <img
                src={app.image}
                alt={app.alt}
                width="1200"
                height="675"
                loading="lazy"
                decoding="async"
              />
              <div class="app-card__overlay">
                <span class="app-card__cta">View Fabrics →</span>
              </div>
            </div>
            <div class="app-card__body">
              <h3>{app.title}</h3>
              <p>{app.description}</p>
              <span class="app-card__link">View Products ›</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== WHY NIXIA ==================== -->
  <section class="section" id="why-nixia">
    <div class="container">
      <div class="why-nixia-split">
        <div class="why-nixia-copy">
          <span class="eyebrow">WHY NIXIA</span>
          <h2>Your Reliable Fabric Manufacturing Partner</h2>
          <p>From raw base fabric to finished glitter &amp; hot-stamping material — full-service manufacturing with documented quality control.</p>

          <div class="why-nixia-trust" aria-label="Company trust data">
            <span><strong>Est. 2013</strong></span>
            <span aria-hidden="true">|</span>
            <span><strong>Exporting to 10+ Countries</strong></span>
            <span aria-hidden="true">|</span>
            <span><strong>500+ Rolls</strong> Monthly Capacity</span>
          </div>

          <div class="why-nixia-advantages" aria-label="Core advantages">
            {whyNixiaBenefits.map((item) => (
              <div class="why-nixia-advantage">
                <div class="why-nixia-advantage__icon" aria-hidden="true">
                  {item.icon === "boxes" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 8l8-4 8 4-8 4-8-4z" />
                      <path d="M4 8v8l8 4 8-4V8" />
                      <path d="M12 12v8" />
                    </svg>
                  )}
                  {item.icon === "swatch" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6 5h10l2 5-6 9H8L6 5z" />
                      <path d="M8 9h6" />
                      <path d="M9 12h4" />
                    </svg>
                  )}
                  {item.icon === "certificate" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 4h10v14H7z" />
                      <path d="M9 8h6" />
                      <path d="M9 12h4" />
                      <path d="M14 15l2 4-2-1-2 1 2-4z" />
                    </svg>
                  )}
                  {item.icon === "shipping" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 15h11l2-5H7L5 7H3z" />
                      <path d="M14 15h5l-1-4h-4z" />
                      <circle cx="8" cy="18" r="1.2" />
                      <circle cx="17" cy="18" r="1.2" />
                    </svg>
                  )}
                </div>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="why-nixia-media">
          <img src="/image/process/hot_stamping_foil_transfer.jpg" alt="Factory workshop for fabric manufacturing" loading="lazy" />
          <div class="why-nixia-badges" aria-label="Factory badges">
            <span class="why-nixia-badge-chip">SGS Test Available</span>
            <span class="why-nixia-badge-chip">Verified Factory</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== MANUFACTURING CAPABILITIES ==================== -->
  <section class="section section--alt" id="manufacturing-capabilities">
    <div class="container">
      <div class="capabilities-shell">
        <div class="capabilities-shell__title">MANUFACTURING CAPABILITIES</div>

        <div class="capability-bar" aria-label="Manufacturing capabilities">
          <div class="capability-item">
            <span class="capability-item__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 8h7l1 3H5z" />
                <path d="M12 7h6l1 4h-6z" />
                <path d="M5 11v6h14v-6" />
                <path d="M9 15h6" />
                <path d="M9 18h4" />
              </svg>
            </span>
            <div>
              <h3>Custom Foil Stamping</h3>
              <p>Custom metallic foil patterns &amp; colors</p>
            </div>
          </div>

          <div class="capability-item">
            <span class="capability-item__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 16c1.5-5 3.5-8 6-8s4 3 8 8" />
                <path d="M7 13l2-3 2 4 2-5 2 6" />
                <path d="M4 19h16" />
              </svg>
            </span>
            <div>
              <h3>Glitter Coating</h3>
              <p>Fine-particle glitter surface treatment</p>
            </div>
          </div>

          <div class="capability-item">
            <span class="capability-item__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 7h7l4 4v6H4z" />
                <path d="M11 7v4h4" />
                <path d="M7 14c2-2 5-3 8-4" />
                <path d="M15 10l2 1.5" />
              </svg>
            </span>
            <div>
              <h3>Custom Design</h3>
              <p>Custom pattern, color and base fabric selection</p>
            </div>
          </div>

          <div class="capability-item">
            <span class="capability-item__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 7h12" />
                <path d="M7 7l2 10h6l2-10" />
                <path d="M9 11h6" />
                <path d="M10 15h4" />
              </svg>
            </span>
            <div>
              <h3>Surface Finishing</h3>
              <p>Anti-drop-powder &amp; wear-resistant treatment</p>
            </div>
          </div>

          <div class="capability-item">
            <span class="capability-item__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 9h8l2 3h6v4H4z" />
                <path d="M7 16h2" />
                <path d="M14 16h2" />
                <path d="M15 12h3" />
              </svg>
            </span>
            <div>
              <h3>Export-ready Packaging</h3>
              <p>Roll packing for sea-shipping</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== RFQ & BUYER RESOURCE ==================== -->
  <section class="section section--alt" id="rfq-buyer-resource">
    <div class="container">
      <div class="rfq-grid">
        <div class="rfq-card rfq-card--dark">
          <span class="rfq-card__eyebrow">FACTORY DIRECT WHOLESALE</span>
          <h2>Send RFQ for Custom Fabric Solutions</h2>
          <p class="rfq-card__desc">Tell us your fabric type, end-use, quantity, color & backing requirements. Our factory team will reply with sample info, MOQ and quotation within 24 hours.</p>

          <div class="rfq-preview-grid" aria-hidden="true">
            <div class="rfq-preview-field">Fabric / Material Code</div>
            <div class="rfq-preview-field">Target Application</div>
            <div class="rfq-preview-field">Estimated Quantity</div>
            <div class="rfq-preview-field">Color & Backing Requirement</div>
            <div class="rfq-preview-field">Destination country</div>
            <div class="rfq-preview-field">Target delivery date</div>
          </div>
          <button type="button" class="btn btn--primary btn--lg rfq-form__submit" data-rfq-open>Send RFQ Now</button>
        </div>

        <div class="rfq-card rfq-card--light">
          <span class="rfq-card__eyebrow rfq-card__eyebrow--warm">BUYER RESOURCE</span>
          <h2>Request Wholesale Fabric Catalog</h2>
          <p>Use the catalog request to receive product range suggestions, OEM/ODM options, MOQ guidance and recommended SKUs for your market.</p>

          <ul class="buyer-resource-list" aria-label="Buyer resources">
            <li>Full fabric product range</li>
            <li>Custom surface finish options</li>
            <li>MOQ and sample guidance</li>
            <li>Recommended SKUs by market</li>
          </ul>

          <a class="buyer-resource-button" href="/catalog.pdf" download>Download Catalog</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SOURCING WORKFLOW ==================== -->
  <section class="section" id="sourcing-workflow">
    <div class="container">
      <div class="section-header section-header--left section-header--compact">
        <span class="eyebrow">SAMPLE TO SHIPMENT</span>
        <h2>Two Sourcing Paths for Fabric Buyers</h2>
        <p>We support both ready-stock fabric and custom finished orders, with clear workflows for each.</p>
      </div>

      <div class="workflow-timelines">
        <article class="workflow-timeline">
          <div class="workflow-timeline__head">
            <span class="workflow-timeline__eyebrow">Path A</span>
            <h3>Ready-Stock Foil &amp; Glitter Fabric</h3>
            <p>For in-stock hot-stamping &amp; glitter synthetic leather, fast lead time</p>
          </div>

          <ol class="workflow-timeline__track" aria-label="Ready-stock fabric workflow">
            <li class="workflow-step"><span>1</span><strong>Inquiry &amp; Check Stock</strong></li>
            <li class="workflow-step"><span>2</span><strong>Confirm Unit Price</strong></li>
            <li class="workflow-step"><span>3</span><strong>Request Stock Sample</strong></li>
            <li class="workflow-step"><span>4</span><strong>Approve Fabric</strong></li>
            <li class="workflow-step workflow-step--active"><span>5</span><strong>Place Bulk Order</strong></li>
            <li class="workflow-step"><span>6</span><strong>Production &amp; Delivery</strong></li>
          </ol>

          <div class="workflow-timeline__actions">
            <a href="/products" class="btn btn--outline btn--lg">Browse Stock Products →</a>
          </div>
        </article>

        <article class="workflow-timeline">
          <div class="workflow-timeline__head">
            <span class="workflow-timeline__eyebrow">Path B</span>
            <h3>Custom Foil / Glitter Fabric Order</h3>
            <p>For custom color, backing and pattern modification</p>
          </div>

          <ol class="workflow-timeline__track" aria-label="Custom fabric workflow">
            <li class="workflow-step"><span>1</span><strong>Inquiry &amp; Requirement</strong></li>
            <li class="workflow-step"><span>2</span><strong>Formal Quotation</strong></li>
            <li class="workflow-step"><span>3</span><strong>Prototype Sampling</strong></li>
            <li class="workflow-step"><span>4</span><strong>Buyer Sample Confirmation</strong></li>
            <li class="workflow-step"><span>5</span><strong>Pre-Production Sample</strong></li>
            <li class="workflow-step workflow-step--active"><span>6</span><strong>Mass Production</strong></li>
            <li class="workflow-step"><span>7</span><strong>Final Inspection &amp; Shipment</strong></li>
          </ol>

          <div class="workflow-timeline__actions">
            <a href="/contact" class="btn btn--primary btn--lg">Request Custom Quote →</a>
          </div>
        </article>
      </div>

    </div>
  </section>

