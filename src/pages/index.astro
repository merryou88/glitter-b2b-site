---
/**
 * index.astro — Nixia Fabric Home Page
 * Solution-oriented narrative (inspired by ecowoodplate.com)
 *
 * Module order: Hero → Our Main Fabric Series → Why Choose Nixia Fabric →
 *               Our Factory → Factory Trust → Final CTA
 */
import Layout from "@layouts/Layout.astro";
import HeroCarousel from "@components/HeroCarousel.astro";
import CTAButton from "@components/CTAButton.astro";
import { performanceProducts } from "@data/allProducts";

// WebPage structured data for SEO
const webPageData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Foil Fabrics for Performance Wear Manufacturers | Nixia Fabric",
  description:
  "Specialist foil fabric supplier with 15+ years of experience. Ready-stock foil fabrics and custom development for stage costumes, performance wear, dancewear and party apparel.",
  url: "https://nixiafabric.com",
};

const toWebp = (src: string) => src.replace(/\.(png|jpe?g)$/i, ".webp");

const productMap = new Map(performanceProducts.map((product) => [product.slug, product]));

const popularProducts = [
  {
    slug: "iridescent-laser-hot-stamping-stretch-ice-silk",
    title: "Iridescent Laser Foil Stretch Fabric",
    description: "Elastic ice-silk base with an iridescent laser foil effect for stage costumes, dancewear and performance wear.",
    href: "/products/iridescent-laser-hot-stamping-stretch-ice-silk/",
    moq: "MOQ 100 m / 109 yd",
    badge: "Laser & Iridescent Foil",
  },
  {
    slug: "iridescent-gradient-laser-ice-silk",
    title: "Rainbow Iridescent Laser Foil Stretch Fabric",
    description: "Multi-color iridescent foil finish on a flexible base for dancewear, stage costumes and performance outfits.",
    href: "/products/iridescent-gradient-laser-ice-silk/",
    moq: "MOQ 100 m / 109 yd",
    badge: "Laser & Iridescent Foil",
  },
  {
    slug: "shiny-foil-4-way-stretch-knit-fabric",
    title: "Glossy Foil High-Stretch Knit Fabric",
    description: "Reflective foil stretch knit for stage costumes, dancewear, performance wear and party apparel.",
    href: "/products/shiny-foil-4-way-stretch-knit-fabric/",
    moq: "MOQ 100 m / 109 yd",
    badge: "Classic Foil",
  },
  {
    slug: "blue-purple-gradient-laser-foil-spandex-fabric",
    title: "Blue-Purple Gradient Laser Foil 4-Way Stretch Fabric",
    description: "Blue-purple gradient laser foil on a 4-way stretch base for costumes and performance apparel.",
    href: "/products/blue-purple-gradient-laser-foil-spandex-fabric/",
    moq: "MOQ 100 m / 109 yd",
    badge: "Patterned Laser Foil",
  },
  {
    slug: "full-print-hot-stamping-spandex-milk-silk",
    title: "Patterned Foil Spandex Milk-Silk Fabric",
    description: "Soft stretch milk-silk fabric with an all-over foil print for stage costumes, dancewear and performance outfits.",
    href: "/products/full-print-hot-stamping-spandex-milk-silk/",
    moq: "MOQ 100 m / 109 yd",
    badge: "Patterned Foil",
  },
  {
    slug: "non-shedding-glitter-suede-look-laser-foil-fabric",
    title: "Dense Dot Foil Suede-Look Fabric",
    description: "Suede-look base with a dense small-dot foil finish for stage costumes, props, backdrops and event displays.",
    href: "/products/non-shedding-glitter-suede-look-laser-foil-fabric/",
    moq: "MOQ 100 m / 109 yd",
    badge: "Specialty Textured Foil",
  },
];

const whyNixiaBenefits = [
  {
    title: "15+ Years of Foil Fabric Experience",
    desc: "Focused on foil fabric development and supply for more than 15 years.",
    icon: "boxes",
  },
  {
    title: "Ready Stock",
    desc: "Selected styles and colors are available from stock to help buyers move faster from sampling to production.",
    icon: "swatch",
  },
  {
    title: "Custom Development",
    desc: "Send us your sample, photo or design reference for matching and development.",
    icon: "certificate",
  },
  {
    title: "B2B-Focused Supply",
    desc: "We work with buyers and manufacturers who need practical foil fabric solutions for production.",
    icon: "shipping",
  },
];

const applications = [
  {
    title: "Stage Costumes",
    desc: "Stage costumes and show outfits that need strong shine and visual impact.",
    featured: true,
  },
  {
    title: "Performance Wear",
    desc: "Performance garments designed for movement, lighting and visual effects.",
    featured: true,
  },
  {
    title: "Dancewear",
    desc: "Stretch foil fabrics for dance costumes, competition wear and performance outfits.",
    featured: true,
  },
  {
    title: "Show Costumes",
    desc: "Distinctive fabrics for entertainment, show and event costume production.",
  },
  {
    title: "Party Wear",
    desc: "Eye-catching foil fabrics for party dresses, themed outfits and statement apparel.",
  },
  {
    title: "Festival & Carnival Costumes",
    desc: "Reflective and colorful fabrics for festival, carnival and themed costume designs.",
  },
];

const sampleToProduction = [
  {
    title: "Send Your Reference",
    desc: "Send us your fabric sample, photo or design reference.",
  },
  {
    title: "Match & Develop",
    desc: "We evaluate the base fabric, foil effect, pattern and finish to find or develop a suitable option.",
  },
  {
    title: "Sample Approval",
    desc: "Receive samples for review before production.",
  },
  {
    title: "Production & Dispatch",
    desc: "Confirm specifications, quantity and delivery requirements for production.",
  },
];

const workflowA = [
  { title: "Check Stock" },
  { title: "Confirm Price" },
  { title: "Request Sample" },
  { title: "Approve Fabric" },
  { title: "Place Order" },
  { title: "Dispatch" },
];

const workflowB = [
  { title: "Share Requirement" },
  { title: "Quote Project" },
  { title: "Develop Sample" },
  { title: "Approve Sample" },
  { title: "Confirm Bulk" },
  { title: "Mass Production" },
  { title: "Inspect & Ship" },
];

const WORKER_URL = (import.meta.env.WORKER_URL ?? "").replace(/\/$/, "");
const RFQ_ENDPOINT = WORKER_URL ? `${WORKER_URL}/api/rfq` : "https://nixia-fabric-inquiry.sales-8db.workers.dev/api/rfq";

// homepage section data continues below
---

<Layout
  title="Foil Fabrics for Performance Wear Manufacturers | Nixia Fabric"
  description="Specialist foil fabric supplier with 15+ years of experience. Ready-stock foil fabrics and custom development for stage costumes, performance wear, dancewear and party apparel."
  keywords="foil fabric supplier, foil fabrics, foil stretch fabric, laser foil fabric, iridescent foil fabric, performance fabric, stage costume fabric"
  structuredData={[webPageData]}
  footerFocus="foil"
>
  <!-- ==================== HERO CAROUSEL ==================== -->
  <HeroCarousel />

  <!-- ==================== HERO TRUST BAR ==================== -->
  <section class="hero-trust" aria-label="Business advantages">
    <div class="container">
      <div class="hero-trust__grid">
        <div class="hero-trust__item">
          <span class="hero-trust__value">15+ Years</span>
          <span class="hero-trust__label">Foil Fabric Experience</span>
        </div>
        <div class="hero-trust__item">
          <span class="hero-trust__value">Ready Stock</span>
          <span class="hero-trust__label">Selected Styles & Colors</span>
        </div>
        <div class="hero-trust__item">
          <span class="hero-trust__value">Custom</span>
          <span class="hero-trust__label">Sample & Photo Matching</span>
        </div>
        <div class="hero-trust__item">
          <span class="hero-trust__value">B2B Supply</span>
          <span class="hero-trust__label">For Apparel Manufacturers</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== VALUE PROPOSITION ==================== -->
  <section class="section section--alt" id="foil-value">
    <div class="container">
      <div class="section-header section-header--center section-header--compact">
        <span class="eyebrow">FOIL FABRIC SUPPLY</span>
        <h2>Foil Fabrics Built for Strong Visual Impact</h2>
        <p>Designed for costumes and performance garments that need shine, movement and a distinctive visual effect.</p>
      </div>

      <div class="capability-bar" aria-label="Foil fabric value points">
        <div class="capability-item">
          <span class="capability-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z" />
              <path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z" />
            </svg>
          </span>
          <div>
            <h3>Stage-Ready Visual Effects</h3>
            <p>Foil surfaces designed to create strong shine and visual impact under stage and event lighting.</p>
          </div>
        </div>

        <div class="capability-item">
          <span class="capability-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12c4-6 10-6 14 0" />
              <path d="M5 12c4 6 10 6 14 0" />
              <path d="M8 12h8" />
            </svg>
          </span>
          <div>
            <h3>Stretch &amp; Flexible Bases</h3>
            <p>Selected stretch and flexible fabric bases for fitted costumes, dancewear and performance garments.</p>
          </div>
        </div>

        <div class="capability-item">
          <span class="capability-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 8l8-4 8 4-8 4-8-4z" />
              <path d="M4 8v8l8 4 8-4V8" />
              <path d="M12 12v8" />
            </svg>
          </span>
          <div>
            <h3>Ready Stock</h3>
            <p>Selected styles and colors are available from stock for faster sampling and production planning.</p>
          </div>
        </div>

        <div class="capability-item">
          <span class="capability-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 20h16" />
              <path d="M6 16l8-8 4 4-8 8H6v-4z" />
              <path d="M13 9l2 2" />
            </svg>
          </span>
          <div>
            <h3>Custom Development</h3>
            <p>Send us your fabric sample, photo or design reference for matching and custom development.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== OUR MAIN FABRIC SERIES ==================== -->
  <section class="section" id="main-fabric-series">
    <div class="container">
      <div class="section-header section-header--row">
        <div>
          <span class="eyebrow">FEATURED PRODUCTS</span>
          <h2>Featured Foil Fabrics</h2>
        <p>Selected foil fabrics developed for stage costumes, performance wear, dancewear and party apparel.</p>
        </div>
        <div class="section-header__links">
          <a href="#applications" class="view-all-link">Explore Applications →</a>
          <a href="/products/" class="view-all-link">View All Foil Fabrics →</a>
        </div>
      </div>

      <div class="grid fabric-series-grid">
          {popularProducts.map((item) => {
            const product = productMap.get(item.slug);
            return (
            <a href={item.href} class="fabric-card fabric-card--split">
              <div class="fabric-card__visual">
                {product && (
                  <picture>
                    {product.mainImageWebp && <source srcset={product.mainImageWebp} type="image/webp" />}
                    <img src={product.mainImageUrl} alt={product.mainImageAlt} width="1200" height="675" loading="lazy" decoding="async" />
                  </picture>
                )}
              </div>
              <div class="fabric-card__body">
                <span class="fabric-card__tag fabric-card__tag--inline">{item.badge}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <div class="fabric-card__meta">
                  <span>{item.moq}</span>
                  <span>View Details</span>
                </div>
              </div>
            </a>
            );
          })}
        </div>
    </div>
  </section>

  <!-- ==================== APPLICATIONS ==================== -->
  <section class="section section--alt" id="applications">
    <div class="container">
      <div class="section-header section-header--center section-header--compact">
        <span class="eyebrow">APPLICATIONS</span>
        <h2>Applications</h2>
        <p>Foil fabrics for costumes and garments designed to stand out on stage, at events and in performance settings.</p>
      </div>

      <div class="applications-grid" aria-label="Foil fabric applications">
        {applications.map((item) => (
          <article class:list={["application-card", { "application-card--featured": item.featured }]}>
            <h3>{item.title}</h3>
            <p>{item.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== WHY NIXIA ==================== -->
  <section class="section" id="why-nixia">
    <div class="container">
      <div class="why-nixia-split">
        <div class="why-nixia-copy">
          <span class="eyebrow">WHY NIXIA</span>
          <h2>Why Buyers Choose Nixia</h2>
          <p>Specialist foil fabric support for buyers and manufacturers who need practical sourcing, sampling and production development.</p>

          <div class="why-nixia-advantages" aria-label="Core advantages">
            {whyNixiaBenefits.map((item) => (
              <div class="why-nixia-advantage">
                <div class="why-nixia-advantage__icon" aria-hidden="true">
                  {item.icon === "boxes" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 8l8-4 8 4-8 4-8-4z" />
                      <path d="M4 8v8l8 4 8-4V8" />
                      <path d="M12 12v8" />
                    </svg>
                  )}
                  {item.icon === "swatch" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M6 5h10l2 5-6 9H8L6 5z" />
                      <path d="M8 9h6" />
                      <path d="M9 12h4" />
                    </svg>
                  )}
                  {item.icon === "certificate" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 4h10v14H7z" />
                      <path d="M9 8h6" />
                      <path d="M9 12h4" />
                      <path d="M14 15l2 4-2-1-2 1 2-4z" />
                    </svg>
                  )}
                  {item.icon === "shipping" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 15h11l2-5H7L5 7H3z" />
                      <path d="M14 15h5l-1-4h-4z" />
                      <circle cx="8" cy="18" r="1.2" />
                      <circle cx="17" cy="18" r="1.2" />
                    </svg>
                  )}
                </div>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="why-nixia-media">
          <picture>
            <img src="/images/process/hot_stamping_foil_transfer.webp" alt="Foil application process for fabric production" width="1200" height="675" loading="lazy" decoding="async" />
          </picture>
          <div class="why-nixia-badges" aria-label="Factory badges">
            <span class="why-nixia-badge-chip">Foil Fabric Focus</span>
            <span class="why-nixia-badge-chip">Sample Matching Support</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== PRODUCTION / FACTORY ==================== -->
  <section class="section section--alt" id="manufacturing-capabilities">
    <div class="container">
      <div class="section-header section-header--center section-header--compact">
        <span class="eyebrow">PRODUCTION</span>
        <h2>Production &amp; Quality Control</h2>
        <p>From foil application to finished rolls, we work with experienced production partners to maintain consistent quality and production requirements.</p>
      </div>

      <div class="capability-bar" aria-label="Manufacturing capabilities">
        <div class="capability-item">
          <span class="capability-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 8h7l1 3H5z" />
              <path d="M12 7h6l1 4h-6z" />
              <path d="M5 11v6h14v-6" />
              <path d="M9 15h6" />
              <path d="M9 18h4" />
            </svg>
          </span>
          <div>
            <h3>Custom Foil Stamping</h3>
            <p>Foil patterns, colors and finishes developed around buyer references.</p>
          </div>
        </div>

        <div class="capability-item">
          <span class="capability-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 7h7l4 4v6H4z" />
              <path d="M11 7v4h4" />
              <path d="M7 14c2-2 5-3 8-4" />
              <path d="M15 10l2 1.5" />
            </svg>
          </span>
          <div>
            <h3>Base Fabric Matching</h3>
            <p>Base fabric, stretch and hand-feel reviewed against the target application.</p>
          </div>
        </div>

        <div class="capability-item">
          <span class="capability-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 7h12" />
              <path d="M7 7l2 10h6l2-10" />
              <path d="M9 11h6" />
              <path d="M10 15h4" />
            </svg>
          </span>
          <div>
            <h3>Surface Review</h3>
            <p>Foil effect, pattern clarity and finish are checked during development.</p>
          </div>
        </div>

        <div class="capability-item">
          <span class="capability-item__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 9h8l2 3h6v4H4z" />
              <path d="M7 16h2" />
              <path d="M14 16h2" />
              <path d="M15 12h3" />
            </svg>
          </span>
          <div>
            <h3>Roll Packing</h3>
            <p>Finished fabrics are prepared in roll packing according to order needs.</p>
          </div>
        </div>
      </div>

      <div class="credential-cta production-cta">
        <CTAButton href="/factory/" variant="outline" size="lg">
          Explore Our Production →
        </CTAButton>
      </div>
    </div>
  </section>

  <!-- ==================== RFQ & BUYER RESOURCE ==================== -->
  <section class="section section--alt" id="rfq-buyer-resource">
    <div class="container">
      <div class="rfq-grid">
        <div class="rfq-card rfq-card--dark">
          <div class="rfq-card__main">
            <span class="rfq-card__eyebrow">SAMPLE &amp; QUOTE</span>
            <h2>Looking for a Specific Foil Effect?</h2>
            <p class="rfq-card__desc">Send us your fabric sample, photo or design reference. We can help match the effect and develop a suitable fabric for your production.</p>

            <form class="rfq-inline-form" id="rfq-inline-form" novalidate>
            <div class="rfq-inline-form__row">
              <div class="rfq-inline-form__field">
                <label for="rfq-inline-name">Name *</label>
                <input type="text" id="rfq-inline-name" name="name" placeholder="Your name" autocomplete="name" required />
              </div>
              <div class="rfq-inline-form__field">
                <label for="rfq-inline-email">E-mail *</label>
                <input type="email" id="rfq-inline-email" name="email" placeholder="you@company.com" autocomplete="email" required />
              </div>
            </div>
            <div class="rfq-inline-form__field">
              <label for="rfq-inline-message">Message *</label>
              <textarea id="rfq-inline-message" name="message" rows="3" placeholder="Fabric requirements, quantity and target application..." required></textarea>
            </div>
            <!-- Honeypot: hidden from humans, bots fill it and get rejected server-side -->
            <div class="rfq-inline-hp" aria-hidden="true">
              <label for="rfq-inline-website">Website</label>
              <input type="text" id="rfq-inline-website" name="website" tabindex="-1" autocomplete="off" />
            </div>
            <div class="rfq-inline-form__error" id="rfq-inline-error" role="alert" hidden></div>
            <button type="submit" class="btn btn--primary btn--lg rfq-inline-form__submit">
              <span class="rfq-inline-form__submit-text">Send Your Sample / Request a Quote</span>
              <span class="rfq-inline-form__spinner" hidden>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/></svg>
              </span>
            </button>
          </form>
          </div>
          <figure class="rfq-card__quote">
            <blockquote>Tell us your fabric requirements, quantity and target application.</blockquote>
            <figcaption>For stage costumes, performance wear, dancewear and party apparel.</figcaption>
          </figure>
        </div>

        <div class="rfq-card rfq-card--light">
          <span class="rfq-card__eyebrow rfq-card__eyebrow--warm">BUYER RESOURCE</span>
          <h2>Request Foil Fabric Suggestions</h2>
          <p>Use the catalog request to receive foil fabric suggestions, sample guidance and recommended existing styles for your application.</p>

          <ul class="buyer-resource-list" aria-label="Buyer resources">
            <li>Foil fabric product range</li>
            <li>Ready-stock style suggestions</li>
            <li>Sample and MOQ guidance</li>
            <li>Custom development options</li>
          </ul>

          <a class="buyer-resource-button" href="/contact/?subject=catalog-request">Request Catalog via Email</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== SOURCING WORKFLOW ==================== -->
  <section class="section" id="sourcing-workflow">
    <div class="container">
      <div class="section-header section-header--center section-header--compact">
        <span class="eyebrow">SAMPLE TO PRODUCTION</span>
        <h2>From Sample to Production</h2>
        <p>A simple process for sourcing, matching and developing foil fabrics for your production.</p>
      </div>

      <div class="sample-process-grid" aria-label="Sample to production process">
        {sampleToProduction.map((step, idx) => (
          <article class="sample-process-step">
            <span class="sample-process-step__number">Step {idx + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== B2B SUPPORT ==================== -->
  <section class="section section--alt" id="verified-factory">
    <div class="container">
      <div class="section-header section-header--left section-header--compact">
        <span class="eyebrow">B2B SUPPORT</span>
        <h2>Practical Support for Foil Fabric Buyers</h2>
        <p>We keep the buying process focused on product fit, sample confirmation and production requirements.</p>
      </div>

      <div class="support-grid grid grid--4">
        <article class="support-card">
          <span class="support-card__eyebrow">ENTITY</span>
          <h3>Business Communication</h3>
