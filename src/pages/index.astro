<script define:vars={{ RFQ_ENDPOINT, TURNSTILE_SITE_KEY }}>
(function() {
  var form = document.getElementById("rfq-inline-form");
  if (!form) return;
  var errorEl = document.getElementById("rfq-inline-error");
  var submitText = form.querySelector(".rfq-inline-form__submit-text");
  var submitSpinner = form.querySelector(".rfq-inline-form__spinner");
  var submitBtn = form.querySelector(".rfq-inline-form__submit");

  var turnstileToken = "";
  var turnstileWidgetId = null;

  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  function showError(msg) {
    if (errorEl) { errorEl.textContent = msg; errorEl.hidden = false; }
  }
  function hideError() {
    if (errorEl) errorEl.hidden = true;
  }

  function updateSubmitState() {
    if (!submitBtn) return;
    var data = new FormData(form);
    var allFilled = (data.get("name") || "").trim() &&
                    (data.get("email") || "").trim() &&
                    (data.get("message") || "").trim();
    submitBtn.disabled = !allFilled || !turnstileToken;
  }

  function setLoading(loading) {
    if (!submitBtn) return;
    submitBtn.disabled = loading;
    if (submitText) submitText.textContent = loading ? "Sending..." : "Send";
    if (submitSpinner) submitSpinner.hidden = !loading;
  }

  if (TURNSTILE_SITE_KEY) {
    var script = document.createElement("script");
    script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
    script.async = true;
    script.defer = true;
    script.onload = function() {
      var win = window;
      if (!win.turnstile) return;
      var container = document.getElementById("rfq-inline-turnstile");
      if (!container) return;
      turnstileWidgetId = win.turnstile.render(container, {
        sitekey: TURNSTILE_SITE_KEY,
        theme: "dark",
        callback: function(token) { turnstileToken = token; updateSubmitState(); },
        "expired-callback": function() { turnstileToken = ""; updateSubmitState(); },
        "error-callback": function() { turnstileToken = ""; updateSubmitState(); }
      });
    };
    document.head.appendChild(script);
  }

  form.addEventListener("input", updateSubmitState);
  updateSubmitState();

  form.addEventListener("submit", async function(e) {
    e.preventDefault();
    hideError();

    var data = new FormData(form);
    var name = (data.get("name") || "").trim();
    var email = (data.get("email") || "").trim();
    var message = (data.get("message") || "").trim();

    if (!name || !email || !message) {
      showError("Please fill in all required fields.");
      return;
    }
    if (!EMAIL_RE.test(email)) {
      showError("Please enter a valid email address.");
      return;
    }
    if (!turnstileToken) {
      showError("Please complete the human verification.");
      return;
    }

    setLoading(true);

    try {
      var resp = await fetch(RFQ_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name: name, email: email, message: message, captcha: turnstileToken }),
      });
      if (resp.ok) {
        window.location.href = "/thank-you";
      } else {
        var errData = await resp.json().catch(function() { return {}; });
        showError(errData.message || "Submission failed. Please try again later.");
      }
    } catch (err) {
      showError("Network error. Please check your connection and try again.");
    } finally {
      setLoading(false);
    }
  });
})();
</script>
