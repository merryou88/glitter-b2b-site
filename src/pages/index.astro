---
/**
 * index.astro — Nixia Fabric Home Page
 * China Glitter Fabric Manufacturer
 *
 * Sections: Hero → Product Categories → Factory Capability →
 *           Applications → Why Choose Us → Final CTA
 */
import Layout from "@layouts/Layout.astro";
import Hero from "@components/Hero.astro";
import CTAButton from "@components/CTAButton.astro";
import { productCategories } from "@data/products";

// WebPage structured data for SEO
const webPageData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Nixia Fabric — China Glitter Fabric Manufacturer",
  description:
    "China glitter fabric manufacturer specializing in glitter fabric and foil fabric for shoes, handbags, and fashion accessories. OEM production and custom color development.",
  url: "https://nixiafabric.com",
};

// FAQPage structured data for rich snippets
const faqData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What does Nixia Fabric manufacture?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Nixia Fabric manufactures glitter fabric and foil fabric for shoes, handbags, bags accessories, and fashion applications. We produce elastic glitter fabric, PU glitter fabric, non-woven glitter fabric, Oxford glitter fabric, and metallic foil fabric including gold and silver foil.",
      },
    },
    {
      "@type": "Question",
      name: "Is Nixia Fabric a manufacturer or a trading company?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Nixia Fabric is a manufacturer — not a trading company or sourcing agent. We produce all fabrics in-house with direct control over quality, custom color development, and OEM production.",
      },
    },
    {
      "@type": "Question",
      name: "Can I get custom colors developed?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. We offer full custom color development including Pantone color matching, metallic tone development, and batch-to-batch color consistency. Our in-house color lab ensures your custom colors are matched accurately.",
      },
    },
    {
      "@type": "Question",
      name: "Do you offer OEM production?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, we provide full OEM production services including custom GSM, width, backing material, glitter density, and special finishes tailored to your specifications.",
      },
    },
    {
      "@type": "Question",
      name: "How can I get fabric swatches?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "You can request free fabric swatches by contacting us through our website. We ship swatches worldwide so you can see and feel the quality before placing an order.",
      },
    },
  ],
};

const factoryCapabilities = [
  {
    title: "Manufacturing Experience",
    description:
      "Years of specialized experience in decorative fabric production, serving global brands and manufacturers across the footwear and fashion accessories industry.",
    icon: "factory",
  },
  {
    title: "Custom Color Development",
    description:
      "In-house color matching and development capability. We develop custom glitter and metallic colors to meet your specific design requirements and brand standards.",
    icon: "palette",
  },
  {
    title: "OEM Production",
    description:
      "Full OEM production service from material selection to finished fabric. We manufacture to your specifications with consistent quality across production runs.",
    icon: "production",
  },
  {
    title: "Quality Control",
    description:
      "Systematic quality inspection at every production stage — from raw material testing to finished fabric QC. Adhesion, color fastness, and GSM verification on every batch.",
    icon: "quality",
  },
];

const applications = [
  {
    title: "Shoes",
    description: "Shoe uppers, trims, and decorative panels",
    gradient: "linear-gradient(135deg, #d4af37 0%, #c4a035 50%, #b89530 100%)",
  },
  {
    title: "Handbags",
    description: "Bag bodies, flaps, and accent panels",
    gradient: "linear-gradient(135deg, #e8e8e8 0%, #c0c0c0 50%, #a8a8a8 100%)",
  },
  {
    title: "Accessories",
    description: "Belts, wallets, and small leather goods",
    gradient: "linear-gradient(135deg, #e8c4a0 0%, #d4a070 50%, #c09060 100%)",
  },
  {
    title: "Fashion",
    description: "Garment trims, decorative elements, and more",
    gradient: "linear-gradient(135deg, #2a3a6a 0%, #1a2b4d 50%, #0d1b33 100%)",
  },
];

const whyChooseUs = [
  {
    title: "Professional Fabric Manufacturing",
    description:
      "We are a manufacturer, not a trading company. Our production lines are optimized for decorative fabric — glitter, foil, and metallic finishes.",
  },
  {
    title: "Custom Development Capability",
    description:
      "From custom colors to custom backing materials, we develop fabric solutions tailored to your product requirements and performance standards.",
  },
  {
    title: "Wide Color Selection",
    description:
      "An extensive range of standard colors plus full custom color matching. Gold, silver, rose gold, champagne, black, and unlimited custom tones.",
  },
  {
    title: "Quality Management",
    description:
      "Every production batch undergoes systematic QC — composition verification, GSM checking, adhesion testing, and color fastness inspection.",
  },
];
---

<Layout
  title=""
  description="Nixia Fabric is a China glitter fabric manufacturer specializing in glitter fabric and foil fabric for shoes, handbags, and fashion accessories. OEM production and custom color development."
  keywords="glitter fabric manufacturer, foil fabric manufacturer, glitter fabric factory china, metallic fabric factory, OEM fabric production, custom fabric development, glitter fabric for shoes, foil fabric for handbags"
  structuredData={[webPageData, faqData]}
>
  <!-- ==================== 1. HERO ==================== -->
  <Hero />

  <!-- ==================== 2. PRODUCT CATEGORIES ==================== -->
  <section class="section" id="products-section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Product Range</span>
        <h2>Fabric Categories</h2>
        <p>
          Two specialized fabric lines designed for footwear, handbags, bags
          accessories, and fashion applications. Available in multiple backing
          options with full custom color development.
        </p>
      </div>

      <div class="grid grid--2 categories-grid">
        {productCategories.map((category) => (
          <article class="category-card">
            <div class="category-card__visual" style={`background: ${category.slug === "glitter-fabric"
              ? "linear-gradient(135deg, #d4af37 0%, #c4a035 40%, #b89530 100%)"
              : "linear-gradient(135deg, #e8e8e8 0%, #c0c0c0 40%, #a8a8a8 100%)"};`}>
              <div class="category-card__visual-overlay"></div>
              <div class="category-card__visual-content">
                <span class="category-card__badge">{category.products.length} Products</span>
              </div>
            </div>
            <div class="category-card__body">
              <h3>{category.name}</h3>
              <p>{category.description}</p>
              <div class="category-card__sub-products">
                {category.products.map((product) => (
                  <a href={`/products/${product.slug}`} class="category-card__sub-link">
                    {product.name}
                  </a>
                ))}
              </div>
              <div class="category-card__actions">
                <CTAButton href={`/products?category=${category.slug}`} variant="dark">
                  View {category.name}
                </CTAButton>
                <CTAButton href="/contact?inquiry=swatch" variant="outline">
                  Request Swatch
                </CTAButton>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 3. FACTORY CAPABILITY ==================== -->
  <section class="section section--alt" id="factory-capability">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Factory Capability</span>
        <h2>What We Manufacture</h2>
        <p>
          Our manufacturing capability covers the full decorative fabric
          production chain — from custom color development to OEM production
          and quality-controlled delivery.
        </p>
      </div>

      <div class="grid grid--4 capability-grid">
        {factoryCapabilities.map((item) => (
          <div class="capability-card">
            <div class="capability-card__icon">
              {item.icon === "factory" && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M6 42V20L18 26V20L30 26V20L42 26V42H6Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <rect x="12" y="32" width="4" height="6" fill="currentColor"/>
                  <rect x="22" y="32" width="4" height="6" fill="currentColor"/>
                  <rect x="32" y="32" width="4" height="6" fill="currentColor"/>
                  <path d="M6 16L10 10H16L18 16" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                </svg>
              )}
              {item.icon === "palette" && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M24 6C13 6 6 13 6 22C6 31 13 38 22 38C24 38 26 36 26 34C26 33 25 32 25 31C25 29 26 28 28 28H32C37 28 42 25 42 20C42 12 34 6 24 6Z" stroke="currentColor" stroke-width="2.5"/>
                  <circle cx="15" cy="22" r="3" fill="currentColor"/>
                  <circle cx="22" cy="15" r="3" fill="currentColor"/>
                  <circle cx="31" cy="17" r="3" fill="currentColor"/>
                </svg>
              )}
              {item.icon === "production" && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M8 38V24L16 28V24L24 28V24L32 28V20H40V38H8Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <path d="M8 38H40" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
                  <circle cx="14" cy="33" r="2" fill="currentColor"/>
                  <circle cx="22" cy="33" r="2" fill="currentColor"/>
                  <circle cx="30" cy="33" r="2" fill="currentColor"/>
                </svg>
              )}
              {item.icon === "quality" && (
                <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M24 6L38 12V22C38 31 32 38 24 42C16 38 10 31 10 22V12L24 6Z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                  <path d="M18 24L22 28L30 20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
            </div>
            <h3 class="capability-card__title">{item.title}</h3>
            <p class="capability-card__desc">{item.description}</p>
          </div>
        ))}
      </div>

      <div class="capability-cta">
        <CTAButton href="/factory" variant="dark" size="lg">
          Explore Our Factory
        </CTAButton>
      </div>
    </div>
  </section>

  <!-- ==================== 4. APPLICATIONS ==================== -->
  <section class="section" id="applications">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Applications</span>
        <h2>Where Our Fabrics Are Used</h2>
        <p>
          Nixia Fabric products are used across footwear, handbags, bags
          accessories, and fashion — anywhere decorative glitter and metallic
          surfaces add value.
        </p>
      </div>

      <div class="grid grid--4 applications-grid">
        {applications.map((app) => (
          <div class="app-card">
            <div class="app-card__visual" style={`background: ${app.gradient};`}>
              <div class="app-card__visual-shine"></div>
            </div>
            <div class="app-card__body">
              <h3>{app.title}</h3>
              <p>{app.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 5. WHY CHOOSE NIXIA FABRIC ==================== -->
  <section class="section section--dark" id="why-choose">
    <div class="container">
      <div class="why-layout">
        <!-- Left: Heading -->
        <div class="why-layout__header">
          <span class="eyebrow">Why Choose Nixia Fabric</span>
          <h2>Manufacturer, Not Middleman</h2>
          <p>
            We are a fabric manufacturer — not a supplier, trading company, or
            sourcing agent. That means direct control over quality, faster
            custom development, and transparent communication from production
            floor to your door.
          </p>
          <div class="why-layout__badges">
            <span class="why-badge">Manufacturer</span>
            <span class="why-badge">Factory</span>
            <span class="why-badge">OEM</span>
            <span class="why-badge">Custom Manufacturing</span>
          </div>
          <div class="why-layout__actions">
            <CTAButton href="/about" variant="secondary" size="lg">
              About Nixia Fabric
            </CTAButton>
          </div>
        </div>

        <!-- Right: Feature list -->
        <div class="why-layout__features">
          {whyChooseUs.map((feature, idx) => (
            <div class="why-feature">
              <div class="why-feature__num">{String(idx + 1).padStart(2, "0")}</div>
              <div class="why-feature__content">
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 6. FINAL CTA ==================== -->
  <section class="final-cta" id="final-cta">
    <div class="container">
      <div class="final-cta__inner">
        <span class="eyebrow final-cta__eyebrow">Get Started</span>
        <h2 class="final-cta__title">
          Request Free Swatches for Your Project
        </h2>
        <p class="final-cta__text">
          See and feel the quality before you commit. We send free fabric
          swatches worldwide. For custom color development, our team will work
          with you from concept to production.
        </p>
        <div class="final-cta__actions">
          <CTAButton href="/contact?inquiry=swatch" variant="primary" size="lg">
            Request Swatch
          </CTAButton>
          <CTAButton href="/contact?inquiry=quote" variant="outline" size="lg">
            Get Custom Quote
          </CTAButton>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ==================== Product Categories ==================== */
  .categories-grid {
    gap: var(--space-2xl);
  }

  .category-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition-base);
    display: flex;
    flex-direction: column;
  }

  .category-card:hover {
    box-shadow: var(--shadow-xl);
    transform: translateY(-4px);
  }

  .category-card__visual {
    aspect-ratio: 16 / 7;
    position: relative;
    overflow: hidden;
  }

  .category-card__visual::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 25% 35%, rgba(255, 255, 255, 0.3) 0%, transparent 40%),
      radial-gradient(circle at 75% 65%, rgba(255, 255, 255, 0.15) 0%, transparent 30%);
  }

  .category-card__visual-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .category-card__visual-content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    padding: var(--space-md);
  }

  .category-card__badge {
    padding: 0.375rem 0.875rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: var(--radius-full);
    backdrop-filter: blur(4px);
  }

  .category-card__body {
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    flex: 1;
  }

  .category-card__body h3 {
    font-size: var(--text-2xl);
  }

  .category-card__body > p {
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .category-card__sub-products {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    padding-block: var(--space-sm);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .category-card__sub-link {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-secondary);
    padding: 0.25rem 0.625rem;
    background-color: var(--color-bg-alt);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .category-card__sub-link:hover {
    color: var(--color-white);
    background-color: var(--color-primary);
  }

  .category-card__actions {
    display: flex;
    gap: var(--space-sm);
    margin-top: auto;
  }

  /* ==================== Factory Capability ==================== */
  .capability-grid {
    gap: var(--space-xl);
  }

  .capability-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    text-align: center;
    transition: all var(--transition-base);
  }

  .capability-card:hover {
    box-shadow: var(--shadow-lg);
    border-color: var(--color-accent);
    transform: translateY(-4px);
  }

  .capability-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background-color: rgba(196, 160, 53, 0.1);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-md);
    color: var(--color-accent);
  }

  .capability-card__icon svg {
    width: 32px;
    height: 32px;
  }

  .capability-card__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-sm);
  }

  .capability-card__desc {
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .capability-cta {
    text-align: center;
    margin-top: var(--space-2xl);
  }

  /* ==================== Applications ==================== */
  .applications-grid {
    gap: var(--space-lg);
  }

  .app-card {
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    transition: all var(--transition-base);
  }

  .app-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .app-card__visual {
    aspect-ratio: 1;
    position: relative;
    overflow: hidden;
  }

  .app-card__visual-shine {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 30% 30%,
      rgba(255, 255, 255, 0.35) 0%,
      transparent 50%
    );
  }

  .app-card__body {
    padding: var(--space-md) var(--space-lg);
    text-align: center;
  }

  .app-card__body h3 {
    font-size: var(--text-lg);
    margin-bottom: 0.25rem;
  }

  .app-card__body p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* ==================== Why Choose Us ==================== */
  .why-layout {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: var(--space-4xl);
    align-items: start;
  }

  .why-layout__header h2 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .why-layout__header > p {
    color: rgba(255, 255, 255, 0.7);
    font-size: var(--text-lg);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
  }

  .why-layout__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .why-badge {
    display: inline-block;
    padding: 0.375rem 1rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent);
    border: 1px solid rgba(196, 160, 53, 0.3);
    border-radius: var(--radius-full);
  }

  .why-layout__features {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .why-feature {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
  }

  .why-feature__num {
    font-size: var(--text-2xl);
    font-weight: 800;
    color: var(--color-accent);
    opacity: 0.5;
    flex-shrink: 0;
    width: 48px;
    line-height: 1;
  }

  .why-feature__content h3 {
    color: var(--color-white);
    font-size: var(--text-lg);
    margin-bottom: var(--space-xs);
  }

  .why-feature__content p {
    color: rgba(255, 255, 255, 0.65);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  /* ==================== Final CTA ==================== */
  .final-cta {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    padding-block: var(--space-5xl);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .final-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 50%, rgba(196, 160, 53, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 50%, rgba(196, 160, 53, 0.06) 0%, transparent 50%);
  }

  .final-cta__inner {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin-inline: auto;
  }

  .final-cta__eyebrow {
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }

  .final-cta__title {
    color: var(--color-white);
    font-size: var(--text-4xl);
    margin-bottom: var(--space-md);
  }

  .final-cta__text {
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-lg);
    line-height: 1.7;
    margin-bottom: var(--space-2xl);
  }

  .final-cta__actions {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* ==================== Responsive ==================== */
  @media (max-width: 968px) {
    .why-layout {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .grid--4.capability-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .grid--4.applications-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .final-cta__title {
      font-size: var(--text-3xl);
    }
  }

  @media (max-width: 640px) {
    .grid--4.capability-grid,
    .grid--4.applications-grid {
      grid-template-columns: 1fr;
    }

    .category-card__actions {
      flex-direction: column;
    }

    .final-cta__title {
      font-size: var(--text-2xl);
    }

    .final-cta__actions {
      flex-direction: column;
    }
  }
</style>
