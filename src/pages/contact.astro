---
/**
 * Contact Page — /contact
 * Form submission via Cloudflare Worker (/api/contact)
 * Success → redirect to /thank-you; Failure → inline error message
 */
import Layout from "@layouts/Layout.astro";
import ContactForm from "@components/ContactForm.astro";

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Contact", item: "https://nixiafabric.com/contact/" },
  ],
};

const contactPageData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contact Nixia Fabric",
  description: "Contact Nixia Fabric for free samples, custom quotations, and synthetic leather manufacturing inquiries.",
  url: "https://nixiafabric.com/contact/",
};
---

<Layout
  title="Contact — Request Free Sample or Custom Quotation | Nixia Fabric"
  description="Contact Nixia Fabric for free fabric samples, custom quotations, and synthetic leather manufacturing inquiries. Factory Direct Supply with Custom Color Matching."
  keywords="contact fabric manufacturer, request free sample, custom quotation, synthetic leather supplier, glitter fabric, foil fabric"
  canonical="https://nixiafabric.com/contact/"
  structuredData={[breadcrumbData, contactPageData]}
>
  <div data-rfq-autoopen aria-hidden="true"></div>

  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__current">Contact</span>
      </nav>
      <span class="eyebrow">Get In Touch</span>
      <h1>Request Free Sample or Custom Quotation</h1>
      <p class="page-hero__desc">
        We are a professional supplier of glitter & foil-printed synthetic leather
        since 2013, serving footwear, handbag and accessory manufacturers all over the world.
        Feel free to submit your requirement below, we will reply shortly.
      </p>
    </div>
  </section>

  <!-- Inquiry Form -->
  <section class="section section--alt inquiry-section" id="inquiry">
    <div class="container">
      <div class="contact-layout">
        <div class="contact-form-wrapper">
          <h2 class="contact-form__title">Send Us Your Inquiry</h2>
          <p class="contact-form__subtitle">
            Fields marked with * are required. Keep it brief — we'll follow up for details.
          </p>

          <ContactForm />
        </div>

        <aside class="contact-sidebar">
          <div class="contact-info-card">
            <h3 class="contact-info-card__title">Contact Information</h3>
            <div class="contact-info-card__item">
              <span class="contact-info-card__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
                  <polyline points="22,6 12,13 2,6" />
                </svg>
              </span>
              <div>
                <span class="contact-info-card__label">Email</span>
                <a href="mailto:info@nixiafabric.com" class="contact-info-card__value">info@nixiafabric.com</a>
              </div>
            </div>
            <div class="contact-info-card__item">
              <span class="contact-info-card__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
                </svg>
              </span>
              <div>
                <span class="contact-info-card__label">Phone / WhatsApp</span>
                <span class="contact-info-card__value">+86 136-1689-9303</span>
              </div>
            </div>
            <div class="contact-info-card__item">
              <span class="contact-info-card__icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
              </span>
              <div>
                <span class="contact-info-card__label">Factory Location</span>
                <span class="contact-info-card__value">No.63 Chuangqi Road, Shilou Town, Panyu District, Guangzhou, China</span>
              </div>
            </div>
          </div>

          <div class="contact-quick-links">
            <h3 class="contact-quick-links__title">Quick Links</h3>
            <a href="/sample-policy/" class="contact-quick-links__item">
              <span>Sample Policy</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
            <a href="/certifications/" class="contact-quick-links__item">
              <span>Certifications</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
            <a href="/products/" class="contact-quick-links__item">
              <span>All Fabrics</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </a>
          </div>

          <div class="contact-response-card">
            <span class="contact-response-card__value">24h</span>
            <span class="contact-response-card__label">RFQ Response Time</span>
          </div>
        </aside>
      </div>
    </div>
  </section>
 </Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    padding-block: var(--space-3xl) var(--space-4xl);
    position: relative;
    overflow: hidden;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 20% 50%, rgba(196, 160, 53, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 30%, rgba(42, 65, 112, 0.4) 0%, transparent 50%);
    pointer-events: none;
  }

  .page-hero .container {
    position: relative;
    z-index: 1;
  }

  .page-hero .breadcrumb {
    margin-bottom: var(--space-lg);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
  }

  .page-hero .breadcrumb a:hover {
    color: var(--color-accent-light);
  }

  .breadcrumb__sep {
    margin-inline: var(--space-xs);
    opacity: 0.5;
  }

  .breadcrumb__current {
    color: var(--color-white);
  }

  .page-hero .eyebrow {
    color: var(--color-accent-light);
  }

  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .page-hero__desc {
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-lg);
    max-width: 640px;
  }

  /* Contact Layout */
  .contact-layout {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  /* Form */
  .contact-form-wrapper {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2xl);
  }

  .contact-form__title {
    font-size: var(--text-xl);
    color: var(--color-primary);
    margin-bottom: var(--space-xs);
  }

  .contact-form__subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-xl);
  }

  /* Contact Sidebar */
  .contact-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .contact-info-card {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
  }

  .contact-info-card__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .contact-info-card__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .contact-info-card__item:last-child {
    margin-bottom: 0;
  }

  .contact-info-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-accent);
    background-color: rgba(196, 160, 53, 0.1);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .contact-info-card__label {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: 2px;
  }

  .contact-info-card__value {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }

  a.contact-info-card__value:hover {
    color: var(--color-accent-dark);
  }

  /* Quick Links */
  .contact-quick-links {
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
  }

  .contact-quick-links__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-md);
  }

  .contact-quick-links__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-sm) 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent-dark);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    transition: color var(--transition-fast);
  }

  .contact-quick-links__item:last-child {
    border-bottom: none;
  }

  .contact-quick-links__item:hover {
    color: var(--color-accent);
  }

  /* Response Card */
  .contact-response-card {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    text-align: center;
    color: var(--color-white);
  }

  .contact-response-card__value {
    display: block;
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-accent-light);
    margin-bottom: var(--space-xs);
  }

  .contact-response-card__label {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.8);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
