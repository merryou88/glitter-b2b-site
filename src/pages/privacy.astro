---
/**
 * Privacy Policy Page — /privacy
 * GDPR / CCPA friendly B2B privacy policy
 * Required for Google Ads landing page compliance
 */
import Layout from "@layouts/Layout.astro";
import CTAButton from "@components/CTAButton.astro";

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Privacy Policy", item: "https://nixiafabric.com/privacy/" },
  ],
};

const lastUpdated = "August 2026";

const sections = [
  {
    id: "information-we-collect",
    title: "1. Information We Collect",
    paragraphs: [
      "We collect information you provide directly when you use our website and inquiry forms:",
    ],
    list: [
      "Contact details: name, company name, email address, phone number, and country — submitted through our Contact and RFQ (Request for Quotation) forms.",
      "Business details: product interests, target quantities, destination country, and end-use applications relevant to your inquiry.",
      "Communication records: messages you send us and our replies, kept for order history and customer service purposes.",
    ],
    paragraphsAfter: [
      "We also collect limited technical data automatically when you visit the site, including your IP address, browser type, pages visited, and referring pages. This data is used only in aggregate form for website analytics and security monitoring.",
    ],
  },
  {
    id: "how-we-use",
    title: "2. How We Use Your Information",
    paragraphs: [
      "We use the information we collect only to operate our B2B fabric business and serve you better:",
    ],
    list: [
      "Responding to your inquiries, sample requests, and quotation requests within 24 hours.",
      "Processing orders, arranging production, and coordinating shipment of your fabric products.",
      "Sending transactional communications such as order confirmations, shipping updates, and sample notifications.",
      "Occasionally sending product updates or promotional offers — only if you have consented. You may opt out at any time via the unsubscribe link in any email.",
      "Improving our website, products, and services based on aggregated usage data.",
    ],
  },
  {
    id: "legal-basis",
    title: "3. Legal Basis for Processing (GDPR)",
    paragraphs: [
      "If you are located in the European Economic Area (EEA), we process your personal data under one or more of the following legal bases:",
    ],
    list: [
      "Consent — when you submit an inquiry form or opt in to receive marketing communications.",
      "Legitimate interests — to respond to business inquiries, maintain customer records, and protect the security of our website.",
      "Contract performance — when processing is necessary to fulfill orders and provide quotes you have requested.",
    ],
  },
  {
    id: "data-sharing",
    title: "4. How We Share Your Information",
    paragraphs: [
      "We do not sell, trade, or rent your personal information to third parties. We share data only with service providers who help us operate our business:",
    ],
    list: [
      "Shipping carriers (DHL, FedEx, UPS) — to deliver samples and orders, limited to name, address, and contact details.",
      "Cloud infrastructure providers (Cloudflare, and similar) — for website hosting, form processing, and email delivery.",
      "Professional advisors — lawyers, accountants, or auditors, when required by law.",
    ],
    paragraphsAfter: [
      "We may also disclose information if required by law, regulation, or valid legal process, or to protect the rights, property, and safety of our company or others.",
    ],
  },
  {
    id: "cookies",
    title: "5. Cookies and Tracking",
    paragraphs: [
      "Our website uses only minimal, privacy-friendly technologies. We do not use advertising cookies or third-party behavioral trackers.",
    ],
    list: [
      "Essential cookies — required for basic site functionality and security.",
      "Analytics — aggregate, anonymized statistics about page usage to improve site performance.",
    ],
    paragraphsAfter: [
      "You can control or delete cookies through your browser settings. Disabling essential cookies may affect form submission.",
    ],
  },
  {
    id: "data-retention",
    title: "6. Data Retention",
    paragraphs: [
      "We retain inquiry and customer records for up to 5 years after our last business contact, in line with commercial record-keeping requirements and limitation periods for contractual claims. Aggregate, anonymized analytics data may be retained longer, as it cannot identify you.",
    ],
  },
  {
    id: "your-rights",
    title: "7. Your Rights",
    paragraphs: [
      "Depending on your location, you may have the following rights regarding your personal data:",
    ],
    list: [
      "Access — request a copy of the personal data we hold about you.",
      "Rectification — request correction of inaccurate or incomplete data.",
      "Erasure — request deletion of your data, subject to legal retention obligations.",
      "Restriction and objection — request that we limit processing or stop using your data for marketing.",
      "Portability — receive your data in a structured, machine-readable format.",
      "Withdraw consent — withdraw consent at any time where processing is based on it.",
    ],
    paragraphsAfter: [
      "To exercise any of these rights, email us at info@nixiafabric.com. We respond within 30 days. If you are in the EEA and believe we have mishandled your data, you also have the right to lodge a complaint with your local data protection authority.",
    ],
  },
  {
    id: "international-transfers",
    title: "8. International Data Transfers",
    paragraphs: [
      "Our company operates in China, and your data may be transferred to and processed in China and other countries where our service providers operate. When we transfer personal data internationally, we use appropriate safeguards such as standard contractual clauses to protect your data.",
    ],
  },
  {
    id: "security",
    title: "9. Data Security",
    paragraphs: [
      "We apply industry-standard measures to protect your information, including encrypted transmission (HTTPS), access controls, and minimized data collection. No method of transmission over the internet is 100% secure, but we take reasonable steps to safeguard your data against unauthorized access, alteration, or destruction.",
    ],
  },
  {
    id: "children",
    title: "10. Children's Privacy",
    paragraphs: [
      "Our website and services are intended for business users aged 18 and over. We do not knowingly collect personal information from children under 16. If you believe a child has provided us personal data, contact us and we will delete it promptly.",
    ],
  },
  {
    id: "changes",
    title: "11. Changes to This Policy",
    paragraphs: [
      "We may update this Privacy Policy from time to time to reflect changes in our practices or legal requirements. The latest version will always be posted on this page with the effective date shown above. Material changes will be highlighted on our website.",
    ],
  },
  {
    id: "contact",
    title: "12. Contact Us",
    paragraphs: [
      "For any questions about this Privacy Policy or how we handle your personal data, contact:",
    ],
    list: [
      "Guangzhou Jiahong Fabric Co., Ltd. (Nixia Fabric)",
      "Email: info@nixiafabric.com",
      "Website: https://nixiafabric.com",
    ],
  },
];
---

<Layout
  title="Privacy Policy | Nixia Fabric"
  description="How Nixia Fabric collects, uses, and protects your personal data. GDPR and CCPA friendly privacy policy for our B2B fabric inquiry and quotation services."
  keywords="privacy policy, data protection, GDPR, fabric supplier privacy"
  canonical="https://nixiafabric.com/privacy/"
  structuredData={[breadcrumbData]}
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__current">Privacy Policy</span>
      </nav>
      <span class="eyebrow">Legal</span>
      <h1>Privacy Policy</h1>
      <p class="page-hero__desc">
        We collect only the information needed to answer your fabric inquiries and
        serve your orders. This page explains what we collect, how we use it,
        and the rights you have over your data.
      </p>
      <p class="page-hero__updated">Last updated: {lastUpdated}</p>
    </div>
  </section>

  <!-- Policy Content -->
  <section class="section">
    <div class="container">
      <div class="policy-layout">
        <nav class="policy-toc" aria-label="Table of contents">
          <span class="policy-toc__title">On this page</span>
          <ul class="policy-toc__list">
            {sections.map((s) => (
              <li><a href={`#${s.id}`}>{s.title}</a></li>
            ))}
          </ul>
        </nav>

        <div class="policy-content">
          {sections.map((s) => (
            <section class="policy-section" id={s.id}>
              <h2>{s.title}</h2>
              {s.paragraphs?.map((p) => <p>{p}</p>)}
              {s.list && (
                <ul class="policy-list">
                  {s.list.map((item) => (
                    <li class="policy-list__item">
                      <span class="policy-list__icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M20 6L9 17l-5-5" />
                        </svg>
                      </span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}
              {s.paragraphsAfter?.map((p) => <p>{p}</p>)}
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--dark">
    <div class="container text-center">
      <span class="eyebrow">Questions?</span>
      <h2>Talk to Our Team</h2>
      <p style="max-width: 600px; margin: var(--space-lg) auto var(--space-2xl);">
        If you have any questions about your data or our products,
        reach out and we will respond within 24 hours.
      </p>
      <div class="btn-group" style="justify-content: center;">
        <CTAButton href="/contact/" variant="primary" size="lg">Contact Us</CTAButton>
        <CTAButton href="/products/" variant="secondary" size="lg">Explore Fabrics</CTAButton>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    padding-block: var(--space-3xl) var(--space-4xl);
    position: relative;
    overflow: hidden;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 20% 50%, rgba(196, 160, 53, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 30%, rgba(42, 65, 112, 0.4) 0%, transparent 50%);
    pointer-events: none;
  }

  .page-hero .container {
    position: relative;
    z-index: 1;
  }

  .page-hero .breadcrumb {
    margin-bottom: var(--space-lg);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
  }

  .page-hero .breadcrumb a:hover {
    color: var(--color-accent-light);
  }

  .breadcrumb__sep {
    margin-inline: var(--space-xs);
    opacity: 0.5;
  }

  .breadcrumb__current {
    color: var(--color-white);
  }

  .page-hero .eyebrow {
    color: var(--color-accent-light);
  }

  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .page-hero__desc {
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-lg);
    max-width: 640px;
  }

  .page-hero__updated {
    color: rgba(255, 255, 255, 0.5);
    font-size: var(--text-sm);
    margin-top: var(--space-md);
  }

  /* Policy Layout */
  .policy-layout {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  /* TOC */
  .policy-toc {
    position: sticky;
    top: calc(var(--header-height) + var(--space-lg));
    padding: var(--space-lg);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .policy-toc__title {
    display: block;
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: var(--space-md);
  }

  .policy-toc__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .policy-toc__list a {
    font-size: var(--text-sm);
    color: var(--color-text-muted, #5a6472);
    text-decoration: none;
    line-height: 1.5;
    transition: color var(--transition-base);
  }

  .policy-toc__list a:hover {
    color: var(--color-accent);
  }

  /* Sections */
  .policy-section {
    padding-bottom: var(--space-2xl);
    margin-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
  }

  .policy-section:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .policy-section h2 {
    font-size: var(--text-xl, 1.375rem);
    color: var(--color-primary);
    margin-bottom: var(--space-md);
    scroll-margin-top: calc(var(--header-height) + var(--space-lg));
  }

  .policy-section p {
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  /* List */
  .policy-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .policy-list__item {
    display: flex;
    gap: var(--space-sm);
    align-items: flex-start;
    line-height: 1.6;
  }

  .policy-list__icon {
    flex-shrink: 0;
    display: inline-flex;
    margin-top: 4px;
    color: var(--color-accent);
  }

  /* Responsive */
  @media (max-width: 992px) {
    .policy-layout {
      grid-template-columns: 1fr;
    }

    .policy-toc {
      position: static;
    }
  }
</style>
