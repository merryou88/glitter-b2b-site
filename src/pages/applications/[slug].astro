      "Review pattern scale and panel placement from expected audience distance.",
      "Record the approved product, color and batch standard for repeat orders.",
    ],
    blogSlugs: [
      "best-fabric-for-cheerleading-and-performance-costumes",
      "stretch-recovery-vs-stretch-amount-fabric-buyers",
      "pre-shipment-quality-control-checklist-foil-stretch-fabric",
    ],
    sourcingScenario: {
      buyer: "Team uniform supplier",
      brief: "A supplier is planning coordinated performance uniforms that need a consistent team color, readable foil effect and a practical route for later replenishment.",
      decisions: [
        "Review color and pattern scale under competition lighting and from spectator distance.",
        "Test recovery and surface appearance at the working tension of the uniform pattern.",
        "Record the selected construction and color reference so future quotation requests use the same starting point.",
      ],
      rfq: "The RFQ should include team color reference, garment panels, size range, initial quantity, replenishment estimate and event deadline.",
    },
    faqs: [
      {
        question: "What should buyers check for cheerleading fabric?",
        answer:
          "Check stretch direction, recovery, opacity, hand feel, sewing behavior and whether the surface keeps its appearance after repeated movement.",
      },
      {
        question: "Can team colors be matched for performance costumes?",
        answer:
          "Custom color development can be discussed for bulk orders. Send a Pantone reference, approved swatch or clear color target with the estimated quantity.",
      },
    ],
  },
];

export function getStaticPaths() {
  return [
    "foil-fabric-for-stage-costumes",
    "custom-foil-fabric-development",
    "holographic-fabric-wholesale",
    "dancewear-fabric-supplier",
    "swimwear-fabric-supplier",
    "cheerleading-performance-costume-fabric",
  ].map((slug) => ({ params: { slug } }));
}

const page = applicationPages.find((item) => item.slug === Astro.params.slug);
if (!page) throw new Error(`Unknown application page: ${Astro.params.slug}`);
const relatedProducts = page.productSlugs?.length
  ? page.productSlugs
      .map((slug) => performanceProducts.find((product) => product.slug === slug))
      .filter(Boolean)
  : page.tags.length === 0
    ? performanceProducts
    : performanceProducts.filter((product) => page.tags.some((tag) => product.tags.includes(tag)));
const shortlistProducts = page.shortlist.map((item) => ({
  ...item,
  product: performanceProducts.find((product) => product.slug === item.slug),
})).filter((item) => item.product);
const relatedGuides = page.blogSlugs
  .map((slug) => blogArticles.find((article) => article.slug === slug))
  .filter(Boolean);
const findRowValue = (rows, labels) => {
  const normalizedLabels = labels.map((label) => label.toLowerCase());
  return rows?.find((row) => normalizedLabels.includes(row.label.toLowerCase()))?.value;
};
const productField = (product, labels, fallback = "Confirm by sample") =>
  findRowValue(product.specTable, labels) || fallback;
const productMoq = (product) =>
  findRowValue(product.specTable, ["MOQ"]) ||
  findRowValue(product.b2bTable, ["MOQ"]) ||
  product.specs.moq;

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Applications", item: "https://nixiafabric.com/applications/" },
    { "@type": "ListItem", position: 3, name: page.title, item: `https://nixiafabric.com/applications/${page.slug}/` },
  ],
};

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: page.title,
  description: page.description,
  url: `https://nixiafabric.com/applications/${page.slug}/`,
  about: page.applications.length > 0 ? page.applications : ["Custom foil fabric development"],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: page.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<Layout
  title={page.metaTitle}
  description={page.description}
  keywords={page.keywords}
  canonical={`https://nixiafabric.com/applications/${page.slug}/`}
  image={page.image}
  structuredData={[breadcrumbData, pageSchema, faqSchema]}
  footerFocus="foil"
>
  <section class="application-hero">
    <div class="container application-hero__grid">
      <div class="application-hero__copy">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/applications/">Applications</a>
          <span>/</span>
          <span aria-current="page">{page.title}</span>
        </nav>
        <span class="eyebrow">B2B APPLICATION GUIDE</span>
        <h1>{page.title}</h1>
        <p>{page.intro}</p>
        <div class="application-hero__actions">
          <a href="/contact/" data-rfq-open class="btn btn--primary btn--lg">Request a Quote</a>
          <a href="/products/" class="btn btn--outline btn--lg">Browse All Products</a>
        </div>
      </div>
      <picture class="application-hero__image">
        <img src={page.image} alt={page.imageAlt} width="1200" height="800" fetchpriority="high" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container application-content">
      <div>
        <span class="eyebrow">WHAT BUYERS REVIEW</span>
        <h2>Choose the right material for your production</h2>
        <p>
          A fabric that looks right in a photo still needs to work in cutting, sewing,
          bonding, packaging and shipment. We help buyers compare the practical details
          before a stock or custom route is quoted.
        </p>
        <ul class="application-benefits">
          {page.benefits.map((benefit) => <li>{benefit}</li>)}
        </ul>
      </div>
      <aside class="application-note">
        <span class="eyebrow">RFQ CHECKLIST</span>
        <h2>Share these details for a faster reply</h2>
        <ul>
          <li>End product and application</li>
          <li>Approximate quantity</li>
          <li>Target color or reference image</li>
          <li>Required width or backing</li>
          <li>Destination country</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-header section-header--left">
        <span class="eyebrow">SELECTION CRITERIA</span>
        <h2>How to shortlist fabric for this application</h2>
        <p>Use the end product and production method to narrow the material route before comparing color or price.</p>
      </div>
      <div class="criteria-grid">
        {page.selectionCriteria.map((criterion, index) => (
          <article class="criterion">
            <span class="criterion__number">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h3>{criterion.title}</h3>
              <p>{criterion.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section scenario-band">
    <div class="container scenario-grid">
      <div class="scenario-summary">
        <span class="eyebrow">COMMON SOURCING SCENARIO</span>
        <h2>{page.sourcingScenario.buyer}</h2>
        <p>{page.sourcingScenario.brief}</p>
        <small>Illustrative scenario based on recurring buyer requirements. It is not a named customer case or a performance claim.</small>
      </div>
      <div class="scenario-decisions">
        <h3>Practical decision path</h3>
        <ol>
          {page.sourcingScenario.decisions.map((decision) => <li>{decision}</li>)}
        </ol>
        <p><strong>Prepare the RFQ:</strong> {page.sourcingScenario.rfq}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header section-header--left">
        <span class="eyebrow">BUYER SHORTLIST</span>
        <h2>Compare practical starting points</h2>
        <p>These products represent different surface and construction routes. Final approval should be based on a physical sample and the requirements of your project.</p>
      </div>
      <div class="comparison-table" tabindex="0" role="region" aria-label={`Product comparison for ${page.title}`}>
        <table>
          <thead>
            <tr>
              <th scope="col">Product</th>
              <th scope="col">Surface</th>
              <th scope="col">Base</th>
              <th scope="col">Stretch</th>
              <th scope="col">Weight</th>
              <th scope="col">MOQ</th>
              <th scope="col">Why shortlist it</th>
            </tr>
          </thead>
          <tbody>
            {shortlistProducts.map(({ product, fit }) => (
              <tr>
                <th scope="row"><a href={`/products/${product.slug}/`}>{product.title}</a></th>
                <td>{productField(product, ["Surface Effect", "Surface Finish", "Surface"])}</td>
                <td>{productField(product, ["Base Fabric", "Base Material", "Material"], product.specs.baseMaterial || "Confirm by sample")}</td>
                <td>{productField(product, ["Stretch"])}</td>
                <td>{productField(product, ["Weight"], product.specs.weight || "Confirm by sample")}</td>
                <td>{productMoq(product)}</td>
                <td>{fit}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-header section-header--left">
        <span class="eyebrow">RECOMMENDED MATERIALS</span>
        <h2>Products for {page.title.replace(" | Wholesale Supplier", "")}</h2>
        <p>Review the specifications and request a sample or quotation for the material closest to your project.</p>
      </div>
      <div class="application-products">
        {relatedProducts.map((product) => (
          <article class="application-product">
            <a href={`/products/${product.slug}/`} class="application-product__image">
              <img src={product.mainImageUrl} alt={product.mainImageAlt} width="800" height="800" loading="lazy" />
            </a>
            <div class="application-product__body">
              <h3><a href={`/products/${product.slug}/`}>{product.title}</a></h3>
              <p>{product.shortIntro}</p>
              <div class="application-product__meta">
                <span>MOQ {productMoq(product)}</span>
                <span>{product.specs.width}</span>
                <span>{product.stockStatus}</span>
              </div>
              <a href={`/products/${product.slug}/`} class="application-product__link">View product specifications</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container approval-grid">
      <div>
        <span class="eyebrow">SAMPLE APPROVAL</span>
        <h2>Checks to complete before bulk production</h2>
        <p class="approval-intro">Record the approved sample and test it in the intended garment construction so the quotation, sample and production standard stay aligned.</p>
        <ol class="sample-checks">
          {page.sampleChecks.map((item) => <li>{item}</li>)}
        </ol>
      </div>
      <aside class="commercial-path">
        <span class="eyebrow">PROJECT RFQ</span>
        <h2>Move from shortlist to quotation</h2>
        <p>Send the product links you are comparing together with your application, quantity, target color, destination and required test standards. We will confirm the relevant sample and quotation route.</p>
        <div class="commercial-path__actions">
          <a href="/contact/" data-rfq-open class="btn btn--primary">Request Samples & Quote</a>
          <a href="/sample-policy/" class="text-link">Review sample policy</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-header section-header--left">
        <span class="eyebrow">RELATED BUYER GUIDES</span>
        <h2>Plan the next sourcing decision</h2>
        <p>Use these guides to prepare sample comparisons, testing questions and a clearer RFQ.</p>
      </div>
      <div class="guide-grid">
        {relatedGuides.map((guide) => (
          <article class="guide-item">
            <span>{guide.category} · {guide.readTime}</span>
            <h3><a href={`/blog/${guide.slug}/`}>{guide.title}</a></h3>
            <p>{guide.excerpt}</p>
            <a href={`/blog/${guide.slug}/`} class="text-link">Read buyer guide</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container application-faq">
      <div class="section-header section-header--left">
        <span class="eyebrow">BUYER QUESTIONS</span>
        <h2>Frequently asked questions</h2>
      </div>
      {page.faqs.map((faq) => (
        <details>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>

<style>
  .application-hero {
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-3xl);
  }

  .application-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
    align-items: center;
    gap: var(--space-3xl);
  }

  .application-hero__copy .breadcrumb {
    margin-bottom: var(--space-xl);
    color: var(--color-text-muted);
  }

  .application-hero__copy .breadcrumb a {
    color: var(--color-text-secondary);
  }

  .application-hero h1 {
    max-width: 760px;
    margin: var(--space-sm) 0 var(--space-md);
    color: var(--color-primary);
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.12;
  }

  .application-hero__copy > p {
    max-width: 650px;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .application-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .application-hero__image {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-white);
    box-shadow: var(--shadow-md);
  }

  .application-hero__image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .application-content {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: var(--space-3xl);
    align-items: start;
  }

  .application-content h2,
  .application-note h2 {
    margin: var(--space-sm) 0 var(--space-md);
    color: var(--color-primary);
  }

  .application-content p {
    max-width: 700px;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .application-benefits,
  .application-note ul {
    display: grid;
    gap: var(--space-sm);
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
  }

  .application-benefits li,
  .application-note li {
    position: relative;
    padding-left: 1.35rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .application-benefits li::before,
  .application-note li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .application-note {
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    background: var(--color-bg-alt);
  }

  .criteria-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-2xl);
  }

  .criterion {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .criterion__number {
    color: var(--color-accent-dark);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .criterion h3,
  .guide-item h3 {
    margin: 0 0 var(--space-sm);
    color: var(--color-primary);
    font-size: var(--text-lg);
    line-height: 1.35;
  }

  .criterion p,
  .guide-item p {
    margin: 0;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .comparison-table {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
  }

  .comparison-table:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .comparison-table table {
    width: 100%;
    min-width: 1120px;
    border-collapse: collapse;
    font-size: var(--text-sm);
    text-align: left;
  }

  .comparison-table th,
  .comparison-table td {
    padding: var(--space-md);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
    line-height: 1.5;
  }

  .comparison-table thead th {
    background: var(--color-bg-alt);
    color: var(--color-primary);
    font-size: var(--text-xs);
    text-transform: uppercase;
  }

  .comparison-table tbody tr:last-child th,
  .comparison-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .comparison-table tbody th {
    min-width: 220px;
    color: var(--color-primary);
  }

  .comparison-table tbody th a,
  .guide-item h3 a {
    color: inherit;
  }

  .comparison-table td:last-child {
    min-width: 260px;
  }

  .application-products {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .application-product {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-white);
  }

  .application-product__image {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--color-bg);
  }

  .application-product__image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .application-product:hover .application-product__image img {
    transform: scale(1.04);
  }

  .application-product__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-lg);
  }

  .application-product h3 {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.35;
  }

  .application-product h3 a {
    color: var(--color-primary);
  }

  .application-product p {
    margin: var(--space-sm) 0 var(--space-md);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .application-product__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    margin-top: auto;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .application-product__link {
    margin-top: var(--space-md);
    color: var(--color-accent-dark);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .scenario-band {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .scenario-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: var(--space-3xl);
    align-items: start;
  }

  .scenario-band .eyebrow {
    color: var(--color-accent-light);
  }

  .scenario-summary h2,
  .scenario-decisions h3 {
    color: var(--color-white);
  }

  .scenario-summary h2 {
    margin: var(--space-sm) 0 var(--space-md);
  }

  .scenario-summary p,
  .scenario-decisions > p {
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.7;
  }

  .scenario-summary small {
    display: block;
    margin-top: var(--space-xl);
    color: rgba(255, 255, 255, 0.58);
    font-size: var(--text-xs);
    line-height: 1.6;
  }

  .scenario-decisions h3 {
    margin: 0 0 var(--space-lg);
    font-size: var(--text-xl);
  }

  .scenario-decisions ol {
    display: grid;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: scenario-step;
  }

  .scenario-decisions li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-md);
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
    counter-increment: scenario-step;
  }

  .scenario-decisions li::before {
    content: counter(scenario-step);
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.36);
    border-radius: 50%;
    color: var(--color-accent-light);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .scenario-decisions > p {
    margin: var(--space-xl) 0 0;
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .scenario-decisions strong {
    color: var(--color-white);
  }

  .approval-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.9fr);
    gap: var(--space-3xl);
    align-items: start;
  }

  .approval-grid h2,
  .commercial-path h2 {
    margin: var(--space-sm) 0 var(--space-md);
    color: var(--color-primary);
  }

  .approval-intro,
  .commercial-path p {
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .sample-checks {
    display: grid;
    gap: var(--space-md);
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: sample-check;
  }

  .sample-checks li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-md);
    align-items: start;
    color: var(--color-text);
    line-height: 1.6;
    counter-increment: sample-check;
  }

  .sample-checks li::before {
    content: counter(sample-check);
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    color: var(--color-accent-dark);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .commercial-path {
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent);
    background: var(--color-bg-alt);
  }

  .commercial-path__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .text-link {
    color: var(--color-accent-dark);
    font-weight: 700;
  }

  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-xl);
  }

  .guide-item {
