---
/**
 * Application landing pages for search-led B2B fabric sourcing.
 * Each page has one clear buying use case and links to relevant products.
 */
import Layout from "@layouts/Layout.astro";
import { performanceProducts } from "@data/allProducts";

const applicationPages = [
  {
    slug: "foil-fabric-for-stage-costumes",
    title: "Foil Fabric for Stage & Dancewear",
    metaTitle: "Foil Fabric for Stage Costumes | Nixia Fabric",
    keywords: "stage costume fabric supplier, foil fabric for stage costumes, dancewear fabric wholesale, performance costume fabric",
    description:
      "Hot-stamping foil and iridescent stretch fabrics for stage costumes and dancewear, with sample approval support.",
    intro:
      "Stage and performance buyers need a strong metallic or color-shifting effect that reads under changing light while remaining practical to cut and sew. Compare foil and stretch options by costume application.",
    image: "/shots/application-costume-foil.webp",
    imageAlt: "Foil fabric for stage costumes and performance outfits",
    tags: ["stage-costume"],
    applications: ["Stage costumes", "Dancewear", "Performance costumes"],
    benefits: [
      "Foil and iridescent finishes for stage lighting",
      "Stretch options for fitted costumes and dancewear",
      "Gradient color-flow and metallic surface choices",
      "Physical sample approval before a production run",
    ],
    faqs: [
      {
        question: "Which fabric finish works best under stage lights?",
        answer:
          "Iridescent laser and gradient foil finishes shift with light and viewing angle. The best choice depends on the costume distance, lighting and desired surface effect.",
      },
      {
        question: "Can you match a costume color or reference?",
        answer:
          "Custom color matching can be discussed for bulk orders. Send a Pantone reference, photo or physical swatch together with the required quantity.",
      },
    ],
  },
  {
    slug: "custom-foil-fabric-development",
    title: "Custom Foil Fabric Development",
    metaTitle: "Custom Foil Fabric Development | Nixia Fabric",
    keywords: "custom foil fabric manufacturer, custom stretch fabric supplier, custom holographic fabric, OEM foil fabric",
    description:
      "Develop custom foil, iridescent and stretch fabrics for stage costumes, dancewear, performance wear and party apparel.",
    intro:
      "When a stock color or standard finish is not enough, we can review your target appearance and end product before confirming a development route. Custom scope, sample timing and quotation are based on the actual requirement.",
    image: "/images/process/hot_stamping_foil_transfer.webp",
    imageAlt: "Hot-stamping foil fabric production and custom finishing",
    tags: [],
    applications: [],
    benefits: [
      "Custom color, pattern and gradient discussions",
      "Base fabric, width and thickness discussions",
      "Sample and approval workflow",
      "Testing support arranged according to buyer requirements",
    ],
    faqs: [
      {
        question: "What information is needed for a custom fabric quote?",
        answer:
          "Share the end product, target appearance, base material, width, thickness, approximate quantity, destination and any reference image or physical sample.",
      },
      {
        question: "Do custom fabrics require a separate sample approval?",
        answer:
          "Yes. Custom colors, patterns or finishes should be reviewed on a physical approval sample before bulk production is confirmed.",
      },
    ],
  },
  {
    slug: "holographic-fabric-wholesale",
    title: "Wholesale Holographic Fabric",
    metaTitle: "Wholesale Holographic Fabric | Nixia Fabric",
    keywords: "holographic fabric wholesale, holographic spandex fabric, holographic stretch fabric supplier, holographic costume fabric",
    description:
      "Source holographic stretch and foil fabrics for dancewear, stage costumes and performance apparel. Compare samples, MOQ and custom color options.",
    intro:
      "Buyers searching for holographic fabric usually need a reflective or color-shifting surface that remains practical for costume production. Compare stretch, recovery, width, MOQ and sample approval before choosing a stock or custom option.",
    image: "/images/products/plain-iridescent-laser-spandex-4-way-stretch/application/7.webp",
    imageAlt: "Holographic stretch fabric for dancewear and stage costumes",
    productSlugs: [
      "plain-iridescent-laser-spandex-4-way-stretch",
      "iridescent-laser-hot-stamping-stretch-ice-silk",
      "iridescent-gradient-laser-ice-silk",
      "blue-purple-gradient-laser-foil-spandex-fabric",
    ],
    tags: [],
    applications: ["Holographic dancewear", "Stage costumes", "Performance apparel"],
    benefits: [
      "Reflective and color-shifting finishes for performance lighting",
      "4-way stretch options for fitted costumes and dancewear",
      "Metric and US-friendly width and MOQ specifications",
      "Physical samples for shine, stretch and sewing review",
    ],
    faqs: [
      {
        question: "Is holographic fabric suitable for fitted dancewear?",
        answer:
          "Yes, when it uses a stretch base with suitable recovery. Test a physical sample for movement, sewing and surface appearance before bulk production.",
      },
      {
        question: "Can holographic colors or effects be customized?",
        answer:
          "Custom foil colors, gradients and related surface effects can be discussed for bulk orders based on the reference and required quantity.",
      },
    ],
  },
  {
    slug: "dancewear-fabric-supplier",
    title: "Dancewear Fabric Supplier",
    metaTitle: "Dancewear Fabric Supplier | Stretch Foil Fabrics",
    keywords: "dancewear fabric supplier, dancewear fabric wholesale, 4-way stretch fabric for dancewear, foil spandex fabric",
    description:
      "Source 4-way stretch foil, iridescent and holographic fabrics for dancewear, bodysuits and competition costumes. Samples and custom development available.",
    intro:
      "Dancewear fabric needs more than visual impact. Buyers should compare stretch direction, recovery, hand feel, width, sewing behavior and surface performance before approving fabric for bodysuits, leotards or competition costumes.",
    image: "/images/products/full-print-hot-stamping-spandex-milk-silk/application/2.webp",
    imageAlt: "Stretch foil fabric for dancewear and competition costumes",
    productSlugs: [
      "plain-iridescent-laser-spandex-4-way-stretch",
      "full-print-hot-stamping-spandex-milk-silk",
      "shiny-foil-4-way-stretch-knit-fabric",
      "iridescent-gradient-laser-ice-silk",
    ],
    tags: [],
    applications: ["Dancewear", "Bodysuits", "Competition costumes"],
    benefits: [
      "4-way stretch and recovery options for fitted garments",
      "Foil, iridescent and holographic surface choices",
      "Samples for stretch, sewing, comfort and lighting tests",
      "Custom colors and surface development for bulk programs",
    ],
    faqs: [
      {
        question: "What fabric works best for dancewear and bodysuits?",
        answer:
          "A 4-way stretch fabric with reliable recovery is usually the practical starting point. The final choice should also match the garment pattern, opacity, hand feel and required shine.",
      },
      {
        question: "Can I test dancewear fabric before placing a bulk order?",
        answer:
          "Yes. Request samples to test stretch, recovery, sewing, comfort and the foil effect under the lighting used by the final performance.",
      },
    ],
  },
  {
    slug: "cheerleading-performance-costume-fabric",
    title: "Cheerleading & Performance Costume Fabric",
    metaTitle: "Cheerleading Fabric Wholesale | Nixia Fabric",
    keywords: "cheerleading fabric wholesale, cheerleading uniform fabric supplier, performance costume fabric, stretch foil fabric",
    description:
      "Wholesale stretch foil fabrics for cheerleading uniforms and performance costumes. Compare recovery, shine, width, MOQ, samples and custom colors.",
    intro:
      "Cheerleading and team performance costumes need consistent color, strong recovery and a surface that keeps its visual effect through movement. Review physical samples and commercial specifications before confirming a team or collection order.",
    image: "/images/products/iridescent-laser-hot-stamping-stretch-ice-silk/application/1.webp",
    imageAlt: "Stretch foil fabric for cheerleading and performance costumes",
    productSlugs: [
      "plain-iridescent-laser-spandex-4-way-stretch",
      "shiny-foil-4-way-stretch-knit-fabric",
      "blue-purple-gradient-laser-foil-spandex-fabric",
      "rainbow-dot-laser-foil-knit-fabric",
    ],
    tags: [],
    applications: ["Cheerleading uniforms", "Team costumes", "Performance wear"],
    benefits: [
      "Stretch and recovery options for active performance garments",
      "High-impact foil finishes for team and stage visibility",
      "Sample approval for color and repeat-order comparison",
      "Custom color discussions for team or collection programs",
    ],
    faqs: [
      {
        question: "What should buyers check for cheerleading fabric?",
        answer:
          "Check stretch direction, recovery, opacity, hand feel, sewing behavior and whether the surface keeps its appearance after repeated movement.",
      },
      {
        question: "Can team colors be matched for performance costumes?",
        answer:
          "Custom color development can be discussed for bulk orders. Send a Pantone reference, approved swatch or clear color target with the estimated quantity.",
      },
    ],
  },
];

export function getStaticPaths() {
  return [
    "foil-fabric-for-stage-costumes",
    "custom-foil-fabric-development",
    "holographic-fabric-wholesale",
    "dancewear-fabric-supplier",
    "cheerleading-performance-costume-fabric",
  ].map((slug) => ({ params: { slug } }));
}

const page = applicationPages.find((item) => item.slug === Astro.params.slug);
if (!page) throw new Error(`Unknown application page: ${Astro.params.slug}`);
const relatedProducts = page.productSlugs?.length
  ? page.productSlugs
      .map((slug) => performanceProducts.find((product) => product.slug === slug))
      .filter(Boolean)
  : page.tags.length === 0
    ? performanceProducts
    : performanceProducts.filter((product) => page.tags.some((tag) => product.tags.includes(tag)));
const findRowValue = (rows, labels) =>
  rows?.find((row) => labels.includes(row.label))?.value;
const productMoq = (product) =>
  findRowValue(product.specTable, ["MOQ"]) ||
  findRowValue(product.b2bTable, ["MOQ"]) ||
  product.specs.moq;

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Applications", item: "https://nixiafabric.com/applications/" },
    { "@type": "ListItem", position: 3, name: page.title, item: `https://nixiafabric.com/applications/${page.slug}/` },
  ],
};

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: page.title,
  description: page.description,
  url: `https://nixiafabric.com/applications/${page.slug}/`,
  about: page.applications.length > 0 ? page.applications : ["Custom foil fabric development"],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: page.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<Layout
  title={page.metaTitle}
  description={page.description}
  keywords={page.keywords}
  canonical={`https://nixiafabric.com/applications/${page.slug}/`}
  image={page.image}
  structuredData={[breadcrumbData, pageSchema, faqSchema]}
  footerFocus="foil"
>
  <section class="application-hero">
    <div class="container application-hero__grid">
      <div class="application-hero__copy">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <a href="/applications/">Applications</a>
          <span>/</span>
          <span aria-current="page">{page.title}</span>
        </nav>
        <span class="eyebrow">B2B APPLICATION GUIDE</span>
        <h1>{page.title}</h1>
        <p>{page.intro}</p>
        <div class="application-hero__actions">
          <a href="/contact/" data-rfq-open class="btn btn--primary btn--lg">Request a Quote</a>
          <a href="/products/" class="btn btn--outline btn--lg">Browse All Products</a>
        </div>
      </div>
      <picture class="application-hero__image">
        <img src={page.image} alt={page.imageAlt} width="1200" height="800" fetchpriority="high" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container application-content">
      <div>
        <span class="eyebrow">WHAT BUYERS REVIEW</span>
        <h2>Choose the right material for your production</h2>
        <p>
          A fabric that looks right in a photo still needs to work in cutting, sewing,
          bonding, packaging and shipment. We help buyers compare the practical details
          before a stock or custom route is quoted.
        </p>
        <ul class="application-benefits">
          {page.benefits.map((benefit) => <li>{benefit}</li>)}
        </ul>
      </div>
      <aside class="application-note">
        <span class="eyebrow">RFQ CHECKLIST</span>
        <h2>Share these details for a faster reply</h2>
        <ul>
          <li>End product and application</li>
          <li>Approximate quantity</li>
          <li>Target color or reference image</li>
          <li>Required width or backing</li>
          <li>Destination country</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-header section-header--left">
        <span class="eyebrow">RECOMMENDED MATERIALS</span>
        <h2>Products for {page.title.replace(" | Wholesale Supplier", "")}</h2>
        <p>Review the specifications and request a sample or quotation for the material closest to your project.</p>
      </div>
      <div class="application-products">
        {relatedProducts.map((product) => (
          <article class="application-product">
            <a href={`/products/${product.slug}/`} class="application-product__image">
              <img src={product.mainImageUrl} alt={product.mainImageAlt} width="800" height="800" loading="lazy" />
            </a>
            <div class="application-product__body">
              <h3><a href={`/products/${product.slug}/`}>{product.title}</a></h3>
              <p>{product.shortIntro}</p>
              <div class="application-product__meta">
                <span>MOQ {productMoq(product)}</span>
                <span>{product.specs.width}</span>
                <span>{product.stockStatus}</span>
              </div>
              <a href={`/products/${product.slug}/`} class="application-product__link">View product specifications</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container application-faq">
      <div class="section-header section-header--left">
        <span class="eyebrow">BUYER QUESTIONS</span>
        <h2>Frequently asked questions</h2>
      </div>
      {page.faqs.map((faq) => (
        <details>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>
</Layout>

<style>
  .application-hero {
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-3xl);
  }

  .application-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
    align-items: center;
    gap: var(--space-3xl);
  }

  .application-hero__copy .breadcrumb {
    margin-bottom: var(--space-xl);
    color: var(--color-text-muted);
  }

  .application-hero__copy .breadcrumb a {
    color: var(--color-text-secondary);
  }

  .application-hero h1 {
    max-width: 760px;
    margin: var(--space-sm) 0 var(--space-md);
    color: var(--color-primary);
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.12;
  }

  .application-hero__copy > p {
    max-width: 650px;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .application-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .application-hero__image {
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-white);
    box-shadow: var(--shadow-md);
  }

  .application-hero__image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .application-content {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: var(--space-3xl);
    align-items: start;
  }

  .application-content h2,
  .application-note h2 {
    margin: var(--space-sm) 0 var(--space-md);
    color: var(--color-primary);
  }

  .application-content p {
    max-width: 700px;
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  .application-benefits,
  .application-note ul {
    display: grid;
    gap: var(--space-sm);
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
  }

  .application-benefits li,
  .application-note li {
    position: relative;
    padding-left: 1.35rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .application-benefits li::before,
  .application-note li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .application-note {
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-accent);
    background: var(--color-bg-alt);
  }

  .application-products {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .application-product {
    display: flex;
    flex-direction: column;
    min-width: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-white);
  }

  .application-product__image {
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--color-bg);
  }

  .application-product__image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .application-product:hover .application-product__image img {
    transform: scale(1.04);
  }

  .application-product__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: var(--space-lg);
  }

  .application-product h3 {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.35;
  }

  .application-product h3 a {
    color: var(--color-primary);
  }

  .application-product p {
    margin: var(--space-sm) 0 var(--space-md);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .application-product__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.75rem;
    margin-top: auto;
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .application-product__link {
    margin-top: var(--space-md);
    color: var(--color-accent-dark);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .application-faq {
    max-width: 900px;
  }

  .application-faq details {
    border-top: 1px solid var(--color-border);
  }

  .application-faq details:last-of-type {
    border-bottom: 1px solid var(--color-border);
  }

  .application-faq summary {
    cursor: pointer;
    padding: var(--space-lg) 2rem var(--space-lg) 0;
    color: var(--color-primary);
    font-weight: 700;
    list-style: none;
    position: relative;
  }

  .application-faq summary::-webkit-details-marker {
    display: none;
  }

  .application-faq summary::after {
    content: "+";
    position: absolute;
    right: 0;
    top: var(--space-lg);
    color: var(--color-accent-dark);
    font-size: 1.25rem;
    font-weight: 400;
  }

  .application-faq details[open] summary::after {
    content: "−";
  }

  .application-faq details p {
    max-width: 760px;
    margin: -0.25rem 0 var(--space-lg);
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .application-hero__grid,
    .application-content {
      grid-template-columns: 1fr;
    }

    .application-hero__image {
      max-width: 680px;
    }

    .application-products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .application-hero {
      padding-block: var(--space-2xl);
    }

    .application-hero__actions {
      flex-direction: column;
    }

    .application-hero__actions .btn {
      width: 100%;
    }

    .application-products {
      grid-template-columns: 1fr;
    }
  }
</style>
