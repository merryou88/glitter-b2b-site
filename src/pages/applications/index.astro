---
import Layout from "@layouts/Layout.astro";

const applications = [
  {
    href: "/applications/foil-fabric-for-stage-costumes/",
    title: "Foil Fabric for Stage & Dancewear",
    description: "Hot-stamping foil and iridescent stretch fabrics for stage costumes, dancewear and performance outfits.",
    image: "/shots/application-costume-foil.webp",
    alt: "Foil fabric for stage costumes",
  },
  {
    href: "/applications/custom-foil-fabric-development/",
    title: "Custom Foil Fabric Development",
    description: "Custom development for foil, iridescent and stretch fabrics for costume production.",
    image: "/images/process/hot_stamping_foil_transfer.webp",
    alt: "Custom hot-stamping foil fabric manufacturing",
  },
  {
    href: "/applications/holographic-fabric-wholesale/",
    title: "Holographic Fabric Wholesale",
    description: "Holographic stretch and foil fabrics for dancewear, stage costumes and performance apparel buyers.",
    image: "/images/products/H2013090102/application/7.webp",
    alt: "Wholesale holographic stretch fabric",
  },
  {
    href: "/applications/dancewear-fabric-supplier/",
    title: "Dancewear Fabric Supplier",
    description: "4-way stretch foil, iridescent and holographic fabrics for bodysuits and competition costumes.",
    image: "/images/products/H2013060101/application/2.webp",
    alt: "Stretch foil fabric for dancewear",
  },
  {
    href: "/applications/cheerleading-performance-costume-fabric/",
    title: "Cheerleading & Performance Costume Fabric",
    description: "Stretch foil fabrics for cheerleading uniforms, team costumes and performance collections.",
    image: "/images/products/H2013120107/application/1.webp",
    alt: "Foil fabric for cheerleading and performance costumes",
  },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Performance Costume & Dancewear Fabric Applications",
  description: "Application guides for buyers sourcing foil, holographic, iridescent and stretch fabrics for performance costumes and dancewear.",
  url: "https://nixiafabric.com/applications/",
};

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Applications", item: "https://nixiafabric.com/applications/" },
  ],
};
---

<Layout
  title="Performance Costume & Dancewear Fabric Applications | Nixia Fabric"
  description="Explore foil, holographic, iridescent and stretch fabric applications for stage costumes, dancewear and performance apparel buyers."
  keywords="performance costume fabric, dancewear fabric supplier, stage costume fabric supplier, holographic fabric wholesale, foil fabric supplier, custom foil fabric manufacturer"
  canonical="https://nixiafabric.com/applications/"
  structuredData={[breadcrumbData, pageSchema]}
  footerFocus="foil"
>
  <section class="applications-index-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <span aria-current="page">Applications</span>
      </nav>
      <span class="eyebrow">B2B SOURCING GUIDES</span>
      <h1>Choose Performance Costume & Dancewear Fabrics by Application</h1>
      <p>
        Explore foil fabric, holographic fabric and iridescent stretch fabric guidance
        for stage costumes, dancewear and performance apparel. Each guide links to
        relevant products, samples and practical buyer specifications.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="applications-index-grid">
        {applications.map((application) => (
          <a href={application.href} class="applications-index-card">
            <div class="applications-index-card__image">
              <img src={application.image} alt={application.alt} width="1200" height="800" loading="lazy" />
            </div>
            <div class="applications-index-card__body">
              <h2>{application.title}</h2>
              <p>{application.description}</p>
              <span>View sourcing guide</span>
            </div>
          </a>
        ))}
      </div>
      <p class="applications-index-footer">
        Need a product shortlist? <a href="/products/">Browse all foil fabrics</a> or
        <a href="/blog/">read our buyer guides</a> before requesting samples.
      </p>
    </div>
  </section>
</Layout>

<style>
  .applications-index-hero {
    padding-block: var(--space-3xl);
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .applications-index-hero .breadcrumb {
    margin-bottom: var(--space-xl);
    color: var(--color-text-muted);
  }

  .applications-index-hero .breadcrumb a {
    color: var(--color-text-secondary);
  }

  .applications-index-hero h1 {
    margin: var(--space-sm) 0 var(--space-md);
    color: var(--color-primary);
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.12;
  }

  .applications-index-hero p {
    max-width: 720px;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .applications-index-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-lg);
  }

  .applications-index-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
    color: inherit;
    text-decoration: none;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .applications-index-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .applications-index-card__image {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-bg);
  }

  .applications-index-card__image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .applications-index-card__body {
    padding: var(--space-lg);
  }

  .applications-index-card h2 {
    margin: 0 0 var(--space-sm);
    color: var(--color-primary);
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  .applications-index-card p {
    margin: 0 0 var(--space-md);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .applications-index-card span {
    color: var(--color-accent-dark);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .applications-index-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .applications-index-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
