---
/**
 * About Page — /about
 * Sections: Brand Story, Nixia Fabric Background,
 *           Industry Experience, Focus on Decorative Fabric, Global Market Service
 */
import Layout from "@layouts/Layout.astro";
import CTAButton from "@components/CTAButton.astro";
import { allProducts } from "@data/allProducts";

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://nixiafabric.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "About",
      item: "https://nixiafabric.com/about/",
    },
  ],
};

const aboutPageData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "About Nixia Fabric",
  description: "Learn about Nixia Fabric, a Guangzhou manufacturer of glitter, foil, iridescent and stretch fabrics for fashion, footwear, handbags, swimwear and stage costumes.",
  url: "https://nixiafabric.com/about/",
  mainEntity: {
    "@type": "Organization",
    name: "Nixia Fabric",
    foundingLocation: {
      "@type": "Place",
      addressCountry: "CN",
    },
    knowsAbout: [
      "Glitter Fabric Manufacturing",
      "Hot-Stamping Foil Fabric Manufacturing",
      "Laser Iridescent Fabric Manufacturing",
      "Stretch Fabric Manufacturing",
      "Custom Color Matching",
      "Factory Direct Supply",
      "Decorative Fabric",
    ],
  },
};

const milestones = [
  {
    year: "2013",
    title: "Since 2013",
    desc: "Started specializing in glitter and foil-printed synthetic leather for footwear, handbag and accessory applications.",
  },
  {
    year: "Growth",
    title: "Product Line Expansion",
    desc: "Expanded with multiple backing options and custom color matching for glitter and foil-printed PU materials.",
  },
  {
    year: "Today",
    title: "Global B2B Manufacturing",
    desc: "Serve footwear, handbag and accessory manufacturers worldwide with our own factory and stable partnerships with qualified material manufacturers.",
  },
  {
    year: "Future",
    title: "Custom Color Matching Focus",
    desc: "Continuing to invest in custom color development and factory direct supply flexibility to serve clients who need specific fabric solutions.",
  },
];

const globalMarkets = [
  {
    region: "North America",
    desc: "Shoe brands, handbag manufacturers, and fashion accessory companies.",
  },
  {
    region: "Europe",
    desc: "Footwear brands, handbag manufacturers, and accessory companies.",
  },
  {
    region: "Asia Pacific",
    desc: "Shoe manufacturers, bag producers, and regional fabric distributors.",
  },
  {
    region: "Middle East & Africa",
    desc: "Footwear, handbag and accessory producers.",
  },
];

const brandValues = [
  {
    title: "Manufacturer First",
    desc: "We are a manufacturer — not a trading company. You deal directly with the people who make your fabric.",
    icon: "factory",
  },
  {
    title: "Custom Color Matching",
    desc: "We invest in color development and factory direct supply capability. If you need a specific fabric, we can develop it.",
    icon: "palette",
  },
  {
    title: "Quality Over Volume",
    desc: "We prioritize consistency and quality in every production batch — from raw material to final inspection.",
    icon: "shield",
  },
  {
    title: "Direct Communication",
    desc: "No middleman, no layers. You talk to our production team directly about your specifications.",
    icon: "chat",
  },
];

const currentProductCount = allProducts.length;
const buyerSteps = [
  {
    num: "01",
    title: "Tell us the application",
    desc: "Share your finished product, target look, quantity and destination market.",
  },
  {
    num: "02",
    title: "Compare material routes",
    desc: "We recommend stock glitter, foil, iridescent or stretch options and confirm the key specifications.",
  },
  {
    num: "03",
    title: "Approve the sample",
    desc: "Check color, hand feel, stretch, structure and processing performance before bulk production.",
  },
];
---

<Layout
  title="About Nixia Fabric | Glitter & Foil Fabric Manufacturer"
  description="Learn about Nixia Fabric, a Guangzhou manufacturer of glitter, foil, iridescent and stretch fabrics for fashion, footwear, handbags, swimwear and stage costumes."
  keywords="nixia fabric, glitter fabric manufacturer, fabric manufacturer china, decorative fabric, Factory Direct Supply, Custom Color Matching"
  structuredData={[breadcrumbData, aboutPageData]}
>
  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__current">About</span>
      </nav>
    </div>
  </div>

  <!-- About Hero -->
  <section class="about-hero">
    <picture class="about-hero__media" aria-hidden="true">
      <source srcset="/images/process/raw_material_preparation.webp" type="image/webp" />
      <img src="/images/process/raw_material_preparation.jpg" alt="" width="1200" height="675" fetchpriority="high" />
    </picture>
    <div class="about-hero__overlay" aria-hidden="true"></div>
    <div class="container about-hero__content">
      <span class="eyebrow">About Nixia Fabric</span>
      <h1>Built for buyers who need decorative fabric to perform</h1>
      <p class="about-hero__desc">
        Since 2013, we have supplied glitter, foil, iridescent and stretch materials for
        footwear, handbags, fashion, swimwear and stage costumes. Our own production capability
        and qualified material partners help buyers move from material selection to approved sample
        with less uncertainty.
      </p>
      <div class="about-hero__actions">
        <CTAButton href="/contact/" variant="primary" size="lg" rfq>Discuss Your Material</CTAButton>
        <CTAButton href="/factory/" variant="outline" size="lg">See Our Capability</CTAButton>
      </div>
      <div class="about-hero__proof">
        <span>Since 2013</span>
        <span>Guangzhou, China</span>
        <span>Factory-direct support</span>
      </div>
    </div>
  </section>

  <!-- Brand Story -->
  <section class="section">
    <div class="container">
      <div class="brand-story">
        <div class="brand-story__left">
          <span class="eyebrow">Brand Story</span>
          <h2>From a material brief to a production-ready solution</h2>
          <p>
            Nixia Fabric was built around a practical sourcing problem: buyers need decorative
            materials that look right in a photo and still work in cutting, sewing, bonding and
            shipment.
          </p>
          <p>
            We own our in-house factory for glitter and foil-printed PU materials.
            Meanwhile, we keep stable partnerships with other qualified material manufacturers.
          </p>
          <p>
            We are dedicated to supplying reliable synthetic textile materials for footwear,
            handbag and accessory manufacturers worldwide.
          </p>
          <p>
            We support custom colors, different backing options and can arrange SGS / REACH
            testing according to buyer requirements. We offer free material samples — customers only
            cover international shipping cost, and sample freight can be deducted from bulk orders.
          </p>
        </div>
        <div class="brand-story__right">
          <div class="brand-story__card">
            <div class="brand-story__card-item">
              <span class="brand-story__card-num">2013</span>
              <span class="brand-story__card-label">Specialist Since</span>
            </div>
            <div class="brand-story__card-item">
              <span class="brand-story__card-num">4</span>
              <span class="brand-story__card-label">Material Routes</span>
            </div>
            <div class="brand-story__card-item">
              <span class="brand-story__card-num">{currentProductCount}</span>
              <span class="brand-story__card-label">Current Product SKUs</span>
            </div>
            <div class="brand-story__card-item">
              <span class="brand-story__card-num">Factory</span>
              <span class="brand-story__card-label">Direct Supply</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Industry Experience Timeline -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Industry Experience</span>
        <h2>Our Journey in Synthetic Leather</h2>
        <p>
          From our start in 2013 to today, our work has stayed focused on decorative materials
          that help footwear, handbag, fashion and performance-product buyers make confident
          production decisions.
        </p>
      </div>

      <div class="milestone-timeline">
        {milestones.map((m, i) => (
          <div class={`milestone ${i === milestones.length - 1 ? "milestone--last" : ""}`}>
            <div class="milestone__dot"></div>
            <div class="milestone__content">
              <span class="milestone__year">{m.year}</span>
              <h3 class="milestone__title">{m.title}</h3>
              <p class="milestone__desc">{m.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Focus on Decorative Fabric -->
  <section class="section">
    <div class="container">
      <div class="focus-section">
        <div class="focus-section__left">
          <span class="eyebrow">Our Focus</span>
          <h2>Specialized in glitter, foil and iridescent materials</h2>
          <p>
            Our current range covers glitter, hot-stamping foil, laser-iridescent and stretch
            materials — each selected for a specific end-use requirement rather than only for
            surface appearance.
          </p>
          <p>
            This focus means we pay attention to glitter adhesion, foil lamination, stretch
            recovery, color consistency and the processing conditions buyers use in production.
          </p>
          <ul class="focus-section__list">
            <li>
              <strong>Glitter Materials</strong> — Non-woven glitter and structured glitter synthetic
              leather for decoration, footwear, handbags and accessories
            </li>
            <li>
              <strong>Hot-Stamping &amp; Laser Foil</strong> — Full-print, plain iridescent, gradient
              and stretch finishes for garments and performance products
            </li>
            <li>
              <strong>Custom Development</strong> — Color, GSM, width, backing, pattern and packaging
              options tailored to client specifications
            </li>
          </ul>
        </div>
        <div class="focus-section__right">
          <div class="focus-section__products">
            <div class="focus-section__product">
              <span class="focus-section__product-name">Chunky Glitter Synthetic Leather</span>
              <span class="focus-section__product-types">4 Variations</span>
            </div>
            <div class="focus-section__product">
              <span class="focus-section__product-name">Foil-Printed Synthetic Leather</span>
              <span class="focus-section__product-types">3 Variations</span>
            </div>
            <div class="focus-section__product">
              <span class="focus-section__product-name">Custom Color Matching</span>
              <span class="focus-section__product-types">Unlimited Options</span>
            </div>
            <div class="focus-section__product">
              <span class="focus-section__product-name">Factory Direct Supply</span>
              <span class="focus-section__product-types">Full Customization</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Buyer Journey -->
  <section class="section buyer-journey-section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">How We Work With Buyers</span>
        <h2>A clear path from inquiry to bulk order</h2>
        <p>
          Good material decisions happen before production starts. We help you reduce risk at each
          stage, from the first specification to sample approval and quotation.
        </p>
      </div>

      <div class="buyer-journey">
        {buyerSteps.map((step) => (
          <div class="buyer-step">
            <span class="buyer-step__num">{step.num}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </div>
        ))}
      </div>

      <div class="buyer-journey__cta">
        <p>Have a reference image or material sample? Send it with your target quantity.</p>
        <CTAButton href="/contact/" variant="primary" rfq>Start a Material Discussion</CTAButton>
      </div>
    </div>
  </section>

  <!-- Brand Values -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">What Drives Us</span>
        <h2>Our Values</h2>
        <p>
          Four principles that define how we operate as a manufacturer.
        </p>
      </div>

      <div class="values-grid">
        {brandValues.map((val) => (
          <div class="value-card">
            <div class="value-card__icon">
              {val.icon === "factory" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 20h20V8l-6 4V8l-6 4V4H2v16z" /><path d="M6 16h2M10 16h2M14 16h2" />
                </svg>
              )}
              {val.icon === "palette" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="13.5" cy="6.5" r=".5" fill="currentColor" /><circle cx="17.5" cy="10.5" r=".5" fill="currentColor" /><circle cx="8.5" cy="7.5" r=".5" fill="currentColor" /><circle cx="6.5" cy="12.5" r=".5" fill="currentColor" /><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z" />
                </svg>
              )}
              {val.icon === "shield" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
              )}
              {val.icon === "chat" && (
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                </svg>
              )}
            </div>
            <h3 class="value-card__title">{val.title}</h3>
            <p class="value-card__desc">{val.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Global Market Service -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Global Market Service</span>
        <h2>Serving Clients Worldwide</h2>
        <p>
          Our glitter and foil-printed fabrics are used by footwear, handbag and accessory
          manufacturers across multiple regions. We understand the requirements of different
          markets — from quality standards to packaging specifications.
        </p>
      </div>

      <div class="markets-grid">
        {globalMarkets.map((market) => (
          <div class="market-card">
            <div class="market-card__icon">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" /><line x1="2" y1="12" x2="22" y2="12" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
            </div>
            <h3 class="market-card__region">{market.region}</h3>
            <p class="market-card__desc">{market.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section section--dark">
    <div class="container text-center">
      <span class="eyebrow">Let's Build Together</span>
      <h2>Partner With a Manufacturer</h2>
      <p style="max-width: 600px; margin: var(--space-lg) auto var(--space-2xl);">
        Whether you need a standard stock material, a specific color and backing, or a custom
        decorative finish, send us the project details and we will recommend the next practical step.
      </p>
      <div class="btn-group" style="justify-content: center;">
        <CTAButton href="/factory/" variant="outline" size="lg">View Manufacturing Capability</CTAButton>
        <CTAButton href="/sample-policy/" variant="primary" size="lg" rfq>Request Free Sample</CTAButton>
        <CTAButton href="/contact/" variant="secondary" size="lg" rfq>Get Custom Quotation</CTAButton>
      </div>
    </div>
  </section>
</Layout>

<style>
  .breadcrumb-bar {
    background-color: var(--color-bg-alt);
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb a:hover {
    color: var(--color-accent-dark);
  }

  .breadcrumb__sep {
    color: var(--color-text-light);
  }

  .breadcrumb__current {
    color: var(--color-primary);
    font-weight: 600;
  }

  /* About Hero */
  .about-hero {
    min-height: 560px;
    display: flex;
    align-items: center;
    color: var(--color-white);
    position: relative;
    overflow: hidden;
  }

  .about-hero__media,
  .about-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .about-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .about-hero__overlay {
    background:
      linear-gradient(90deg, rgba(13, 27, 51, 0.92) 0%, rgba(13, 27, 51, 0.72) 48%, rgba(13, 27, 51, 0.3) 100%),
      linear-gradient(0deg, rgba(13, 27, 51, 0.45), rgba(13, 27, 51, 0.08));
  }

  .about-hero__content {
    position: relative;
    z-index: 1;
    padding-block: var(--space-4xl);
  }

  .about-hero__content h1 {
    max-width: 760px;
  }

  .about-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
  }

  .about-hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-top: var(--space-2xl);
    color: rgba(255, 255, 255, 0.8);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .about-hero__proof span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .about-hero__proof span::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-light);
  }

  .about-hero::before {
    content: "";
    position: absolute;
    width: 1px;
    top: 0;
    bottom: 0;
    left: 66%;
    background: rgba(255, 255, 255, 0.18);
    pointer-events: none;
    z-index: 1;
  }

  .about-hero .container {
    position: relative;
    z-index: 1;
  }

  .about-hero .eyebrow {
    color: var(--color-accent-light);
  }

  .about-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .about-hero__desc {
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-lg);
    max-width: 680px;
  }

  /* Brand Story */
  .brand-story {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-4xl);
    align-items: start;
  }

  .brand-story__left p {
    margin-bottom: var(--space-md);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .brand-story__card {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    border-radius: var(--radius-lg);
    padding: var(--space-3xl) var(--space-2xl);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl);
  }

  .brand-story__card-item {
    text-align: center;
  }

  .brand-story__card-num {
    display: block;
    font-size: var(--text-4xl);
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1;
    margin-bottom: var(--space-sm);
  }

  .brand-story__card-label {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Milestone Timeline */
  .milestone-timeline {
    position: relative;
    max-width: 800px;
    margin-inline: auto;
    padding-left: 40px;
  }

  .milestone-timeline::before {
    content: "";
    position: absolute;
    left: 12px;
    top: 8px;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, var(--color-accent), var(--color-border));
  }

  .milestone {
    position: relative;
    margin-bottom: var(--space-3xl);
  }

  .milestone--last {
    margin-bottom: 0;
  }

  .milestone__dot {
    position: absolute;
    left: -40px;
    top: 6px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background-color: var(--color-white);
    border: 3px solid var(--color-accent);
  }

  .milestone__year {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-dark);
    background-color: rgba(196, 160, 53, 0.12);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-sm);
  }

  .milestone__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-sm);
  }

  .milestone__desc {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
  }

  /* Focus Section */
  .focus-section {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-4xl);
    align-items: start;
  }

  .focus-section__left p {
    margin-bottom: var(--space-md);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  .focus-section__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .focus-section__list li {
    padding: var(--space-md);
    background-color: var(--color-bg-alt);
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--color-accent);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .focus-section__list li strong {
    color: var(--color-primary);
  }

  .focus-section__products {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .focus-section__product {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-lg) var(--space-xl);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: all var(--transition-base);
  }

  .focus-section__product:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-sm);
    transform: translateX(4px);
  }

  .focus-section__product-name {
    font-weight: 700;
    color: var(--color-primary);
    font-size: var(--text-base);
  }

  .focus-section__product-types {
    font-size: var(--text-xs);
    color: var(--color-accent-dark);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  /* Buyer Journey */
  .buyer-journey-section {
    background: #fbf3e0;
  }

  .buyer-journey {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

