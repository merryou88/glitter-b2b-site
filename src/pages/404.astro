---
/**
 * 404.astro — Custom "Page Not Found" page
 * Served by Cloudflare Pages as /404.html with HTTP 404 status
 * Robots: noindex (soft-404 avoidance)
 */
import Layout from "@layouts/Layout.astro";

const notFoundData = {
  "@context": "https://schema.org",
  "@type": "ErrorPage",
  name: "Page Not Found",
  description: "The requested page does not exist on Nixia Fabric.",
  url: "https://nixiafabric.com/404",
};
---

<Layout
  title="Page Not Found | Nixia Fabric"
  description="The page you are looking for could not be found. Return to the Nixia Fabric homepage or browse the product catalog."
  robots="noindex"
  structuredData={[notFoundData]}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>Page Not Found</h1>
      <p class="page-hero__desc">
        The page you are looking for may have been moved, renamed, or never existed. Let's get you back on track.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="nf-actions">
        <a class="btn btn--primary btn--lg" href="/">Back to Homepage</a>
        <a class="btn btn--outline btn--lg" href="/products/">Browse All Products</a>
      </div>
      <p class="nf-hint">
        Looking for something specific? Explore our holographic, iridescent and glitter fabric catalog, or
        <a href="/contact/">contact us</a> and we'll help you find the right material.
      </p>
    </div>
  </section>

  <style>
    .nf-actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-md);
      justify-content: center;
      margin-bottom: var(--space-lg);
    }

    .nf-hint {
      text-align: center;
      color: var(--color-text-secondary);
      font-size: var(--text-sm);
      max-width: 520px;
      margin-inline: auto;
    }

    .nf-hint a {
      color: var(--color-accent-dark);
      font-weight: 600;
    }

    @media (max-width: 640px) {
      .nf-actions {
        flex-direction: column;
      }

      .nf-actions .btn {
        width: 100%;
        justify-content: center;
        text-align: center;
      }
    }
  </style>
</Layout>