---
/**
 * Product Detail Page — /products/[id]
 * Dynamic page for each glitter synthetic leather product
 */
import Layout from "@layouts/Layout.astro";
import products from "@data/products.json";
import { existsSync, readdirSync } from "node:fs";

export interface ProductSpec {
  label: string;
  value: string;
}

export interface ProductFaqItem {
  q: string;
  a: string;
}

export interface Product {
  id: string;
  title: string;
  category: string;
  shortDesc: string;
  fullDescription: string;
  mainImage: string;
  skuImages: string[];
  detailImages: string[];
  videoLocal: string;
  videoYoutubeUrl: string;
  tags: string[];
  moq?: string;
  leadTime?: string;
  specs?: ProductSpec[];
  faq?: ProductFaqItem[];
}

export function getStaticPaths() {
  return (products as Product[]).map((p) => ({
    params: { id: p.id },
  }));
}

const { id } = Astro.params;
const product = (products as Product[]).find((p) => p.id === id);

if (!product) {
  return new Response(null, {
    status: 302,
    headers: { Location: "/products/" },
  });
}

// Gather all main images for gallery (from the main folder via scan)
const baseMainPath = `/images/products/${product.id}/main/`;
const skuBasePath = `/images/products/${product.id}/sku/`;

// Plain iridescent page uses a custom spec-table + B2B buyers layout
const isPlainIridescent = product.id === "plain-iridescent-laser-spandex-4-way-stretch";

// Application scenario images, scanned from the /application folder at build time
const appImagesBase = `public/images/products/${product.id}/application`;
const applicationImages =
  isPlainIridescent && existsSync(appImagesBase)
    ? readdirSync(appImagesBase)
        .filter((f: string) => /\.(png|jpe?g|webp)$/i.test(f))
        .sort((a: string, b: string) => {
          const na = Number.parseInt(a.match(/\d+/)?.[0] ?? "0", 10);
          const nb = Number.parseInt(b.match(/\d+/)?.[0] ?? "0", 10);
          return (na || 0) - (nb || 0) || a.localeCompare(b);
        })
        .map((f: string) => ({
          src: `/images/products/${product.id}/application/${f}`,
          hasWebp: existsSync(`${appImagesBase}/${f.replace(/\.(png|jpe?g)$/i, ".webp")}`),
        }))
    : [];

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Products", item: "https://nixiafabric.com/products" },
    { "@type": "ListItem", position: 3, name: product.title, item: `https://nixiafabric.com/products/${product.id}` },
  ],
};

// Build main image gallery: use mainImage as hero, then all sku images
const mainImages = product.mainImage ? [product.mainImage] : [];
const galleryImages = [...mainImages, ...product.skuImages];

// FAQ structured data
const faqData = (product.faq ?? []).length > 0 && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: (product.faq ?? []).map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const structuredDataList = [breadcrumbData, ...(faqData ? [faqData] : [])];

// Related products: other items sharing at least one tag (max 3)
const relatedProducts = (products as Product[])
  .filter((p) => p.id !== product.id && p.tags.some((t) => product.tags.includes(t)))
  .slice(0, 3);

const toWebp = (src: string) => src.replace(/\.(png|jpe?g)$/i, ".webp");

// MOQ / Lead Time card display values (reference-style fixed copy)
const titleCase = (s: string) =>
  s.replace(/(^|[\s-])([a-z])/g, (_m, p1: string, p2: string) => p1 + p2.toUpperCase());

// Application scenarios from specs, plus combined bottom SEO tags
const applications =
  ((product.specs ?? []).find((s: ProductSpec) => s.label.toLowerCase().includes("applications"))?.value ?? "")
    .split(",")
    .map((s: string) => s.trim())
    .filter(Boolean);
const seoTags = [
  ...new Map(
    [...applications, ...product.tags.map((t: string) => t.replace(/-/g, " "))].map((t) => [t.toLowerCase(), t] as const)
  ).values(),
];

// SEO title & description — per-product, not shared
const productMeta: Record<string, { title: string; desc: string }> = {
  "full-print-hot-stamping-spandex-milk-silk": {
    title: "Full-Print Hot-Stamping Spandex Milk-Silk Fabric | Wholesale - Nixia Fabric",
    desc: "Wholesale full-print hot-stamping spandex milk-silk fabric. 4-way stretch, soft hand-feel, free sample, low MOQ. Ideal for fashion garments, swimwear & stage costumes. Get custom quote.",
  },
  "iridescent-laser-hot-stamping-stretch-ice-silk": {
    title: "Iridescent Laser Hot-Stamping Stretch Ice-Silk Fabric | Wholesale - Nixia Fabric",
    desc: "Wholesale iridescent laser hot-stamping stretch ice-silk fabric. Gradient multi-color finish, elastic recovery, free sample, low MOQ. Ideal for stage costumes & backdrop decoration. Get custom quote.",
  },
  "non-woven-glitter-fabric": {
    title: "Non-Woven Glitter Fabric | Wholesale - Nixia Fabric",
    desc: "Wholesale non-woven glitter fabric. Dense sparkle coating, cut-clean edges, free sample, low MOQ. Ideal for holiday decoration, stage props & performance costumes. Get custom quote.",
  },
  "iridescent-gradient-laser-ice-silk": {
    title: "Iridescent Gradient Laser Hot-Stamping Ice-Silk Fabric | Wholesale - Nixia Fabric",
    desc: "Wholesale iridescent gradient laser hot-stamping ice-silk fabric. Smooth color-flow finish, stretch base, free sample, low MOQ. Ideal for fashion apparel, stage costumes & backdrops. Get custom quote.",
  },
  "plain-iridescent-laser-spandex-4-way-stretch": {
    title: "Plain Iridescent Laser Spandex 4-Way Stretch Fabric | Nixia Fabric",
    desc: "4-way stretch plain iridescent laser hot-stamping spandex fabric. 150cm width, 180g/m², polyester knitted base. For swimwear, dance & stage costumes. Request quotation.",
  },
  "rainbow-gradient-glitter-synthetic-leather": {
    title: "Rainbow Gradient Glitter Synthetic Leather Fabric | Wholesale - Nixia Fabric",
    desc: "Wholesale rainbow gradient glitter synthetic leather. Reflective finish, structured base, free sample, low MOQ. Ideal for bags, footwear & book-covering materials. Get custom quote.",
  },
};

const meta = productMeta[product.id] ?? {
  title: `${product.title} | Wholesale - Nixia Fabric`,
  desc: product.shortDesc,
};
const seoTitle = meta.title;
const seoDesc = meta.desc;
---

<Layout
  title={seoTitle}
  description={seoDesc}
  keywords={product.tags.join(", ")}
  image={product.mainImage ? `https://nixiafabric.com${product.mainImage}` : undefined}
  canonical={`https://nixiafabric.com/products/${product.id}`}
  structuredData={structuredDataList}
>
  <!-- Product Banner Header -->
  <section class="p-banner">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">/</span>
        <a href="/products/">Products</a>
        <span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__current">{product.title}</span>
      </nav>

      <h1 class="p-banner__title">{product.title}</h1>
      <p class="p-banner__desc">{product.shortDesc}</p>
    </div>
  </section>

  <!-- Hero Section -->
  <section class="detail-hero">
    <div class="container">
      <div class="detail-layout">
        {/* Hero Carousel — plain-iridescent-laser-spandex-4-way-stretch only */}
        {product.id === "plain-iridescent-laser-spandex-4-way-stretch" ? (
          <div class="p-hero-gallery" id="p-hero-gallery">
            <div class="p-hero-gallery__main" id="p-hero-main">
              <img id="p-hero-img" src="/images/products/plain-iridescent-laser-spandex-4-way-stretch/main/1.jpg" alt="Plain iridescent laser hot‑stamping 4‑way stretch spandex fabric" loading="eager" decoding="async" />
              <video id="p-hero-video" controls preload="none" muted playsinline style="display:none">
                <source src="/images/products/plain-iridescent-laser-spandex-4-way-stretch/video/demo-video.mp4" type="video/mp4" />
              </video>
            </div>
            <div class="p-hero-gallery__thumbs">
              <button class="p-hero-gallery__thumb p-hero-gallery__thumb--active" data-type="image" data-src="/images/products/plain-iridescent-laser-spandex-4-way-stretch/main/1.jpg" aria-label="View main image">
                <img src="/images/products/plain-iridescent-laser-spandex-4-way-stretch/main/1.jpg" alt="Plain iridescent laser hot‑stamping 4‑way stretch spandex fabric" width="120" height="80" loading="eager" decoding="async" />
              </button>
              {[2, 3, 4].map((n) => (
                <button class="p-hero-gallery__thumb" data-type="image" data-src={`/images/products/plain-iridescent-laser-spandex-4-way-stretch/detail/${n}.jpg`} aria-label="View detail image">
                  <img src={`/images/products/plain-iridescent-laser-spandex-4-way-stretch/detail/${n}.jpg`} alt="Plain iridescent laser hot‑stamping 4‑way stretch spandex fabric" width="120" height="80" loading="lazy" decoding="async" />
                </button>
              ))}
            </div>

            <div class="detail-feature-tags">
              <span class="feature-tag feature-tag--green">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span>SGS Certified</span>
              </span>
              <span class="feature-tag feature-tag--blue">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span>REACH Compliant</span>
              </span>
              <span class="feature-tag feature-tag--amber">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Pre-shipment QC</span>
              </span>
            </div>
          </div>
        ) : (
        /* Default gallery for other products */
        <div class="detail-gallery">
          <!-- Main Image -->
          <div class="detail-gallery__main">
            {
              product.mainImage ? (
                <picture>
                  <source srcset={toWebp(product.mainImage)} type="image/webp" />
                  <img id="main-image" src={product.mainImage} alt={product.title} class="detail-gallery__hero" loading="lazy" width="1200" height="675" decoding="async" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                </picture>
              ) : null
            }
            <div
              class="detail-gallery__hero-placeholder"
              style={product.mainImage ? "display:none" : "display:flex"}
            >
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <span>Image coming soon</span>
            </div>
          </div>

          <!-- Gallery Thumbnails -->
          {
            galleryImages.length > 1 && (
              <div class="detail-gallery__thumbs">
                {galleryImages.map((img: string, i: number) => (
                  <button
                    class={`detail-gallery__thumb ${i === 0 ? "detail-gallery__thumb--active" : ""}`}
                    onclick={`document.getElementById('main-image').src='${img}';document.querySelectorAll('.detail-gallery__thumb').forEach(b=>b.classList.remove('detail-gallery__thumb--active'));this.classList.add('detail-gallery__thumb--active')`}
                    aria-label={`View image ${i + 1}`}
                  >
                    <picture>
                      <source srcset={toWebp(img)} type="image/webp" />
                      <img src={img} alt={`${product.title} thumbnail ${i + 1}`} loading="lazy" width="80" height="80" decoding="async" onerror="this.style.display='none'" />
                    </picture>
                  </button>
                ))}
              </div>
            )
          }
        </div>

        <div class="detail-feature-tags">
          <span class="feature-tag feature-tag--green">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>SGS Certified</span>
          </span>
          <span class="feature-tag feature-tag--blue">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>REACH Compliant</span>
          </span>
          <span class="feature-tag feature-tag--amber">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Pre-shipment QC</span>
          </span>
        </div>
        )}

        <!-- Product Info -->
        <div class="detail-info">
          <div class="detail-info__heading">
            <h2 class="detail-info__title">
              <span class="detail-info__badge">
                <svg class="detail-info__badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                  <path d="m3.3 7 8.7 5 8.7-5" />
                  <path d="M12 22V12" />
                </svg>
                WHOLESALE
              </span>
              {product.title}
            </h2>
          </div>
          <p class="detail-info__desc">Plain iridescent laser hot‑stamping spandex fabric is engineered for garments that need real stretch performance. The 4‑way stretch spandex base stretches and recovers in every direction, while the plain laser foil surface delivers a clean, uniform iridescent shine.</p>

          <!-- MOQ / Lead Time cards -->
          <div class="detail-offer-grid">
            <div class="detail-offer-card detail-offer-card--moq">
              <span class="detail-offer-card__label">MOQ</span>
              <strong class="detail-offer-card__value">100</strong>
              <span class="detail-offer-card__unit">Meters</span>
            </div>
            <div class="detail-offer-card detail-offer-card--lead">
              <span class="detail-offer-card__label">LEAD TIME</span>
              <strong class="detail-offer-card__value">1-3</strong>
              <span class="detail-offer-card__unit">Days</span>
            </div>
          </div>

          <!-- B2B Buying Details -->
          <div class="detail-buying">
            <div class="detail-buying__card">
              <h2 class="detail-buying__title">B2B Buying Details</h2>
              <div class="detail-buying__grid">
                <div class="detail-buying__item">
                  <h3 class="detail-buying__item-title">SAMPLE</h3>
                  <p class="detail-buying__item-text">Free sample available, customer bears shipping cost</p>
                </div>
                <div class="detail-buying__item">
                  <h3 class="detail-buying__item-title">CUSTOMIZATION</h3>
                  <p class="detail-buying__item-text">Custom colors &amp; custom base fabric</p>
                </div>
                <div class="detail-buying__item">
                  <h3 class="detail-buying__item-title">PACKAGING</h3>
                  <p class="detail-buying__item-text">Roll packing, export carton</p>
                </div>
                <div class="detail-buying__item">
                  <h3 class="detail-buying__item-title">TRADE TERMS</h3>
                  <p class="detail-buying__item-text">FOB, CIF upon quotation</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Quote Information Tips -->
          <div class="detail-quote-tips">
            <h3 class="detail-quote-tips__title">For an Accurate Quote, Please Share</h3>
            <div class="detail-quote-tips__grid">
              <div class="detail-quote-tips__item">Target quantity(Meters)</div>
              <div class="detail-quote-tips__item">Destination country</div>
              <div class="detail-quote-tips__item">Color requirement</div>
              <div class="detail-quote-tips__item">Trade Terms (FOB/CIF/EXW)</div>
              <div class="detail-quote-tips__item">Base material</div>
              <div class="detail-quote-tips__item">Target delivery date</div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="detail-cta">
            <a href={`/contact/?sku=${encodeURIComponent(product.title)}`} data-rfq-open data-rfq-sku={product.title} class="btn detail-cta__btn detail-cta__btn--gold">
              <svg class="detail-cta__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                <path d="M10 9H8" />
                <path d="M16 13H8" />
                <path d="M16 17H8" />
              </svg>
              Add to Quotation List
            </a>
            <a href="/sample-policy/" class="btn detail-cta__btn detail-cta__btn--sample">
              <svg class="detail-cta__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
                <path d="m3.3 7 8.7 5 8.7-5" />
                <path d="M12 22V12" />
              </svg>
              Request Free Sample
            </a>
            <a href="https://wa.me/8613616899303" target="_blank" rel="noopener noreferrer" class="btn detail-cta__btn detail-cta__btn--wa">
              <svg class="detail-cta__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
              </svg>
              WhatsApp
            </a>
            <button type="button" class="btn detail-cta__btn detail-cta__btn--sample" id="copy-product-link">
              <svg class="detail-cta__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
              </svg>
              Copy Product Link
            </button>
          </div>
          <p class="detail-cta__note">Our factory team will reply within 24 hours.</p>
          <div class="rfq-toast" id="rfq-toast" role="status" aria-live="polite">Link copied</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Full Description -->
  <section class="section">
    <div class="container">
      <div class={`detail-body${isPlainIridescent ? " detail-body--plain" : ""}`}>
        <!-- Description -->
        <div class="detail-body__text">
          <h2>Product Description</h2>
          {product.fullDescription.split("\n\n").map((para: string) => (
            <p>{para}</p>
          ))}
        </div>

        <!-- SKU Color Gallery -->
        {product.skuImages.length > 0 && (
          <div class="detail-body__section" id="sku-colors">
            <h2>Color Options ({product.skuImages.length})</h2>
            <div class="sku-grid">
              {product.skuImages.map((img: string) => (
                <div class="sku-item">
                  <picture>
                    <source srcset={toWebp(img)} type="image/webp" />
                    <img src={img} alt="Color variant" loading="lazy" width="200" height="200" decoding="async" onerror="this.style.display='none';this.parentElement.querySelector('.sku-item__placeholder').style.display='flex'" />
                  </picture>
                  <div class="sku-item__placeholder" style="display:none">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21 15 16 10 5 21"/>
                    </svg>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Detail Images -->
        {product.detailImages.length > 0 && (
          <div class="detail-body__section" id="product-details">
            <h2>Product Details</h2>
            <div class="detail-images-grid">
              {product.detailImages.map((img: string) => (
                <picture>
                  <source srcset={toWebp(img)} type="image/webp" />
                  <img src={img} alt={`${product.title} detail`} loading="lazy" width="1200" height="675" class="detail-image" decoding="async" onerror="this.style.display='none'" />
                </picture>
              ))}
            </div>
          </div>
        )}

        <!-- Video: YouTube priority > local mp4 > none -->
        {(product.videoYoutubeUrl || product.videoLocal) && (
          <div class="detail-body__section" id="product-video">
            <h2>Product Video</h2>
            <div class="detail-video">
              {product.videoYoutubeUrl ? (
                <iframe
                  src={product.videoYoutubeUrl.replace("watch?v=", "embed/")}
                  title={`${product.title} video`}
                  class="detail-video__player"
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  style="border:none"
                >
                </iframe>
              ) : product.videoLocal ? (
                <video
                  controls
                  preload="metadata"
                  poster={product.mainImage}
                  class="detail-video__player"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                >
