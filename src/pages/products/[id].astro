<script>
  const gallery = document.getElementById('p-hero-gallery');
  if (gallery) {
    const heroImg = document.getElementById('p-hero-img');
    const heroVid = document.getElementById('p-hero-video');
    const thumbs = gallery.querySelectorAll('.p-hero-gallery__thumb');

    thumbs.forEach(thumb => {
      thumb.addEventListener('click', () => {
        thumbs.forEach(t => t.classList.remove('p-hero-gallery__thumb--active'));
        thumb.classList.add('p-hero-gallery__thumb--active');
        const type = thumb.dataset.type;

        if (type === 'video') {
          heroImg.style.display = 'none';
          heroVid.style.display = 'block';
          heroVid.currentTime = 0;
        } else {
          heroVid.pause();
          heroVid.style.display = 'none';
          heroImg.style.display = 'block';
          heroImg.src = thumb.dataset.src;
        }
      });
    });
  }
</script>

<script>
  document.getElementById("copy-product-link")?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(window.location.href);
    } catch {
      const t = document.createElement("textarea");
      t.value = window.location.href;
      t.style.cssText = "position:fixed;opacity:0";
      document.body.appendChild(t);
      t.select();
      document.execCommand("copy");
      document.body.removeChild(t);
    }
    const toast = document.getElementById("rfq-toast");
    if (toast) {
      toast.classList.add("is-visible");
      setTimeout(() => toast.classList.remove("is-visible"), 2000);
    }
  });
</script>

