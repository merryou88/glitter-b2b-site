    color: var(--color-text-muted);
  }

  .detail-offer-card__value {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-primary);
    line-height: 1.1;
  }

  .detail-offer-card__unit {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: 0.03em;
  }

  /* B2B Buying Details */
  .detail-buying {
    margin-top: var(--space-lg);
  }

  .detail-buying__card {
    background: #f8f8f8;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .detail-buying__title {
    margin: 0;
    padding: var(--space-md) var(--space-lg);
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-base);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
  }

  .detail-buying__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--color-border);
  }

  .detail-buying__item {
    background: #f8f8f8;
    padding: var(--space-md) var(--space-lg);
  }

  .detail-buying__item-title {
    display: block;
    margin: 0 0 var(--space-xs);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .detail-buying__item-text {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
    color: #1a1a1a;
    line-height: 1.4;
  }

  /* Quote Information Tips */
  .detail-quote-tips {
    margin-top: var(--space-lg);
    background: #fbf3e0;
    border: 1px solid var(--color-accent-light);
    border-radius: var(--radius-lg);
    box-shadow: 0 2px 12px rgba(22, 41, 77, 0.06);
    padding: var(--space-lg);
  }

  .detail-quote-tips__title {
    margin: 0 0 var(--space-lg);
    font-size: var(--text-lg);
    font-weight: 800;
    color: var(--color-primary);
  }

  .detail-quote-tips__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
  }

  .detail-quote-tips__item {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-sm) var(--space-sm);
    background: var(--color-bg);
    border: 1px solid #f0e2bd;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  /* Application Scenarios */
  .detail-apps {
    margin-top: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .detail-apps__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .detail-apps__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.625rem 2rem;
  }

  .detail-apps__item {
    position: relative;
    padding-left: 1.25rem;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .detail-apps__item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.4rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  /* ===== Plain iridescent: reordered body stack (flex order) ===== */
  .detail-body--plain {
    display: flex;
    flex-direction: column;
  }

  .detail-body--plain > * {
    order: 50;
  }

  .detail-body--plain .detail-body__text {
    order: 10;
  }

  .detail-body--plain #specifications {
    order: 20;
  }

  .detail-body--plain #b2b-specifications {
    order: 30;
  }

  .detail-body--plain #applications {
    order: 40;
  }

  .detail-body--plain #oem-manufacturing {
    order: 50;
  }

  .detail-body--plain .buyer-notice {
    order: 60;
  }

  .detail-body--plain #faq {
    order: 70;
  }

  .detail-body--plain #sku-colors {
    order: 90;
  }

  .detail-body--plain #product-details {
    order: 91;
  }

  .detail-body--plain #product-video {
    order: 92;
  }

  .detail-body--plain .detail-sample-policy {
    order: 99;
  }

  /* ===== Buyer Important Notice (collapsible) ===== */
  .buyer-notice__box {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-lg);
  }

  .buyer-notice__summary {
    list-style: none;
    cursor: pointer;
    user-select: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
  }

  .buyer-notice__summary::-webkit-details-marker {
    display: none;
  }

  .buyer-notice__summary h2 {
    margin: 0;
    border: 0;
    padding: 0;
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-primary);
  }

  .buyer-notice__summary::after {
    content: "+";
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .buyer-notice__box[open] .buyer-notice__summary::after {
    content: "\2212";
  }

  .buyer-notice__list {
    margin: var(--space-md) 0 0;
    padding-left: 1.25rem;
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .buyer-notice__list li {
    margin-bottom: 0.625rem;
  }

  .buyer-notice__list li:last-child {
    margin-bottom: 0;
  }

  .detail-tags-section {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-alt);
  }

  .detail-tags-section h2 {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .detail-tags-section p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-md);
  }

  /* Tags */
  .detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: var(--space-sm);
  }

  .detail-tags__item {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    font-size: var(--text-xs);
    color: var(--color-accent-dark);
    background: rgba(196, 160, 53, 0.08);
    border-radius: var(--radius-sm);
    text-transform: capitalize;
  }

  /* ===== Specification Grid ===== */
  .spec-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .spec-grid__item {
    background: var(--color-white);
    padding: var(--space-md) var(--space-lg);
  }

  .spec-grid__item dt {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .spec-grid__item dd {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
    line-height: 1.45;
    margin: 0;
  }

  /* ===== Simple field-value tables (plain iridescent) ===== */
  .table-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .param-table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: var(--text-base);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .param-table thead th {
    text-align: left;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
    padding: 0.875rem var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .param-table tbody td {
    padding: 0.8125rem var(--space-md);
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
    color: var(--color-text);
  }

  .param-table tbody tr:last-child td {
    border-bottom: none;
  }

  .param-table tbody td:first-child {
    font-weight: 600;
    color: var(--color-primary);
  }

  .b2b-card {
    background: #fbf3e0;
    border: 1px solid var(--color-accent-light);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
  }

  .b2b-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-sm);
    flex-wrap: wrap;
    padding: 0 var(--space-sm) var(--space-sm);
  }

  .b2b-card__head h2 {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-primary);
    margin: 0 0 0.25rem;
  }

  .b2b-card__subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  .b2b-card__tag {
    display: inline-flex;
    align-items: center;
    padding: 0.3125rem 0.75rem;
    font-size: var(--text-xs);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #8a6d1f;
    background: var(--color-white);
    border: 1px solid var(--color-accent-light);
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .b2b-card .param-table {
    border-color: var(--color-accent-light);
  }

  /* ===== OEM / ODM ===== */
  .oem-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .oem-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
  }

  .oem-card__icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
    background: rgba(196, 160, 53, 0.1);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-md);
  }

  .oem-card__icon svg {
    width: 24px;
    height: 24px;
  }

  .oem-card h3 {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .oem-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
  }

  /* ===== FAQ ===== */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .faq-item {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .faq-item summary {
    cursor: pointer;
    padding: var(--space-md) var(--space-lg);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-primary);
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    transition: background var(--transition-fast);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: "+";
    font-size: 1.35rem;
    font-weight: 400;
    color: var(--color-accent);
    flex-shrink: 0;
    line-height: 1;
  }

  .faq-item[open] summary::after {
    content: "−";
  }

  .faq-item summary:hover {
    background: var(--color-bg);
  }

  .faq-item p {
    padding: 0 var(--space-lg) var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-md);
  }

  /* ===== Related Products ===== */
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .related-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all var(--transition-base);
  }

  .related-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .related-card__visual {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .related-card__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .related-card:hover .related-card__visual img {
    transform: scale(1.05);
  }

  .related-card__body {
    padding: var(--space-md) var(--space-lg) var(--space-lg);
  }

  .related-card__body h3 {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.4rem;
    line-height: 1.35;
  }

  .related-card__meta {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-accent-dark);
    background: rgba(196, 160, 53, 0.08);
    border-radius: var(--radius-full);
    padding: 0.2rem 0.65rem;
    margin-bottom: 0.5rem;
  }

  .related-card__link {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent);
  }

  /* ===== Detail Body ===== */
  .detail-body {
    max-width: 900px;
    margin: 0 auto;
  }

  .detail-body__text {
    margin-bottom: var(--space-2xl);
  }

  .detail-body__text h2 {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--color-accent);
    display: inline-block;
  }

  .detail-body__text p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-md);
  }

  .detail-body__section {
    margin-bottom: var(--space-3xl);
  }

  .detail-body__section h2 {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--color-accent);
    display: inline-block;
  }

  /* SKU Grid */
  .sku-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .sku-item {
    aspect-ratio: 1 / 1;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    position: relative;
  }

  .sku-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sku-item__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--color-text-muted);
  }

  /* Detail Images */
  .detail-images-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
  }

  /* Application scenario images */
  .detail-apps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    margin-top: var(--space-lg);
  }

  .detail-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  /* Video */
  .detail-video {
    aspect-ratio: 16 / 9;
    background: #000;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .detail-video__player {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .detail-video__fallback {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    width: 100%;
    height: 100%;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    background: var(--color-bg);
  }

  /* Sample Policy */
  .detail-sample-policy {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
  }

  .sample-policy-content p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-sm);
  }

  .sample-policy-content strong {
    color: var(--color-primary);
  }

  .policy-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
  }

  .policy-cta__btn {
    flex: 1 1 0;
    min-width: 190px;
    justify-content: center;
    align-items: center;
    text-align: center;
    white-space: normal;
  }

  /* ===== Responsive ===== */
  @media (max-width: 968px) {
    .detail-layout {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .detail-gallery {
      position: static;
    }

    .sku-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .detail-images-grid {
      grid-template-columns: 1fr 1fr;
    }

    .spec-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .detail-layout,
    .sku-grid,
    .detail-images-grid,
    .oem-grid,
    .related-grid {
      grid-template-columns: 1fr;
    }

    .detail-offer-grid {
      grid-template-columns: 1fr;
    }

    .detail-info__title {
      font-size: var(--text-2xl);
    }

    .detail-buying__grid {
      grid-template-columns: 1fr;
    }

    .detail-quote-tips__grid {
      grid-template-columns: 1fr;
    }

    .detail-apps__list {
      flex-direction: column;
      gap: var(--space-xs);
    }

    .detail-gallery__thumbs {
      gap: var(--space-xs);
    }

    .p-hero-gallery {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .detail-hero {
      padding-top: var(--space-lg);
    }

    .spec-grid {
      grid-template-columns: 1fr;
    }

    .sku-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .detail-images-grid {
      grid-template-columns: 1fr;
    }

    .detail-gallery__thumbs {
      gap: var(--space-xs);
    }

    .detail-gallery__thumb {
      width: 56px;
      height: 56px;
    }

    .p-hero-gallery__thumb {
      width: 56px;
      aspect-ratio: 1 / 1;
    }
  }

  /* ===== Hero Gallery Viewer (plain-iridescent-laser) ===== */
  .p-hero-gallery {
    position: sticky;
    top: calc(var(--header-height) + var(--space-xl));
    max-width: 560px;
    margin-inline: auto;
  }

  .p-hero-gallery__main {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #ffffff;
  }

  .p-hero-gallery__main img {
    width: 100%;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  .p-hero-gallery__main video {
    width: 100%;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  .p-hero-gallery__thumbs {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    overflow-x: auto;
    padding-bottom: var(--space-xs);
  }

  .p-hero-gallery__thumb {
    flex-shrink: 0;
    width: 72px;
    aspect-ratio: 1 / 1;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    background: none;
    transition: border-color var(--transition-fast);
    position: relative;
  }

  .p-hero-gallery__thumb:hover {
    border-color: var(--color-accent);
  }

  .p-hero-gallery__thumb--active {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 2px var(--color-accent);
  }

  .p-hero-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  .p-hero-gallery__play-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,.35);
    color: #fff;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .p-hero-carousel {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 640px) {
    .p-hero-carousel {
      aspect-ratio: 1 / 1;
    }

    .p-hero-carousel__arrow {
      width: 30px;
      height: 30px;
    }

