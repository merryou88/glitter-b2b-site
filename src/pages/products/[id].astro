---
/**
 * Product Detail Page — /products/[id]
 * Dynamic page for each glitter synthetic leather product
 */
import Layout from "@layouts/Layout.astro";
import products from "@data/products.json";

export interface ProductSpec {
  label: string;
  value: string;
}

export interface ProductFaqItem {
  q: string;
  a: string;
}

export interface Product {
  id: string;
  title: string;
  category: string;
  shortDesc: string;
  fullDescription: string;
  mainImage: string;
  skuImages: string[];
  detailImages: string[];
  videoLocal: string;
  videoYoutubeUrl: string;
  tags: string[];
  moq?: string;
  leadTime?: string;
  specs?: ProductSpec[];
  faq?: ProductFaqItem[];
}

export function getStaticPaths() {
  return (products as Product[]).map((p) => ({
    params: { id: p.id },
  }));
}

const { id } = Astro.params;
const product = (products as Product[]).find((p) => p.id === id);

if (!product) {
  return new Response(null, {
    status: 302,
    headers: { Location: "/products/" },
  });
}

// Gather all main images for gallery (from the main folder via scan)
const baseMainPath = `/images/products/${product.id}/main/`;
const skuBasePath = `/images/products/${product.id}/sku/`;

const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Products", item: "https://nixiafabric.com/products" },
    { "@type": "ListItem", position: 3, name: product.title, item: `https://nixiafabric.com/products/${product.id}` },
  ],
};

// Build main image gallery: use mainImage as hero, then all sku images
const mainImages = product.mainImage ? [product.mainImage] : [];
const galleryImages = [...mainImages, ...product.skuImages];

// FAQ structured data
const faqData = (product.faq ?? []).length > 0 && {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: (product.faq ?? []).map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

const structuredDataList = [breadcrumbData, ...(faqData ? [faqData] : [])];

// Related products: other items sharing at least one tag (max 3)
const relatedProducts = (products as Product[])
  .filter((p) => p.id !== product.id && p.tags.some((t) => product.tags.includes(t)))
  .slice(0, 3);

const toWebp = (src: string) => src.replace(/\.(png|jpe?g)$/i, ".webp");

// SEO title & description — per-product, not shared
const productMeta: Record<string, { title: string; desc: string }> = {
  "full-print-hot-stamping-spandex-milk-silk": {
    title: "Full-Print Hot-Stamping Spandex Milk-Silk Fabric | Wholesale - Nixia Fabric",
    desc: "Wholesale full-print hot-stamping spandex milk-silk fabric. 4-way stretch, soft hand-feel, free sample, low MOQ. Ideal for fashion garments, swimwear & stage costumes. Get custom quote.",
  },
  "iridescent-laser-hot-stamping-stretch-ice-silk": {
    title: "Iridescent Laser Hot-Stamping Stretch Ice-Silk Fabric | Wholesale - Nixia Fabric",
    desc: "Wholesale iridescent laser hot-stamping stretch ice-silk fabric. Gradient multi-color finish, elastic recovery, free sample, low MOQ. Ideal for stage costumes & backdrop decoration. Get custom quote.",
  },
  "non-woven-glitter-fabric": {
    title: "Non-Woven Glitter Fabric | Wholesale - Nixia Fabric",
    desc: "Wholesale non-woven glitter fabric. Dense sparkle coating, cut-clean edges, free sample, low MOQ. Ideal for holiday decoration, stage props & performance costumes. Get custom quote.",
  },
  "iridescent-gradient-laser-ice-silk": {
    title: "Iridescent Gradient Laser Hot-Stamping Ice-Silk Fabric | Wholesale - Nixia Fabric",
    desc: "Wholesale iridescent gradient laser hot-stamping ice-silk fabric. Smooth color-flow finish, stretch base, free sample, low MOQ. Ideal for fashion apparel, stage costumes & backdrops. Get custom quote.",
  },
  "plain-iridescent-laser-spandex-4-way-stretch": {
    title: "Plain Iridescent Laser Hot-Stamping Spandex | 4-Way Stretch Fabric-Nixia Fabric",
    desc: "Wholesale plain iridescent laser hot-stamping 4-way stretch spandex fabric. Free sample, low 100m MOQ. For swimwear, stage costumes & dance apparel. Get custom quote.",
  },
  "rainbow-gradient-glitter-synthetic-leather": {
    title: "Rainbow Gradient Glitter Synthetic Leather Fabric | Wholesale - Nixia Fabric",
    desc: "Wholesale rainbow gradient glitter synthetic leather. Reflective finish, structured base, free sample, low MOQ. Ideal for bags, footwear & book-covering materials. Get custom quote.",
  },
};

const meta = productMeta[product.id] ?? {
  title: `${product.title} | Wholesale - Nixia Fabric`,
  desc: product.shortDesc,
};
const seoTitle = meta.title;
const seoDesc = meta.desc;
---

<Layout
  title={seoTitle}
  description={seoDesc}
  keywords={product.tags.join(", ")}
  image={product.mainImage ? `https://nixiafabric.com${product.mainImage}` : undefined}
  canonical={`https://nixiafabric.com/products/${product.id}`}
  structuredData={structuredDataList}
>
  <!-- Hero Section -->
  <section class="detail-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">/</span>
        <a href="/products/">Products</a>
        <span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__current">{product.title}</span>
      </nav>

      <div class="detail-layout">
        {/* Hero Carousel — plain-iridescent-laser-spandex-4-way-stretch only */}
        {product.id === "plain-iridescent-laser-spandex-4-way-stretch" ? (
          <div class="p-hero-gallery" id="p-hero-gallery">
            <div class="p-hero-gallery__main" id="p-hero-main">
              <img id="p-hero-img" src="/images/products/plain-iridescent-laser-spandex-4-way-stretch/main/1.jpg" alt="Plain iridescent laser hot‑stamping 4‑way stretch spandex fabric" loading="eager" decoding="async" />
              <video id="p-hero-video" controls preload="none" muted playsinline style="display:none">
                <source src="/images/products/plain-iridescent-laser-spandex-4-way-stretch/video/demo-video.mp4" type="video/mp4" />
              </video>
            </div>
            <div class="p-hero-gallery__thumbs">
              <button class="p-hero-gallery__thumb p-hero-gallery__thumb--active" data-type="image" data-src="/images/products/plain-iridescent-laser-spandex-4-way-stretch/main/1.jpg" aria-label="View main image">
                <img src="/images/products/plain-iridescent-laser-spandex-4-way-stretch/main/1.jpg" alt="Plain iridescent laser hot‑stamping 4‑way stretch spandex fabric" width="120" height="80" loading="eager" decoding="async" />
              </button>
              {[2, 3, 4].map((n) => (
                <button class="p-hero-gallery__thumb" data-type="image" data-src={`/images/products/plain-iridescent-laser-spandex-4-way-stretch/detail/${n}.jpg`} aria-label="View detail image">
                  <img src={`/images/products/plain-iridescent-laser-spandex-4-way-stretch/detail/${n}.jpg`} alt="Plain iridescent laser hot‑stamping 4‑way stretch spandex fabric" width="120" height="80" loading="lazy" decoding="async" />
                </button>
              ))}
            </div>
          </div>
        ) : (
        /* Default gallery for other products */
        <div class="detail-gallery">
          <!-- Main Image -->
          <div class="detail-gallery__main">
            {
              product.mainImage ? (
                <picture>
                  <source srcset={toWebp(product.mainImage)} type="image/webp" />
                  <img id="main-image" src={product.mainImage} alt={product.title} class="detail-gallery__hero" loading="lazy" width="1200" height="675" decoding="async" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                </picture>
              ) : null
            }
            <div
              class="detail-gallery__hero-placeholder"
              style={product.mainImage ? "display:none" : "display:flex"}
            >
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                <circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <span>Image coming soon</span>
            </div>
          </div>

          <!-- Gallery Thumbnails -->
          {
            galleryImages.length > 1 && (
              <div class="detail-gallery__thumbs">
                {galleryImages.map((img: string, i: number) => (
                  <button
                    class={`detail-gallery__thumb ${i === 0 ? "detail-gallery__thumb--active" : ""}`}
                    onclick={`document.getElementById('main-image').src='${img}';document.querySelectorAll('.detail-gallery__thumb').forEach(b=>b.classList.remove('detail-gallery__thumb--active'));this.classList.add('detail-gallery__thumb--active')`}
                    aria-label={`View image ${i + 1}`}
                  >
                    <picture>
                      <source srcset={toWebp(img)} type="image/webp" />
                      <img src={img} alt={`${product.title} thumbnail ${i + 1}`} loading="lazy" width="80" height="80" decoding="async" onerror="this.style.display='none'" />
                    </picture>
                  </button>
                ))}
              </div>
            )
          }
        </div>
        )}

        <!-- Product Info -->
        <div class="detail-info">
          <span class="badge badge--accent">{product.category}</span>
          <h1 class="detail-info__title">{product.title}</h1>
          <p class="detail-info__desc">{product.shortDesc}</p>

          <!-- MOQ / Lead Time highlights -->
          <div class="detail-highlights">
            {product.moq && <span class="detail-highlights__item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 7h-9l-2 2H4a1 1 0 0 0-1 1v8a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1z"/></svg>{product.moq}</span>}
            {product.leadTime && <span class="detail-highlights__item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>{product.leadTime}</span>}
            <span class="detail-highlights__item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>Free Sample</span>
          </div>

          <!-- CTA Buttons -->
          <div class="detail-cta">
            <a href="/sample-policy/" class="btn btn--primary btn--lg">
              Request Free Sample
            </a>
            <a href={`/contact/?sku=${product.id}`} class="btn btn--outline btn--lg">
              Add to Quote
            </a>
          </div>

          <!-- Quick Specs -->
          <div class="detail-specs">
            <div class="detail-specs__item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span>SGS Certified</span>
            </div>
            <div class="detail-specs__item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span>REACH Compliant</span>
            </div>
            <div class="detail-specs__item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span>Custom Color Matching</span>
            </div>
            <div class="detail-specs__item">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              <span>{product.skuImages.length > 0 ? `${product.skuImages.length} Color Options` : "Multi-Color Available"}</span>
            </div>
          </div>

          <!-- Tags -->
          <div class="detail-tags">
            {product.tags.map((tag: string) => (
              <span class="detail-tags__item">{tag.replace(/-/g, " ")}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Full Description -->
  <section class="section">
    <div class="container">
      <div class="detail-body">
        <!-- Description -->
        <div class="detail-body__text">
          <h2>Product Description</h2>
          {product.fullDescription.split("\n\n").map((para: string) => (
            <p>{para}</p>
          ))}
        </div>

        <!-- SKU Color Gallery -->
        {product.skuImages.length > 0 && (
          <div class="detail-body__section" id="sku-colors">
            <h2>Color Options ({product.skuImages.length})</h2>
            <div class="sku-grid">
              {product.skuImages.map((img: string) => (
                <div class="sku-item">
                  <picture>
                    <source srcset={toWebp(img)} type="image/webp" />
                    <img src={img} alt="Color variant" loading="lazy" width="200" height="200" decoding="async" onerror="this.style.display='none';this.parentElement.querySelector('.sku-item__placeholder').style.display='flex'" />
                  </picture>
                  <div class="sku-item__placeholder" style="display:none">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21 15 16 10 5 21"/>
                    </svg>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Detail Images -->
        {product.detailImages.length > 0 && (
          <div class="detail-body__section">
            <h2>Product Details</h2>
            <div class="detail-images-grid">
              {product.detailImages.map((img: string) => (
                <picture>
                  <source srcset={toWebp(img)} type="image/webp" />
                  <img src={img} alt={`${product.title} detail`} loading="lazy" width="1200" height="675" class="detail-image" decoding="async" onerror="this.style.display='none'" />
                </picture>
              ))}
            </div>
          </div>
        )}

        <!-- Video: YouTube priority > local mp4 > none -->
        {(product.videoYoutubeUrl || product.videoLocal) && (
          <div class="detail-body__section">
            <h2>Product Video</h2>
            <div class="detail-video">
              {product.videoYoutubeUrl ? (
                <iframe
                  src={product.videoYoutubeUrl.replace("watch?v=", "embed/")}
                  title={`${product.title} video`}
                  class="detail-video__player"
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                  style="border:none"
                >
                </iframe>
              ) : product.videoLocal ? (
                <video
                  controls
                  preload="metadata"
                  poster={product.mainImage}
                  class="detail-video__player"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
                >
                  <source src={product.videoLocal} type="video/mp4" />
                  Your browser does not support the video element.
                </video>
              ) : null}
              <div class="detail-video__fallback" style="display:none">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
                </svg>
                <span>Video unavailable</span>
              </div>
            </div>
          </div>
        )}

        <!-- Specifications -->
        {(product.specs ?? []).length > 0 && (
          <div class="detail-body__section" id="specifications">
            <h2>Product Specifications</h2>
            <dl class="spec-grid">
              {(product.specs ?? []).map((spec) => (
                <div class="spec-grid__item">
                  <dt>{spec.label}</dt>
                  <dd>{spec.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        <!-- OEM / ODM Service -->
        <div class="detail-body__section detail-body__section--full">
          <h2>OEM &amp; ODM Manufacturing Service</h2>
          <div class="oem-grid">
            <div class="oem-card">
              <div class="oem-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
              </div>
              <h3>Custom Development</h3>
              <p>Custom logo, pattern, color, width, thickness, backing and packaging development. From your design or reference sample to bulk production with physical approval samples at every stage.</p>
            </div>
            <div class="oem-card">
              <div class="oem-card__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2 4-4"/><path d="M21 12c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 19.5 4 17 4 12V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
              </div>
              <h3>Sampling, QC &amp; Export</h3>
              <p>Free samples within 3–7 working days. Inline quality control and final inspection on every bulk order, plus export-ready packing and FOB / CIF shipping arrangement.</p>
            </div>
          </div>
        </div>

        <!-- FAQ -->
        {(product.faq ?? []).length > 0 && (
          <div class="detail-body__section" id="faq">
            <h2>Frequently Asked Questions</h2>
            <div class="faq-list">
              {(product.faq ?? []).map((item) => (
                <details class="faq-item">
                  <summary>{item.q}</summary>
                  <p>{item.a}</p>
                </details>
              ))}
            </div>
          </div>
        )}

        <!-- Sample Policy -->
        <div class="detail-body__section detail-sample-policy">
          <h2>Sample Policy</h2>
          <div class="sample-policy-content">
            <p>
              <strong>Free sample available</strong> — customer bears international shipping cost.
              The shipping cost will be <strong>deducted from your bulk order</strong>.
            </p>
            <p>
              <strong>SGS</strong> and <strong>REACH</strong> test reports available upon request.
              Custom color matching and backing options are also available for bulk orders.
            </p>
          </div>
          <div class="detail-cta detail-cta--bottom">
            <a href="/sample-policy/" class="btn btn--primary btn--lg">
              Request Free Sample
            </a>
            <a href={`/contact/?sku=${product.id}`} class="btn btn--outline btn--lg">
              Add to Quote
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Products -->
  {relatedProducts.length > 0 && (
    <section class="section section--alt" aria-label="Related products">
      <div class="container">
        <div class="section-header">
          <h2>You May Also Like</h2>
          <p>Other glitter &amp; foil fabrics frequently ordered together with this item.</p>
        </div>
        <div class="related-grid">
          {relatedProducts.map((rel) => (
            <a href={`/products/${rel.id}/`} class="related-card">
              <div class="related-card__visual">
                <picture>
                  <source srcset={toWebp(rel.mainImage)} type="image/webp" />
                  <img src={rel.mainImage} alt={rel.title} loading="lazy" width="1200" height="675" decoding="async" />
                </picture>
              </div>
              <div class="related-card__body">
                <h3>{rel.title}</h3>
                <span class="related-card__meta">{rel.moq ?? "Low MOQ"}</span>
                <span class="related-card__link">View Details ›</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<script>
  const gallery = document.getElementById('p-hero-gallery');
  if (gallery) {
    const heroImg = document.getElementById('p-hero-img');
    const heroVid = document.getElementById('p-hero-video');
    const thumbs = gallery.querySelectorAll('.p-hero-gallery__thumb');

    thumbs.forEach(thumb => {
      thumb.addEventListener('click', () => {
        thumbs.forEach(t => t.classList.remove('p-hero-gallery__thumb--active'));
        thumb.classList.add('p-hero-gallery__thumb--active');
        const type = thumb.dataset.type;

        if (type === 'video') {
          heroImg.style.display = 'none';
          heroVid.style.display = 'block';
          heroVid.currentTime = 0;
        } else {
          heroVid.pause();
          heroVid.style.display = 'none';
          heroImg.style.display = 'block';
          heroImg.src = thumb.dataset.src;
        }
      });
    });
  }
</script>

<style>
  /* ===== Hero ===== */
  .detail-hero {
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-3xl);
  }

  .breadcrumb {
    margin-bottom: var(--space-xl);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-accent-dark);
  }

  .breadcrumb__sep {
    margin-inline: var(--space-xs);
    opacity: 0.5;
  }

  .breadcrumb__current {
    color: var(--color-text-secondary);
    font-weight: 600;
  }

  .detail-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  /* ===== Gallery ===== */
  .detail-gallery {
    position: sticky;
    top: calc(var(--header-height) + var(--space-xl));
  }

  .detail-gallery__main {
    aspect-ratio: 16 / 9;
    background: var(--color-bg);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .detail-gallery__hero {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .detail-gallery__main picture,
  .detail-images-grid picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .detail-gallery__hero-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    width: 100%;
    height: 100%;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .detail-gallery__thumbs {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    overflow-x: auto;
    padding-bottom: var(--space-xs);
  }

  .detail-gallery__thumb {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    border: 2px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    padding: 0;
    background: none;
