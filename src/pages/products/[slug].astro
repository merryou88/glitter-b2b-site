---
/**
 * Product Detail Page — /products/[slug]
 * ---------------------------------------------------------------------------
 * Astro dynamic route. At build time it loops over every entry in
 * allProducts.js and generates one static page per public product at
 * /products/{slug}.
 *
 * This page is responsible ONLY for:
 *   - <head> SEO: title, meta description, og:title, og:description,
 *     og:image, og:type
 *   - Product, FAQPage and BreadcrumbList structured data
 *
 * The visible UI lives entirely in <ProductDetail product={product} />.
 */
import { existsSync } from "node:fs";
import Layout from "@layouts/Layout.astro";
import ProductDetail from "@components/ProductDetail.astro";
import ProductSchema from "@components/ProductSchema.astro";
import { performanceProducts } from "@data/allProducts";

export function getStaticPaths() {
  return performanceProducts.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props as {
  product: (typeof performanceProducts)[number];
};

const productUrl = `https://nixiafabric.com/products/${product.slug}/`;
const ogImage = `https://nixiafabric.com${product.mainImageUrl}`;

const heroImage = product.galleryImages[0]
  ? `${product.galleryMainPath}${product.galleryImages[0]}`
  : product.mainImageUrl;
const heroWebp = heroImage.replace(/\.(png|jpe?g)$/i, ".webp");
const hero = existsSync(`public${heroWebp}`) ? heroWebp : heroImage;

const getImageMimeType = (src = "") => {
  if (/\.png$/i.test(src)) return "image/png";
  if (/\.webp$/i.test(src)) return "image/webp";
  return "image/jpeg";
};

// JSON-LD: FAQPage schema (each product supplies its own Q&A list)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: product.faqList.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

// JSON-LD: breadcrumb for navigation context
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Products", item: "https://nixiafabric.com/products/" },
    { "@type": "ListItem", position: 3, name: product.title, item: productUrl },
  ],
};
---

<Layout
  title={product.metaTitle}
  description={product.metaDesc}
  canonical={productUrl}
  image={ogImage}
  ogType="product"
  structuredData={[faqSchema, breadcrumbSchema]}
  preloadImages={[{ href: hero, type: getImageMimeType(hero), fetchpriority: "high" }]}
>
  <ProductSchema
    productName={product.title}
    productImageUrl={product.mainImageUrl ? `https://nixiafabric.com${product.mainImageUrl}` : ""}
    productDescription={product.fullDescription || product.metaDesc}
    pageUrl={productUrl}
  />
  <ProductDetail product={product} />
</Layout>
