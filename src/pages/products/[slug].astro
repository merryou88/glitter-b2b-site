---
/**
 * Product Detail Page — /products/[slug]
 * ---------------------------------------------------------------------------
 * Astro dynamic route. At build time it loops over every entry in
 * allProducts.js and generates one static page per public product at
 * /products/{slug}.
 *
 * This page is responsible ONLY for:
 *   - <head> SEO: title, meta description, og:title, og:description,
 *     og:image, og:type
 *   - FAQPage and BreadcrumbList structured data
 *   - Build-time gallery assets and matching responsive preload when enabled
 *
 * The visible UI lives entirely in <ProductDetail product={product} />.
 */
import { existsSync } from "node:fs";
import Layout from "@layouts/Layout.astro";
import ProductDetail from "@components/ProductDetail.astro";
import { performanceProducts } from "@data/allProducts";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

// Optimize selected galleries without importing unrelated product assets.
const optimizedGalleryImages = import.meta.glob<{ default: ImageMetadata }>(
  [
    "/public/images/products/H2013120107/main/*-main-[1-5].webp",
    "/public/images/products/H2013120101/main/*-main-[1-5].webp",
    "/public/images/products/H2013120105/main/*-main-[1-5].webp",
    "/public/images/products/H2013090101/main/*-main-[1-5].webp",
    "/public/images/products/H2013120106/main/*-main-[1-5].webp",
    "/public/images/products/H2013090102/main/*-main-[1-5].webp",
    "/public/images/products/H2013090104/main/*-main-[1-5].webp",
    "/public/images/products/H2013060102/main/*-main-[1-5].webp",
    "/public/images/products/H2015030103/main/*-main-[1-5].webp",
  ],
  { eager: true },
);

export function getStaticPaths() {
  return performanceProducts.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props as {
  product: (typeof performanceProducts)[number];
};

const productUrl = `https://nixiafabric.com/products/${product.slug}/`;
const ogImage = `https://nixiafabric.com${product.mainImageUrl}`;

// Keep product-page search terms close to the product data so new products
// inherit a useful buyer-intent keyword set without another page edit.
const productKeywords = [
  product.title,
  ...(product.applications ?? []),
  "foil fabric supplier",
  "wholesale foil fabric",
  "performance fabric manufacturer",
]
  .filter(Boolean)
  .join(", ");

const heroImage = product.galleryImages[0]
  ? `${product.galleryMainPath}${product.galleryImages[0]}`
  : product.mainImageUrl;
const heroWebp = heroImage.replace(/\.(png|jpe?g)$/i, ".webp");
const hero = existsSync(`public${heroWebp}`) ? heroWebp : heroImage;

const gallerySizes = "(max-width: 592px) calc(100vw - 32px), (max-width: 968px) 560px, (max-width: 1240px) calc(47vw - 22.56px), 560px";
const optimizedGallery = [
  "iridescent-laser-hot-stamping-stretch-ice-silk",
  "rainbow-iridescent-laser-foil-nylon-spandex-fabric",
  "holographic-mermaid-scale-milk-silk-stretch-fabric",
  "holographic-snakeskin-stretch-fabric",
  "iridescent-gradient-laser-ice-silk",
  "plain-iridescent-laser-spandex-4-way-stretch",
  "rainbow-dot-laser-foil-knit-fabric",
  "rainbow-stripe-foil-4-way-stretch-fabric",
  "shattered-glass-metallic-foil-dot-4-way-stretch-nylon-spandex-fabric",
].includes(product.slug)
  ? await Promise.all(product.galleryImages.slice(0, 8).map(async (file) => {
      const source = optimizedGalleryImages[`/public${product.galleryMainPath}${file}`]?.default;
      if (!source) throw new Error(`Missing optimized gallery source: ${file}`);
      const [main, thumbnail] = await Promise.all([
        getImage({
          src: source,
          widths: [...new Set([480, 720, 1080, 1440].map((width) => Math.min(width, source.width)))],
          width: Math.min(1080, source.width),
          format: "webp",
          quality: 76,
        }),
        getImage({ src: source, width: 160, format: "webp", quality: 70 }),
      ]);
      return {
        src: main.src,
        srcset: main.srcSet.attribute,
        sizes: gallerySizes,
        width: Number(main.attributes.width),
        height: Number(main.attributes.height),
        thumbnail: thumbnail.src,
      };
    }))
  : [];

const getImageMimeType = (src = "") => {
  if (/\.png$/i.test(src)) return "image/png";
  if (/\.webp$/i.test(src)) return "image/webp";
  return "image/jpeg";
};

// JSON-LD: FAQPage schema (each product supplies its own Q&A list)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: product.faqList.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

// JSON-LD: breadcrumb for navigation context
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Products", item: "https://nixiafabric.com/products/" },
    { "@type": "ListItem", position: 3, name: product.title, item: productUrl },
  ],
};
---

<Layout
  title={product.metaTitle}
  description={product.metaDesc}
  keywords={productKeywords}
  canonical={productUrl}
  image={ogImage}
  ogType="product"
  structuredData={[faqSchema, breadcrumbSchema]}
  preloadImages={optimizedGallery.length ? [] : [{ href: hero, type: getImageMimeType(hero), fetchpriority: "high" }]}
>
  {optimizedGallery[0] && (
    <link slot="head" rel="preload" as="image" href={optimizedGallery[0].src}
      imagesrcset={optimizedGallery[0].srcset} imagesizes={gallerySizes}
      type="image/webp" fetchpriority="high" />
  )}
  <ProductDetail product={product} optimizedGallery={optimizedGallery} />
</Layout>
