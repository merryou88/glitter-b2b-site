---
/**
 * Product Detail Page — /products/[slug]
 * Also handles end-use category pages (fabric-for-shoes, etc.)
 *
 * If slug matches an end-use category, renders EndUseListing.
 * Otherwise renders the product detail template.
 */
import Layout from "@layouts/Layout.astro";
import CTAButton from "@components/CTAButton.astro";
import SpecificationTable from "@components/SpecificationTable.astro";
import EndUseListing from "@components/EndUseListing.astro";
import {
  allProducts,
  getProductBySlug,
  endUseCategories,
  getProductsByEndUse,
  getEndUseLabel,
} from "@data/products";
import type { Product, EndUseCategory } from "@data/products";

// Color swatch mapping for visual placeholders
const colorSwatchMap: Record<string, string> = {
  Gold: "#D4AF37",
  Silver: "#C0C0C0",
  "Rose Gold": "#B76E79",
  Black: "#1A1A1A",
  "Navy Blue": "#1B2845",
  Champagne: "#F7E7CE",
  Red: "#C41E3A",
  Pink: "#E8A0BF",
  Blue: "#3B82F6",
  Green: "#2E7D32",
  Gunmetal: "#2A3439",
  "Bright Gold": "#FFD700",
  "Antique Gold": "#8B7355",
  "Champagne Gold": "#F7E7CE",
  "Bright Silver": "#E8E8E8",
  "Antique Silver": "#9C9C9C",
  Platinum: "#E5E4E2",
};

export function getStaticPaths() {
  // Product detail paths
  const productPaths = allProducts.map((product) => ({
    params: { slug: product.slug },
    props: { type: "product" as const, product },
  }));

  // End-use category paths
  const endUsePaths = endUseCategories.map((cat) => {
    const products = getProductsByEndUse(cat.slug);
    return {
      params: { slug: cat.slug },
      props: { type: "endUse" as const, category: cat, products },
    };
  });

  return [...productPaths, ...endUsePaths];
}

interface Props {
  type: "product" | "endUse";
  product?: Product;
  category?: EndUseCategory;
  products?: Product[];
}

const { type, product, category, products } = Astro.props;

// ==================== Product Detail Page ====================
const p = product as Product | undefined;
const isProduct = type === "product" && !!p;
const isEndUse = type === "endUse" && !!category && !!products;

// Guard all product-specific computations for end-use pages
const relatedProducts = p
  ? allProducts.filter((rp) => rp.category === p.category && rp.slug !== p.slug).slice(0, 3)
  : [];

const endUseLabels = p ? p.endUse.map((tag) => getEndUseLabel(tag)) : [];

const breadcrumbData = p ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Products", item: "https://nixiafabric.com/products" },
    { "@type": "ListItem", position: 3, name: p.name, item: `https://nixiafabric.com/products/${p.slug}` },
  ],
} : {};

const productStructuredData = p ? {
  "@context": "https://schema.org",
  "@type": "Product",
  name: p.name,
  description: p.description,
  category: p.category,
  url: `https://nixiafabric.com/products/${p.slug}`,
  brand: { "@type": "Brand", name: "Nixia Fabric" },
  manufacturer: { "@type": "Organization", name: "Nixia Fabric", url: "https://nixiafabric.com" },
  material: p.specifications.composition,
  additionalProperty: [
    { "@type": "PropertyValue", name: "GSM", value: p.specifications.gsm },
    { "@type": "PropertyValue", name: "Width", value: p.specifications.width },
    { "@type": "PropertyValue", name: "Backing", value: p.specifications.backing },
    { "@type": "PropertyValue", name: "Craft", value: p.craft },
    { "@type": "PropertyValue", name: "Applications", value: endUseLabels.join(", ") },
  ],
} : {};

const swatchColors = p
  ? p.colors.filter((c) => !c.includes("Custom")).map((c) => ({ name: c, color: colorSwatchMap[c] || "#ccc" }))
  : [];
const hasCustomColors = p ? p.colors.some((c) => c.includes("Custom")) : false;

// Determine main detail image based on product category
const detailMainImage = p
  ? p.category === "Hot-Stamping Foil Finish"
    ? "/images/detail_hotstamping_main.jpg"
    : "/images/detail_glitter_main.jpg"
  : "";

// Customization parameters for detail page
const backingOptions = [
  {
    name: "Elastic Knitted",
    image: "/images/backing_elastic_knit.jpg",
    alt: "Elastic knitted backing material for synthetic leather",
    desc: "Flexible, stretchable backing for applications requiring elasticity",
  },
  {
    name: "PU Coated",
    image: "/images/backing_pu_coated.jpg",
    alt: "PU coated backing material for synthetic leather",
    desc: "Durable, water-resistant backing for structured applications",
  },
];
---

{isEndUse && category && products ? (
  <EndUseListing category={category} products={products} />
) : isProduct ? (
  <Layout
  title={p.name}
  description={p.description}
  keywords={`${p.name}, ${p.category}, ${p.craft}, ${p.name.toLowerCase()}, ${p.specifications.composition.toLowerCase()}, fabric manufacturer`}
  canonical={`https://nixiafabric.com/products/${p.slug}`}
  structuredData={[breadcrumbData, productStructuredData]}
>
  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">/</span>
        <a href="/products">Products</a>
        <span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__current">{p.name}</span>
      </nav>
    </div>
  </div>

  <!-- Product Main Section -->
  <section class="product-main">
    <div class="container">
      <div class="product-main__grid">
        <!-- Image Gallery -->
        <div class="product-gallery">
          <div class="product-gallery__main">
            <img
              src={detailMainImage}
              alt={`${p.name} — ${p.category} synthetic leather fabric`}
              width="1200"
              height="1200"
              loading="eager"
              decoding="async"
              class="product-gallery__main-img"
            />
          </div>
          <div class="product-gallery__thumbs">
            {swatchColors.slice(0, 5).map((sw, i) => (
              <div class={`product-gallery__thumb${i === 0 ? " is-active" : ""}`}>
                <span
                  class="product-gallery__thumb-swatch"
                  style={`background:${sw.color}`}
                  title={sw.name}
                ></span>
              </div>
            ))}
          </div>
          <div class="product-gallery__hint">
            Product images for illustration. Request swatches for actual color and texture.
          </div>
        </div>

        <!-- Product Info -->
        <div class="product-info">
          <div class="product-info__badges">
            <span class="badge badge--accent">{p.category}</span>
            <span class="badge badge--craft">{p.craft}</span>
          </div>
          <h1>{p.name}</h1>
          <p class="product-info__desc">{p.description}</p>

          <!-- Suitable for (end-use tags) -->
          {endUseLabels.length > 0 && (
            <div class="product-info__suitable">
              <span class="product-info__suitable-label">Suitable for:</span>
              <div class="product-info__suitable-tags">
                {endUseLabels.map((label) => (
                  <a href={`/products/fabric-for-${label.toLowerCase().replace(/\s+/g, "-")}`} class="product-info__suitable-tag">
                    {label}
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Quick Specs -->
          <div class="product-info__quick-specs">
            <div class="quick-spec">
              <span class="quick-spec__label">Composition</span>
              <span class="quick-spec__value">{p.specifications.composition}</span>
            </div>
            <div class="quick-spec">
              <span class="quick-spec__label">Width</span>
              <span class="quick-spec__value">{p.specifications.width}</span>
            </div>
            <div class="quick-spec">
              <span class="quick-spec__label">GSM</span>
              <span class="quick-spec__value">{p.specifications.gsm}</span>
            </div>
          </div>

          <!-- CTA -->
          <div class="product-info__cta">
            <CTAButton href="/sample-policy" variant="dark" size="lg" block>
              Request Free Sample
            </CTAButton>
            <CTAButton href="/contact" variant="outline" size="lg" block>
              Get Custom Quotation
            </CTAButton>
          </div>
          <p class="product-info__note">
            Minimum order quantity applies. Contact us for sample policy and Custom Color Matching details.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Sections -->
  <section class="section section--alt">
    <div class="container">
      <div class="product-details__grid">
        <!-- Specifications -->
        <div class="product-details__col">
          <h2 class="product-details__heading">Specifications</h2>
          <SpecificationTable specs={p.specifications} />
        </div>

        <!-- Available Colors -->
        <div class="product-details__col">
          <h2 class="product-details__heading">Available Colors</h2>
          <div class="color-list">
            {swatchColors.map((sw) => (
              <div class="color-list__item">
                <span class="color-list__swatch" style={`background:${sw.color}`}></span>
                <span class="color-list__name">{sw.name}</span>
              </div>
            ))}
            {hasCustomColors && (
              <div class="color-list__item color-list__item--custom">
                <span class="color-list__swatch color-list__swatch--custom">+</span>
                <span class="color-list__name">Custom Colors</span>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Customization Parameters -->
  <section class="section">
    <div class="container">
      <div class="section-header section-header--center">
        <span class="eyebrow">Customization Options</span>
        <h2>Customize Your {p.category}</h2>
        <p>Backing material, colors, thickness, and width — all tailored to your project requirements.</p>
      </div>

      <div class="custom-params">
        <!-- Backing Options -->
        <div class="custom-params__block">
          <h3 class="custom-params__title">Backing Material</h3>
          <div class="custom-params__backing-grid">
            {backingOptions.map((opt, i) => (
              <div class={`backing-option${i === 0 ? " is-selected" : ""}`}>
                <div class="backing-option__image">
                  <img
                    src={opt.image}
                    alt={opt.alt}
                    width="800"
                    height="800"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="backing-option__body">
                  <span class="backing-option__name">{opt.name}</span>
                  <p class="backing-option__desc">{opt.desc}</p>
                </div>
                <span class="backing-option__check">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6L9 17l-5-5" />
                  </svg>
                </span>
              </div>
            ))}
          </div>
        </div>

        <!-- Color Selection -->
        <div class="custom-params__block">
          <h3 class="custom-params__title">Color Selection</h3>
          <div class="custom-params__color-grid">
            {swatchColors.map((sw, i) => (
              <div class={`color-swatch${i === 0 ? " is-selected" : ""}`}>
                <span class="color-swatch__circle" style={`background:${sw.color}`}></span>
                <span class="color-swatch__name">{sw.name}</span>
              </div>
            ))}
            {hasCustomColors && (
              <div class="color-swatch color-swatch--custom">
                <span class="color-swatch__circle color-swatch__circle--custom">+</span>
                <span class="color-swatch__name">Custom Color Matching</span>
              </div>
            )}
          </div>
        </div>

        <!-- Thickness & Width -->
        <div class="custom-params__block">
          <h3 class="custom-params__title">Thickness &amp; Width</h3>
          <div class="custom-params__specs">
            <div class="custom-params__spec">
              <span class="custom-params__spec-label">Standard Thickness</span>
              <span class="custom-params__spec-value">{p.specifications.gsm}</span>
              <span class="custom-params__spec-note">Custom thickness available upon request</span>
            </div>
            <div class="custom-params__spec">
              <span class="custom-params__spec-label">Standard Width</span>
              <span class="custom-params__spec-value">{p.specifications.width}</span>
              <span class="custom-params__spec-note">Custom width available upon request</span>
            </div>
          </div>
        </div>
      </div>

      <div class="custom-params__cta">
        <CTAButton href="/contact" variant="primary" size="lg">Get Custom Quotation</CTAButton>
        <CTAButton href="/sample-policy" variant="outline" size="lg">Request Free Sample</CTAButton>
      </div>
    </div>
  </section>

  <!-- Sample Policy -->
  <section class="section section--alt">
    <div class="container">
      <div class="sample-policy">
        <span class="eyebrow">Sample Policy</span>
        <h2>Request Free Sample</h2>
        <p class="sample-policy__text">{p.samplePolicy}</p>
        <div class="sample-policy__features">
          <div class="sample-policy__feature">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13" />
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8" />
              <circle cx="5.5" cy="18.5" r="2.5" />
              <circle cx="18.5" cy="18.5" r="2.5" />
            </svg>
            <span>Free swatch shipping</span>
          </div>
          <div class="sample-policy__feature">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <span>Fast turnaround</span>
          </div>
          <div class="sample-policy__feature">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7v10l10 5 10-5V7z" />
              <path d="M2 7l10 5 10-5" />
              <path d="M12 12v10" />
            </svg>
            <span>Custom Color Matching available</span>
          </div>
        </div>
        <CTAButton href="/sample-policy" variant="primary" size="lg">Request Free Sample</CTAButton>
      </div>
    </div>
  </section>

  <!-- Related Products -->
  {relatedProducts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="related-header">
          <div>
            <span class="eyebrow">More Products</span>
            <h2>Related {p.category}</h2>
          </div>
          <a href="/products" class="related-header__link">
            Discover Fabrics →
          </a>
        </div>
        <div class="related-grid">
          {relatedProducts.map((rp) => {
            const rpSwatches = rp.colors
              .filter((c) => !c.includes("Custom"))
              .slice(0, 3)
              .map((c) => colorSwatchMap[c] || "#ccc");
            return (
              <a href={`/products/${rp.slug}`} class="related-card">
                <div class="related-card__image">
                  {rpSwatches.map((color) => (
                    <span class="related-card__swatch" style={`background:${color}`}></span>
                  ))}
                </div>
                <div class="related-card__body">
                  <span class="badge">{rp.category}</span>
                  <h3>{rp.name}</h3>
                  <p>{rp.description.slice(0, 80)}...</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Final CTA -->
  <section class="section section--dark">
    <div class="container text-center">
      <span class="eyebrow">Ready to Start?</span>
      <h2>Get Your Custom {p.name}</h2>
      <p style="max-width: 600px; margin: var(--space-lg) auto var(--space-2xl);">
        Contact Nixia Fabric for Factory Direct Supply, Custom Color Matching, and fabric customization.
        We manufacture at our factory — no trading company, no middleman.
      </p>
      <div class="btn-group" style="justify-content: center;">
        <CTAButton href="/sample-policy" variant="primary" size="lg">Request Free Sample</CTAButton>
        <CTAButton href="/contact" variant="secondary" size="lg">Get Custom Quotation</CTAButton>
      </div>
    </div>
  </section>
</Layout>
) : null}

<style>
  /* Breadcrumb Bar */
  .breadcrumb-bar {
    background-color: var(--color-bg-alt);
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb a:hover {
    color: var(--color-accent-dark);
  }

  .breadcrumb__sep {
    color: var(--color-text-light);
  }

  .breadcrumb__current {
    color: var(--color-primary);
    font-weight: 600;
  }

  /* Product Main */
  .product-main {
    padding-block: var(--space-3xl);
  }

  .product-main__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4xl);
    align-items: start;
  }

  /* Gallery */
  .product-gallery__main {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-lg);
    background: var(--color-bg-alt);
    position: relative;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .product-gallery__main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .product-gallery__thumb.is-active {
    border-color: var(--color-accent);
  }

  .product-gallery__thumbs {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  .product-gallery__thumb {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-sm);
    background: var(--color-bg-alt);
    border: 2px solid var(--color-border);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--transition-fast);
  }

  .product-gallery__thumb:hover {
    border-color: var(--color-accent);
  }

  .product-gallery__thumb-swatch {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }

  .product-gallery__hint {
    font-size: var(--text-xs);
    color: var(--color-text-light);
    margin-top: var(--space-md);
    font-style: italic;
  }

  /* Product Info */
  .product-info__badges {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .badge--craft {
    background-color: rgba(196, 160, 53, 0.12);
    color: var(--color-accent-dark);
    border: 1px solid rgba(196, 160, 53, 0.3);
  }

  .product-info__suitable {
    margin-bottom: var(--space-2xl);
  }

  .product-info__suitable-label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .product-info__suitable-tags {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .product-info__suitable-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.875rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .product-info__suitable-tag:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-dark);
    background-color: rgba(196, 160, 53, 0.06);
  }

  .product-info h1 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .product-info__desc {
    font-size: var(--text-lg);
    line-height: 1.7;
    margin-bottom: var(--space-2xl);
  }

  .product-info__quick-specs {
    display: flex;
    gap: var(--space-lg);
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-2xl);
  }

  .quick-spec {
    flex: 1;
  }

  .quick-spec__label {
    display: block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .quick-spec__value {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-primary);
  }

  .product-info__cta {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .product-info__note {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
  }

  /* Product Details Grid */
  .product-details__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  .product-details__grid--2 {
    grid-template-columns: 1fr 1fr;
  }

  .product-details__heading {
    font-size: var(--text-xl);
    margin-bottom: var(--space-lg);
  }

  /* Color List */
  .color-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .color-list__item {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    transition: border-color var(--transition-fast);
  }

  .color-list__item:hover {
    border-color: var(--color-accent-light);
  }

  .color-list__swatch {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2), inset 0 0 0 2px rgba(255, 255, 255, 0.3);
    flex-shrink: 0;
  }

  .color-list__swatch--custom {
    background: linear-gradient(135deg, #e4e7ec, #c9cdd6);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text-muted);
    box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.3);
  }

  .color-list__name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  /* Application List */
  .application-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .application-list__item {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md);
