---
/**
 * Layout.astro — Base layout for all pages
 * Handles SEO meta, structured data, header/footer
 *
 * SEO features:
 * - Primary meta tags (title, description, keywords)
 * - Canonical URL
 * - Open Graph + Twitter Cards
 * - JSON-LD structured data (Organization + WebSite + page-specific)
 * - Robots meta
 * - Theme color
 * - Font preconnect + preload
 * - Skip link for accessibility
 */
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import FloatingContact from "@components/FloatingContact.astro";
import RFQQuoteModal from "@components/RFQQuoteModal.astro";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  canonical?: string;
  /** Page type for OG: "website" (default), "article" or "product" */
  ogType?: "website" | "article" | "product";
  /** Additional JSON-LD structured data */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Robots meta: default "index, follow" */
  robots?: string;
  /** LCP image preloads: { href, type, media?, fetchpriority? } */
  preloadImages?: Array<{
    href: string;
    type?: string;
    media?: string;
    fetchpriority?: string;
  }>;
  footerFocus?: "default" | "foil";
}

const {
  title,
  description = "Nixia Fabric is a specialist foil fabric supplier for stage costumes, performance wear, dancewear and party apparel, with ready-stock styles and custom development support.",
  keywords = "foil fabric supplier, foil fabrics, hot-stamping foil fabric, laser foil fabric, iridescent foil fabric, stage costume fabric, dancewear fabric",
  image = "/og-image.jpg",
  canonical,
  ogType = "website",
  structuredData,
  robots = "index, follow",
  preloadImages = [],
  footerFocus = "default",
} = Astro.props;

const siteName = "Nixia Fabric";
const siteUrl = "https://nixiafabric.com";
const isHomePage = Astro.url.pathname === "/";
const pageTitle = title
  ? title.includes(siteName)
    ? title
    : `${title} | ${siteName}`
    : `${siteName} — Specialist Foil Fabric Supplier`;
const withTrailingSlash = (value: string) => {
  const url = new URL(value, siteUrl);
  if (url.pathname !== "/" && !url.pathname.endsWith("/")) {
    url.pathname += "/";
  }
  return url.toString();
};
const canonicalUrl = withTrailingSlash(canonical || new URL(Astro.url.pathname, siteUrl).toString());
const ogImageUrl = new URL(image, Astro.site).toString();
const getImageMimeType = (src = "") => {
  if (/\.png$/i.test(src)) return "image/png";
  if (/\.webp$/i.test(src)) return "image/webp";
  return "image/jpeg";
};
const ogImageType = getImageMimeType(ogImageUrl);

// Organization structured data
const orgStructuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Nixia Fabric",
  alternateName: "Nixia Fabric Manufacturer",
  description: "Specialist foil fabric supplier for stage costumes, performance wear, dancewear and party apparel, with ready-stock styles and custom development support.",
  url: siteUrl,
  logo: `${siteUrl}/logo.png`,
  address: {
    "@type": "PostalAddress",
    streetAddress: "No.63 Chuangqi Road, Shilou Town, Panyu District",
    addressLocality: "Guangzhou",
    addressRegion: "Guangdong",
    addressCountry: "CN",
  },
  areaServed: ["Worldwide"],
  knowsAbout: [
    "Hot-Stamping Performance Fabric",
    "Iridescent Stretch Fabric",
    "Foil Fabric Supplier",
    "Custom Color Matching",
    "Custom Backing Options",
    "Stage Costume Fabric Manufacturing",
    "Dancewear Fabric Manufacturing",
    "Performance Costume Fabric Supply",
  ],
};

// WebSite structured data (enables sitelinks search box)
const websiteStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Nixia Fabric",
  url: siteUrl,
  publisher: {
    "@type": "Organization",
    name: "Nixia Fabric",
  },
};

// Merge all structured data
const allStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? [orgStructuredData, websiteStructuredData, ...structuredData]
    : [orgStructuredData, websiteStructuredData, structuredData]
  : [orgStructuredData, websiteStructuredData];
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js), loaded after the first render -->
    <script is:inline>
      (function () {
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
        window.__nixiaTrack = window.__nixiaTrack || function (eventName, params) {
          var eventParams = params || {};
          if (window.__nixiaAnalyticsDebug) {
            eventParams = Object.assign({ debug_mode: true }, eventParams);
          }
          window.gtag("event", eventName, eventParams);
        };

        // Keep first-touch campaign data available to inquiry forms.
        try {
          var params = new URLSearchParams(window.location.search);
          var debugParam = params.get("ga_debug");
          if (debugParam === "1") {
            window.sessionStorage.setItem("nixia_ga_debug", "1");
          } else if (debugParam === "0") {
            window.sessionStorage.removeItem("nixia_ga_debug");
          }
          window.__nixiaAnalyticsDebug =
            debugParam === "1" ||
            window.sessionStorage.getItem("nixia_ga_debug") === "1";

          var keys = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "gclid"];
          var attribution = {};
          try {
            attribution = JSON.parse(window.sessionStorage.getItem("nixia_attribution") || "{}");
          } catch (error) {}
          keys.forEach(function (key) {
            var value = params.get(key);
            if (value && !attribution[key]) attribution[key] = value;
          });
          var existingAttribution = window.sessionStorage.getItem("nixia_attribution");
          if (Object.keys(attribution).length || !existingAttribution) {
            attribution.landing_page = attribution.landing_page || window.location.href;
            attribution.landing_at = attribution.landing_at || new Date().toISOString();
            window.sessionStorage.setItem("nixia_attribution", JSON.stringify(attribution));
          }
        } catch (error) {}

        var analyticsOptOutCookie = "nixia_ga_optout=true";
        if (document.cookie.split("; ").indexOf(analyticsOptOutCookie) !== -1) {
          return;
        }

        function loadAnalytics() {
          if (window.__nixiaAnalyticsLoaded) return;
          window.__nixiaAnalyticsLoaded = true;

          var googleTag = document.createElement("script");
          googleTag.async = true;
          googleTag.src = "https://www.googletagmanager.com/gtag/js?id=G-VDYGZBSQ62";
          document.head.appendChild(googleTag);

          window.gtag("js", new Date());
          window.gtag("config", "G-VDYGZBSQ62", window.__nixiaAnalyticsDebug
            ? { debug_mode: true }
            : {});
        }

        window.addEventListener("load", function () {
          if ("requestIdleCallback" in window) {
            window.requestIdleCallback(loadAnalytics, { timeout: 2000 });
          } else {
            window.setTimeout(loadAnalytics, 1200);
          }
        }, { once: true });
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Robots -->
    <meta name="robots" content={robots} />
    <meta name="author" content="Nixia Fabric" />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="7 days" />

    <!-- Mobile / PWA -->
    <meta name="theme-color" content="#16294d" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Nixia Fabric" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={`${siteName} — Specialist Foil Fabric Supplier`} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${siteName} — Specialist Foil Fabric Supplier`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    {isHomePage && (
      <>
        <!-- LCP: Preload hero image (desktop & mobile variants) -->
        <link rel="preload" as="image" href="/images/home/slide1.webp" type="image/webp" media="(min-width: 769px)" fetchpriority="high" />
        <link rel="preload" as="image" href="/images/home/slide1-mobile.webp" type="image/webp" media="(max-width: 768px)" fetchpriority="high" />
      </>
    )}

    {preloadImages.map((img) => (
      <link
        rel="preload"
        as="image"
        href={img.href}
        type={img.type}
        media={img.media}
        fetchpriority={img.fetchpriority}
      />
    ))}

    <!-- Structured Data -->
    {allStructuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <!-- Astro view transitions (optional) -->
    <meta name="view-transition" content="same-origin" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer focus={footerFocus} />
    <RFQQuoteModal />
    <FloatingContact />

    <style>
      .skip-link {
        position: absolute;
        top: -100px;
        left: 0;
        padding: 0.75rem 1.5rem;
        background-color: var(--color-primary);
        color: var(--color-white);
        z-index: var(--z-modal);
        border-radius: 0 0 var(--radius-sm) 0;
        transition: top var(--transition-fast);
      }

      .skip-link:focus {
        top: 0;
      }
    </style>
  </body>
</html>
