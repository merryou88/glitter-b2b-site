---
/**
 * Layout.astro — Base layout for all pages
 * Handles SEO meta, structured data, header/footer
 *
 * SEO features:
 * - Primary meta tags (title, description, keywords)
 * - Canonical URL
 * - Open Graph + Twitter Cards
 * - JSON-LD structured data (Organization + WebSite + page-specific)
 * - Robots meta
 * - Theme color
 * - Font preconnect + preload
 * - Skip link for accessibility
 */
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import FloatingContact from "@components/FloatingContact.astro";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  canonical?: string;
  /** Page type for OG: "website" (default) or "article" */
  ogType?: "website" | "article";
  /** Additional JSON-LD structured data */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Robots meta: default "index, follow" */
  robots?: string;
}

const {
  title,
  description = "Nixia Fabric is a China manufacturer specializing in Chunky Glitter Synthetic Leather and Foil-Printed Synthetic Leather for shoes, handbags, and fashion accessories. Factory Direct Supply and Custom Color Matching.",
  keywords = "chunky glitter synthetic leather, foil-printed synthetic leather, glitter fabric manufacturer, foil fabric manufacturer, fabric factory china, metallic fabric factory, Custom Color Matching, Custom Backing Options",
  image = "/og-image.svg",
  canonical,
  ogType = "website",
  structuredData,
  robots = "index, follow",
} = Astro.props;

const siteName = "Nixia Fabric";
const siteUrl = "https://nixiafabric.com";
const pageTitle = title ? `${title} | ${siteName}` : `${siteName} — Glitter & Foil-Printed Synthetic Leather Manufacturer`;
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(image, Astro.site).toString();

// Organization structured data
const orgStructuredData = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Nixia Fabric",
  alternateName: "Nixia Fabric Manufacturer",
  description: "China manufacturer specializing in Chunky Glitter Synthetic Leather and Foil-Printed Synthetic Leather for shoes, handbags, and fashion accessories. Factory Direct Supply and Custom Color Matching.",
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  address: {
    "@type": "PostalAddress",
    addressCountry: "CN",
  },
  areaServed: ["Worldwide"],
  knowsAbout: [
    "Chunky Glitter Synthetic Leather",
    "Foil-Printed Synthetic Leather",
    "Composite Fabric",
    "Factory Direct Supply",
    "Custom Color Matching",
    "Custom Backing Options",
    "Decorative Fabric Manufacturing",
  ],
  makesOffer: [
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Product",
        name: "Chunky Glitter Synthetic Leather",
        category: "Decorative Fabric",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Product",
        name: "Foil-Printed Synthetic Leather",
        category: "Decorative Fabric",
      },
    },
  ],
};

// WebSite structured data (enables sitelinks search box)
const websiteStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Nixia Fabric",
  url: siteUrl,
  publisher: {
    "@type": "Organization",
    name: "Nixia Fabric",
  },
};

// Merge all structured data
const allStructuredData = structuredData
  ? Array.isArray(structuredData)
    ? [orgStructuredData, websiteStructuredData, ...structuredData]
    : [orgStructuredData, websiteStructuredData, structuredData]
  : [orgStructuredData, websiteStructuredData];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Robots -->
    <meta name="robots" content={robots} />
    <meta name="author" content="Nixia Fabric" />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="7 days" />

    <!-- Mobile / PWA -->
    <meta name="theme-color" content="#16294d" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Nixia Fabric" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${siteName} — Decorative Fabric Manufacturer`} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${siteName} — Decorative Fabric Manufacturer`} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Performance: Preconnect & DNS Prefetch -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />

    <!-- Fonts: Inter -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data -->
    {allStructuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <!-- Astro view transitions (optional) -->
    <meta name="view-transition" content="same-origin" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <FloatingContact />

    <style>
      .skip-link {
        position: absolute;
        top: -100px;
        left: 0;
        padding: 0.75rem 1.5rem;
        background-color: var(--color-primary);
        color: var(--color-white);
        z-index: var(--z-modal);
        border-radius: 0 0 var(--radius-sm) 0;
        transition: top var(--transition-fast);
      }

      .skip-link:focus {
        top: 0;
      }
    </style>
  </body>
</html>
