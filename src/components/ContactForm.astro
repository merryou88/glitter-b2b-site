---
/**
 * ContactForm.astro — Reusable contact inquiry form
 * Posts to Worker: WORKER_URL + "/api/inquiry/contact"
 * Custom English validation
 * Success → /thank-you; failure → inline error message
 */

// Backend endpoint comes from environment — NEVER hard-code the domain.
// Set WORKER_URL in .env (dev) / .env.production (prod) or as a build var.
const WORKER_URL = (import.meta.env.WORKER_URL ?? "").replace(/\/$/, "");
const CONTACT_ENDPOINT = WORKER_URL ? `${WORKER_URL}/api/contact` : "https://nixia-fabric-inquiry.sales-8db.workers.dev/api/contact";
---

<div class="contact-form">
  <div class="form-error" id="form-error" role="alert" hidden>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10" />
      <line x1="12" y1="8" x2="12" y2="12" />
      <line x1="12" y1="16" x2="12.01" y2="16" />
    </svg>
    <span id="form-error-text"></span>
  </div>

  <form class="contact-form__inner" id="contact-form" novalidate>
    <div class="form-row">
      <div class="form-field">
        <label for="name" class="form-field__label">Name *</label>
        <input type="text" id="name" name="name" class="form-field__input" placeholder="Your full name" autocomplete="name" />
      </div>
      <div class="form-field">
        <label for="company" class="form-field__label">Company</label>
        <input type="text" id="company" name="company" class="form-field__input" placeholder="Your company name (optional)" autocomplete="organization" />
      </div>
    </div>

    <div class="form-row">
      <div class="form-field">
        <label for="email" class="form-field__label">Email *</label>
        <input type="email" id="email" name="email" class="form-field__input" placeholder="you@company.com" autocomplete="email" />
      </div>
      <div class="form-field">
        <label for="subject" class="form-field__label">Subject</label>
        <input type="text" id="subject" name="subject" class="form-field__input" placeholder="e.g. Request free sample — glitter synthetic leather for shoes (optional)" />
      </div>
    </div>

    <div class="form-field">
      <label for="message" class="form-field__label">Message *</label>
      <textarea id="message" name="message" rows="5" class="form-field__textarea" placeholder="Product interest, color requirements, backing preference, quantity, timeline..."></textarea>
    </div>

    <!-- Honeypot: hidden from humans, bots fill it and get rejected server-side -->
    <div class="hp-field" aria-hidden="true">
      <label for="company-website">Website</label>
      <input type="text" id="company-website" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <button type="submit" class="form-submit" id="form-submit-btn" disabled>
      <span class="form-submit__text">Send Inquiry</span>
      <span class="form-submit__spinner" hidden>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="12" y1="2" x2="12" y2="6" />
          <line x1="12" y1="18" x2="12" y2="22" />
          <line x1="4.93" y1="4.93" x2="7.76" y2="7.76" />
          <line x1="16.24" y1="16.24" x2="19.07" y2="19.07" />
          <line x1="2" y1="12" x2="6" y2="12" />
          <line x1="18" y1="12" x2="22" y2="12" />
          <line x1="4.93" y1="19.07" x2="7.76" y2="16.24" />
          <line x1="16.24" y1="7.76" x2="19.07" y2="4.93" />
        </svg>
      </span>
      <svg class="form-submit__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12" />
        <polyline points="12 5 19 12 12 19" />
      </svg>
    </button>

    <p class="form-disclaimer">By submitting, you agree to be contacted by Nixia Fabric regarding your inquiry. We do not share your information with third parties.</p>
  </form>
</div>

<script define:vars={{ CONTACT_ENDPOINT }}>
(function () {
  // NOTE: define:vars scripts are inlined without TS compilation — plain JS only.
  const form = document.getElementById("contact-form");
  const submitBtn = document.getElementById("form-submit-btn");
  const submitText = submitBtn ? submitBtn.querySelector(".form-submit__text") : null;
  const submitSpinner = submitBtn ? submitBtn.querySelector(".form-submit__spinner") : null;
  const submitArrow = submitBtn ? submitBtn.querySelector(".form-submit__arrow") : null;
  const errorBanner = document.getElementById("form-error");
  const errorText = document.getElementById("form-error-text");

  function showError(message) {
    if (errorText) errorText.textContent = message;
    if (errorBanner) errorBanner.hidden = false;
    if (errorBanner) errorBanner.scrollIntoView({ behavior: "smooth", block: "center" });
  }

  function hideError() {
    if (errorBanner) errorBanner.hidden = true;
  }

  function validateForm() {
    if (!form) return false;
    const data = new FormData(form);
    const name = String(data.get("name") || "").trim();
    const email = String(data.get("email") || "").trim();
    const message = String(data.get("message") || "").trim();
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if (!name || !email || !message) {
      showError("Please fill in all required fields.");
      return false;
    }
    if (!emailRegex.test(email)) {
      showError("Please provide a valid email address.");
      return false;
    }
    return true;
  }

  function updateSubmitState() {
    if (!submitBtn) return;
    const allFilled = (() => {
      if (!form) return false;
      const data = new FormData(form);
      return ["name", "email", "message"].every(
        (k) => String(data.get(k) || "").trim().length > 0
      );
    })();
    submitBtn.disabled = !allFilled;
  }

  function setLoading(loading) {
    if (!submitBtn) return;
    submitBtn.disabled = loading;
    if (submitText) submitText.textContent = loading ? "Sending..." : "Send Inquiry";
    if (submitSpinner) submitSpinner.hidden = !loading;
    if (submitArrow) submitArrow.style.display = loading ? "none" : "inline";
  }

  form?.addEventListener("input", updateSubmitState);

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    hideError();

    if (!validateForm()) return;

    const formData = new FormData(form);
    const payload = {
      name: String(formData.get("name") || "").trim(),
      company: String(formData.get("company") || "").trim(),
      email: String(formData.get("email") || "").trim(),
      subject: String(formData.get("subject") || "").trim(),
      message: String(formData.get("message") || "").trim(),
      website: String(formData.get("website") || "").trim(),
    };

    setLoading(true);

    try {
      const res = await fetch(CONTACT_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      let data = {};
      const contentType = res.headers.get("content-type") || "";
      if (contentType.includes("application/json")) {
        data = await res.json();
      } else {
        const textSample = (await res.text().catch(() => "")).slice(0, 200);
        console.error("Non-JSON response:", res.status, textSample);
        showError("Server error. Please try again or contact us at info@nixiafabric.com.");
        return;
      }

      if (res.ok && data.success) {
        window.location.href = "/thank-you/";
      } else {
        showError(data.message || "Submission failed. Please try again or contact us at info@nixiafabric.com.");
      }
    } catch (err) {
      showError("Unable to reach the server. Please check your internet connection and try again.");
    } finally {
      setLoading(false);
    }
  });
})();
</script>

<style>
  /* Honeypot — visually and accessibly hidden */
  .hp-field {
    position: absolute;
    left: -9999px;
    top: -9999px;
    height: 0;
    width: 0;
    overflow: hidden;
  }

  .contact-form__inner {
    display: block;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  .form-field {
    margin-bottom: var(--space-md);
  }

  .form-field__label {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xs);
  }

  .form-field__input,
  .form-field__textarea {
    width: 100%;
    padding: 0.75rem var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-text);
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    transition: border-color var(--transition-fast);
    font-family: inherit;
  }

  .form-field__input:focus,
  .form-field__textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(196, 160, 53, 0.1);
  }

  .form-field__textarea {
    resize: vertical;
    min-height: 100px;
  }

  .form-submit {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    width: 100%;
    justify-content: center;
    padding: 0.875rem var(--space-xl);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-white);
    background-color: var(--color-accent);
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .form-submit:hover:not(:disabled) {
    background-color: var(--color-accent-dark);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .form-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-submit__spinner svg {
    animation: form-spin 0.8s linear infinite;
  }

  @keyframes form-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .form-error {
    display: none;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.875rem var(--space-md);
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: var(--radius-sm);
    color: #dc2626;
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-md);
  }

  .form-error:not([hidden]) {
    display: flex;
  }

  .form-error svg {
    flex-shrink: 0;
  }

  .form-disclaimer {
    font-size: var(--text-xs);
    color: var(--color-text-light);
    text-align: center;
    margin-top: var(--space-md);
  }

  @media (max-width: 768px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
