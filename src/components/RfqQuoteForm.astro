---
/**
 * RfqQuoteForm.astro — Step 1 (Contact Info) of the RFQ quote modal
 * Fields: Full Name*, Company, Email*, Phone. Required fields get gold borders.
 * Posts to Worker: WORKER_URL + "/api/rfq" along with the selected product info.
 * The Worker also accepts the documented legacy alias "/api/inquiry/rfq".
 * Success → /thank-you; failure → inline error message.
 */

// Backend endpoint comes from environment — NEVER hard-code the domain.
// Set WORKER_URL in .env (dev) / .env.production (prod) or as a build var.
const WORKER_URL = (import.meta.env.WORKER_URL ?? "").replace(/\/$/, "");
const RFQ_ENDPOINT = WORKER_URL ? `${WORKER_URL}/api/rfq` : "https://nixia-fabric-inquiry.sales-8db.workers.dev/api/rfq";
---

<div class="rfq-form">
  <div class="rfq-form__error" id="rfq-form-error" role="alert" hidden>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="10" />
      <line x1="12" y1="8" x2="12" y2="12" />
      <line x1="12" y1="16" x2="12.01" y2="16" />
    </svg>
    <span id="rfq-form-error-text"></span>
  </div>

  <form class="rfq-form__inner" id="rfq-form" novalidate>
    <input type="hidden" id="rfq-sku" name="productSku" />

    <div class="rfq-field">
      <label for="rfq-full-name" class="rfq-field__label">Full Name <span class="rfq-field__req">*</span></label>
      <input type="text" id="rfq-full-name" name="fullName" class="rfq-field__input rfq-field__input--required" placeholder="Your full name" autocomplete="name" />
      <span class="rfq-field__error" id="rfq-full-name-error"></span>
    </div>

    <div class="rfq-field">
      <label for="rfq-company" class="rfq-field__label">Company Name</label>
      <input type="text" id="rfq-company" name="company" class="rfq-field__input" placeholder="Company name (optional)" autocomplete="organization" />
    </div>

    <div class="rfq-field">
      <label for="rfq-email" class="rfq-field__label">Email Address <span class="rfq-field__req">*</span></label>
      <input type="email" id="rfq-email" name="email" class="rfq-field__input rfq-field__input--required" placeholder="you@company.com" autocomplete="email" />
      <span class="rfq-field__error" id="rfq-email-error"></span>
    </div>

    <div class="rfq-field">
      <label for="rfq-phone" class="rfq-field__label">Phone Number</label>
      <input type="tel" id="rfq-phone" name="phone" class="rfq-field__input" placeholder="+ country code (optional)" autocomplete="tel" />
      <span class="rfq-field__hint">Optional. If you prefer WhatsApp communication, please leave your phone number.</span>
    </div>

    <div class="rfq-field">
      <label for="rfq-quantity" class="rfq-field__label">Estimated Quantity</label>
      <input type="text" id="rfq-quantity" name="estimatedQuantity" class="rfq-field__input" placeholder="e.g. 100 meters (optional)" />
    </div>

    <div class="rfq-field">
      <label for="rfq-message" class="rfq-field__label">Message <span class="rfq-field__req">*</span></label>
      <textarea id="rfq-message" name="message" rows="4" class="rfq-field__textarea rfq-field__input--required" placeholder="Please share any details you have, such as color, application or target delivery date."></textarea>
      <span class="rfq-field__error" id="rfq-message-error"></span>
    </div>

    <!-- Honeypot: hidden from humans, bots fill it and get rejected server-side -->
    <div class="hp-field" aria-hidden="true">
      <label for="rfq-company-website">Website</label>
      <input type="text" id="rfq-company-website" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="rfq-form__actions">
      <button type="submit" class="rfq-form__submit" id="rfq-form-submit">
        <span class="rfq-form__submit-text">Send Inquiry</span>
        <span class="rfq-form__submit-arrow" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12" />
            <polyline points="12 5 19 12 12 19" />
          </svg>
        </span>
        <span class="rfq-form__spinner" hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="2" x2="12" y2="6" />
            <line x1="12" y1="18" x2="12" y2="22" />
            <line x1="4.93" y1="4.93" x2="7.76" y2="7.76" />
            <line x1="16.24" y1="16.24" x2="19.07" y2="19.07" />
            <line x1="2" y1="12" x2="6" y2="12" />
            <line x1="18" y1="12" x2="22" y2="12" />
            <line x1="4.93" y1="19.07" x2="7.76" y2="16.24" />
            <line x1="16.24" y1="7.76" x2="19.07" y2="4.93" />
          </svg>
        </span>
      </button>
    </div>
  </form>
</div>

<script define:vars={{ RFQ_ENDPOINT }}>
(function () {
  const form = document.getElementById("rfq-form");
  const submitBtn = document.getElementById("rfq-form-submit");
  const submitText = submitBtn ? submitBtn.querySelector(".rfq-form__submit-text") : null;
  const submitSpinner = submitBtn ? submitBtn.querySelector(".rfq-form__spinner") : null;
  const errorBanner = document.getElementById("rfq-form-error");
  const errorText = document.getElementById("rfq-form-error-text");

  function showError(message) {
    if (errorText) errorText.textContent = message;
    if (errorBanner) errorBanner.hidden = false;
    if (errorBanner) errorBanner.scrollIntoView({ behavior: "smooth", block: "center" });
  }

  function hideError() {
    if (errorBanner) errorBanner.hidden = true;
  }

  function setFieldError(input, errorEl, message) {
    const field = input?.closest(".rfq-field");
    if (!input || !errorEl) return;
    if (message) {
      input.classList.add("is-invalid");
      errorEl.textContent = message;
      if (field) field.classList.add("rfq-field--invalid");
    } else {
      input.classList.remove("is-invalid");
      errorEl.textContent = "";
      if (field) field.classList.remove("rfq-field--invalid");
    }
  }

  function validateStep1() {
    if (!form) return false;
    const data = new FormData(form);
    const name = String(data.get("fullName") || "").trim();
    const email = String(data.get("email") || "").trim();
    const message = String(data.get("message") || "").trim();
    const nameInput = document.getElementById("rfq-full-name");
    const emailInput = document.getElementById("rfq-email");
    const messageInput = document.getElementById("rfq-message");
    const nameError = document.getElementById("rfq-full-name-error");
    const emailError = document.getElementById("rfq-email-error");
    const messageError = document.getElementById("rfq-message-error");

    let valid = true;

    if (!name) {
      setFieldError(nameInput, nameError, "Please enter your full name.");
      valid = false;
    } else {
      setFieldError(nameInput, nameError, "");
    }

    if (!email) {
      setFieldError(emailInput, emailError, "Please enter your email address.");
      valid = false;
    } else if (!/^\S+@\S+\.\S+$/.test(email)) {
      setFieldError(emailInput, emailError, "Please enter a valid email address.");
      valid = false;
    } else {
      setFieldError(emailInput, emailError, "");
    }

    if (!message) {
      setFieldError(messageInput, messageError, "Message is required.");
      valid = false;
    } else {
      setFieldError(messageInput, messageError, "");
    }

    return valid;
  }

  function setLoading(loading) {
    if (!submitBtn) return;
    submitBtn.classList.toggle("is-loading", loading);
    submitBtn.disabled = loading;
    if (submitText) submitText.textContent = loading ? "Sending..." : "Send Inquiry";
    if (submitSpinner) submitSpinner.hidden = !loading;
    const arrow = submitBtn ? submitBtn.querySelector(".rfq-form__submit-arrow") : null;
    if (arrow) arrow.hidden = loading;
  }

  // Clear a field's error as soon as the user types
  ["rfq-full-name", "rfq-email"].forEach((id) => {
    const input = document.getElementById(id);
    input?.addEventListener("input", () => {
      setFieldError(input, document.getElementById(`${id}-error`), "");
      hideError();
    });
  });

  document.getElementById("rfq-message")?.addEventListener("input", () => {
    const input = document.getElementById("rfq-message");
    setFieldError(input, document.getElementById("rfq-message-error"), "");
    hideError();
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    hideError();

    if (!validateStep1()) return;

    const formData = new FormData(form);
    const phone = String(formData.get("phone") || "").trim();
    const selectedName = String(formData.get("productSku") || "").trim();
    const weight = document.getElementById("rfq-selected-weight")?.textContent || "—";
    const width = document.getElementById("rfq-selected-width")?.textContent || "—";

    const payload = {
      name: String(formData.get("fullName") || "").trim(),
      company: String(formData.get("company") || "").trim(),
      email: String(formData.get("email") || "").trim(),
      phone,
      message: String(formData.get("message") || "").trim(),
      productSku: selectedName,
      productName: selectedName,
      productWeight: weight,
      productWidth: width,
      estimatedQuantity: String(formData.get("estimatedQuantity") || "").trim(),
      website: String(formData.get("website") || "").trim(),
    };

    setLoading(true);

    try {
      const res = await fetch(RFQ_ENDPOINT, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      let data = {};
      const contentType = res.headers.get("content-type") || "";
      if (contentType.includes("application/json")) {
        data = await res.json();
      } else {
        const textSample = (await res.text().catch(() => "")).slice(0, 200);
        console.error("Non-JSON response:", res.status, textSample);
        showError("Server error. Please try again or contact us at info@nixiafabric.com.");
        return;
      }

      if (res.ok && data.success) {
        window.location.href = "/thank-you/";
      } else {
        showError(data.message || "Submission failed. Please try again or contact us at info@nixiafabric.com.");
      }
    } catch (err) {
      showError("Unable to reach the server. Please check your internet connection and try again.");
    } finally {
      setLoading(false);
    }
  });
})();
</script>

<style>
  /* Honeypot — visually and accessibly hidden */
  .hp-field {
    position: absolute;
    left: -9999px;
    top: -9999px;
    height: 0;
    width: 0;
    overflow: hidden;
  }

  .rfq-form__inner {
    display: flex;
    flex-direction: column;
  }

  .rfq-field {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .rfq-field__label {
    font-family: inherit;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #5b6576;
  }

  .rfq-field__req {
    color: var(--color-accent-dark);
  }

  .rfq-field__input {
    width: 100%;
    height: 50px;
    border: 1px solid #d8dce4;
    border-radius: 6px;
    background: var(--color-white);
    color: var(--color-text);
    padding: 0 1rem;
    font-family: inherit;
    font-size: 15px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .rfq-field__input--required {
    border-color: var(--color-accent);
  }

  .rfq-field__input::placeholder {
    color: #a3abba;
  }

  .rfq-field__input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(196, 160, 53, 0.16);
  }

  .rfq-field__input.is-invalid {
    border-color: #dc2626;
  }

  .rfq-field__error {
    min-height: 0;
    font-size: 12.5px;
    font-weight: 600;
    color: #dc2626;
  }

  .rfq-field__hint {
    font-size: 12px;
    line-height: 1.5;
    color: #98a2b3;
  }

  .rfq-field__textarea {
    width: 100%;
    border: 1px solid var(--color-accent);
    border-radius: 6px;
    background: var(--color-white);
    color: var(--color-text);
    padding: 0.85rem 1rem;
    font-family: inherit;
    font-size: 15px;
    line-height: 1.6;
    resize: vertical;
    min-height: 110px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .rfq-field__textarea::placeholder {
    color: #a3abba;
  }

  .rfq-field__textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(196, 160, 53, 0.16);
  }

  .rfq-field__textarea.is-invalid {
    border-color: #dc2626;
  }

  .rfq-form__actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.5rem;
  }

  .rfq-form__submit {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 48px;
    padding: 0 1.5rem;
    border: 0;
    border-radius: 6px;
    background: var(--color-primary);
    color: #ffffff;
    font-family: inherit;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .rfq-form__submit:hover:not(:disabled) {
    background: var(--color-primary-dark);
    transform: translateY(-1px);
  }

  .rfq-form__submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .rfq-form__submit .rfq-form__submit-arrow {
    display: inline-flex;
  }

  .rfq-form__spinner svg {
    animation: rfq-form-spin 0.8s linear infinite;
  }

  @keyframes rfq-form-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .rfq-form__error {
    display: none;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.875rem var(--space-md);
    margin-bottom: 1.5rem;
    background-color: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 6px;
    color: #dc2626;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .rfq-form__error:not([hidden]) {
    display: flex;
  }

  .rfq-form__error svg {
    flex-shrink: 0;
  }
</style>
