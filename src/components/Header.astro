---
/**
 * Header.astro — Site navigation header
 * Sticky, responsive with mobile menu
 * "Products" dropdown shows 4 end-use category links
 */
import { endUseCategories } from "@data/products";

const navItems = [
  { label: "Home", href: "/" },
  { label: "Products", href: "/products", hasDropdown: true },
  { label: "Factory", href: "/factory" },
  { label: "About", href: "/about" },
  { label: "Blog", href: "/blog" },
  { label: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  return currentPath.startsWith(href);
};

// Check if any end-use sub-page is active
const isProductSectionActive = currentPath.startsWith("/products");
---

<header class="header" id="site-header">
  <!-- Top announcement bar -->
  <div class="header__topbar">
    <div class="container header__topbar-inner">
      <span class="header__topbar-label">Glitter &amp; Foil-Printed Synthetic Leather Manufacturer</span>
      <div class="header__topbar-contacts">
        <a href="https://wa.me/8613800000000" class="header__topbar-contact" aria-label="WhatsApp" target="_blank" rel="noopener noreferrer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          <span>WhatsApp</span>
        </a>
        <a href="tel:+8613800000000" class="header__topbar-contact" aria-label="Phone">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span>+86 138 0000 0000</span>
        </a>
        <a href="mailto:info@nixiafabric.com" class="header__topbar-contact" aria-label="Email">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          <span>info@nixiafabric.com</span>
        </a>
        <a href="https://www.facebook.com/nixiafabric" class="header__topbar-social" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/nixiafabric" class="header__topbar-social" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div class="container header__inner">
    <!-- Logo -->
    <a href="/" class="header__logo" aria-label="Nixia Fabric — Home">
      <span class="header__logo-mark">NF</span>
      <span class="header__logo-text">
        Nixia<span class="header__logo-accent">Fabric</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="header__nav" aria-label="Main navigation">
      <ul class="header__nav-list">
        {navItems.map((item) => (
          <li class="header__nav-item">
            <a
              href={item.href}
              class:list={[
                "header__nav-link",
                { "is-active": item.label === "Products" ? isProductSectionActive : isActive(item.href) },
              ]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
              {item.hasDropdown && (
                <svg class="header__nav-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              )}
            </a>
            {item.hasDropdown && (
              <div class="header__dropdown">
                {endUseCategories.map((cat) => (
                  <a href={`/products/${cat.slug}`} class="header__dropdown-link">
                    <span class="header__dropdown-title">{cat.shortName}</span>
                    <span class="header__dropdown-desc">{cat.name}</span>
                  </a>
                ))}
                <a href="/products" class="header__dropdown-link header__dropdown-link--all">
                  <span class="header__dropdown-title">All Products</span>
                  <span class="header__dropdown-desc">Browse full catalog</span>
                </a>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <!-- Desktop CTA -->
    <div class="header__actions">
      <a href="/sample-policy" class="btn btn--outline header__btn">
        Request Free Sample
      </a>
      <a href="/contact" class="btn btn--dark header__btn">
        Get Custom Quotation
      </a>
    </div>

    <!-- Mobile Menu Toggle -->
    <button
      class="header__toggle"
      id="menu-toggle"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
    </button>
  </div>

  <!-- Mobile Navigation -->
  <div class="header__mobile" id="mobile-nav" aria-hidden="true">
    <nav aria-label="Mobile navigation">
      <ul class="header__mobile-list">
        <li>
          <a href="/" class:list={["header__mobile-link", { "is-active": currentPath === "/" }]}>
            Home
          </a>
        </li>
        <li class="header__mobile-group">
          <span class="header__mobile-label">Products</span>
          <ul class="header__mobile-sublist">
            {endUseCategories.map((cat) => (
              <li>
                <a href={`/products/${cat.slug}`} class="header__mobile-sublink">
                  {cat.shortName}
                </a>
              </li>
            ))}
            <li>
              <a href="/products" class="header__mobile-sublink header__mobile-sublink--all">
                All Products
              </a>
            </li>
          </ul>
        </li>
        <li>
          <a href="/factory" class:list={["header__mobile-link", { "is-active": isActive("/factory") }]}>
            Factory
          </a>
        </li>
        <li>
          <a href="/about" class:list={["header__mobile-link", { "is-active": isActive("/about") }]}>
            About
          </a>
        </li>
        <li>
          <a href="/blog" class:list={["header__mobile-link", { "is-active": isActive("/blog") }]}>
            Blog
          </a>
        </li>
      </ul>
    </nav>
    <div class="header__mobile-actions">
      <a href="/sample-policy" class="btn btn--outline btn--block">
        Request Free Sample
      </a>
      <a href="/contact" class="btn btn--dark btn--block">
        Get Custom Quotation
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    transition: box-shadow var(--transition-base);
  }

  /* Top announcement bar */
  .header__topbar {
    background-color: var(--color-primary-dark);
    padding: 0.4rem 0;
  }

  .header__topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 36px;
  }

  .header__topbar-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .header__topbar-contacts {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    flex-shrink: 0;
  }

  .header__topbar-contact {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    transition: color var(--transition-fast);
    white-space: nowrap;
  }

  .header__topbar-contact:hover {
    color: var(--color-accent);
  }

  .header__topbar-contact svg {
    flex-shrink: 0;
    opacity: 0.8;
  }

  .header__topbar-contact:hover svg {
    opacity: 1;
  }

  .header__topbar-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    color: rgba(255, 255, 255, 0.7);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .header__topbar-social:hover {
    color: var(--color-accent);
    background-color: rgba(255, 255, 255, 0.08);
  }

  /* Responsive — hide text labels on smaller screens */
  @media (max-width: 1100px) {
    .header__topbar-label {
      font-size: 0.68rem;
    }
    .header__topbar-contact span {
      display: none;
    }
    .header__topbar-contact {
      width: 28px;
      height: 28px;
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .header__topbar-label {
      font-size: 0.65rem;
      letter-spacing: 0.03em;
    }
    .header__topbar-contacts {
      gap: var(--space-sm);
    }
  }

  .header.is-scrolled {
    box-shadow: var(--shadow-md);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
    gap: var(--space-xl);
  }

  /* Logo */
  .header__logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-shrink: 0;
  }

  .header__logo-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 800;
    letter-spacing: -0.05em;
    border-radius: var(--radius-sm);
  }

  .header__logo-text {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-primary);
    letter-spacing: -0.03em;
  }

  .header__logo-accent {
    color: var(--color-accent);
    margin-left: 2px;
  }

  /* Desktop Nav */
  .header__nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .header__nav-list {
    display: flex;
    gap: var(--space-xl);
  }

  .header__nav-item {
    position: relative;
  }

  .header__nav-link {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
    padding: 0.5rem 0;
    position: relative;
    transition: color var(--transition-fast);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .header__nav-link::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: var(--color-accent);
    transition: width var(--transition-base);
  }

  .header__nav-link:hover {
    color: var(--color-primary);
  }

  .header__nav-link:hover::after,
  .header__nav-link.is-active::after {
    width: 100%;
  }

  .header__nav-link.is-active {
    color: var(--color-primary);
    font-weight: 600;
  }

  .header__nav-chevron {
    transition: transform var(--transition-base);
  }

  .header__nav-item:hover .header__nav-chevron {
    transform: rotate(180deg);
  }

  /* Dropdown */
  .header__dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    min-width: 280px;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    padding: var(--space-sm);
    opacity: 0;
    visibility: hidden;
    transition: all var(--transition-base);
    z-index: 100;
  }

  .header__nav-item:hover .header__dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .header__dropdown-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-fast);
  }

  .header__dropdown-link:hover {
    background-color: var(--color-bg-alt);
  }

  .header__dropdown-title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
  }

  .header__dropdown-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .header__dropdown-link--all {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-xs);
    padding-top: 0.75rem;
  }

  /* Desktop CTA */
  .header__actions {
    display: flex;
    gap: var(--space-sm);
    flex-shrink: 0;
  }

  .header__btn {
    padding: 0.5rem 1.25rem;
    font-size: var(--text-sm);
  }

  /* Mobile Toggle */
  .header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .header__toggle-bar {
    display: block;
    width: 24px;
    height: 2px;
    background-color: var(--color-primary);
    border-radius: 2px;
    transition: all var(--transition-base);
  }

  .header__toggle.is-open .header__toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .header__toggle.is-open .header__toggle-bar:nth-child(2) {
    opacity: 0;
  }

  .header__toggle.is-open .header__toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Nav */
  .header__mobile {
    display: none;
    flex-direction: column;
    gap: var(--space-lg);
    padding: var(--space-lg) var(--space-md) var(--space-xl);
    background-color: var(--color-white);
    border-top: 1px solid var(--color-border);
    max-height: 0;
    overflow: hidden;
    transition: max-height var(--transition-slow), padding var(--transition-slow);
  }

  .header__mobile.is-open {
    max-height: 600px;
    padding: var(--space-lg) var(--space-md) var(--space-xl);
    box-shadow: var(--shadow-md);
  }

  .header__mobile-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .header__mobile-link {
    display: block;
    padding: 0.75rem 0;
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    transition: color var(--transition-fast);
  }

  .header__mobile-link.is-active {
    color: var(--color-accent);
    font-weight: 600;
  }

  .header__mobile-group {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .header__mobile-label {
    display: block;
    padding: 0.5rem 0;
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-text);
  }

  .header__mobile-sublist {
    list-style: none;
    padding-left: var(--space-md);
    margin-top: var(--space-xs);
  }

  .header__mobile-sublink {
    display: block;
    padding: 0.5rem 0;
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    transition: color var(--transition-fast);
  }

  .header__mobile-sublink:hover {
    color: var(--color-accent);
  }

  .header__mobile-sublink--all {
    color: var(--color-accent-dark);
    font-weight: 600;
  }

  .header__mobile-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }

  /* Responsive */
  @media (max-width: 968px) {
    .header__nav,
    .header__actions {
      display: none;
    }

    .header__toggle {
      display: flex;
    }

    .header__mobile {
      display: flex;
    }
  }
</style>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById("menu-toggle");
  const mobileNav = document.getElementById("mobile-nav");
  const header = document.getElementById("site-header");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.classList.toggle("is-open");
    mobileNav?.classList.toggle("is-open", isOpen);
    toggle.setAttribute("aria-expanded", String(isOpen));
    mobileNav?.setAttribute("aria-hidden", String(!isOpen));
  });

  // Sticky header shadow on scroll
  let ticking = false;
  window.addEventListener("scroll", () => {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        header?.classList.toggle("is-scrolled", window.scrollY > 8);
        ticking = false;
      });
      ticking = true;
    }
  });

  // Close mobile menu on link click
  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      toggle?.classList.remove("is-open");
      mobileNav?.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
      mobileNav?.setAttribute("aria-hidden", "true");
    });
  });
</script>
