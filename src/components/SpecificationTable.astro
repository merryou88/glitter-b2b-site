---
/**
 * SpecificationTable.astro — Product specification table
 * Displays: Composition, GSM, Width, Backing
 */
import type { ProductSpecifications } from "@data/products";

export interface Props {
  specs: ProductSpecifications;
}

const { specs } = Astro.props;

const rows = [
  { label: "Composition", value: specs.composition },
  { label: "GSM", value: specs.gsm },
  { label: "Width", value: specs.width },
  { label: "Backing", value: specs.backing },
];
---

<table class="spec-table">
  <thead>
    <tr>
      <th colspan="2">Product Specifications</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => (
      <tr>
        <td class="spec-table__label">{row.label}</td>
        <td class="spec-table__value">{row.value}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .spec-table {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .spec-table thead th {
    background-color: var(--color-primary);
    color: var(--color-white);
    padding: var(--space-md) var(--space-lg);
    font-size: var(--text-base);
    font-weight: 700;
    text-align: left;
    letter-spacing: 0.01em;
  }

  .spec-table tbody tr {
    border-bottom: 1px solid var(--color-border);
    transition: background-color var(--transition-fast);
  }

  .spec-table tbody tr:last-child {
    border-bottom: none;
  }

  .spec-table tbody tr:hover {
    background-color: var(--color-bg-alt);
  }

  .spec-table__label {
    width: 40%;
    padding: var(--space-md) var(--space-lg);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-primary);
    background-color: var(--color-bg-alt);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .spec-table__value {
    padding: var(--space-md) var(--space-lg);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  @media (max-width: 640px) {
    .spec-table__label {
      width: 35%;
      padding: var(--space-sm) var(--space-md);
    }

    .spec-table__value {
      padding: var(--space-sm) var(--space-md);
    }
  }
</style>
