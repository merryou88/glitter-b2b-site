---
/**
 * Hero.astro — Homepage hero banner
 * Title, subtitle, dual CTA, trust indicators, visual swatch display
 */
import CTAButton from "@components/CTAButton.astro";
---

<section class="hero">
  <!-- Decorative background -->
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__bg-gradient"></div>
    <div class="hero__bg-pattern"></div>
  </div>

  <div class="container hero__inner">
    <!-- Left: Content -->
    <div class="hero__content">
      <span class="hero__eyebrow">Glitter &amp; Foil-Printed Synthetic Leather Manufacturer</span>
      <h1 class="hero__title">
        Chunky Glitter Synthetic Leather &amp;<br />
        Foil-Printed Synthetic Leather<br />
        <span class="hero__title-accent">Manufactured to Spec</span>
      </h1>
      <p class="hero__subtitle">
        Specializing in Chunky Glitter Synthetic Leather and Foil-Printed Synthetic Leather
        for shoes, handbags and fashion accessories. Factory Direct Supply, Custom Color
        Matching, and quality-controlled manufacturing.
      </p>

      <div class="hero__actions">
        <CTAButton href="/contact?inquiry=sample" variant="primary" size="lg">
          Request Free Sample
        </CTAButton>
        <CTAButton href="/contact?inquiry=quote" variant="secondary" size="lg">
          Get Custom Quotation
        </CTAButton>
      </div>

      <!-- Trust indicators -->
      <div class="hero__trust">
        <div class="hero__trust-item">
          <span class="hero__trust-value">Factory</span>
          <span class="hero__trust-label">Direct Supply</span>
        </div>
        <div class="hero__trust-divider"></div>
        <div class="hero__trust-item">
          <span class="hero__trust-value">Custom</span>
          <span class="hero__trust-label">Color Matching</span>
        </div>
        <div class="hero__trust-divider"></div>
        <div class="hero__trust-item">
          <span class="hero__trust-value">QC</span>
          <span class="hero__trust-label">Quality Control</span>
        </div>
      </div>
    </div>

    <!-- Right: Visual swatch display -->
    <div class="hero__visual" aria-hidden="true">
      <div class="hero__swatch-card">
        <div class="hero__swatch-label">Available Colors</div>
        <div class="hero__swatches">
          <div class="hero__swatch hero__swatch--gold" title="Gold">
            <span>Gold</span>
          </div>
          <div class="hero__swatch hero__swatch--silver" title="Silver">
            <span>Silver</span>
          </div>
          <div class="hero__swatch hero__swatch--rosegold" title="Rose Gold">
            <span>Rose Gold</span>
          </div>
          <div class="hero__swatch hero__swatch--champagne" title="Champagne">
            <span>Champagne</span>
          </div>
          <div class="hero__swatch hero__swatch--black" title="Black">
            <span>Black</span>
          </div>
          <div class="hero__swatch hero__swatch--navy" title="Navy">
            <span>Navy</span>
          </div>
        </div>
        <div class="hero__swatch-note">
          + Custom Colors Available
        </div>
      </div>

      <!-- Floating product tag -->
      <div class="hero__tag hero__tag--1">
        <span class="hero__tag-title">Chunky Glitter Synthetic Leather</span>
        <span class="hero__tag-desc">Elastic / PU / Non-woven / Oxford</span>
      </div>
      <div class="hero__tag hero__tag--2">
        <span class="hero__tag-title">Foil-Printed Synthetic Leather</span>
        <span class="hero__tag-desc">Gold / Silver / Metallic</span>
      </div>
    </div>
  </div>

  <!-- Bottom wave -->
  <div class="hero__wave" aria-hidden="true">
    <svg viewBox="0 0 1440 80" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M0 80L1440 80L1440 40C1440 40 1080 0 720 20C360 40 0 40 0 40L0 80Z" fill="var(--color-bg)"/>
    </svg>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-5xl) var(--space-4xl);
    background-color: var(--color-bg-dark);
  }

  /* Background layers */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      var(--color-primary-dark) 0%,
      var(--color-primary) 50%,
      var(--color-primary-light) 100%
    );
  }

  .hero__bg-pattern {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 30%, rgba(196, 160, 53, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(196, 160, 53, 0.06) 0%, transparent 40%);
  }

  .hero__bg-pattern::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-3xl);
    align-items: center;
  }

  /* Content */
  .hero__eyebrow {
    display: inline-block;
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: var(--space-lg);
    padding: 0.375rem 1rem;
    background-color: rgba(196, 160, 53, 0.1);
    border: 1px solid rgba(196, 160, 53, 0.3);
    border-radius: var(--radius-full);
  }

  .hero__title {
    color: var(--color-white);
    font-size: var(--text-6xl);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-lg);
  }

  .hero__title-accent {
    color: var(--color-accent);
  }

  .hero__subtitle {
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-xl);
    line-height: 1.6;
    max-width: 560px;
    margin-bottom: var(--space-2xl);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    margin-bottom: var(--space-3xl);
  }

  /* Trust indicators */
  .hero__trust {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
  }

  .hero__trust-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero__trust-value {
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-accent);
  }

  .hero__trust-label {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .hero__trust-divider {
    width: 1px;
    height: 32px;
    background-color: rgba(255, 255, 255, 0.15);
  }

  /* Visual swatch display */
  .hero__visual {
    position: relative;
  }

  .hero__swatch-card {
    background-color: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl);
  }

  .hero__swatch-label {
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: var(--space-lg);
  }

  .hero__swatches {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  .hero__swatch {
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0.5rem;
    position: relative;
    overflow: hidden;
    transition: transform var(--transition-base);
  }

  .hero__swatch::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 30% 30%, rgba(255, 255, 255, 0.3) 0%, transparent 40%),
      radial-gradient(circle at 70% 70%, rgba(255, 255, 255, 0.15) 0%, transparent 30%);
  }

  .hero__swatch span {
    position: relative;
    z-index: 1;
    font-size: var(--text-xs);
    font-weight: 600;
    color: rgba(0, 0, 0, 0.7);
    text-shadow: 0 1px 2px rgba(255, 255, 255, 0.3);
  }

  .hero__swatch--gold {
    background: linear-gradient(135deg, #d4af37 0%, #c4a035 50%, #b89530 100%);
  }

  .hero__swatch--silver {
    background: linear-gradient(135deg, #e8e8e8 0%, #c0c0c0 50%, #a8a8a8 100%);
  }

  .hero__swatch--rosegold {
    background: linear-gradient(135deg, #e8c4a0 0%, #d4a070 50%, #c09060 100%);
  }

  .hero__swatch--champagne {
    background: linear-gradient(135deg, #f0e0b0 0%, #e0c890 50%, #d0b070 100%);
  }

  .hero__swatch--black {
    background: linear-gradient(135deg, #2a2a2a 0%, #1a1a1a 50%, #0a0a0a 100%);
  }

  .hero__swatch--black span {
    color: rgba(255, 255, 255, 0.7);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  .hero__swatch--navy {
    background: linear-gradient(135deg, #2a3a6a 0%, #1a2b4d 50%, #0d1b33 100%);
  }

  .hero__swatch--navy span {
    color: rgba(255, 255, 255, 0.7);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  .hero__swatch-note {
    margin-top: var(--space-lg);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-weight: 500;
  }

  /* Floating tags */
  .hero__tag {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: var(--radius-md);
    padding: 0.625rem 1rem;
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero__tag--1 {
    top: -12px;
    right: -16px;
  }

  .hero__tag--2 {
    bottom: -12px;
    left: -16px;
  }

  .hero__tag-title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
  }

  .hero__tag-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Wave */
  .hero__wave {
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    z-index: 0;
    line-height: 0;
  }

  .hero__wave svg {
    width: 100%;
    height: 60px;
  }

  /* Responsive */
  @media (max-width: 968px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-3xl);
    }

    .hero__title {
      font-size: var(--text-4xl);
    }

    .hero__visual {
      display: none;
    }

    .hero__actions {
      flex-direction: column;
    }

    .hero__trust {
      flex-wrap: wrap;
      gap: var(--space-md);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-block: var(--space-4xl) var(--space-3xl);
    }

    .hero__title {
      font-size: var(--text-3xl);
    }

    .hero__subtitle {
      font-size: var(--text-base);
    }
  }
</style>
