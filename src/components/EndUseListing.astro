---
/**
 * EndUseListing.astro — End-use category listing page
 *
 * Renders a category page (e.g. /products/fabric-for-shoes) with:
 * - Independent meta title/description/H1 (includes glitter + foil keywords)
 * - Left sidebar: Filter by Craft + Filter by Backing
 * - Product grid filtered by end-use tag
 * - noindex for filtered URLs (?craft=xxx) via JS-injected meta tag
 * - Canonical pointing to the clean URL
 */
import Layout from "@layouts/Layout.astro";
import ProductCard from "@components/ProductCard.astro";
import CTAButton from "@components/CTAButton.astro";
import { craftOptions, backingOptions, endUseCategories } from "@data/products";
import type { EndUseCategory, Product } from "@data/products";

interface Props {
  category: EndUseCategory;
  products: Product[];
}

const { category, products } = Astro.props;
const totalProducts = products.length;

// Breadcrumb structured data
const breadcrumbData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://nixiafabric.com/" },
    { "@type": "ListItem", position: 2, name: "Products", item: "https://nixiafabric.com/products" },
    { "@type": "ListItem", position: 3, name: category.name, item: `https://nixiafabric.com/products/${category.slug}` },
  ],
};

// CollectionPage structured data
const collectionPageData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: category.name,
  description: category.metaDescription,
  url: `https://nixiafabric.com/products/${category.slug}`,
};

// ItemList structured data
const itemListData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: category.name,
  numberOfItems: totalProducts,
  itemListElement: products.map((p, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: p.name,
    url: `https://nixiafabric.com/products/${p.slug}`,
  })),
};

// Other end-use categories for cross-linking
const otherCategories = endUseCategories.filter((c) => c.slug !== category.slug);
---

<Layout
  title={category.metaTitle}
  description={category.metaDescription}
  keywords={`${category.name.toLowerCase()}, chunky glitter synthetic leather, foil-printed synthetic leather, ${category.shortName.toLowerCase()} fabric, fabric manufacturer, fabric for ${category.shortName.toLowerCase()}`}
  canonical={`https://nixiafabric.com/products/${category.slug}`}
  structuredData={[breadcrumbData, collectionPageData, itemListData]}
>
  <!-- Page Header -->
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb__sep">/</span>
        <a href="/products">Products</a>
        <span class="breadcrumb__sep">/</span>
        <span class="breadcrumb__current">{category.shortName}</span>
      </nav>
      <span class="eyebrow">Application Category</span>
      <h1>{category.h1}</h1>
      <p class="page-hero__desc">{category.description}</p>
      <div class="page-hero__stats">
        <div class="page-hero__stat">
          <span class="page-hero__stat-num">{totalProducts}</span>
          <span class="page-hero__stat-label">Matching Fabrics</span>
        </div>
        <div class="page-hero__stat">
          <span class="page-hero__stat-num">{craftOptions.length}</span>
          <span class="page-hero__stat-label">Craft Types</span>
        </div>
        <div class="page-hero__stat">
          <span class="page-hero__stat-num">{backingOptions.length}</span>
          <span class="page-hero__stat-label">Backing Options</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Listing: sidebar + grid -->
  <section class="listing">
    <div class="container">
      <div class="listing__layout">
        <!-- Filter Sidebar -->
        <aside class="filter-sidebar" id="filter-sidebar">
          <div class="filter-sidebar__header">
            <h2 class="filter-sidebar__title">Filter Products</h2>
            <button class="filter-sidebar__reset" id="filter-reset" type="button" style="display:none;">Reset</button>
          </div>

          <!-- Filter by Craft -->
          <div class="filter-section">
            <h3 class="filter-section__title">Filter by Craft</h3>
            <div class="filter-section__options" role="group" aria-label="Filter by craft">
              <label class="filter-option">
                <input type="radio" name="craft" value="all" checked class="filter-option__input" data-filter-type="craft" />
                <span class="filter-option__label">All Crafts</span>
                <span class="filter-option__count">{totalProducts}</span>
              </label>
              {craftOptions.map((craft) => {
                const count = products.filter((p) => p.craft === craft).length;
                return (
                  <label class="filter-option">
                    <input type="radio" name="craft" value={craft} class="filter-option__input" data-filter-type="craft" />
                    <span class="filter-option__label">{craft}</span>
                    <span class="filter-option__count">{count}</span>
                  </label>
                );
              })}
            </div>
          </div>

          <!-- Filter by Backing -->
          <div class="filter-section">
            <h3 class="filter-section__title">Filter by Backing</h3>
            <div class="filter-section__options" role="group" aria-label="Filter by backing">
              <label class="filter-option">
                <input type="radio" name="backing" value="all" checked class="filter-option__input" data-filter-type="backing" />
                <span class="filter-option__label">All Backings</span>
                <span class="filter-option__count">{totalProducts}</span>
              </label>
              {backingOptions.map((backing) => {
                const count = products.filter((p) => p.backingCategory === backing).length;
                return (
                  <label class="filter-option">
                    <input type="radio" name="backing" value={backing} class="filter-option__input" data-filter-type="backing" />
                    <span class="filter-option__label">{backing}</span>
                    <span class="filter-option__count">{count}</span>
                  </label>
                );
              })}
            </div>
          </div>

          <!-- Mobile filter toggle -->
          <button class="filter-sidebar__mobile-toggle" id="mobile-filter-toggle" type="button">
            <span>Filters</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="4" y1="6" x2="20" y2="6" />
              <line x1="7" y1="12" x2="17" y2="12" />
              <line x1="10" y1="18" x2="14" y2="18" />
            </svg>
          </button>
        </aside>

        <!-- Product Grid -->
        <div class="listing__main">
          <div class="listing__toolbar">
            <span class="listing__count" id="result-count">Showing {totalProducts} fabrics</span>
          </div>

          <div class="product-grid" id="product-grid">
            {products.map((product) => (
              <div
                class="product-grid__item"
                data-craft={product.craft}
                data-backing={product.backingCategory}
              >
                <ProductCard product={product} />
              </div>
            ))}
          </div>

          <!-- No results -->
          <div class="no-results" id="no-results" style="display:none;">
            <p>No fabrics match your current filters.</p>
            <CTAButton href="#" variant="outline" data-action="reset">Reset Filters</CTAButton>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cross-link to other categories -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">Other Applications</span>
        <h2>Browse by End-Use</h2>
      </div>
      <div class="cross-link-grid">
        {otherCategories.map((cat) => (
          <a href={`/products/${cat.slug}`} class="cross-link-card">
            <div class="cross-link-card__visual">
              <img src={cat.image} alt={cat.alt} width="1200" height="675" loading="lazy" />
            </div>
            <div class="cross-link-card__body">
              <h3>{cat.shortName}</h3>
              <p>{cat.description}</p>
              <span class="cross-link-card__cta">View Fabrics →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section section--dark">
    <div class="container text-center">
      <span class="eyebrow">Need Help Choosing?</span>
      <h2>Not Sure Which Fabric Fits Your {category.shortName}?</h2>
      <p style="max-width: 600px; margin: var(--space-lg) auto var(--space-2xl);">
        Request free samples and our team will help you select the right Chunky
        Glitter Synthetic Leather or Foil-Printed Synthetic Leather for your project.
        Custom Color Matching and Custom Backing Options available.
      </p>
      <div class="btn-group" style="justify-content: center;">
        <CTAButton href="/sample-policy" variant="primary" size="lg">Request Free Sample</CTAButton>
        <CTAButton href="/contact" variant="secondary" size="lg">Get Custom Quotation</CTAButton>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: var(--color-white);
    padding-block: var(--space-3xl) var(--space-4xl);
    position: relative;
    overflow: hidden;
  }

  .page-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 20% 50%, rgba(196, 160, 53, 0.08) 0%, transparent 50%),
      radial-gradient(circle at 80% 30%, rgba(42, 65, 112, 0.4) 0%, transparent 50%);
    pointer-events: none;
  }

  .page-hero .container {
    position: relative;
    z-index: 1;
  }

  .page-hero .breadcrumb {
    margin-bottom: var(--space-lg);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
  }

  .page-hero .breadcrumb a:hover {
    color: var(--color-accent-light);
  }

  .breadcrumb__sep {
    margin-inline: var(--space-xs);
    opacity: 0.5;
  }

  .breadcrumb__current {
    color: var(--color-white);
  }

  .page-hero .eyebrow {
    color: var(--color-accent-light);
  }

  .page-hero h1 {
    color: var(--color-white);
    margin-bottom: var(--space-md);
  }

  .page-hero__desc {
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-lg);
    max-width: 640px;
  }

  .page-hero__stats {
    display: flex;
    gap: var(--space-2xl);
    margin-top: var(--space-2xl);
  }

  .page-hero__stat {
    display: flex;
    flex-direction: column;
  }

  .page-hero__stat-num {
    font-size: var(--text-3xl);
    font-weight: 800;
    color: var(--color-accent);
  }

  .page-hero__stat-label {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* ==================== Listing Layout ==================== */
  .listing {
    padding-block: var(--space-2xl);
  }

  .listing__layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  /* ==================== Filter Sidebar ==================== */
  .filter-sidebar {
    position: sticky;
    top: calc(var(--header-height) + var(--space-md));
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
  }

  .filter-sidebar__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .filter-sidebar__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-primary);
  }

  .filter-sidebar__reset {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent-dark);
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: underline;
  }

  .filter-sidebar__reset:hover {
    color: var(--color-accent);
  }

  .filter-section {
    margin-bottom: var(--space-lg);
  }

  .filter-section:last-child {
    margin-bottom: 0;
  }

  .filter-section__title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .filter-section__options {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .filter-option {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: 0.5rem 0.625rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .filter-option:hover {
    background-color: var(--color-bg-alt);
  }

  .filter-option__input {
    width: 16px;
    height: 16px;
    accent-color: var(--color-accent);
    cursor: pointer;
    flex-shrink: 0;
  }

  .filter-option__label {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    flex: 1;
  }

  .filter-option__input:checked + .filter-option__label {
    font-weight: 600;
    color: var(--color-primary);
  }

  .filter-option__count {
    font-size: var(--text-xs);
    color: var(--color-text-light);
    background-color: var(--color-bg-alt);
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-full);
    min-width: 24px;
    text-align: center;
  }

  .filter-sidebar__mobile-toggle {
    display: none;
  }

  /* ==================== Product Grid ==================== */
  .listing__toolbar {
    margin-bottom: var(--space-lg);
  }

  .listing__count {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .product-grid__item {
    display: block;
  }

  .product-grid__item.is-hidden {
    display: none;
  }

  .no-results {
    text-align: center;
    padding: var(--space-4xl) var(--space-lg);
  }

  .no-results p {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  /* ==================== Cross-link ==================== */
  .cross-link-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .cross-link-card {
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    transition: all var(--transition-base);
  }

  .cross-link-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .cross-link-card__visual {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .cross-link-card__visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .cross-link-card:hover .cross-link-card__visual img {
    transform: scale(1.05);
  }

  .cross-link-card__body {
    padding: var(--space-md) var(--space-lg);
  }

  .cross-link-card__body h3 {
    font-size: var(--text-lg);
    margin-bottom: 0.25rem;
  }

  .cross-link-card__body p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .cross-link-card__cta {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent-dark);
  }

  /* ==================== Responsive ==================== */
  @media (max-width: 968px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cross-link-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .page-hero__stats {
      gap: var(--space-xl);
    }
  }

  @media (max-width: 768px) {
    .listing__layout {
      grid-template-columns: 1fr;
    }

    .filter-sidebar {
      position: static;
      padding: var(--space-md);
    }

    .filter-sidebar__mobile-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 0.75rem var(--space-md);
      font-size: var(--text-sm);
      font-weight: 700;
      color: var(--color-primary);
      background-color: var(--color-bg-alt);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      cursor: pointer;
      margin-bottom: var(--space-md);
    }

    .filter-sidebar__mobile-toggle.is-open + .filter-section,
    .filter-sidebar__mobile-toggle.is-open ~ .filter-section {
      display: block;
    }

    .filter-section {
      display: none;
    }

    .filter-sidebar.is-mobile-open .filter-section {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .product-grid {
      grid-template-columns: 1fr;
    }

    .cross-link-grid {
      grid-template-columns: 1fr;
    }

    .page-hero__stats {
      flex-direction: column;
      gap: var(--space-lg);
    }
  }
</style>

<script>
  // ==================== Filter Logic ====================
  const sidebar = document.getElementById("filter-sidebar");
  const grid = document.getElementById("product-grid");
  const items = grid?.querySelectorAll<HTMLElement>(".product-grid__item") || [];
  const resultCount = document.getElementById("result-count");
  const noResults = document.getElementById("no-results");
  const resetBtn = document.getElementById("filter-reset") as HTMLButtonElement | null;
  const mobileToggle = document.getElementById("mobile-filter-toggle");

  let activeCraft = "all";
  let activeBacking = "all";

  // Mobile filter toggle
  mobileToggle?.addEventListener("click", () => {
    sidebar?.classList.toggle("is-mobile-open");
  });

  function applyFilters() {
    let visibleCount = 0;

    items.forEach((item) => {
      const craft = item.dataset.craft || "";
      const backing = item.dataset.backing || "";

      const craftMatch = activeCraft === "all" || craft === activeCraft;
      const backingMatch = activeBacking === "all" || backing === activeBacking;

      if (craftMatch && backingMatch) {
        item.classList.remove("is-hidden");
        visibleCount++;
      } else {
        item.classList.add("is-hidden");
      }
    });

    if (resultCount) {
      resultCount.textContent = `Showing ${visibleCount} fabric${visibleCount !== 1 ? "s" : ""}`;
    }

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? "block" : "none";
    }

    const hasActiveFilter = activeCraft !== "all" || activeBacking !== "all";
    if (resetBtn) {
      resetBtn.style.display = hasActiveFilter ? "inline-block" : "none";
    }

    // ==================== SEO: noindex for filtered URLs ====================
    // When filters are active, add noindex meta tag to prevent Google from
    // indexing ?craft=xxx parameter URLs
    updateRobotsMeta(hasActiveFilter);

    // Update URL params (without triggering navigation)
    updateUrlParams();
  }

  function updateRobotsMeta(hasFilter: boolean) {
    let meta = document.querySelector('meta[name="robots"]') as HTMLMetaElement | null;
    if (!meta) {
      meta = document.createElement("meta");
      meta.setAttribute("name", "robots");
      document.head.appendChild(meta);
    }
    // Base page is index,follow. Filtered views are noindex,follow.
    meta.setAttribute("content", hasFilter ? "noindex, follow" : "index, follow");
  }

  function updateUrlParams() {
    const params = new URLSearchParams();
    if (activeCraft !== "all") params.set("craft", activeCraft);
    if (activeBacking !== "all") params.set("backing", activeBacking);

    const queryString = params.toString();
    const newUrl = queryString
      ? `${window.location.pathname}?${queryString}`
      : window.location.pathname;

    window.history.replaceState({}, "", newUrl);
  }

  // Restore filters from URL params on page load
  function restoreFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const craftParam = params.get("craft");
    const backingParam = params.get("backing");

    if (craftParam) {
      const radio = document.querySelector(`input[name="craft"][value="${craftParam}"]`) as HTMLInputElement | null;
      if (radio) {
        radio.checked = true;
        activeCraft = craftParam;
      }
    }

    if (backingParam) {
      const radio = document.querySelector(`input[name="backing"][value="${backingParam}"]`) as HTMLInputElement | null;
      if (radio) {
        radio.checked = true;
        activeBacking = backingParam;
      }
    }

    if (activeCraft !== "all" || activeBacking !== "all") {
      applyFilters();
    }
  }

  // Listen for filter changes
  document.querySelectorAll<HTMLInputElement>(".filter-option__input").forEach((input) => {
    input.addEventListener("change", () => {
      const type = input.dataset.filterType;
      const value = input.value;

      if (type === "craft") {
        activeCraft = value;
      } else if (type === "backing") {
        activeBacking = value;
      }

      applyFilters();
    });
  });

  // Reset button
  resetBtn?.addEventListener("click", () => {
    activeCraft = "all";
    activeBacking = "all";
    document.querySelectorAll<HTMLInputElement>(".filter-option__input").forEach((input) => {
      input.checked = input.value === "all";
    });
    applyFilters();
  });

  // No results reset button
  noResults?.querySelector('[data-action="reset"]')?.addEventListener("click", (e) => {
    e.preventDefault();
    resetBtn?.click();
  });

  // Initialize from URL
  restoreFromUrl();
</script>
