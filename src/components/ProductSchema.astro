---
const { productName, productImageUrl, productDescription } = Astro.props;

const hasProductImage =
  typeof productImageUrl === "string" && productImageUrl.trim().length > 0;

const productSchema = hasProductImage
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      name: productName,
      image: productImageUrl,
      description: productDescription,
      publisher: {
        "@type": "Organization",
        name: "Nixia Fabric",
      },
      about: {
        "@type": "Product",
        name: productName,
        image: productImageUrl,
        description: productDescription,
      },
    }
  : null;
---

{productSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
)}
