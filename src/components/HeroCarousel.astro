---
/**
 * HeroCarousel.astro — Full-viewport hero carousel
 * Fade transition, 7s auto-play, arrows + dots
 * Supports MP4 video slides (mobile falls back to static image)
 * Inspired by ecowoodplate.com carousel style
 */

interface Slide {
  image: string;
  video?: string;
  title: string;
  description: string;
  buttons: { label: string; href: string; variant: "primary" | "outline" }[];
}

const slides: Slide[] = [
  {
    image: "/image/home/slide1.webp",
    title: "Specialty Fabrics for Fashion & Creative Products",
    description:
      "Iridescent, glitter and foil‑effect fabrics designed to bring distinctive finishes to your products.",
    buttons: [
      { label: "Explore Fabrics", href: "/products/", variant: "primary" },
      { label: "Request Samples", href: "#rfq-buyer-resource", variant: "outline" },
    ],
  },
  {
    image: "/image/home/slide2.webp",
    title: "Runway-Ready Finishes, Factory-Direct Prices",
    description:
      "Laser and holographic foils with a catwalk shine, at wholesale-direct pricing. OEM/ODM development from your design or reference sample.",
    buttons: [
      { label: "Explore Products", href: "/products/", variant: "primary" },
      { label: "Send Your Design", href: "/contact/", variant: "outline" },
    ],
  },
  {
    image: "/image/home/slide3.webp",
    title: "Built for Shoes, Bags & Accessories",
    description:
      "Structured glitter and foil synthetic leathers for uppers, handbags and trims — sparkle that keeps its shape through production.",
    buttons: [
      { label: "View Fabrics", href: "/products/", variant: "primary" },
      { label: "Get a Quote", href: "/contact/", variant: "outline" },
    ],
  },
  {
    image: "/image/home/slide4.webp",
    title: "Made for the Spotlight",
    description:
      "Holographic stretch fabrics for party wear, dance costumes and stage outfits — bright under the lights, comfortable on the body.",
    buttons: [
      { label: "Explore Fabrics", href: "/products/", variant: "primary" },
    ],
  },
  {
    image: "/image/home/slide5.webp",
    title: "In-House Production, Batch-by-Batch QC",
    description:
      "Every roll is finished and inspected in our own facility. SGS certified, REACH compliant — test reports available on request.",
    buttons: [
      { label: "Tour Our Factory", href: "/factory/", variant: "primary" },
      { label: "Get Custom Quotation", href: "/contact/", variant: "outline" },
    ],
  },
];

const toWebp = (src: string) => src.replace(/\.(png|jpe?g)$/i, ".webp");
const toMobile = (src: string) => src.replace(/\.(png|jpe?g|webp)$/i, "-mobile.webp");
---

<div class="hero-carousel-wrap">
  <div class="hero-carousel" id="hero-carousel" role="region" aria-label="Hero carousel">
  <!-- Slides -->
  <div class="hero-carousel__track">
    {slides.map((slide, idx) => (
      <div
        class:list={["hero-carousel__slide", { "is-active": idx === 0 }]}
        data-index={idx}
        role="group"
        aria-label={`Slide ${idx + 1} of ${slides.length}`}
        aria-hidden={idx !== 0 ? "true" : "false"}
      >
        {slide.video ? (
          <>
            <video
              class="hero-carousel__video"
              src={slide.video}
              poster={slide.image}
              autoplay
              muted
              loop
              playsinline
              preload="none"
              aria-label={slide.title}
            />
            <picture>
              <source srcset={toMobile(slide.image)} media="(max-width: 768px)" type="image/webp" />
              <source srcset={toWebp(slide.image)} type="image/webp" />
              <img
                src={slide.image}
                alt="Glitter and foil-printed synthetic leather production at Nixia Fabric factory"
                class="hero-carousel__image hero-carousel__image--mobile"
                width="1920"
                height="1080"
                decoding="async"
                loading={idx === 0 ? "eager" : "lazy"}
                fetchpriority={idx === 0 ? "high" : "auto"}
              />
            </picture>
          </>
        ) : (
          <picture>
            <source srcset={toMobile(slide.image)} media="(max-width: 768px)" type="image/webp" />
            <source srcset={toWebp(slide.image)} type="image/webp" />
            <img
              src={slide.image}
              alt={idx === 0
                ? "Model wearing an iridescent holographic dress made with Nixia foil fabric"
                : idx === 1
                ? "Runway model in an iridescent gown with a close-up of the laser foil fabric"
                : idx === 2
                ? "Holographic shoes and accessories with rolls of pastel glitter fabric"
                : idx === 3
                ? "Party outfits in lime holographic fabric with a close-up of the material"
                : "Nixia Fabric in-house production line finishing rolls of foil fabric"}
              class="hero-carousel__image"
              width="1920"
              height="1080"
              decoding="async"
              loading={idx === 0 ? "eager" : "lazy"}
              fetchpriority={idx === 0 ? "high" : "auto"}
            />
          </picture>
        )}
        <div class="hero-carousel__overlay"></div>
        <div class="hero-carousel__content">
            <div class="hero-carousel__text">
              {idx === 0 ? (
                <h1 class="hero-carousel__title">{slide.title}</h1>
              ) : (
                <h2 class="hero-carousel__title">{slide.title}</h2>
              )}
              <p class="hero-carousel__desc">{slide.description}</p>
              <div class="hero-carousel__actions">
                {slide.buttons.map((btn) => (
                  <a
                    href={btn.href}
                    class:list={[
                      "hero-carousel__btn",
                      `hero-carousel__btn--${btn.variant}`,
                    ]}
                  >
                    {btn.label}
                  </a>
                ))}
              </div>
            </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Arrows -->
  <button
    class="hero-carousel__arrow hero-carousel__arrow--prev"
    id="carousel-prev"
    aria-label="Previous slide"
    type="button"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
  <button
    class="hero-carousel__arrow hero-carousel__arrow--next"
    id="carousel-next"
    aria-label="Next slide"
    type="button"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <!-- Dots -->
  <div class="hero-carousel__dots" role="tablist" aria-label="Slide selectors">
    {slides.map((_, idx) => (
      <button
        class:list={["hero-carousel__dot", { "is-active": idx === 0 }]}
        data-index={idx}
        role="tab"
        aria-label={`Go to slide ${idx + 1}`}
        aria-selected={idx === 0 ? "true" : "false"}
        type="button"
      ></button>
    ))}
  </div>
  </div>
</div>

<style>
  /* Outer wrap: content width, centered — aligns with header nav width */
  .hero-carousel-wrap {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-lg);
    box-sizing: border-box;
  }

.hero-carousel {
    position: relative;
    width: 100%;
    max-width: 100%;
    /* ~16:9 of the 1280px content column; height tapers on short viewports */
    height: clamp(360px, 46vw, 720px);
    overflow: hidden;
    border-radius: 8px;
    background-color: #0a0a0a;
  }

  .hero-carousel__track {
    position: absolute;
    inset: 0;
  }

  .hero-carousel__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s ease-in-out;
    pointer-events: none;
  }

  .hero-carousel__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-carousel__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: sepia(0.06) saturate(0.95) brightness(1.02) hue-rotate(5deg);
  }

  /* Video slide — desktop only, mobile falls back to image */
  .hero-carousel__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: sepia(0.06) saturate(0.95) brightness(1.02) hue-rotate(5deg);
  }

  .hero-carousel__image--mobile {
    display: none;
  }

  @media (max-width: 768px) {
    .hero-carousel {
      height: clamp(280px, 62vw, 440px);
    }

    .hero-carousel__video {
      display: none;
    }

    .hero-carousel__image--mobile {
      display: block;
    }
  }

  /* Bottom-up gradient overlay — light touch, only darkens lower third */
  .hero-carousel__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.5) 0%,
      rgba(0, 0, 0, 0.18) 30%,
      transparent 55%
    );
  }

  /* Content — horizontally & vertically centered */
  .hero-carousel__content {
    position: absolute;
    inset: 0;
    padding: calc(var(--header-height) * 0.5 + 1rem) clamp(1.5rem, 5vw, 6rem) clamp(2.5rem, 6vh, 4rem);
    z-index: 2;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .hero-carousel__text {
    width: 100%;
    max-width: 720px;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .hero-carousel__title {
    color: #fff;
    font-size: clamp(1.5rem, 3.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
  }

  .hero-carousel__desc {
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(0.85rem, 1.1vw, 1rem);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.3);
  }

  .hero-carousel__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Buttons */
  .hero-carousel__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.75rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.25s ease;
    cursor: pointer;
    white-space: nowrap;
    min-height: 44px;
  }

  .hero-carousel__btn--primary {
    background-color: var(--color-accent);
    color: #fff;
    border: 2px solid var(--color-accent);
    box-shadow: 0 0 16px rgba(196, 160, 53, 0.25), 0 4px 12px rgba(0, 0, 0, 0.3);
  }

  .hero-carousel__btn--primary:hover {
    background-color: var(--color-accent-dark);
    border-color: var(--color-accent-dark);
    transform: translateY(-2px);
    box-shadow: 0 0 24px rgba(196, 160, 53, 0.4), 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .hero-carousel__btn--outline {
    background-color: transparent;
    color: var(--color-accent);
    border: 2px solid var(--color-accent);
  }

  .hero-carousel__btn--outline:hover {
    background-color: rgba(196, 160, 53, 0.1);
    border-color: var(--color-accent-light);
    color: var(--color-accent-light);
  }

  /* Arrows */
  .hero-carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    transition: all 0.25s ease;
    backdrop-filter: blur(4px);
  }

  .hero-carousel__arrow:hover {
    background-color: rgba(0, 0, 0, 0.5);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .hero-carousel__arrow svg {
    width: 24px;
    height: 24px;
  }

  .hero-carousel__arrow--prev {
    left: clamp(1rem, 3vw, 2.5rem);
  }

  .hero-carousel__arrow--next {
    right: clamp(1rem, 3vw, 2.5rem);
  }

  /* Dots */
  .hero-carousel__dots {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.625rem;
    z-index: 10;
  }

  .hero-carousel__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.35);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 8px;
    background-clip: content-box;
  }

  .hero-carousel__dot.is-active {
    background-color: #d4ac2e;
    width: 30px;
    border-radius: 5px;
    background-clip: content-box;
  }

  .hero-carousel__dot:hover {
    background-color: rgba(255, 255, 255, 0.6);
  }

  .hero-carousel__dot.is-active:hover {
    background-color: var(--color-accent-light);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-carousel__arrow {
      width: 48px;
      height: 48px;
    }

    .hero-carousel__arrow svg {
      width: 18px;
      height: 18px;
    }

    .hero-carousel__actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .hero-carousel__text {
      width: 100%;
      max-width: 100%;
    }

    .hero-carousel__btn {
      text-align: center;
      padding: 0.75rem 1.5rem;
      font-size: 0.9rem;
      min-height: 48px;
    }

    .hero-carousel__content {
      padding-bottom: clamp(2rem, 6vh, 4rem);
    }

    .hero-carousel__dot {
      width: 8px;
      height: 8px;
      padding: 10px;
    }

    .hero-carousel__dot.is-active {
      width: 24px;
    }
  }

  @media (max-width: 480px) {
    .hero-carousel__title {
      font-size: 1.5rem;
    }

    .hero-carousel__desc {
      font-size: 0.85rem;
      margin-bottom: 1.25rem;
    }

    .hero-carousel__arrow--prev {
      left: 0.5rem;
    }

    .hero-carousel__arrow--next {
      right: 0.5rem;
    }
  }
</style>

<script>
  const carousel = document.getElementById("hero-carousel");
  if (carousel) {
    const slides = carousel.querySelectorAll<HTMLElement>(".hero-carousel__slide");
    const dots = carousel.querySelectorAll<HTMLButtonElement>(".hero-carousel__dot");
    const prevBtn = document.getElementById("carousel-prev");
    const nextBtn = document.getElementById("carousel-next");
    let current = 0;
    let autoTimer: ReturnType<typeof setInterval> | null = null;
    const INTERVAL = 5000;

    function goTo(index: number) {
      const total = slides.length;
      current = ((index % total) + total) % total;

      slides.forEach((slide, i) => {
        slide.classList.toggle("is-active", i === current);
        slide.setAttribute("aria-hidden", i !== current ? "true" : "false");
      });

      dots.forEach((dot, i) => {
        dot.classList.toggle("is-active", i === current);
        dot.setAttribute("aria-selected", i === current ? "true" : "false");
      });
    }

    function next() {
      goTo(current + 1);
    }

    function prev() {
      goTo(current - 1);
    }

    function startAuto() {
      stopAuto();
      autoTimer = setInterval(next, INTERVAL);
    }

    function stopAuto() {
      if (autoTimer) {
        clearInterval(autoTimer);
        autoTimer = null;
      }
    }

    function restartAuto() {
      startAuto();
    }

    // Arrow controls
    prevBtn?.addEventListener("click", () => {
      prev();
      restartAuto();
    });

    nextBtn?.addEventListener("click", () => {
      next();
      restartAuto();
    });

    // Dot controls
    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const idx = parseInt(dot.dataset.index || "0", 10);
        goTo(idx);
        restartAuto();
      });
    });

    // Pause on hover
    carousel.addEventListener("mouseenter", stopAuto);
    carousel.addEventListener("mouseleave", startAuto);

    // Keyboard navigation
    carousel.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        prev();
        restartAuto();
      } else if (e.key === "ArrowRight") {
        next();
        restartAuto();
      }
    });

    // Touch / swipe support
    let touchStartX = 0;
    let touchEndX = 0;

    carousel.addEventListener("touchstart", (e) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAuto();
    }, { passive: true });

    carousel.addEventListener("touchend", (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) {
          next();
        } else {
          prev();
        }
      }
      startAuto();
    }, { passive: true });

    // Start auto-play
    startAuto();
  }
</script>
