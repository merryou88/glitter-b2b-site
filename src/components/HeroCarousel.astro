---
/**
 * HeroCarousel.astro — Full-viewport hero carousel
 * Fade transition, 7s auto-play, arrows + dots
 * Supports MP4 video slides (mobile falls back to static image)
 * Inspired by ecowoodplate.com carousel style
 */

interface Slide {
  image: string;
  video?: string;
  title: string;
  description: string;
  buttons: { label: string; href: string; variant: "primary" | "outline" }[];
}

const slides: Slide[] = [
  {
    image: "/image/home/slide1.png",
    title: "Glitter & Foil-Printed Synthetic Leather Manufacturer",
    description:
      "Specializing in Foil-Printed Synthetic Leather and Chunky Glitter Synthetic Leather for shoes, handbags and fashion accessories. Factory Direct Supply, Custom Color Matching and strict quality-controlled manufacturing.",
    buttons: [
      { label: "Request Free Sample", href: "/sample-policy", variant: "primary" },
      { label: "Get Custom Quotation", href: "/contact", variant: "outline" },
    ],
  },
  {
    image: "/image/home/slide2.png",
    title: "Wide Range of Glitter & Foil Fabric Options",
    description:
      "Foil-Printed Synthetic Leather and Chunky Glitter Synthetic Leather with multiple colors and base materials. Request free samples — buyer only covers international shipping cost.",
    buttons: [
      { label: "Request Free Sample", href: "/sample-policy", variant: "primary" },
      { label: "Discover Fabrics", href: "/products", variant: "outline" },
    ],
  },
  {
    image: "/image/home/slide3.png",
    title: "Strict In-House Quality Control",
    description:
      "Every batch undergoes full-range inspection during production. SGS Certified, REACH Compliant — test reports available upon request.",
    buttons: [
      { label: "Request Free Sample", href: "/sample-policy", variant: "primary" },
      { label: "Get Custom Quotation", href: "/contact", variant: "outline" },
    ],
  },
  {
    image: "/image/home/slide4.png",
    title: "Reliable Export Delivery",
    description:
      "Well-managed warehouse for finished fabric stock. Support FOB and CIF international trade terms.",
    buttons: [
      { label: "Request Free Sample", href: "/sample-policy", variant: "primary" },
      { label: "Get Custom Quotation", href: "/contact", variant: "outline" },
    ],
  },
  {
    image: "/image/home/slide5.png",
    title: "Fabric for Finished Shoes and Bags",
    description:
      "Our Foil-Printed Synthetic Leather and Chunky Glitter Synthetic Leather are widely applied for footwear, handbags and fashion accessories. Custom Color Matching available for your end-product projects.",
    buttons: [
      { label: "Request Free Sample", href: "/sample-policy", variant: "primary" },
      { label: "Discover Fabrics", href: "/products", variant: "outline" },
    ],
  },
];
---

<div class="hero-carousel" id="hero-carousel" role="region" aria-label="Hero carousel">
  <!-- Slides -->
  <div class="hero-carousel__track">
    {slides.map((slide, idx) => (
      <div
        class:list={["hero-carousel__slide", { "is-active": idx === 0 }]}
        data-index={idx}
        role="group"
        aria-label={`Slide ${idx + 1} of ${slides.length}`}
        aria-hidden={idx !== 0 ? "true" : "false"}
      >
        {slide.video ? (
          <>
            <video
              class="hero-carousel__video"
              src={slide.video}
              poster={slide.image}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-label={slide.title}
            />
            <img
              src={slide.image}
              alt={slide.title}
              class="hero-carousel__image hero-carousel__image--mobile"
              loading={idx === 0 ? "eager" : "lazy"}
              width="1920"
              height="1080"
            />
          </>
        ) : (
          <img
            src={slide.image}
            alt={slide.title}
            class="hero-carousel__image"
            loading={idx === 0 ? "eager" : "lazy"}
            width="1920"
            height="1080"
          />
        )}
        <div class="hero-carousel__overlay"></div>
        <div class="hero-carousel__content">
          <div class="container">
            <div class="hero-carousel__text">
              <h2 class="hero-carousel__title">{slide.title}</h2>
              <p class="hero-carousel__desc">{slide.description}</p>
              <div class="hero-carousel__actions">
                {slide.buttons.map((btn) => (
                  <a
                    href={btn.href}
                    class:list={[
                      "hero-carousel__btn",
                      `hero-carousel__btn--${btn.variant}`,
                    ]}
                  >
                    {btn.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- Arrows -->
  <button
    class="hero-carousel__arrow hero-carousel__arrow--prev"
    id="carousel-prev"
    aria-label="Previous slide"
    type="button"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
  <button
    class="hero-carousel__arrow hero-carousel__arrow--next"
    id="carousel-next"
    aria-label="Next slide"
    type="button"
  >
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <!-- Dots -->
  <div class="hero-carousel__dots" role="tablist" aria-label="Slide selectors">
    {slides.map((_, idx) => (
      <button
        class:list={["hero-carousel__dot", { "is-active": idx === 0 }]}
        data-index={idx}
        role="tab"
        aria-label={`Go to slide ${idx + 1}`}
        aria-selected={idx === 0 ? "true" : "false"}
        type="button"
      ></button>
    ))}
  </div>
</div>

<style>
  .hero-carousel {
    position: relative;
    width: 100%;
    height: clamp(520px, 80vh, 780px);
    max-height: 800px;
    overflow: hidden;
    background-color: #0a0a0a;
  }

  .hero-carousel__track {
    position: absolute;
    inset: 0;
  }

  .hero-carousel__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.8s ease-in-out;
    pointer-events: none;
  }

  .hero-carousel__slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  .hero-carousel__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Video slide — desktop only, mobile falls back to image */
  .hero-carousel__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-carousel__image--mobile {
    display: none;
  }

  @media (max-width: 768px) {
    .hero-carousel__video {
      display: none;
    }

    .hero-carousel__image--mobile {
      display: block;
    }
  }

  /* Bottom-up gradient overlay — subtle dark at bottom */
  .hero-carousel__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.2) 40%,
      transparent 65%
    );
  }

  /* Content — left aligned, lower portion */
  .hero-carousel__content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(2.5rem, 8vh, 5rem);
  }

  .hero-carousel__text {
    max-width: 680px;
  }

  .hero-carousel__title {
    color: #fff;
    font-size: clamp(1.5rem, 3.5vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
  }

  .hero-carousel__desc {
    color: rgba(255, 255, 255, 0.9);
    font-size: clamp(0.85rem, 1.1vw, 1rem);
    line-height: 1.65;
    margin-bottom: 1.5rem;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.3);
  }

  .hero-carousel__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Buttons */
  .hero-carousel__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.75rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.25s ease;
    cursor: pointer;
    white-space: nowrap;
  }

  .hero-carousel__btn--primary {
    background-color: var(--color-accent);
    color: #fff;
    border: 2px solid var(--color-accent);
    box-shadow: 0 0 16px rgba(196, 160, 53, 0.25), 0 4px 12px rgba(0, 0, 0, 0.3);
  }

  .hero-carousel__btn--primary:hover {
    background-color: var(--color-accent-dark);
    border-color: var(--color-accent-dark);
    transform: translateY(-2px);
    box-shadow: 0 0 24px rgba(196, 160, 53, 0.4), 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .hero-carousel__btn--outline {
    background-color: transparent;
    color: var(--color-accent);
    border: 2px solid var(--color-accent);
  }

  .hero-carousel__btn--outline:hover {
    background-color: rgba(196, 160, 53, 0.1);
    border-color: var(--color-accent-light);
    color: var(--color-accent-light);
  }

  /* Arrows */
  .hero-carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
    transition: all 0.25s ease;
    backdrop-filter: blur(4px);
  }

  .hero-carousel__arrow:hover {
    background-color: rgba(0, 0, 0, 0.5);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .hero-carousel__arrow svg {
    width: 24px;
    height: 24px;
  }

  .hero-carousel__arrow--prev {
    left: clamp(1rem, 3vw, 2.5rem);
  }

  .hero-carousel__arrow--next {
    right: clamp(1rem, 3vw, 2.5rem);
  }

  /* Dots */
  .hero-carousel__dots {
    position: absolute;
    bottom: clamp(1.5rem, 4vh, 2.5rem);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.625rem;
    z-index: 10;
  }

  .hero-carousel__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.35);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    padding: 0;
  }

  .hero-carousel__dot.is-active {
    background-color: var(--color-accent);
    width: 30px;
    border-radius: 5px;
  }

  .hero-carousel__dot:hover {
    background-color: rgba(255, 255, 255, 0.6);
  }

  .hero-carousel__dot.is-active:hover {
    background-color: var(--color-accent-light);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero-carousel__arrow {
      width: 40px;
      height: 40px;
    }

    .hero-carousel__arrow svg {
      width: 18px;
      height: 18px;
    }

    .hero-carousel__actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .hero-carousel__btn {
      text-align: center;
      padding: 0.75rem 1.5rem;
      font-size: 0.9rem;
    }

    .hero-carousel__content {
      padding-bottom: clamp(3.5rem, 10vh, 5rem);
    }

    .hero-carousel__dot {
      width: 8px;
      height: 8px;
    }

    .hero-carousel__dot.is-active {
      width: 24px;
    }
  }

  @media (max-width: 480px) {
    .hero-carousel__title {
      font-size: 1.5rem;
    }

    .hero-carousel__desc {
      font-size: 0.85rem;
      margin-bottom: 1.25rem;
    }

    .hero-carousel__arrow--prev {
      left: 0.5rem;
    }

    .hero-carousel__arrow--next {
      right: 0.5rem;
    }
  }
</style>

<script>
  const carousel = document.getElementById("hero-carousel");
  if (carousel) {
    const slides = carousel.querySelectorAll<HTMLElement>(".hero-carousel__slide");
    const dots = carousel.querySelectorAll<HTMLButtonElement>(".hero-carousel__dot");
    const prevBtn = document.getElementById("carousel-prev");
    const nextBtn = document.getElementById("carousel-next");
    let current = 0;
    let autoTimer: ReturnType<typeof setInterval> | null = null;
    const INTERVAL = 7000;

    function goTo(index: number) {
      const total = slides.length;
      current = ((index % total) + total) % total;

      slides.forEach((slide, i) => {
        slide.classList.toggle("is-active", i === current);
        slide.setAttribute("aria-hidden", i !== current ? "true" : "false");
      });

      dots.forEach((dot, i) => {
        dot.classList.toggle("is-active", i === current);
        dot.setAttribute("aria-selected", i === current ? "true" : "false");
      });
    }

    function next() {
      goTo(current + 1);
    }

    function prev() {
      goTo(current - 1);
    }

    function startAuto() {
      stopAuto();
      autoTimer = setInterval(next, INTERVAL);
    }

    function stopAuto() {
      if (autoTimer) {
        clearInterval(autoTimer);
        autoTimer = null;
      }
    }

    function restartAuto() {
      startAuto();
    }

    // Arrow controls
    prevBtn?.addEventListener("click", () => {
      prev();
      restartAuto();
    });

    nextBtn?.addEventListener("click", () => {
      next();
      restartAuto();
    });

    // Dot controls
    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const idx = parseInt(dot.dataset.index || "0", 10);
        goTo(idx);
        restartAuto();
      });
    });

    // Pause on hover
    carousel.addEventListener("mouseenter", stopAuto);
    carousel.addEventListener("mouseleave", startAuto);

    // Keyboard navigation
    carousel.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") {
        prev();
        restartAuto();
      } else if (e.key === "ArrowRight") {
        next();
        restartAuto();
      }
    });

    // Touch / swipe support
    let touchStartX = 0;
    let touchEndX = 0;

    carousel.addEventListener("touchstart", (e) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAuto();
    }, { passive: true });

    carousel.addEventListener("touchend", (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchStartX - touchEndX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) {
          next();
        } else {
          prev();
        }
      }
      startAuto();
    }, { passive: true });

    // Start auto-play
    startAuto();
  }
</script>
