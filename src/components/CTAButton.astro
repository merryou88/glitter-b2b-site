---
/**
 * CTAButton.astro — Reusable call-to-action button
 * Variants: primary, secondary, outline, dark
 */
export interface Props {
  href: string;
  variant?: "primary" | "secondary" | "outline" | "dark";
  size?: "default" | "lg";
  block?: boolean;
  class?: string;
  rfq?: boolean;
  rfqSku?: string;
}

const {
  href,
  variant = "primary",
  size = "default",
  block = false,
  class: className = "",
  rfq = false,
  rfqSku = "",
} = Astro.props;

const classes = [
  "btn",
  `btn--${variant}`,
  size === "lg" && "btn--lg",
  block && "btn--block",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<a href={href} class={classes} data-rfq-open={rfq ? true : undefined} data-rfq-sku={rfqSku || undefined}>
  <slot />
</a>
