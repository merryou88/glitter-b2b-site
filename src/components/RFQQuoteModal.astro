---
---

<div class="rfq-modal" id="rfq-quote-modal" aria-hidden="true">
  <div class="rfq-modal__backdrop" data-rfq-close></div>

  <div class="rfq-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="rfq-modal-title">
    <button class="rfq-modal__close" type="button" aria-label="Close quote form" data-rfq-close>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>

    <span class="rfq-modal__eyebrow">Request a Quote</span>
    <h2 class="rfq-modal__title" id="rfq-modal-title">Request a Quote</h2>
    <p class="rfq-modal__desc">Share your fabric requirements, target application and OEM/ODM needs for an accurate factory quote.</p>

    <div class="rfq-modal__error" id="rfq-modal-error" role="alert" hidden></div>

    <form class="rfq-modal__form" id="rfq-modal-form" novalidate>
      <div class="rfq-modal__grid">
        <label class="rfq-modal__field">
          <span class="rfq-modal__label">Full Name *</span>
          <input name="fullName" type="text" placeholder="Your name" required />
        </label>

        <label class="rfq-modal__field">
          <span class="rfq-modal__label">Email *</span>
          <input name="email" type="email" placeholder="your@email.com" required />
        </label>

        <label class="rfq-modal__field">
          <span class="rfq-modal__label">Company</span>
          <input name="company" type="text" placeholder="Your company" />
        </label>

        <label class="rfq-modal__field">
          <span class="rfq-modal__label">Destination Country</span>
          <input name="destinationCountry" type="text" placeholder="e.g. United States" />
        </label>

        <label class="rfq-modal__field rfq-modal__field--full">
          <span class="rfq-modal__label">Fabric / Material Code</span>
          <input name="fabricCode" type="text" placeholder="Input SKU or describe your target fabric" />
        </label>

        <label class="rfq-modal__field rfq-modal__field--full">
          <span class="rfq-modal__label">Buyer Identity</span>
          <select name="buyerIdentity">
            <option value="">Select buyer type</option>
            <option>Importer / Distributor</option>
            <option>Retail Chain Buyer</option>
            <option>Amazon / Online Seller</option>
            <option>Brand Owner</option>
            <option>Gift &amp; Event Deco Company</option>
            <option>Shoe &amp; Bag Manufacturer</option>
            <option>Other B2B Buyer</option>
          </select>
        </label>

        <label class="rfq-modal__field">
          <span class="rfq-modal__label">Estimated Quantity</span>
          <input name="estimatedQuantity" type="text" placeholder="e.g. sample order / 500 meters" />
        </label>

        <label class="rfq-modal__field">
          <span class="rfq-modal__label">Target Timeline</span>
          <input name="targetTimeline" type="text" placeholder="e.g. Need samples this month" />
        </label>

        <label class="rfq-modal__field rfq-modal__field--full">
          <span class="rfq-modal__label">Message *</span>
          <textarea name="message" rows="5" placeholder="Tell us your target application, color, backing and other custom fabric requirements..." required></textarea>
        </label>
      </div>

      <button class="btn btn--primary btn--lg rfq-modal__submit" type="submit">Send Quote Request</button>
    </form>
  </div>
</div>

<style>
  .rfq-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
  }

  .rfq-modal.is-open {
    display: block;
  }

  .rfq-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(12, 21, 40, 0.72);
  }

  .rfq-modal__dialog {
    position: relative;
    z-index: 1;
    width: min(920px, calc(100vw - 2rem));
    max-height: calc(100vh - 2rem);
    overflow: auto;
    margin: 1rem auto;
    padding: var(--space-2xl);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.24);
  }

  .rfq-modal__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 999px;
    background: rgba(42, 65, 112, 0.08);
    color: var(--color-primary);
    cursor: pointer;
  }

  .rfq-modal__eyebrow {
    display: inline-block;
    margin-bottom: var(--space-sm);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--color-accent-dark);
  }

  .rfq-modal__title {
    margin-bottom: var(--space-sm);
    color: var(--color-primary);
  }

  .rfq-modal__desc {
    margin-bottom: var(--space-xl);
    color: var(--color-text-muted);
  }

  .rfq-modal__error {
    margin-bottom: var(--space-md);
    padding: 0.9rem 1rem;
    border-radius: var(--radius-sm);
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #b91c1c;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .rfq-modal__form {
    display: grid;
    gap: var(--space-lg);
  }

  .rfq-modal__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .rfq-modal__field {
    display: grid;
    gap: 0.45rem;
  }

  .rfq-modal__field--full {
    grid-column: 1 / -1;
  }

  .rfq-modal__label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-secondary);
  }

  .rfq-modal__field :is(input, select, textarea) {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: var(--color-text);
    padding: 0.85rem 1rem;
    font: inherit;
  }

  .rfq-modal__field :is(input, select, textarea):focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(196, 160, 53, 0.1);
  }

  .rfq-modal__field textarea {
    resize: vertical;
    min-height: 120px;
  }

  .rfq-modal__submit {
    justify-self: start;
  }

  @media (max-width: 640px) {
    .rfq-modal__dialog {
      width: calc(100vw - 1rem);
      margin: 0.5rem auto;
      padding: 1.25rem;
    }

    .rfq-modal__grid {
      grid-template-columns: 1fr;
    }

    .rfq-modal__submit {
      width: 100%;
      justify-self: stretch;
    }
  }
</style>

<script>
  const modal = document.getElementById("rfq-quote-modal");
  const form = document.getElementById("rfq-modal-form") as HTMLFormElement | null;
  const errorBox = document.getElementById("rfq-modal-error") as HTMLElement | null;
  const openers = Array.from(document.querySelectorAll("[data-rfq-open]"));
  const closers = Array.from(document.querySelectorAll("[data-rfq-close]"));

  const showError = (message: string) => {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.hidden = false;
  };

  const hideError = () => {
    if (errorBox) errorBox.hidden = true;
  };

  const openModal = () => {
    if (!modal) return;
    modal.classList.add("is-open");
    modal.setAttribute("aria-hidden", "false");
    hideError();
    document.body.style.overflow = "hidden";
  };

  const closeModal = () => {
    if (!modal) return;
    modal.classList.remove("is-open");
    modal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  };

  openers.forEach((button) => button.addEventListener("click", openModal));
  closers.forEach((button) => button.addEventListener("click", closeModal));

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) closeModal();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && modal?.classList.contains("is-open")) closeModal();
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    hideError();

    const data = new FormData(form);
    const fullName = String(data.get("fullName") || "").trim();
    const email = String(data.get("email") || "").trim();
    const message = String(data.get("message") || "").trim();

    if (!fullName || !email || !message) {
      showError("Please complete the required fields.");
      return;
    }

    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showError("Please provide a valid email address.");
      return;
    }

    showError("Quote request form is ready. Submission will be connected next.");
  });
</script>
