---
/**
 * RFQQuoteModal.astro — Modal container for the RFQ quote form
 * Opens via [data-rfq-open], closes via [data-rfq-close] / backdrop / Esc.
 * The form itself is the reusable <RfqQuoteForm /> component.
 */
import RfqQuoteForm from "@components/RfqQuoteForm.astro";
---

<div class="rfq-modal" id="rfq-quote-modal" aria-hidden="true">
  <div class="rfq-modal__backdrop" data-rfq-close></div>

  <div class="rfq-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="rfq-modal-title">
    <button class="rfq-modal__close" type="button" aria-label="Close quote form" data-rfq-close>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>

    <span class="rfq-modal__eyebrow">Request a Quote</span>
    <h2 class="rfq-modal__title" id="rfq-modal-title">Request a Quote</h2>
    <p class="rfq-modal__desc">Share your fabric requirements, target application and OEM/ODM needs for an accurate factory quote.</p>

    <RfqQuoteForm />
  </div>
</div>

<style>
  .rfq-modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
  }

  .rfq-modal.is-open {
    display: block;
  }

  .rfq-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(12, 21, 40, 0.72);
  }

  .rfq-modal__dialog {
    position: relative;
    z-index: 1;
    width: min(920px, calc(100vw - 2rem));
    max-height: calc(100vh - 2rem);
    overflow: auto;
    margin: 1rem auto;
    padding: var(--space-2xl);
    border-radius: var(--radius-lg);
    background: var(--color-white);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.24);
  }

  .rfq-modal__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: rgba(42, 65, 112, 0.08);
    color: var(--color-primary);
    cursor: pointer;
  }

  .rfq-modal__eyebrow {
    display: inline-block;
    margin-bottom: var(--space-sm);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--color-accent-dark);
  }

  .rfq-modal__title {
    margin-bottom: var(--space-sm);
    color: var(--color-primary);
  }

  .rfq-modal__desc {
    margin-bottom: var(--space-xl);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .rfq-modal__dialog {
      width: calc(100vw - 1rem);
      margin: 0.5rem auto;
      padding: 1.25rem;
    }
  }
</style>

<script>
  const modal = document.getElementById("rfq-quote-modal");
  const openers = Array.from(document.querySelectorAll("[data-rfq-open]"));
  const closers = Array.from(document.querySelectorAll("[data-rfq-close]"));

  const openModal = () => {
    if (!modal) return;
    modal.classList.add("is-open");
    modal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  };

  const closeModal = () => {
    if (!modal) return;
    modal.classList.remove("is-open");
    modal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  };

  openers.forEach((button) => button.addEventListener("click", openModal));
  closers.forEach((button) => button.addEventListener("click", closeModal));

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) closeModal();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && modal?.classList.contains("is-open")) closeModal();
  });
</script>