---
/**
 * FloatingContact.astro — Global floating contact popup
 * Fixed bottom-right, circular trigger button, expandable popup
 * Pure HTML + CSS + JS, no third-party scripts
 */
---

<div class="float-contact" id="float-contact">
  <!-- Trigger Button -->
  <button
    class="float-contact__trigger"
    id="float-contact-trigger"
    aria-label="Open contact options"
    aria-expanded="false"
    aria-controls="float-contact-popup"
  >
    <svg class="float-contact__icon-chat" width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
    </svg>
    <svg class="float-contact__icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </svg>
  </button>

  <!-- Popup Card -->
  <div class="float-contact__popup" id="float-contact-popup" role="dialog" aria-label="Contact options" aria-hidden="true">
    <div class="float-contact__header">
      <h3 class="float-contact__title">Our Contact Options</h3>
      <button
        class="float-contact__close"
        id="float-contact-close"
        aria-label="Close contact popup"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <p class="float-contact__hint">
      Welcome to inquire about glitter &amp; foil-printed synthetic leather.
      Please choose your preferred contact method:
    </p>

    <div class="float-contact__actions">
      <!-- WhatsApp Button -->
      <a
        href="https://wa.me/8613616899303"
        class="float-contact__btn float-contact__btn--whatsapp"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
        </svg>
        <span>Open WhatsApp Chat</span>
      </a>

      <!-- WeChat Button + ID Display -->
      <div class="float-contact__wechat">
        <button
          class="float-contact__btn float-contact__btn--wechat"
          id="float-contact-wechat-toggle"
          aria-expanded="false"
          aria-controls="float-contact-wechat-id"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.328.328 0 0 0 .167-.054l1.903-1.114a.864.864 0 0 1 .717-.098 10.16 10.16 0 0 0 2.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.972 1.932-6.446 1.703-1.415 3.882-1.98 5.853-1.838-.576-3.583-4.196-6.348-8.596-6.348zM5.785 5.991c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178A1.17 1.17 0 0 1 4.623 7.17c0-.651.52-1.18 1.162-1.18zm5.813 0c.642 0 1.162.529 1.162 1.18a1.17 1.17 0 0 1-1.162 1.178 1.17 1.17 0 0 1-1.162-1.178c0-.651.52-1.18 1.162-1.18zm5.34 2.867c-1.797-.052-3.746.512-5.28 1.786-1.72 1.428-2.687 3.72-1.78 6.22.942 2.453 3.666 4.229 6.884 4.229.826 0 1.622-.12 2.361-.336a.722.722 0 0 1 .598.082l1.584.926a.272.272 0 0 0 .14.045c.134 0 .24-.11.24-.245 0-.06-.023-.12-.038-.177l-.327-1.233a.582.582 0 0 1 .19-.554C23.156 18.437 24 16.743 24 14.886c0-3.176-3.095-5.764-6.95-5.873l-.112-.155zm-2.506 2.583c.535 0 .969.44.969.983a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.543.434-.983.97-.983zm4.844 0c.535 0 .969.44.969.983a.976.976 0 0 1-.969.983.976.976 0 0 1-.969-.983c0-.543.434-.983.969-.983z" />
          </svg>
          <span>WeChat Contact</span>
          <svg class="float-contact__btn-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9" />
          </svg>
        </button>

        <div class="float-contact__wechat-id" id="float-contact-wechat-id" aria-hidden="true">
          <div class="float-contact__wechat-id-row">
            <span class="float-contact__wechat-id-label">WeChat ID:</span>
            <code class="float-contact__wechat-id-value" id="float-contact-wechat-value">NixiaFabric</code>
          </div>
          <button
            class="float-contact__copy-btn"
            id="float-contact-copy"
            aria-label="Copy WeChat ID"
          >
            <svg class="float-contact__copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <svg class="float-contact__check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="20 6 9 17 4 12" />
            </svg>
            <span class="float-contact__copy-text">Copy</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Backdrop (mobile only) -->
  <div class="float-contact__backdrop" id="float-contact-backdrop" aria-hidden="true"></div>
</div>

<style>
  .float-contact {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 999;
    font-family: var(--font-sans);
  }

  /* ---- Trigger Button ---- */
  .float-contact__trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    background: #25D366;
    color: var(--color-white);
    box-shadow: 0 4px 20px rgba(37, 211, 102, 0.4);
    transition: transform var(--transition-base), box-shadow var(--transition-base), background var(--transition-base);
    position: relative;
    z-index: 2;
  }

  .float-contact__trigger:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 28px rgba(37, 211, 102, 0.5);
    background: #20bd5a;
  }

  .float-contact__trigger:active {
    transform: scale(0.96);
  }

  /* ---- Pulse Ring Animation ---- */
  .float-contact__trigger::before,
  .float-contact__trigger::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 2px solid #25D366;
    opacity: 0;
    pointer-events: none;
    animation: float-contact-pulse 2.4s ease-out infinite;
  }

  .float-contact__trigger::after {
    animation-delay: 1.2s;
  }

  @keyframes float-contact-pulse {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    100% {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  /* Hide pulse when popup is open */
  .float-contact.is-open .float-contact__trigger::before,
  .float-contact.is-open .float-contact__trigger::after {
    animation: none;
    opacity: 0;
  }

  .float-contact__icon-close {
    display: none;
    position: absolute;
  }

  .float-contact.is-open .float-contact__icon-chat {
    display: none;
  }

  .float-contact.is-open .float-contact__icon-close {
    display: block;
  }

  .float-contact.is-open .float-contact__trigger {
    background: #20bd5a;
  }

  /* ---- Popup Card ---- */
  .float-contact__popup {
    position: absolute;
    bottom: 70px;
    right: 0;
    width: 340px;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.18);
    border: 1px solid var(--color-border);
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px) scale(0.96);
    transition: opacity var(--transition-base), transform var(--transition-base), visibility var(--transition-base);
    overflow: hidden;
  }

  .float-contact.is-open .float-contact__popup {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  /* ---- Popup Header ---- */
  .float-contact__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px 12px;
    background: linear-gradient(135deg, #25D366 0%, #20bd5a 100%);
  }

  .float-contact__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-white);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .float-contact__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: var(--color-white);
    cursor: pointer;
    transition: background var(--transition-fast);
    flex-shrink: 0;
  }

  .float-contact__close:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  /* ---- Popup Body ---- */
  .float-contact__hint {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-secondary);
    padding: 14px 20px 8px;
    margin: 0;
  }

  .float-contact__actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 8px 20px 20px;
  }

  /* ---- Action Buttons ---- */
  .float-contact__btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all var(--transition-fast);
    width: 100%;
    text-align: left;
  }

  .float-contact__btn svg {
    flex-shrink: 0;
  }

  .float-contact__btn--whatsapp {
    background: #25D366;
    color: var(--color-white);
  }

  .float-contact__btn--whatsapp:hover {
    background: #20bd5a;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(37, 211, 102, 0.35);
  }

  .float-contact__btn--wechat {
    background: #07C160;
    color: var(--color-white);
  }

  .float-contact__btn--wechat:hover {
    background: #06ad55;
  }

  .float-contact__btn-chevron {
    margin-left: auto;
    transition: transform var(--transition-base);
  }

  .float-contact__btn--wechat[aria-expanded="true"] .float-contact__btn-chevron {
    transform: rotate(180deg);
  }

  /* ---- WeChat ID Block ---- */
  .float-contact__wechat-id {
    max-height: 0;
    overflow: hidden;
    transition: max-height var(--transition-base);
  }

  .float-contact__wechat-id.is-visible {
    max-height: 80px;
  }

  .float-contact__wechat-id-inner,
  .float-contact__wechat-id-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .float-contact__wechat-id-row {
    padding: 10px 14px;
    background: var(--color-bg-alt);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .float-contact__wechat-id-label {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .float-contact__wechat-id-value {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
    font-family: var(--font-sans);
  }

  .float-contact__copy-btn {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    border: 1px solid #25D366;
    border-radius: var(--radius-sm);
    background: var(--color-white);
    color: #20bd5a;
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .float-contact__copy-btn:hover {
    background: #25D366;
    color: var(--color-white);
  }

  .float-contact__check-icon {
    display: none;
  }

  .float-contact__copy-btn.is-copied .float-contact__copy-icon {
    display: none;
  }

  .float-contact__copy-btn.is-copied .float-contact__check-icon {
    display: block;
  }

  .float-contact__copy-btn.is-copied {
    background: #25D366;
    border-color: #25D366;
    color: var(--color-white);
  }

  /* ---- Backdrop (mobile) ---- */
  .float-contact__backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
    z-index: -1;
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  /* ---- Responsive ---- */
  @media (max-width: 640px) {
    .float-contact {
      bottom: 16px;
      right: 16px;
    }

    .float-contact__trigger {
      width: 50px;
      height: 50px;
    }

    .float-contact__popup {
      bottom: 62px;
      right: 0;
      width: calc(100vw - 32px);
      max-width: 340px;
    }

    .float-contact.is-open .float-contact__backdrop {
      display: block;
      opacity: 1;
    }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .float-contact__trigger,
    .float-contact__popup,
    .float-contact__btn,
    .float-contact__close {
      transition: none;
    }

    .float-contact__trigger::before,
    .float-contact__trigger::after {
      animation: none;
      opacity: 0;
    }
  }
</style>

<script>
  const floatContact = document.getElementById("float-contact");
  const trigger = document.getElementById("float-contact-trigger");
  const closeBtn = document.getElementById("float-contact-close");
  const popup = document.getElementById("float-contact-popup");
  const backdrop = document.getElementById("float-contact-backdrop");
  const wechatToggle = document.getElementById("float-contact-wechat-toggle");
  const wechatId = document.getElementById("float-contact-wechat-id");
  const copyBtn = document.getElementById("float-contact-copy");
  const wechatValue = document.getElementById("float-contact-wechat-value");

  function openPopup() {
    floatContact?.classList.add("is-open");
    trigger?.setAttribute("aria-expanded", "true");
    popup?.setAttribute("aria-hidden", "false");
  }

  function closePopup() {
    floatContact?.classList.remove("is-open");
    trigger?.setAttribute("aria-expanded", "false");
    popup?.setAttribute("aria-hidden", "true");
    // Collapse WeChat ID on close
    wechatId?.classList.remove("is-visible");
    wechatToggle?.setAttribute("aria-expanded", "false");
  }

  trigger?.addEventListener("click", () => {
    if (floatContact?.classList.contains("is-open")) {
      closePopup();
    } else {
      openPopup();
    }
  });

  closeBtn?.addEventListener("click", closePopup);
  backdrop?.addEventListener("click", closePopup);

  // WeChat toggle
  wechatToggle?.addEventListener("click", () => {
    const isVisible = wechatId?.classList.toggle("is-visible");
    wechatToggle.setAttribute("aria-expanded", String(isVisible));
  });

  // Copy WeChat ID
  copyBtn?.addEventListener("click", async () => {
    const text = wechatValue?.textContent || "";
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // Fallback for older browsers
      const textarea = document.createElement("textarea");
      textarea.value = text;
      textarea.style.position = "fixed";
      textarea.style.opacity = "0";
      document.body.appendChild(textarea);
      textarea.select();
      try {
        document.execCommand("copy");
      } catch {
        /* noop */
      }
      document.body.removeChild(textarea);
    }

    // Visual feedback
    copyBtn.classList.add("is-copied");
    const textEl = copyBtn.querySelector(".float-contact__copy-text");
    if (textEl) textEl.textContent = "Copied!";
    setTimeout(() => {
      copyBtn.classList.remove("is-copied");
      if (textEl) textEl.textContent = "Copy";
    }, 2000);
  });

  // Close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && floatContact?.classList.contains("is-open")) {
      closePopup();
    }
  });
</script>
