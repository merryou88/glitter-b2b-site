---
/**
 * ProductCard.astro — Product card for listing pages
 * Shows: Product image placeholder, category badge, product name, brief description
 * No price, no buy button — B2B inquiry model
 */
import type { Product } from "@data/products";

export interface Props {
  product: Product;
}

const { product } = Astro.props;

// Color swatch mapping for visual placeholder
const colorSwatchMap: Record<string, string> = {
  Gold: "#D4AF37",
  Silver: "#C0C0C0",
  "Rose Gold": "#B76E79",
  Black: "#1A1A1A",
  "Navy Blue": "#1B2845",
  Champagne: "#F7E7CE",
  Red: "#C41E3A",
  Pink: "#E8A0BF",
  Blue: "#3B82F6",
  Green: "#2E7D32",
  Gunmetal: "#2A3439",
  "Bright Gold": "#FFD700",
  "Antique Gold": "#8B7355",
  "Champagne Gold": "#F7E7CE",
  "Bright Silver": "#E8E8E8",
  "Antique Silver": "#9C9C9C",
  Platinum: "#E5E4E2",
};

const swatches = product.colors
  .filter((c) => c !== "Custom Colors" && !c.includes("Custom"))
  .slice(0, 4)
  .map((c) => colorSwatchMap[c] || "#ccc");
---

<a href={`/products/${product.slug}`} class="product-card">
  <div class="product-card__image">
    <div class="product-card__swatches">
      {swatches.map((color) => (
        <span class="product-card__swatch" style={`background:${color}`}></span>
      ))}
    </div>
    <div class="product-card__overlay">
      <span class="product-card__view">View Details →</span>
    </div>
  </div>

  <div class="product-card__body">
    <span class="badge badge--accent">{product.category}</span>
    <h3 class="product-card__title">{product.name}</h3>
    <p class="product-card__desc">{product.description.slice(0, 100)}...</p>
    <div class="product-card__meta">
      <span class="product-card__spec">
        {product.specifications.composition}
      </span>
      <span class="product-card__spec-divider">·</span>
      <span class="product-card__spec">{product.specifications.width}</span>
    </div>
  </div>
</a>

<style>
  .product-card {
    display: block;
    background-color: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all var(--transition-base);
    height: 100%;
  }

  .product-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
    border-color: var(--color-accent-light);
  }

  .product-card__image {
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, #f0f2f6 0%, #e4e7ec 100%);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .product-card__swatches {
    display: flex;
    gap: 12px;
    transition: transform var(--transition-slow);
  }

  .product-card:hover .product-card__swatches {
    transform: scale(1.1);
  }

  .product-card__swatch {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15), inset 0 0 0 2px rgba(255, 255, 255, 0.3);
    position: relative;
  }

  .product-card__swatch::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(255,255,255,0.4) 0%, transparent 50%, rgba(0,0,0,0.1) 100%);
  }

  .product-card__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-md) var(--space-lg);
    background: linear-gradient(to top, rgba(22, 41, 77, 0.85) 0%, transparent 100%);
    opacity: 0;
    transition: opacity var(--transition-base);
    display: flex;
    align-items: flex-end;
  }

  .product-card:hover .product-card__overlay {
    opacity: 1;
  }

  .product-card__view {
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .product-card__body {
    padding: var(--space-xl);
  }

  .product-card__title {
    font-size: var(--text-xl);
    margin-top: var(--space-sm);
    margin-bottom: var(--space-sm);
    color: var(--color-primary);
    transition: color var(--transition-fast);
  }

  .product-card:hover .product-card__title {
    color: var(--color-accent-dark);
  }

  .product-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-md);
    line-height: 1.6;
  }

  .product-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-xs);
    color: var(--color-text-light);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .product-card__spec-divider {
    color: var(--color-border-dark);
  }

  @media (max-width: 640px) {
    .product-card__swatch {
      width: 36px;
      height: 36px;
    }
  }
</style>
