---
/**
 * Footer.astro — Site footer
 * Brand info, navigation, contact CTA
 */
const year = new Date().getFullYear();

const footerNav = [
  {
    title: "Products",
    links: [
      { label: "Glitter Fabric", href: "/products/glitter-fabric" },
      { label: "Foil Fabric", href: "/products/foil-fabric" },
      { label: "Elastic Glitter Fabric", href: "/products/elastic-glitter-fabric" },
      { label: "PU Glitter Fabric", href: "/products/pu-glitter-fabric" },
      { label: "All Products", href: "/products" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "Factory", href: "/factory" },
      { label: "About Us", href: "/about" },
      { label: "Blog", href: "/blog" },
    ],
  },
  {
    title: "Applications",
    links: [
      { label: "Shoes", href: "/products?app=shoes" },
      { label: "Handbags", href: "/products?app=handbags" },
      { label: "Fashion Accessories", href: "/products?app=fashion" },
      { label: "Bags Accessories", href: "/products?app=bags" },
    ],
  },
];
---

<footer class="footer">
  <!-- CTA Bar -->
  <div class="footer__cta">
    <div class="container footer__cta-inner">
      <div class="footer__cta-text">
        <h2>Need a Custom Fabric Solution?</h2>
        <p>Request free swatches or get a custom quote for your project.</p>
      </div>
      <div class="footer__cta-actions">
        <a href="/contact?inquiry=swatch" class="btn btn--primary btn--lg">
          Request Swatch
        </a>
        <a href="/contact?inquiry=quote" class="btn btn--secondary btn--lg">
          Get Custom Quote
        </a>
      </div>
    </div>
  </div>

  <!-- Main Footer -->
  <div class="footer__main">
    <div class="container footer__grid">
      <!-- Brand Column -->
      <div class="footer__brand">
        <a href="/" class="footer__logo">
          <span class="footer__logo-mark">NF</span>
          <span class="footer__logo-text">
            Nixia<span class="footer__logo-accent">Fabric</span>
          </span>
        </a>
        <p class="footer__tagline">
          China glitter fabric manufacturer specializing in glitter fabric and
          foil fabric for shoes, handbags, and fashion accessories. OEM
          production and custom color development.
        </p>
        <div class="footer__badges">
          <span class="footer__badge">OEM Production</span>
          <span class="footer__badge">Custom Color Development</span>
          <span class="footer__badge">Quality Control</span>
        </div>
      </div>

      <!-- Navigation Columns -->
      {footerNav.map((col) => (
        <div class="footer__col">
          <h3 class="footer__col-title">{col.title}</h3>
          <ul class="footer__col-links">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="footer__link">{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p class="footer__copyright">
        &copy; {year} Nixia Fabric. All rights reserved.
      </p>
      <div class="footer__bottom-links">
        <a href="/privacy" class="footer__link">Privacy Policy</a>
        <a href="/terms" class="footer__link">Terms of Service</a>
        <a href="/sitemap.xml" class="footer__link">Sitemap</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-bg-dark);
    color: rgba(255, 255, 255, 0.7);
  }

  /* CTA Bar */
  .footer__cta {
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-primary-dark) 100%
    );
    padding-block: var(--space-3xl);
  }

  .footer__cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xl);
  }

  .footer__cta-text h2 {
    color: var(--color-white);
    margin-bottom: var(--space-xs);
  }

  .footer__cta-text p {
    color: rgba(255, 255, 255, 0.75);
    font-size: var(--text-lg);
  }

  .footer__cta-actions {
    display: flex;
    gap: var(--space-md);
    flex-shrink: 0;
  }

  /* Main Footer */
  .footer__main {
    padding-block: var(--space-4xl) var(--space-3xl);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-3xl);
  }

  /* Brand */
  .footer__logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: var(--space-lg);
  }

  .footer__logo-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-dark) 100%);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 800;
    border-radius: var(--radius-sm);
  }

  .footer__logo-text {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-white);
  }

  .footer__logo-accent {
    color: var(--color-accent);
  }

  .footer__tagline {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: var(--space-lg);
    max-width: 380px;
  }

  .footer__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .footer__badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-accent-light);
    border: 1px solid rgba(196, 160, 53, 0.3);
    border-radius: var(--radius-full);
  }

  /* Navigation */
  .footer__col-title {
    color: var(--color-white);
    font-size: var(--text-base);
    font-weight: 700;
    margin-bottom: var(--space-md);
    letter-spacing: 0;
  }

  .footer__col-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer__link {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
    transition: color var(--transition-fast);
  }

  .footer__link:hover {
    color: var(--color-accent-light);
  }

  /* Bottom Bar */
  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-block: var(--space-lg);
  }

  .footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .footer__copyright {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.5);
  }

  .footer__bottom-links {
    display: flex;
    gap: var(--space-lg);
  }

  /* Responsive */
  @media (max-width: 968px) {
    .footer__cta-inner {
      flex-direction: column;
      text-align: center;
    }

    .footer__cta-actions {
      width: 100%;
      flex-direction: column;
    }

    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }

    .footer__bottom-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
