---
/**
 * Footer.astro — EcoWoodPlate-style 4-column footer
 * Brand | Products | Company | Contact
 */
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__main">
    <div class="container footer__grid">
      <!-- Column 1: Brand -->
      <div class="footer__col footer__brand">
        <a href="/" class="footer__logo">
          <span class="footer__logo-mark">NF</span>
          <span class="footer__logo-text">
            Nixia<span class="footer__logo-accent">Fabric</span>
          </span>
        </a>
        <p class="footer__tagline">
          With our own production facility and experienced manufacturing partners, we
          provide reliable glitter &amp; foil-printed synthetic leather solutions for
          global footwear and bag manufacturers.
        </p>
        <div class="footer__social">
          <a
            href="https://facebook.com/nixiafabric"
            class="footer__social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
          </a>
          <a
            href="https://linkedin.com/company/nixiafabric"
            class="footer__social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Products -->
      <div class="footer__col">
        <h3 class="footer__col-title">Products</h3>
        <ul class="footer__col-links">
          <li><a href="/products/elastic-glitter-fabric" class="footer__link">Glitter Synthetic Leather</a></li>
          <li><a href="/products/metallic-foil-fabric" class="footer__link">Foil-Printed PU Synthetic Leather</a></li>
          <li><a href="/products/" class="footer__link">Custom Backing &amp; Color</a></li>
          <li><a href="/sample-policy/" class="footer__link">Request Samples</a></li>
        </ul>
      </div>

      <!-- Column 3: Company -->
      <div class="footer__col">
        <h3 class="footer__col-title">Company</h3>
        <ul class="footer__col-links">
          <li><a href="/about/" class="footer__link">About Us</a></li>
          <li><a href="/sample-policy/" class="footer__link">Sample Policy</a></li>
          <li><a href="/certifications/" class="footer__link">Certifications</a></li>
          <li><a href="/blog/" class="footer__link">Blog</a></li>
          <li><a href="/contact/" class="footer__link">Get Custom Quote</a></li>
        </ul>
      </div>

      <!-- Column 4: Contact -->
      <div class="footer__col footer__contact">
        <h3 class="footer__col-title">Contact</h3>
        <ul class="footer__contact-list">
          <li class="footer__contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
            <span>Dongguan, Guangdong Province, China</span>
          </li>
          <li class="footer__contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
              <polyline points="22,6 12,13 2,6" />
            </svg>
            <a href="mailto:info@nixiafabric.com" class="footer__link">info@nixiafabric.com</a>
          </li>
          <li class="footer__contact-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z" />
            </svg>
            <a href="tel:+8613800000000" class="footer__link">+86 138-0000-0000</a>
          </li>
        </ul>
        <a href="/sample-policy/" class="btn btn--primary footer__cta-btn">
          Request Samples
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="footer__bottom">
    <div class="container footer__bottom-inner">
      <p class="footer__copyright">
        &copy;2026 Guangzhou Jiahong Fabric Co., Ltd. All rights reserved.
      </p>
      <div class="footer__bottom-links">
        <a href="/privacy/" class="footer__link">Privacy Policy</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-bg-dark);
    color: rgba(255, 255, 255, 0.7);
  }

  /* Main Footer */
  .footer__main {
    padding-block: var(--space-4xl) var(--space-3xl);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.2fr;
    gap: var(--space-3xl);
  }

  /* ---- Column 1: Brand ---- */
  .footer__brand {
    max-width: 360px;
  }

  .footer__logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: var(--space-lg);
  }

  .footer__logo-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-dark) 100%);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: 800;
    border-radius: var(--radius-sm);
  }

  .footer__logo-text {
    font-size: var(--text-xl);
    font-weight: 800;
    color: var(--color-white);
  }

  .footer__logo-accent {
    color: var(--color-accent);
  }

  .footer__tagline {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: var(--space-lg);
  }

  .footer__social {
    display: flex;
    gap: var(--space-sm);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.6);
    transition: all var(--transition-fast);
  }

  .footer__social-link:hover {
    background: var(--color-accent);
    color: var(--color-white);
    transform: translateY(-2px);
  }

  /* ---- Columns 2 & 3: Navigation ---- */
  .footer__col-title {
    color: var(--color-white);
    font-size: var(--text-base);
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .footer__col-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__link {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
    transition: color var(--transition-fast);
    text-decoration: none;
  }

  .footer__link:hover {
    color: var(--color-accent-light);
  }

  /* ---- Column 4: Contact ---- */
  .footer__contact-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-lg);
  }

  .footer__contact-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.6;
  }

  .footer__contact-item svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-accent);
  }

  .footer__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 12px 24px;
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: 700;
    border-radius: var(--radius-md);
    text-decoration: none;
  }

  /* ---- Bottom Bar ---- */
  .footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-block: var(--space-lg);
  }

  .footer__bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .footer__copyright {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.5);
  }

  .footer__bottom-links {
    display: flex;
    gap: var(--space-lg);
  }

  /* ---- Responsive ---- */
  @media (max-width: 968px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }

    .footer__brand {
      grid-column: 1 / -1;
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .footer__bottom-inner {
      flex-direction: column;
      text-align: center;
    }
  }
</style>
