---
/**
 * ProductDetail.astro — Single product detail UI component.
 * ---------------------------------------------------------------------------
 * Renders EVERY product using EXACTLY ONE layout: the plain-iridescent
 * reference page (nixiafabric.com/products/plain-iridescent-laser-spandex-4-way-stretch).
 *
 * All variable text/images are read from the `product` prop (see allProducts.js).
 * Fixed public content (Our Policy copy, SGS · REACH · Pre-shipment QC tags,
 * H2 headings) is hardcoded here — it must NOT be passed per product.
 *
 * This component contains NO <head>, NO meta tags, and NO ld+json scripts;
 * those are emitted by the dynamic route page pages/products/[slug].astro.
 */
import { existsSync, readdirSync } from "node:fs";
import { allProducts } from "../data/allProducts";

export interface Props {
  product: {
    slug: string;
    title: string;
    mainImageUrl: string;
    mainImageWebp: string | null;
    mainImageAlt: string;
    imageList: Array<{ src: string; webp: string | null; alt: string }>;
    galleryMainPath: string;
    galleryImages: string[];
    detailImagePath: string;
    video: { src: string; poster: string } | null;
    shortIntro: string;
    fullDescription: string;
    specs: {
      width: string;
      weight: string;
      baseMaterial: string;
      thickness: string;
      moq: string;
      leadTime: string;
    };
    specTable: Array<{ label: string; value: string }>;
    b2bTable: Array<{ label: string; value: string }>;
    availableColors: string;
    applications: string[];
    sampleNote: string;
    customizationNote: string;
    packaging: string;
    tradeTerms: string;
    faqList: Array<{ question: string; answer: string }>;
    skuImages: Array<{ src: string; alt: string }>;
    detailImages: string[];
    heroHighlights?: string[];
    whyChoose?: Array<{ title: string; desc: string }>;
    buyerApplications?: Array<{ title: string; desc: string }>;
    samplePrompt?: string;
  };
}

const { product } = Astro.props;
const isInquiryFocusedProduct = product.slug === "plain-iridescent-laser-spandex-4-way-stretch";
const quoteButtonLabel = isInquiryFocusedProduct ? "Get a Quote" : "Add to Quotation List";
const inquiryButtonLabel = isInquiryFocusedProduct ? "Send an Inquiry" : "WhatsApp";
const samplePolicyIntro =
  product.samplePrompt ??
  "Free samples available, buyer covers international shipping cost. Shipping fee will be deducted from bulk orders.";

// Available Colors — fall back to the factory default when not configured
const availableColors =
  product.availableColors === null ||
  product.availableColors === undefined ||
  product.availableColors.trim() === ""
    ? "1 standard color"
    : product.availableColors;

// Application scenario images — scanned from the product image folder at build time.
const configuredProductFolder = product.galleryMainPath?.replace(/\/main\/?$/i, "") ?? "";
const appImagePath = configuredProductFolder
  ? `${configuredProductFolder}/application/`
  : `/images/products/${product.slug}/application/`;
const appImagesBase = `public${appImagePath}`;
const applicationImages = (() => {
  if (!existsSync(appImagesBase) || product.applications.length === 0) return [];

  const byBase = new Map<
    string,
    { sortName: string; src: string | null; webp: string | null }
  >();

  readdirSync(appImagesBase)
    .filter((f: string) => /\.(png|jpe?g|webp)$/i.test(f))
    .forEach((f: string) => {
      const base = f.replace(/\.(png|jpe?g|webp)$/i, "").toLowerCase();
      const url = `${appImagePath}${f}`;
      const current = byBase.get(base) ?? { sortName: f, src: null, webp: null };

      if (/\.webp$/i.test(f)) {
        current.webp = url;
      } else if (!current.src || /\.jpe?g$/i.test(f)) {
        current.src = url;
      }
      byBase.set(base, current);
    });

  return [...byBase.values()]
    .sort((a, b) => {
      const na = Number.parseInt(a.sortName.match(/\d+/)?.[0] ?? "0", 10);
      const nb = Number.parseInt(b.sortName.match(/\d+/)?.[0] ?? "0", 10);
      return (na || 0) - (nb || 0) || a.sortName.localeCompare(b.sortName);
    })
    .filter((img) => img.src || img.webp)
    .map((img) => ({
      src: img.src ?? (img.webp as string),
      webp: img.src ? img.webp : null,
    }));
})();

// Related products: up to 3 other items sharing at least one application tag
const relatedProducts = allProducts
  .filter((p) => p.slug !== product.slug)
  .filter((p) =>
    p.applications.some((app) => product.applications.some((a) => a === app))
  )
  .slice(0, 3);

// Bottom SEO tags — applications + a stable attribute set
const seoTags = [
  ...new Set([
    ...product.applications,
    ...["wholesale", "oem odm", "factory direct", "free sample"],
  ]),
];

const titleCase = (s: string) =>
  s.replace(/(^|[\s-])([a-z])/g, (_m, p1: string, p2: string) => p1 + p2.toUpperCase());

// Gallery images — files live in the product's main/ subdirectory.
// JSON stores filenames only; here we build the full URL from galleryMainPath.
const galleryMainPath = product.galleryMainPath ?? "";
const galleryImages = (product.galleryImages ?? [])
  .slice(0, 8)
  .map((f: string) => {
    const src = galleryMainPath + f;
    const webp = src.replace(/\.(png|jpe?g)$/i, ".webp");
    return {
      src,
      webp: existsSync("public" + webp) ? webp : null,
      alt: product.mainImageAlt,
    };
  });

// Detail images — files live in images/[slug]/application/product-detail/.
// JSON stores filenames only; here we build the full URL from detailImagePath.
const detailImagePath = product.detailImagePath ?? "";
const detailImages = (product.detailImages ?? [])
  .map((f: string) => {
    const src = detailImagePath + f;
    const webp = src.replace(/\.(png|jpe?g)$/i, ".webp");
    return {
      src,
      webp: existsSync("public" + webp) ? webp : null,
      alt: product.title,
    };
  })
  .filter((img) => existsSync("public" + img.src));

// Prefer configured detail shots; use additional gallery images only as a fallback.
const productDetailImages =
  detailImages.length > 0 ? detailImages : galleryImages.slice(1);

const normalizeLabel = (label: string) => label.trim().toLowerCase();

const findRowValue = (
  rows: Array<{ label: string; value: string }>,
  labels: string[],
) => {
  const aliases = new Set(labels.map(normalizeLabel));
  return rows.find((row) => aliases.has(normalizeLabel(row.label)))?.value ?? "";
};

// Product Specifications follows the buyer's technical review order.
const productSpecRows = [
  {
    label: "Product Type",
    value: findRowValue(product.specTable, ["Product Type", "Name"]) || product.title,
  },
  {
    label: "Base Material",
    value:
      findRowValue(product.specTable, ["Material", "Base Material", "Base Fabric"]) ||
      product.specs.baseMaterial,
  },
  { label: "Width", value: product.specs.width },
  { label: "Weight", value: product.specs.weight },
  { label: "Thickness", value: product.specs.thickness },
  { label: "Surface Finish", value: findRowValue(product.specTable, ["Surface Finish"]) },
  { label: "Stretch", value: findRowValue(product.specTable, ["Stretch"]) },
  { label: "Hand-feel", value: findRowValue(product.specTable, ["Hand-feel"]) },
  { label: "Feature", value: findRowValue(product.specTable, ["Feature"]) },
  { label: "Quality Standard", value: findRowValue(product.specTable, ["Quality Standard"]) },
  {
    label: "Typical Applications",
    value: findRowValue(product.specTable, ["Typical Applications", "Usage"]),
  },
].filter((row) => row.value);

const b2bValue = (labels: string[]) => findRowValue(product.b2bTable, labels);

// B2B Specifications follows the buyer's quote, approval and shipment order.
const b2bRows = [
  { label: "MOQ", value: `${product.specs.moq} meters` },
  { label: "Supply Type", value: b2bValue(["Supply type", "Supply Type"]) },
  {
    label: "Stock Dispatch",
    value: `${product.specs.leadTime} working days after payment and stock confirmation`,
  },
  { label: "Bulk Lead Time", value: b2bValue(["Bulk Lead time", "Bulk Lead Time"]) },
  { label: "Available Colors", value: availableColors },
  { label: "Sample", value: b2bValue(["Sample", "Sampling"]) || product.sampleNote },
  {
    label: "Available Customization",
    value: b2bValue(["Available Customization", "Customization"]) || product.customizationNote,
  },
  { label: "OEM / ODM", value: b2bValue(["OEM / ODM", "OEM/ODM"]) },
  { label: "Packaging", value: b2bValue(["Package type", "Packaging"]) || product.packaging },
  {
    label: "Testing & Compliance",
    value: b2bValue(["Testing & Compliance", "Compliance"]),
  },
  { label: "Country of Origin", value: "China" },
  { label: "Port", value: b2bValue(["Port"]) },
  { label: "HS Code", value: "Confirmed by product and shipment" },
  { label: "Transit Time", value: "Quoted according to destination and shipping method" },
  {
    label: "Payment Terms",
    value: "Confirmed in quotation according to order and buyer requirements",
  },
  { label: "Trade Terms", value: b2bValue(["Trade Terms"]) || product.tradeTerms },
].filter((row) => row.value);

// Video poster is required and read from the product's main/ directory.
const heroVideo = product.video
  ? { src: product.video.src, poster: galleryMainPath + product.video.poster }
  : null;
---

<!-- Product Banner Header -->
<section class="p-banner">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="breadcrumb__sep">/</span>
      <a href="/products/">Products</a>
      <span class="breadcrumb__sep">/</span>
      <span class="breadcrumb__current">{product.title}</span>
    </nav>

    <h1 class="p-banner__title">{product.title}</h1>
    <p class="p-banner__desc">{product.shortIntro}</p>
  </div>
</section>

<!-- Hero Section -->
<section class="detail-hero">
  <div class="container">
    <div class="detail-layout">
      <div class="p-hero-gallery" id="p-hero-gallery">
        <div class="p-hero-gallery__main" id="p-hero-main">
          <picture>
            {
              galleryImages[0]?.webp && (
                <source id="p-hero-img-webp" srcset={galleryImages[0].webp} type="image/webp" />
              )
            }
            <source srcset={galleryImages[0]?.src} type="image/jpeg" />
            <img
              id="p-hero-img"
              src={galleryImages[0]?.src}
              alt={galleryImages[0]?.alt ?? product.mainImageAlt}
              width="800"
              height="800"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </picture>
          {
            heroVideo && (
              <video id="p-hero-video" controls preload="none" muted playsinline poster={heroVideo.poster} style="display:none">
                <source src={heroVideo.src} type="video/mp4" />
              </video>
            )
          }
        </div>
        <div class="p-hero-gallery__thumbs">
          <button
            class="p-hero-gallery__thumb p-hero-gallery__thumb--active"
            data-type="image"
            data-src={galleryImages[0]?.src}
            data-webp={galleryImages[0]?.webp ?? ""}
            data-alt={galleryImages[0]?.alt ?? product.mainImageAlt}
            aria-label="View main image"
          >
            <picture>
              {
                galleryImages[0]?.webp && (
                  <source srcset={galleryImages[0].webp} type="image/webp" />
                )
              }
              <img
                src={galleryImages[0]?.src}
                alt={galleryImages[0]?.alt ?? product.mainImageAlt}
                width="120"
                height="80"
                loading="eager"
                decoding="async"
              />
            </picture>
          </button>
          {galleryImages.slice(1).map((img) => (
            <button
              class="p-hero-gallery__thumb"
              data-type="image"
              data-src={img.src}
              data-webp={img.webp ?? ""}
              data-alt={img.alt}
              aria-label="View detail image"
            >
              <picture>
                {img.webp && <source srcset={img.webp} type="image/webp" />}
                <img src={img.src} alt={img.alt} width="120" height="80" loading="lazy" decoding="async" />
              </picture>
            </button>
          ))}
          {
            heroVideo && (
              <button class="p-hero-gallery__thumb" data-type="video" aria-label="View product video">
                <picture>
                  <img
                    src={galleryImages[0]?.src}
                    alt={galleryImages[0]?.alt ?? product.mainImageAlt}
                    width="120"
                    height="80"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
                <span class="p-hero-gallery__play-icon" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"/></svg>
                </span>
              </button>
            )
          }
        </div>
        {product.heroHighlights && product.heroHighlights.length > 0 && (
          <div class="detail-highlights">
            {product.heroHighlights.map((item) => (
              <div class="detail-highlights__item">{item}</div>
            ))}
          </div>
        )}

        <div class="detail-feature-tags">
          <span class="feature-tag feature-tag--green">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>SGS on Request</span>
          </span>
          <span class="feature-tag feature-tag--blue">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>REACH on Request</span>
          </span>
          <span class="feature-tag feature-tag--amber">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Pre-shipment QC</span>
          </span>
        </div>
      </div>

      <!-- Product Info -->
      <div class="detail-info">
        <div class="detail-info__heading">
          <span class="detail-info__badge">
            <svg class="detail-info__badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
              <path d="m3.3 7 8.7 5 8.7-5" />
              <path d="M12 22V12" />
            </svg>
            WHOLESALE FABRIC
          </span>
          <h2 class="detail-info__title">{product.title}</h2>
        </div>
        <p class="detail-info__desc">{product.shortIntro}</p>

        <!-- MOQ / Lead Time cards -->
        <div class="detail-offer-grid">
          <div class="detail-offer-card detail-offer-card--moq">
            <span class="detail-offer-card__label">MOQ</span>
            <strong class="detail-offer-card__value">{product.specs.moq}</strong>
            <span class="detail-offer-card__unit">Meters</span>
          </div>
          <div class="detail-offer-card detail-offer-card--lead">
            <span class="detail-offer-card__label">STOCK DISPATCH</span>
            <strong class="detail-offer-card__value">{product.specs.leadTime}</strong>
            <span class="detail-offer-card__unit">Working Days</span>
          </div>
        </div>

        <!-- B2B Buying Details -->
        <div class="detail-buying">
          <div class="detail-buying__card">
            <h2 class="detail-buying__title">B2B Buying Information</h2>
            <div class="detail-buying__grid">
              <div class="detail-buying__item">
                <h3 class="detail-buying__item-title">SAMPLE</h3>
                <p class="detail-buying__item-text">{product.sampleNote}</p>
              </div>
              <div class="detail-buying__item">
                <h3 class="detail-buying__item-title">CUSTOMIZATION</h3>
                <p class="detail-buying__item-text">{product.customizationNote}</p>
              </div>
              <div class="detail-buying__item">
                <h3 class="detail-buying__item-title">PACKAGING</h3>
                <p class="detail-buying__item-text">{product.packaging}</p>
              </div>
              <div class="detail-buying__item">
                <h3 class="detail-buying__item-title">TRADE TERMS</h3>
                <p class="detail-buying__item-text">{product.tradeTerms}</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Quote Information Tips -->
        <div class="detail-quote-tips">
          <h3 class="detail-quote-tips__title">For an Accurate Quote, Please Share</h3>
          <div class="detail-quote-tips__grid">
            <div class="detail-quote-tips__item">Target quantity(Meters)</div>
            <div class="detail-quote-tips__item">Destination country</div>
            <div class="detail-quote-tips__item">Application / end product</div>
            <div class="detail-quote-tips__item">Base material</div>
            <div class="detail-quote-tips__item">Customization requirement</div>
            <div class="detail-quote-tips__item">Target delivery date</div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="detail-cta">
          <a href={`/contact/?sku=${encodeURIComponent(product.title)}`} data-rfq-open data-rfq-sku={product.title} class="btn detail-cta__btn detail-cta__btn--gold">
            <svg class="detail-cta__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
              <path d="M14 2v4a2 2 0 0 0 2 2h4" />
              <path d="M10 9H8" />
              <path d="M16 13H8" />
              <path d="M16 17H8" />
            </svg>
            {quoteButtonLabel}
          </a>
          <a href="/sample-policy/" data-rfq-open data-rfq-sku={product.title} class="btn detail-cta__btn detail-cta__btn--sample">
            <svg class="detail-cta__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
              <path d="m3.3 7 8.7 5 8.7-5" />
              <path d="M12 22V12" />
            </svg>
            Get Sample
          </a>
          <a href="https://wa.me/8613616899303" target="_blank" rel="noopener noreferrer" class="btn detail-cta__btn detail-cta__btn--wa">
            <svg class="detail-cta__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
            </svg>
            {inquiryButtonLabel}
          </a>
          <button type="button" class="btn detail-cta__btn detail-cta__btn--sample detail-cta__btn--copy" id="copy-product-link">
            <svg class="detail-cta__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
            </svg>
            Copy Product Link
          </button>
        </div>
        <p class="detail-cta__note">Our factory team will reply within 24 hours.</p>
        <div class="rfq-toast" id="rfq-toast" role="status" aria-live="polite">Link copied</div>
      </div>
    </div>
  </div>
</section>

<!-- Detail Body -->
<section class="section">
  <div class="container">
    <div class={`detail-body detail-body--plain ${isInquiryFocusedProduct ? "detail-body--wide" : ""}`}>
      <!-- Description -->
      <div class="detail-body__text">
        <h2 class="section-title-with-icon">
          <span class="section-title-with-icon__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 3h9l3 3v15H6z" />
              <path d="M15 3v4h4" />
              <path d="M8 11h8" />
              <path d="M8 15h8" />
            </svg>
          </span>
          <span>Product Description</span>
        </h2>
        {product.fullDescription.split("\n\n").map((para: string) => (
          <p>{para}</p>
        ))}
      </div>

      {product.whyChoose && product.whyChoose.length > 0 && (
        <div class="detail-body__section" id="why-choose">
          <h2 class="section-title-with-icon">
            <span class="section-title-with-icon__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.8 6.4 20.2l1.1-6.2L3 9.6l6.2-.9L12 3z" />
              </svg>
            </span>
            <span>Why Choose This Fabric?</span>
          </h2>
          <div class="why-choose-grid">
            {product.whyChoose.map((item) => (
              <div class="why-choose-card">
                <h3>{item.title}</h3>
                <p>{item.desc}</p>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Product Specifications -->
      <div class="detail-body__section" id="specifications">
        <h2 class="section-title-with-icon">
          <span class="section-title-with-icon__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 20h16" />
              <path d="M7 16V8" />
              <path d="M12 16V5" />
              <path d="M17 16v-4" />
            </svg>
