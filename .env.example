# ============================================
# Astro site environment variables
# Copy this file to .env (dev) and/or .env.production (build) and fill values.
# ============================================

# Backend Worker URL for Contact & RFQ forms.
# - Local dev with wrangler:  http://localhost:8787
# - Production: your deployed worker URL, e.g. https://inquiry.nixiafabric.com
WORKER_URL=http://localhost:8787

# Cloudflare Turnstile site key (public).
# Set the matching TURNSTILE_SECRET on the Worker via `wrangler secret put`.
TURNSTILE_SITE_KEY=0x4AAAAAAA